{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "sourceMap": true,
    "isolatedModules": true,
    "outDir": "dist",
    // `build` runs `tsc && vite build`; vite emits dist/, so tsc is only a
    // typecheck pass here. Without this, pulling the out-of-tree catalog source
    // (see "paths" below) into the program would skew tsc's inferred root dir.
    "noEmit": true,
    "baseUrl": ".",
    // Mirrors the `@a2ui/mcp-catalog` alias in vite.config.ts. See the TODO there.
    "paths": {
      "@a2ui/mcp-catalog": ["../../../../../catalogs/mcp/v0_9/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "*.ts"]
}
