{
  "name": "a2ui-embed-sql",
  "private": true,
  "version": "0.1.0",
  "description": "Internal proof of concept: a read-only SQL MCP server that renders A2UI v1.0 inside MCP Apps through @a2ui/embed",
  "type": "module",
  "scripts": {
    "fetch-data": "node scripts/fetch-data.mjs",
    "generate:schema": "UPDATE_SCHEMA=1 vitest run src/catalog/catalog_schema.test.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@a2ui/catalog-vegachart": "portal:../../../../typescript/catalogs/vegachart",
    "@a2ui/web_core": "*",
    "@google/genai": "^2.8.0",
    "lit": "^3.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "ajv": "^8.17.1",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
