{
  "name": "a2ui-kanban-client",
  "private": true,
  "version": "0.1.0",
  "description": "Lit chat host for the A2UI Kanban showcase: A2A to the agent, McpApp for the board",
  "type": "module",
  "scripts": {
    "copy-sandbox": "rm -rf public/a2ui-sandbox && mkdir -p public && cp -R ../../../../../typescript/catalogs/mcp/dist/sandbox public/a2ui-sandbox",
    "dev": "yarn copy-sandbox && vite",
    "build": "yarn copy-sandbox && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@a2ui/markdown-it": "*",
    "@lit-labs/signals": "^0.3.0",
    "@lit/context": "^1.1.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.1",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
