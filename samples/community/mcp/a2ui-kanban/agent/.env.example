# Copy this file to .env and fill in your API key (do not commit .env).
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used by the agent.
KANBAN_MODEL=gemini-flash-lite-latest

# Set to "scripted" to run the deterministic storyline without an API key.
# KANBAN_AGENT=scripted

# Where the Kanban MCP server listens.
KANBAN_MCP_URL=http://localhost:8788/mcp
