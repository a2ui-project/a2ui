    "@modelcontextprotocol/sdk": "^1.29.0",
    "lit": "^3.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "playwright": "1.58.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
