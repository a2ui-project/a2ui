# Copy to .env (gitignored).
# GitHub token for live mode. Optional with GITHUB_FIXTURES.
GITHUB_TOKEN=
# Optional (default: a2ui-project/a2ui)
GITHUB_REPO=
# Optional: serve a captured snapshot instead of the GitHub API, such as fixtures-local/a2ui.
GITHUB_FIXTURES=
# Writes are dry runs unless TRIAGE_WRITE=1 and the repo is in TRIAGE_WRITE_REPOS (comma-separated).
TRIAGE_WRITE=
TRIAGE_WRITE_REPOS=
# Gemini for suggest_triage. Without a key, suggestions are unavailable.
GEMINI_API_KEY=
# Optional (default: gemini-flash-latest)
GEMINI_MODEL=
