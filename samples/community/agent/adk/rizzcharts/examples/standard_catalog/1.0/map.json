[
  {
    "version": "v1.0",
    "createSurface": {
      "surfaceId": "la-map-view",
      "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "v1.0",
    "updateComponents": {
      "surfaceId": "la-map-view",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": ["map_header", "map_image", "location_list"],
          "align": "stretch"
        },
        {
          "id": "map_header",
          "component": "Text",
          "text": "## Points of Interest in Los Angeles"
        },
        {
          "id": "map_image",
          "component": "Image",
          "url": "https://maps.googleapis.com/maps/api/staticmap?center=Los+Angeles,CA&zoom=11&size=600x300&key=YOUR_API_KEY",
          "fit": "cover"
        },
        {
          "id": "location_list",
          "component": "List",
          "direction": "vertical",
          "children": {
            "componentId": "location_card_template",
            "path": "/mapConfig/locations"
          }
        },
        {
          "id": "location_card_template",
          "component": "Card",
          "child": "location_details"
        },
        {
          "id": "location_details",
          "component": "Column",
          "children": ["location_name", "location_description"]
        },
        {
          "id": "location_name",
          "component": "Text",
          "text": {
            "@call": "formatString",
            "args": {
              "value": "#### ${name}"
            }
          }
        },
        {
          "id": "location_description",
          "component": "Text",
          "text": {
            "@path": "description"
          }
        }
      ]
    }
  },
  {
    "version": "v1.0",
    "updateDataModel": {
      "surfaceId": "la-map-view",
      "path": "/",
      "value": {
        "mapConfig": {
          "locations": [
            {
              "name": "Google Store Santa Monica",
              "description": "Your local destination for Google hardware."
            },
            {
              "name": "Griffith Observatory",
              "description": "A public observatory with views of the Hollywood Sign."
            },
            {
              "name": "Hollywood Sign Viewpoint",
              "description": "Iconic landmark in the Hollywood Hills."
            },
            {
              "name": "Crypto.com Arena",
              "description": "Multi-purpose sports and entertainment arena."
            },
            {"name": "LACMA", "description": "Los Angeles County Museum of Art."},
            {"name": "Venice Beach Boardwalk", "description": "Famous oceanfront promenade."}
          ]
        }
      }
    }
  }
]
