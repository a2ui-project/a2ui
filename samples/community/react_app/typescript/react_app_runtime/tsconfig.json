{
  "$schema": "https://json.schemastore.org/tsconfig",
  /* Type-checks the browser runtime and its tests (no emit: scripts/build.mjs bundles with
     esbuild). The Node entry point has its own project, tsconfig.node.json. */
  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/runtime/**/*.ts", "src/runtime/**/*.tsx", "src/a2ui.d.ts"]
}
