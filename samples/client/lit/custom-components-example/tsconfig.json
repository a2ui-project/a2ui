{
  "$schema": "https://json.schemastore.org/tsconfig",

  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": false,
    // "allowJs": true,
    "preserveWatchOutput": true,
    "sourceMap": true,
    "target": "es2022",
    "module": "es2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "lit": ["../../../../adapters/lit/node_modules/lit"],
      "lit-html": ["../../../../adapters/lit/node_modules/lit-html"],
      "lit-element": ["../../../../adapters/lit/node_modules/lit-element"],
      "@lit/reactive-element": ["../../../../adapters/lit/node_modules/@lit/reactive-element"],
      "@lit/context": ["../../../../adapters/lit/node_modules/@lit/context"]
    }
  },
  "references": [{"path": "../../../../adapters/lit"}]
}
