{
  "name": "@a2ui/multi_catalog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "wireit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "yarn --cwd ../.. lint",
    "test": "node -e \"console.log('Workspace has no tests.')\"",
    "lint:fix": "yarn --cwd ../.. lint:fix"
  },
  "dependencies": {
    "@a2ui/angular": "workspace:*",
    "@a2ui/markdown-it": "workspace:*",
    "@a2ui/web_core": "workspace:*"
  },
  "devDependencies": {
    "wireit": "^0.15.0-pre.2"
  },
  "wireit": {
    "build": {
      "command": "yarn workspace angular-a2ui ng build multi_catalog",
      "dependencies": [
        "../../../../../typescript/renderers/angular:build"
      ],
      "files": [
        "src/**/*",
        "tsconfig.app.json"
      ],
      "output": [
        "dist"
      ]
    }
  }
}
