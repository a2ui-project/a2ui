# Copy this file to .env and fill in your API key
# Get your API key at: https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the persistent A2A/A2UI log path. Relative paths are
# resolved from this sample directory. The default is logs/a2ui.log.
# A2UI_LOG_FILE=logs/a2ui.log

# Optional: Use Vertex AI instead of Gemini API
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
