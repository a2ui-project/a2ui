[
  {
    "version": "v1.0",
    "createSurface": {
      "surfaceId": "dashboard",
      "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "v1.0",
    "updateComponents": {
      "surfaceId": "dashboard",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": ["title", "stats_row", "progress_row", "highlights", "refresh_button"]
        },
        {
          "id": "title",
          "component": "Text",
          "text": {"@path": "/title"}
        },
        {
          "id": "stats_row",
          "component": "Row",
          "children": ["revenue", "new_customers", "average_deal"]
        },
        {
          "id": "revenue",
          "component": "StatCard",
          "catalogId": "https://a2ui.org/samples/agent/adk/multi_catalog/catalogs/1.0/dashboard_catalog.json",
          "weight": 1,
          "label": "Revenue",
          "value": {"@path": "/revenue"},
          "caption": {"@path": "/revenueChange"}
        },
        {
          "id": "new_customers",
          "component": "StatCard",
          "catalogId": "https://a2ui.org/samples/agent/adk/multi_catalog/catalogs/1.0/dashboard_catalog.json",
          "weight": 1,
          "label": "New customers",
          "value": {"@path": "/newCustomers"},
          "caption": {"@path": "/customersChange"}
        },
        {
          "id": "average_deal",
          "component": "StatCard",
          "catalogId": "https://a2ui.org/samples/agent/adk/multi_catalog/catalogs/1.0/dashboard_catalog.json",
          "weight": 1,
          "label": "Average deal",
          "value": {"@path": "/averageDeal"},
          "caption": {"@path": "/dealChange"}
        },
        {
          "id": "progress_row",
          "component": "Row",
          "children": ["target", "pipeline"]
        },
        {
          "id": "target",
          "component": "ProgressBar",
          "catalogId": "https://a2ui.org/samples/agent/adk/multi_catalog/catalogs/1.0/dashboard_catalog.json",
          "weight": 1,
          "label": "Quarterly target",
          "percent": {"@path": "/targetPercent"}
        },
        {
          "id": "pipeline",
          "component": "ProgressBar",
          "catalogId": "https://a2ui.org/samples/agent/adk/multi_catalog/catalogs/1.0/dashboard_catalog.json",
          "weight": 1,
          "label": "Pipeline coverage",
          "percent": {"@path": "/pipelinePercent"}
        },
        {
          "id": "highlights",
          "component": "Text",
          "text": {"@path": "/highlights"}
        },
        {
          "id": "refresh_label",
          "component": "Text",
          "text": "Refresh"
        },
        {
          "id": "refresh_button",
          "component": "Button",
          "child": "refresh_label",
          "action": {
            "event": {
              "name": "refresh_dashboard",
              "context": {"region": {"@path": "/region"}}
            }
          }
        }
      ]
    }
  },
  {
    "version": "v1.0",
    "updateDataModel": {
      "surfaceId": "dashboard",
      "path": "/",
      "value": {
        "title": "## [Region] sales, [Quarter]",
        "region": "[Region]",
        "revenue": "[Revenue]",
        "revenueChange": "[RevenueChange]",
        "newCustomers": "[NewCustomers]",
        "customersChange": "[CustomersChange]",
        "averageDeal": "[AverageDeal]",
        "dealChange": "[DealChange]",
        "targetPercent": 0,
        "pipelinePercent": 0,
        "highlights": "[Highlights]"
      }
    }
  }
]
