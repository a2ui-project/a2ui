{
  "name": "@a2ui/agent-restaurant-node",
  "version": "0.1.0",
  "private": true,
  "description": "A2UI Node Restaurant Agent Sample",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "build:tsc": "wireit",
    "start": "node dist/src/index.js",
    "test": "node -e 'const fs=require(\"fs\"); const path=require(\"path\"); function find(d){for(const f of fs.readdirSync(d)){const p=path.join(d,f);if(f===\"node_modules\"||f===\"dist\")continue;if(fs.statSync(p).isDirectory()){if(find(p))return true;}else if(f.includes(\".test.\")||f.includes(\".spec.\"))return true;}return false;} if(find(\".\")){require(\"child_process\").execSync(\"vitest run\",{stdio:\"inherit\"});}else{console.log(\"Workspace has no tests.\");}'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "wireit",
    "format:check": "wireit",
    "clean": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:tsc"
      ]
    },
    "build:tsc": {
      "command": "tsc -b --pretty",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/",
        "!dist/**/*.min.js{,.map}"
      ],
      "clean": "if-file-deleted"
    },
    "clean": {
      "command": "rm -rf dist .tsbuildinfo .wireit"
    },
    "format": {
      "command": "prettier --write .",
      "files": [
        "src/**/*.ts",
        "eslint.config.mjs",
        "package.json",
        "tsconfig.json",
        "README.md"
      ]
    },
    "format:check": {
      "command": "prettier --check .",
      "files": [
        "src/**/*.ts",
        "eslint.config.mjs",
        "package.json",
        "tsconfig.json",
        "README.md"
      ]
    }
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@a2ui/agent": "workspace:*",
    "@google/genai": "^2.8.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "eslint": "^10.4.1",
    "typescript": "5.9.3",
    "wireit": "^0.15.0-pre.2"
  }
}
