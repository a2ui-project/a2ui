{
  "name": "@a2ui/vegachart-sample",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone A2UI VegaChart catalog sample (no LLM agent)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@a2ui/catalog-vegachart": "workspace:*",
    "@a2ui/lit": "workspace:*",
    "@a2ui/markdown-it": "workspace:*",
    "@a2ui/web_core": "workspace:*",
    "@lit/context": "^1.1.6",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
