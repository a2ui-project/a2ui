[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "vegachart-dashboard",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "vegachart-dashboard",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": [
            "title",
            "revenue_card",
            "traffic_card",
            "latency_card",
            "facet_card",
            "tickets_card"
          ]
        },
        {
          "id": "title",
          "component": "Text",
          "text": {"path": "/dashboardTitle"},
          "variant": "h2"
        },

        {
          "id": "revenue_card",
          "component": "Card",
          "child": "revenue_col"
        },
        {
          "id": "revenue_col",
          "component": "Column",
          "children": ["revenue_heading", "revenue_caption", "revenue_chart"]
        },
        {
          "id": "revenue_heading",
          "component": "Text",
          "text": "Quarterly Revenue by Product Line",
          "variant": "h4"
        },
        {
          "id": "revenue_caption",
          "component": "Text",
          "text": "Grouped bars with `xOffset`, rounded corners, and tooltips. Bound to `/charts/quarterlyRevenue`.",
          "variant": "caption"
        },
        {
          "id": "revenue_chart",
          "component": "VegaChart",
          "catalogId": "https://a2ui.org/specification/v0_9/catalogs/vegachart/catalog.json",
          "height": 300,
          "spec": {"path": "/charts/quarterlyRevenue"}
        },

        {
          "id": "traffic_card",
          "component": "Card",
          "child": "traffic_col"
        },
        {
          "id": "traffic_col",
          "component": "Column",
          "children": ["traffic_heading", "traffic_caption", "traffic_chart"]
        },
        {
          "id": "traffic_heading",
          "component": "Text",
          "text": "Monthly Active Users by Channel",
          "variant": "h4"
        },
        {
          "id": "traffic_caption",
          "component": "Text",
          "text": "Multi-series temporal line. The spec asks for `%b` month labels; because the data spans two years, the renderer rewrites the axis to `%b %Y` so labels stay unambiguous.",
          "variant": "caption"
        },
        {
          "id": "traffic_chart",
          "component": "VegaChart",
          "catalogId": "https://a2ui.org/specification/v0_9/catalogs/vegachart/catalog.json",
          "height": 300,
          "spec": {"path": "/charts/monthlyTraffic"}
        },

        {
          "id": "latency_card",
          "component": "Card",
          "child": "latency_col"
        },
        {
          "id": "latency_col",
          "component": "Column",
          "children": ["latency_heading", "latency_caption", "latency_chart"]
        },
        {
          "id": "latency_heading",
          "component": "Text",
          "text": "API Latency: p50 with p5–p95 Band",
          "variant": "h4"
        },
        {
          "id": "latency_caption",
          "component": "Text",
          "text": "A `layer` spec combining an area band, a line, and a dashed SLO rule.",
          "variant": "caption"
        },
        {
          "id": "latency_chart",
          "component": "VegaChart",
          "catalogId": "https://a2ui.org/specification/v0_9/catalogs/vegachart/catalog.json",
          "height": 300,
          "spec": {"path": "/charts/latency"}
        },

        {
          "id": "facet_card",
          "component": "Card",
          "child": "facet_col"
        },
        {
          "id": "facet_col",
          "component": "Column",
          "children": ["facet_heading", "facet_caption", "regional_facet_chart"]
        },
        {
          "id": "facet_heading",
          "component": "Text",
          "text": "Category Sales by Region",
          "variant": "h4"
        },
        {
          "id": "facet_caption",
          "component": "Text",
          "text": "Faceted with `encoding.column`. Subplot width is divided across the measured container; subplot height is derived from the number of categories.",
          "variant": "caption"
        },
        {
          "id": "regional_facet_chart",
          "component": "VegaChart",
          "catalogId": "https://a2ui.org/specification/v0_9/catalogs/vegachart/catalog.json",
          "spec": {"path": "/charts/regionalSales"}
        },

        {
          "id": "tickets_card",
          "component": "Card",
          "child": "tickets_col"
        },
        {
          "id": "tickets_col",
          "component": "Column",
          "children": ["tickets_heading", "tickets_caption", "tickets_chart"]
        },
        {
          "id": "tickets_heading",
          "component": "Text",
          "text": "Open Support Tickets by Team and Priority",
          "variant": "h4"
        },
        {
          "id": "tickets_caption",
          "component": "Text",
          "text": "Faceted with `encoding.facet` and `columns: 2`, so four teams wrap onto two rows. The chart grows taller than its default `height` to fit every subplot.",
          "variant": "caption"
        },
        {
          "id": "tickets_chart",
          "component": "VegaChart",
          "catalogId": "https://a2ui.org/specification/v0_9/catalogs/vegachart/catalog.json",
          "spec": {"path": "/charts/ticketsByTeam"}
        }
      ]
    }
  },
