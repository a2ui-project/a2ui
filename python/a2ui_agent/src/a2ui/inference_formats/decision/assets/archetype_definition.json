{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/specification/v1_0/decision/archetype_definition.json",
  "title": "A2UI decision layout archetype grammar",
  "description": "Catalog-agnostic grammar of layout archetypes, blocks, questions, slots, and rules consumed by the decision inference format.",
  "type": "object",
  "required": ["version", "thresholds", "job", "archetypes", "blocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "job": { "$ref": "#/$defs/job" },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/archetype" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "lint": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "unitInterval": { "type": "number", "minimum": 0, "maximum": 1 },
    "identifier": { "type": "string", "pattern": "^[a-z_]+$" },
    "blockMark": {
      "type": "string",
      "pattern": "^[a-z_]+[!?]?$",
      "description": "A block id with an optional mark: `!` required, `?` optional, bare expected."
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "range": {
      "type": "array",
      "description": "An inclusive [min, max] pair; null leaves that end open.",
      "prefixItems": [
        { "type": ["integer", "null"] },
        { "type": ["integer", "null"] }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "thresholds": {
      "type": "object",
      "required": [
        "family",
        "archetype",
        "expected",
        "optional",
        "instance",
        "reask_below",
        "actionGateFloor",
        "actionGateCap"
      ],
      "additionalProperties": false,
      "properties": {
        "family": { "$ref": "#/$defs/unitInterval" },
        "archetype": { "$ref": "#/$defs/unitInterval" },
        "expected": { "$ref": "#/$defs/unitInterval" },
        "optional": { "$ref": "#/$defs/unitInterval" },
        "instance": { "$ref": "#/$defs/unitInterval" },
        "reask_below": { "$ref": "#/$defs/unitInterval" },
        "actionGateFloor": { "$ref": "#/$defs/unitInterval" },
        "actionGateCap": { "$ref": "#/$defs/unitInterval" }
      }
    },
    "job": {
      "type": "object",
      "required": ["family", "stakes", "urgency"],
      "additionalProperties": false,
      "properties": {
        "family": { "$ref": "#/$defs/choiceQuestion" },
        "stakes": { "$ref": "#/$defs/scoreQuestion" },
        "urgency": { "$ref": "#/$defs/scoreQuestion" }
      }
    },
    "shapeFilter": {
      "type": "object",
      "description": "Deterministic payload pre-filter evaluated before a question enters the batch.",
      "additionalProperties": false,
      "properties": {
        "pointers": { "$ref": "#/$defs/stringList" },
        "arrayLength": { "$ref": "#/$defs/range" },
        "elementTypes": { "$ref": "#/$defs/stringList" },
        "elementKeys": { "$ref": "#/$defs/stringList" },
        "mutable": { "type": "boolean" },
        "proseLength": {
          "type": "array",
          "items": { "enum": ["line", "blurb", "summary", "article"] }
        },
        "count": { "$ref": "#/$defs/range" },
        "actions_allowed": { "type": "boolean" }
      }
    },
    "archetype": {
      "type": "object",
      "required": ["id", "family", "criteria", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "family": { "$ref": "#/$defs/identifier" },
        "criteria": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/blockMark" }
        },
        "shape": { "$ref": "#/$defs/shapeFilter" },
        "atLeast": { "type": "integer", "minimum": 1 },
        "frame": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "appliesWhen": {
      "type": "object",
      "description": "Slot name to semantic type(s) or the word `bound`; the question is asked only when it holds.",
      "additionalProperties": {
        "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/stringList" }]
      }
    },
    "derivedWhen": {
      "type": "object",
      "description": "Deterministic answers keyed by hint source; the question is skipped when one matches.",
      "additionalProperties": { "type": "object" }
    },
    "requires": {
      "type": "object",
      "description": "Option id to the slots, knob options, pattern variants, or capability flags it needs.",
      "additionalProperties": { "$ref": "#/$defs/stringList" }
    },
    "questionBase": {
      "type": "object",
      "required": ["kind", "question"],
      "properties": {
        "kind": { "enum": ["choice", "boolean", "score"] },
        "question": { "type": "string", "minLength": 1 },
        "appliesWhen": { "$ref": "#/$defs/appliesWhen" },
        "derivedWhen": { "$ref": "#/$defs/derivedWhen" },
        "note": { "type": "string" }
      }
    },
    "choiceQuestion": {
      "allOf": [{ "$ref": "#/$defs/questionBase" }],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "choice" },
        "question": true,
        "appliesWhen": true,
        "derivedWhen": true,
        "note": true,
        "options": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        },
        "optionsFrom": { "type": "string", "minLength": 1 },
        "requires": { "$ref": "#/$defs/requires" },
        "allowNone": { "type": "boolean" }
      },
      "oneOf": [{ "required": ["options"] }, { "required": ["optionsFrom"] }]
    },
    "booleanQuestion": {
      "allOf": [{ "$ref": "#/$defs/questionBase" }],
      "type": "object",
      "required": ["yes", "no"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "boolean" },
        "question": true,
        "appliesWhen": true,
        "derivedWhen": true,
        "note": true,
        "yes": { "type": "string", "minLength": 1 },
        "no": { "type": "string", "minLength": 1 }
      }
    },
    "scoreQuestion": {
      "allOf": [{ "$ref": "#/$defs/questionBase" }],
      "type": "object",
      "required": ["levels"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "score" },
        "question": true,
        "appliesWhen": true,
        "derivedWhen": true,
        "note": true,
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "perPointer": { "type": "boolean" },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 1 },
            "aboveLevel": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "question": {
      "oneOf": [
        { "$ref": "#/$defs/choiceQuestion" },
        { "$ref": "#/$defs/booleanQuestion" },
        { "$ref": "#/$defs/scoreQuestion" }
      ]
    },
    "slot": {
      "type": "object",
      "required": ["from"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required": { "type": "boolean" },
        "repeat": { "type": "boolean" },
        "max": { "type": "integer", "minimum": 1 },
        "prefer": { "$ref": "#/$defs/stringList" },
        "avoidKeys": { "$ref": "#/$defs/stringList" },
        "sibling": { "$ref": "#/$defs/stringList" },
        "orderBy": { "type": "string", "minLength": 1 },
        "mutable": { "type": "boolean" },
        "elementTypes": { "$ref": "#/$defs/stringList" },
        "default": true,
        "note": { "type": "string" },
        "fields": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/slot" }
        }
      }
    },
    "measure": {
      "type": "object",
      "required": ["derivedFrom", "levels"],
      "additionalProperties": false,
      "properties": {
        "derivedFrom": { "type": "string", "minLength": 1 },
        "levels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/range" }
        },
        "note": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "pattern", "fallback"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "pattern": { "$ref": "#/$defs/identifier" },
        "shape": { "$ref": "#/$defs/shapeFilter" },
        "gate": { "$ref": "#/$defs/booleanQuestion" },
        "salience": { "$ref": "#/$defs/scoreQuestion" },
        "anatomy": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/question" }
        },
        "instance": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/question" }
        },
        "measures": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/measure" }
        },
        "slots": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/slot" }
        },
        "fallback": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z_-]+(:[a-z_]+)?$" }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "rule"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "rule": { "type": "string", "minLength": 1 }
      }
    }
  }
}
