{
  "name": "@a2ui/catalog-mcp",
  "version": "0.0.1-alpha.1",
  "description": "(experimental) A2UI MCP catalog: calls MCP tools and applies the A2UI messages found in their results and UI resources.",
  "homepage": "https://a2ui.org/",
  "repository": {
    "directory": "typescript/catalogs/mcp",
    "type": "git",
    "url": "git+https://github.com/a2ui-project/a2ui.git"
  },
  "bugs": {
    "url": "https://github.com/a2ui-project/a2ui/issues"
  },
  "keywords": [
    "a2ui",
    "mcp",
    "ai",
    "agent",
    "ui",
    "catalog"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog.json": "./dist/catalog.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"if(!process.cwd().endsWith('dist')) { console.error('Error: This package must be published from the dist/ directory. Run `yarn build` then `cd dist && yarn npm publish`'); process.exit(1); }\"",
    "publish:package": "yarn build && node ../../scripts/prepare-publish.mjs && cd dist && touch yarn.lock && yarn install && yarn npm publish --access public",
    "copy-catalog": "node scripts/copy-catalog.js",
    "build": "yarn copy-catalog && tsc -b --pretty",
    "clean": "rm -rf dist src/catalog.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "yarn copy-catalog && node --import tsx --test 'src/**/*.test.ts'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@a2ui/web_core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "5.9.3"
  }
}
