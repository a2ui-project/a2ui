{
  "name": "@a2ui/embed",
  "version": "0.0.1",
  "description": "Embed A2UI in MCP Apps: renders A2UI v1.0 surfaces from MCP tool results in any MCP Apps host.",
  "homepage": "https://a2ui.org/",
  "repository": {
    "directory": "typescript/embed",
    "type": "git",
    "url": "git+https://github.com/a2ui-project/a2ui.git"
  },
  "bugs": {
    "url": "https://github.com/a2ui-project/a2ui/issues"
  },
  "keywords": [
    "a2ui",
    "mcp",
    "mcp-apps",
    "ai",
    "agent",
    "ui"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./build": {
      "types": "./dist/builder/index.d.ts",
      "default": "./dist/builder/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./mcp/server": {
      "types": "./dist/mcp/server/index.d.ts",
      "default": "./dist/mcp/server/index.js"
    }
  },
  "bin": {
    "a2ui-embed": "./dist/builder/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"if(!process.cwd().endsWith('dist')) { console.error('Error: This package must be published from the dist/ directory. Run `yarn build` then `cd dist && yarn npm publish`'); process.exit(1); }\"",
    "copy-spec": "wireit",
    "build": "wireit",
    "test:types": "wireit",
    "test:node": "wireit",
    "build:test-fixtures": "wireit",
    "test:karma": "wireit",
    "test": "wireit",
    "lint": "wireit",
    "lint:fix": "yarn copy-spec && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "wireit",
    "publish:package": "yarn build && node ../scripts/prepare-publish.mjs && cd dist && touch yarn.lock && yarn install && yarn npm publish --access public"
  },
  "wireit": {
    "copy-spec": {
      "command": "mkdir -p src/mcp/server/spec && cp ../../specification/v1_0/json/agent_to_renderer.json ../../specification/v1_0/json/common_types.json src/mcp/server/spec/",
      "files": [
        "../../specification/v1_0/json/agent_to_renderer.json",
        "../../specification/v1_0/json/common_types.json"
      ],
      "output": [
        "src/mcp/server/spec/*.json"
      ]
    },
    "build": {
      "command": "tsc -b --pretty",
      "dependencies": [
        "../core/web_core:build",
        "../renderers/lit:build",
        "copy-spec"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tsconfig.json"
      ],
      "output": [
        "dist/**",
        ".tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "test:types": {
      "command": "tsc -p tsconfig.test.json --pretty",
      "dependencies": [
        "build",
        "copy-spec"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tsconfig.json",
        "tsconfig.test.json",
        "tests/**/*.ts"
      ],
      "output": []
    },
    "test:node": {
      "command": "node --import tsx --test \"src/**/*.test.ts\"",
      "dependencies": [
        "build"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json"
      ],
      "output": []
    },
    "build:test-fixtures": {
      "command": "node scripts/build-test-fixtures.mjs",
      "dependencies": [
        "build"
      ],
      "files": [
        "tests/fixtures/*.ts",
        "scripts/build-test-fixtures.mjs"
      ],
      "output": [
        "tests/fixtures/generated/**"
      ]
    },
    "test:karma": {
      "command": "karma start karma.conf.cjs --single-run=true",
      "dependencies": [
        "build",
        "build:test-fixtures"
      ],
      "files": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "karma.conf.cjs",
        "tsconfig.test.json"
      ],
      "output": []
    },
    "test": {
      "dependencies": [
        "test:types",
        "test:node",
        "test:karma"
      ]
    },
    "lint": {
      "command": "eslint .",
      "dependencies": [
        "../core/web_core:build",
        "../renderers/lit:build",
        "copy-spec"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "*.mjs",
        "tests/**/*.ts",
        "scripts/**",
        "*.cjs",
        "tsconfig.json",
        "tsconfig.test.json",
        "../../eslint.preset.mjs"
      ],
      "output": []
    },
    "clean": {
      "command": "rm -rf dist src/mcp/server/spec .wireit .tsbuildinfo tests/fixtures/generated"
    }
  },
  "author": "Google",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.1",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@a2ui/lit": "workspace:*",
    "@a2ui/web_core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "lit": "^3.3.3"
  },
  "peerDependenciesMeta": {
    "@a2ui/lit": {
      "optional": true
    },
    "lit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2ui/lit": "workspace:*",
    "@a2ui/web_core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "gts": "^7.0.0",
    "jasmine-core": "^6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-esbuild": "^2.3.0",
    "karma-jasmine": "^5.1.0",
    "lit": "^3.3.3",
    "playwright": "1.58.1",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "wireit": "^0.15.0-pre.2"
  }
}
