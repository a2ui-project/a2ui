{
  "$schema": "https://json.schemastore.org/tsconfig",

  /* Type-checks the whole source tree, tests included, and the browser tests and fixtures under
     tests/. Used by `test:types`, by the Karma esbuild preprocessor and by ESLint; the library build
     uses tsconfig.json, which leaves the tests out. The node tests import node:test and the browser
     tests use the Jasmine globals, so both type sets are loaded. */
  "compilerOptions": {
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "target": "es2021",
    "module": "esnext",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "types": ["jasmine", "node"],
    "skipLibCheck": true,
    "useDefineForClassFields": false,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.json", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests/fixtures/generated"]
}
