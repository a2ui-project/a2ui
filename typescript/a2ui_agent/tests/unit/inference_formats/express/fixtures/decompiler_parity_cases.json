[
  {
    "name": "test_decompile_express_components",
    "catalog": "simplified",
    "messages": [
      {
        "version": "v1.0",
        "createSurface": {
          "surfaceId": "s1",
          "catalogId": "conformance/simplified",
          "components": [
            {
              "id": "root",
              "component": "Card",
              "child": "body"
            },
            {
              "id": "body",
              "component": "Text",
              "text": "Hello"
            }
          ]
        }
      }
    ],
    "expectedNotation": "surface(\"s1\")\nroot = Card(body)\nbody = Text(\"Hello\")"
  },
