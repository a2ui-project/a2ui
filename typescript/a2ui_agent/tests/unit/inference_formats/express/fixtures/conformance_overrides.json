{
  "compiler_corpus.json": {
    "test_compile_express_unknown_component_is_a_validation_error": {
      "justification": "test_compile_express_unknown_component_is_a_validation_error",
      "expected": {
        "status": "error",
        "error": "ExpressUnknownComponentError",
        "message": "Component 'Sparkline' is not defined in the catalog."
      }
    },
    "test_compile_express_surface_targeting_names_a_catalog": {
      "justification": "test_compile_express_unknown_component_is_a_validation_error",
      "expected": {
        "status": "error",
        "error": "ExpressUnknownComponentError",
        "message": "Component 'Gauge' is not defined in the catalog."
      }
    },
    "test_compile_express_missing_required_property_is_a_validation_error": {
      "justification": "test_compile_express_missing_required_property_is_a_validation_error",
      "expected": {
        "status": "error",
        "error": "ExpressMissingRequiredPropertyError",
        "message": "Component 'Button' is missing required property 'action'."
      }
    },
    "test_compile_express_unknown_function_is_a_validation_error": {
      "justification": "test_compile_express_unknown_function_is_a_validation_error",
      "expected": {
        "status": "error",
        "error": "ExpressUnknownFunctionError",
        "message": "Function 'titleCase' is not defined in the catalog."
      }
    },
    "test_compile_express_event_action": {
      "justification": "test_compile_express_event_action",
      "expected": {
        "status": "success",
        "messages": [
          {
            "version": "v1.0",
            "createSurface": {
              "surfaceId": "default_surface",
              "catalogId": "conformance/simplified",
              "components": [
                {
                  "id": "root",
                  "component": "Button",
                  "child": "label",
                  "action": {
                    "event": {
                      "name": "submit"
                    }
                  }
                },
                {
                  "id": "label",
                  "component": "Text",
                  "text": "Submit"
                }
              ]
            }
          }
        ]
      }
    },
    "test_compile_express_event_variable_is_inlined_at_each_use": {
      "justification": "test_compile_express_event_variable_is_inlined_at_each_use",
      "expected": {
        "status": "success",
        "messages": [
          {
            "version": "v1.0",
            "createSurface": {
              "surfaceId": "default_surface",
              "catalogId": "conformance/simplified",
              "components": [
                {
                  "id": "root",
                  "component": "Column",
                  "children": ["save", "send"]
                },
                {
                  "id": "save",
                  "component": "Button",
                  "child": "saveLabel",
                  "action": {
                    "event": {
                      "name": "submit"
                    }
                  }
                },
                {
                  "id": "send",
                  "component": "Button",
                  "child": "sendLabel",
                  "action": {
                    "event": {
                      "name": "submit"
                    }
                  }
                },
                {
                  "id": "saveLabel",
                  "component": "Text",
                  "text": "Save"
                },
                {
                  "id": "sendLabel",
                  "component": "Text",
                  "text": "Send"
                }
              ]
            }
          }
        ]
      }
    },
    "test_compile_express_standalone_function_call": {
      "justification": "test_compile_express_standalone_function_call",
      "expected": {
        "status": "success",
        "messages": [
          {
            "version": "v1.0",
            "callRendererFunction": {
              "functionCallId": "call_1",
              "callFunction": {
                "call": "openUrl",
                "args": {
                  "url": "https://example.com"
                },
                "catalogId": "conformance/simplified"
              }
            }
          }
        ]
      }
    },
