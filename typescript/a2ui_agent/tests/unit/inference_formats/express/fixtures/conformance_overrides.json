  "decompiler_parity_cases.json": {
    "test_decompile_express_escapes_a_quote_in_a_string": {
      "justification": "test_decompile_express_escapes_a_quote_in_a_string",
      "expected": "surface(\"s1\")\nroot = Text(\"He said \\\"hello\\\".\")"
    },
    "test_decompile_express_quotes_a_map_key_that_is_not_an_identifier": {
      "justification": "test_decompile_express_quotes_a_map_key_that_is_not_an_identifier",
      "expected": "surface(\"s1\")\nroot = Button(label, Event(\"submit\", {\"item-id\": \"42\"}))\nlabel = Text(\"Submit\")"
    },
    "test_decompile_express_update_data_model": {
      "justification": "test_decompile_express_update_data_model",
      "expected": "surface(\"s1\")\n$/title = \"Hello\""
    },
    "test_decompile_express_nested_data_model_is_one_assignment_per_leaf": {
      "justification": "test_decompile_express_nested_data_model_is_one_assignment_per_leaf",
      "expected": "surface(\"s1\")\n$/user/city = \"London\"\n$/user/name = \"Ada\""
    },
    "branch_v0_9_update_data_model_basic": {
      "justification": "test_decompile_express_update_data_model",
      "expected": "surface(\"surf_09\")\n$/profile/active = true\n$/profile/name = \"Bob\""
    },
    "branch_batch_multiple_messages": {
      "justification": "test_decompile_express_update_data_model",
      "expected": "surface(\"s1\")\nroot = Text(\"First\")\nsurface(\"s1\")\n$/status = \"loaded\""
    },
    "test_decompile_update_data_model_non_object_values": {
      "justification": "no conformance case: updateDataModel honors path and writes surface for standalone updateDataModel (B3)",
      "expected": "surface(\"default\")\n$/title = \"Found Restaurants\"\nsurface(\"default\")\n$/items = [{name: \"Xi'an Famous Foods\", rating: 4.5}]\nsurface(\"default\")\nsurface(\"default\")"
    }
  }
}
