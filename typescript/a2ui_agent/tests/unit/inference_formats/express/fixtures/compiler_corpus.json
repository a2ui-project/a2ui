          "version": "v1.0",
          "createSurface": {
            "surfaceId": "default_surface",
            "catalogId": "conformance/forms",
            "components": [
              {
                "id": "root",
                "component": "TextField",
                "label": "Zip",
                "value": {
                  "path": "/zip"
                },
                "checks": [
                  {
                    "condition": {
                      "call": "required",
                      "args": {
                        "value": {
                          "path": "/zip"
                        }
                      }
                    },
                    "message": "Zip is required"
                  },
                  {
                    "condition": {
                      "call": "regex",
                      "args": {
                        "value": {
                          "path": "/zip"
                        },
                        "pattern": "^[0-9]{5}$"
                      }
                    },
                    "message": "Must be five digits"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
