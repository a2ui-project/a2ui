  {
    "name": "test_compile_express_validation_expression",
    "catalog": "forms",
    "version": "v1.0",
    "input": "root = TextField(\"Email\", $/email, _, [?required(\"Email is required\")])",
    "expected": {
      "status": "success",
      "messages": [
        {
          "version": "v1.0",
          "createSurface": {
            "surfaceId": "default_surface",
            "catalogId": "conformance/forms",
            "components": [
              {
                "id": "root",
                "component": "TextField",
                "label": "Email",
                "value": {
                  "path": "/email"
                },
                "checks": [
                  {
                    "condition": {
                      "call": "required",
                      "args": {
                        "value": {
                          "path": "/email"
                        }
                      }
                    },
                    "message": "Email is required"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  {
    "name": "test_compile_express_validation_expression_with_an_argument",
