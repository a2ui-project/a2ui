{
  "name": "@a2ui/agent",
  "version": "0.0.1",
  "description": "A2UI Agent SDK for TypeScript and Node.js",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "wireit",
    "build:tsc": "wireit",
    "test": "wireit",
    "test:conformance": "vitest run tests/conformance",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "wireit",
    "format:check": "wireit",
    "clean": "wireit",
    "generate:express": "antlr-ng -Dlanguage=TypeScript --generate-visitor --generate-listener false -o src/inference_formats/express/generated ../../specification/inference_formats/express/Express.g4"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:tsc",
        "../../typescript/web_core:build"
      ]
    },
    "build:tsc": {
      "command": "tsc -b --pretty",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/",
        "!dist/**/*.min.js{,.map}"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "build"
      ]
    },
    "clean": {
      "command": "rm -rf dist .tsbuildinfo .wireit"
    },
    "format": {
      "command": "prettier --write .",
      "files": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.check.json",
        "vitest.config.ts",
        ".prettierignore"
      ]
    },
    "format:check": {
      "command": "prettier --check .",
      "files": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.check.json",
        "vitest.config.ts",
        ".prettierignore"
      ]
    }
  },
  "author": "Google",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "antlr-ng": "1.0.10",
    "eslint": "^10.4.1",
    "js-yaml": "^4.3.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.8",
    "wireit": "^0.15.0-pre.2"
  },
  "dependencies": {
    "@a2ui/web_core": "workspace:*",
    "antlr4ng": "3.0.16"
  }
}
