{
  "name": "@a2ui/markdown-it",
  "version": "0.2.3",
  "description": "A Markdown renderer using markdown-it and dompurify.",
  "repository": {
    "directory": "typescript/renderers/markdown-it",
    "type": "git",
    "url": "git+https://github.com/a2ui-project/a2ui.git"
  },
  "bugs": {
    "url": "https://github.com/a2ui-project/a2ui/issues"
  },
  "keywords": [
    "a2ui",
    "markdown",
    "ai",
    "agent",
    "ui",
    "renderer"
  ],
  "license": "Apache-2.0",
  "author": "Google",
  "type": "module",
  "main": "./dist/src/markdown.js",
  "types": "./dist/src/markdown.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/markdown.d.ts",
      "default": "./dist/src/markdown.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path ../.gitignore --write .",
    "format:check": "prettier --ignore-path ../.gitignore --check .",
    "prepublishOnly": "node ../../scripts/check-publish-dir.mjs",
    "publish:package": "node ../../scripts/publish-package.mjs",
    "test": "wireit",
    "clean": "wireit"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@a2ui/web_core": "workspace:*",
    "@types/dompurify": "^3.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "gts": "^7.0.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "6.0.3",
    "wireit": "^0.15.0-pre.2"
  },
  "peerDependencies": {
    "@a2ui/web_core": "workspace:*"
  },
  "wireit": {
    "build": {
      "command": "tsc -b --pretty",
      "dependencies": [
        "../../core/web_core:build"
      ],
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "tsconfig.json"
      ],
      "output": [
        "dist/",
        "!dist/**/*.min.js{,.map}"
      ],
      "clean": "if-file-deleted"
    },
    "test": {
      "command": "node --test --enable-source-maps --test-reporter spec dist/src/*.test.js",
      "dependencies": [
        "build"
      ]
    },
    "clean": {
      "command": "rm -rf dist .tsbuildinfo .wireit"
    }
  }
}
