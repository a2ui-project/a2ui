{
  "templateId": "TeamGoalList",
  "description": "List of team goals with header banner.",
  "parameters": {
    "teamName": {
      "type": "string",
      "title": "Team Name",
      "description": "The display name of the team whose goals are being listed."
    },
    "goals": {
      "type": "array",
      "title": "Goals List",
      "description": "Array of goal objects with title, priority, and targetDate.",
      "items": {
        "type": "object",
        "title": "Goal Definition",
        "properties": {
          "title": {
            "type": "string",
            "title": "Goal Title",
            "description": "Summary title of the objective"
          },
          "priority": {
            "type": "enum",
            "title": "Priority Level",
            "values": ["High", "Medium", "Low"],
            "default": "Medium"
          },
          "targetDate": {
            "type": "string",
            "title": "Target Date",
            "description": "Target completion date (YYYY-MM-DD)"
          }
        },
        "required": ["title"]
      }
    }
  },
  "components": [
    {
      "id": "root",
      "component": "Column",
      "children": ["header_card", "goals_container"]
    },
    {
      "id": "header_card",
      "component": "Card",
      "child": "header_row"
    },
    {
      "id": "header_row",
      "component": "Row",
      "align": "center",
      "children": ["trophy_icon", "header_text"]
    },
    {
      "id": "trophy_icon",
      "component": "Icon",
      "name": "star"
    },
    {
      "id": "header_text",
      "component": "Text",
      "text": {"concat": ["Strategic Objectives: ", {"param": "teamName"}]},
      "variant": "h2"
    },
    {
      "id": "goals_container",
      "component": "Column",
      "children": {
        "param": "goals",
        "template": "GoalItem"
      }
    }
  ],
  "sampleData": {
    "teamName": "A2UI Core Team",
    "goals": [
      {
        "title": "Implement bidirectional child/children container resolution",
        "priority": "High",
        "targetDate": "2026-07-15"
      },
      {
        "title": "Upgrade all templates to standard Basic Catalog components",
        "priority": "High",
        "targetDate": "2026-07-10"
      }
    ]
  }
}
