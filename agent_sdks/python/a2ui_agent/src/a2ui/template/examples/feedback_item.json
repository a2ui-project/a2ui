{
  "templateId": "FeedbackItem",
  "parameters": {
    "author": {
      "type": "string",
      "title": "Feedback Author",
      "description": "The name of the user providing the feedback.",
      "dynamic": true
    },
    "note": {
      "type": "string",
      "title": "Feedback Note",
      "description": "The textual content of the feedback comment.",
      "dynamic": true
    },
    "rating": {
      "type": "number",
      "title": "Feedback Rating",
      "description": "The numerical rating value out of 5. Defaults to 5.",
      "default": 5,
      "dynamic": true
    }
  },
  "components": [
    {
      "id": "root",
      "component": "Card",
      "child": "col"
    },
    {
      "id": "col",
      "component": "Column",
      "children": ["note_text", "divider", "info_row"]
    },
    {
      "id": "note_text",
      "component": "Text",
      "text": "\"${note}\"",
      "variant": "body"
    },
    {
      "id": "divider",
      "component": "Divider",
      "axis": "horizontal"
    },
    {
      "id": "info_row",
      "component": "Row",
      "justify": "spaceBetween",
      "align": "center",
      "children": ["author_text", "rating_text"]
    },
    {
      "id": "author_text",
      "component": "Text",
      "text": "${author}",
      "variant": "caption"
    },
    {
      "id": "rating_text",
      "component": "Text",
      "text": "Rating: ${rating}/5",
      "variant": "caption"
    }
  ],
  "sampleData": {
    "author": "Charlie Brown",
    "note": "Clean architecture and fast synchronous expansion!",
    "rating": 5
  }
}
