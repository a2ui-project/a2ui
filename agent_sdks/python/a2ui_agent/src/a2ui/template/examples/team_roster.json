{
  "templateId": "TeamRoster",
  "parameters": {
    "directoryTitle": {
      "type": "string",
      "title": "Directory Title",
      "description": "Main title text of the roster directory header.",
      "default": "Organization Directory",
      "dynamic": true
    },
    "children": {
      "type": "children",
      "title": "Roster Children",
      "description": "Child components (TeamCard instances or other layout cards) rendered inside this roster.",
      "default": []
    }
  },
  "components": [
    {
      "id": "root",
      "component": "Column",
      "children": ["title_banner", "roster_list"]
    },
    {
      "id": "title_banner",
      "component": "Card",
      "child": "banner_row"
    },
    {
      "id": "banner_row",
      "component": "Row",
      "align": "center",
      "children": ["banner_icon", "banner_text"]
    },
    {
      "id": "banner_icon",
      "component": "Icon",
      "name": "folder"
    },
    {
      "id": "banner_text",
      "component": "Text",
      "text": "${directoryTitle}",
      "variant": "h2"
    },
    {
      "id": "roster_list",
      "component": "Column",
      "children": "${children}"
    }
  ],
  "sampleData": {
    "directoryTitle": "Engineering Teams Directory",
    "children": ["team_card_1", "team_card_2"]
  }
}
