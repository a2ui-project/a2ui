{
  "templateId": "TeamMemberKnowledgePanel",
  "description": "Card showing competency panel with user experience years and completed task count.",
  "parameters": {
    "userName": {
      "type": "string",
      "title": "User Display Name",
      "description": "The full name of the team member."
    },
    "role": {
      "type": "string",
      "title": "Role Name",
      "description": "The operational role of the team member."
    },
    "experienceYears": {
      "type": "integer",
      "title": "Years of Experience",
      "description": "The number of years of professional experience.",
      "minimum": 0
    },
    "completedTasks": {
      "type": "integer",
      "title": "Completed Tasks Count",
      "description": "The count of completed tasks or tickets.",
      "minimum": 0
    }
  },
  "components": [
    {
      "id": "root",
      "component": "Card",
      "child": "panel_col"
    },
    {
      "id": "panel_col",
      "component": "Column",
      "children": ["header_row", "divider", "stats_row", "footer_text"]
    },
    {
      "id": "header_row",
      "component": "Row",
      "align": "center",
      "children": ["badge_icon", "header_text"]
    },
    {
      "id": "badge_icon",
      "component": "Icon",
      "name": "check"
    },
    {
      "id": "header_text",
      "component": "Text",
      "text": {"concat": ["Competency: ", {"param": "userName"}]},
      "variant": "h4"
    },
    {
      "id": "divider",
      "component": "Divider",
      "axis": "horizontal"
    },
    {
      "id": "stats_row",
      "component": "Row",
      "justify": "spaceBetween",
      "children": ["role_col", "exp_col", "tasks_col"]
    },
    {
      "id": "role_col",
      "component": "Column",
      "align": "center",
      "children": ["role_label", "role_val"]
    },
    {
      "id": "role_label",
      "component": "Text",
      "text": "Role",
      "variant": "caption"
    },
    {
      "id": "role_val",
      "component": "Text",
      "text": {"param": "role"},
      "variant": "body"
    },
    {
      "id": "exp_col",
      "component": "Column",
      "align": "center",
      "children": ["exp_label", "exp_val"]
    },
    {
      "id": "exp_label",
      "component": "Text",
      "text": "Experience",
      "variant": "caption"
    },
    {
      "id": "exp_val",
      "component": "Text",
      "text": {"concat": [{"param": "experienceYears"}, " Yrs"]},
      "variant": "body"
    },
    {
      "id": "tasks_col",
      "component": "Column",
      "align": "center",
      "children": ["tasks_label", "tasks_val"]
    },
    {
      "id": "tasks_label",
      "component": "Text",
      "text": "Tasks",
      "variant": "caption"
    },
    {
      "id": "tasks_val",
      "component": "Text",
      "text": {"concat": [{"param": "completedTasks"}, " Done"]},
      "variant": "body"
    },
    {
      "id": "footer_text",
      "component": "Text",
      "text": "Verified Core Contributor",
      "variant": "caption"
    }
  ],
  "sampleData": {
    "userName": "Alice Smith",
    "role": "Systems Architect",
    "experienceYears": 9,
    "completedTasks": 142
  }
}
