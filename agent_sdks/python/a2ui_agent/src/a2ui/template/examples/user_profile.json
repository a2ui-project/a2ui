{
  "templateId": "UserProfile",
  "description": "Single user profile card with user icon, display name, and role.",
  "parameters": {
    "userId": {
      "type": "string",
      "title": "User ID",
      "description": "Unique identifier of the user (e.g. 'usr_101')."
    },
    "userName": {
      "type": "string",
      "title": "User Display Name",
      "description": "The full name of the user."
    },
    "role": {
      "type": "string",
      "title": "Role Name",
      "description": "The job title or role of the user.",
      "default": "Member"
    }
  },
  "components": [
    {
      "id": "root",
      "component": "Card",
      "child": "col"
    },
    {
      "id": "col",
      "component": "Column",
      "align": "center",
      "children": ["avatar_icon", "name_text", "role_text"]
    },
    {
      "id": "avatar_icon",
      "component": "Icon",
      "name": "person"
    },
    {
      "id": "name_text",
      "component": "Text",
      "text": {"param": "userName"},
      "variant": "h3"
    },
    {
      "id": "role_text",
      "component": "Text",
      "text": {"param": "role"},
      "variant": "caption"
    }
  ],
  "sampleData": {
    "userId": "usr_101",
    "userName": "Alice Smith",
    "role": "Lead Architect"
  }
}
