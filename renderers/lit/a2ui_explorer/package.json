{
  "name": "@a2ui/lit-explorer",
  "private": true,
  "version": "0.9.0",
  "description": "A2UI Lit Explorer",
  "type": "module",
  "scripts": {
    "copy-sandbox": "wireit",
    "generate-examples": "node scripts/generate-examples.mjs",
    "generate:examples": "wireit",
    "dev": "yarn copy-sandbox && yarn generate-examples && vite",
    "build": "wireit",
    "test": "wireit",
    "test:vite-compilation": "wireit",
    "test:watch": "yarn generate-examples && karma start karma.conf.cjs --single-run=false --auto-watch=true",
    "test:debug": "yarn generate-examples && karma start karma.conf.cjs --single-run=false --auto-watch=true --browsers Chrome",
    "test:ci": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "wireit",
    "format": "prettier --ignore-path ../../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../../.prettierignore --check ."
  },
  "wireit": {
    "generate:examples": {
      "command": "node scripts/generate-examples.mjs",
      "files": [
        "scripts/generate-examples.mjs",
        "../../../specification/v0_9/catalogs/basic/examples/*.json",
        "../../../catalogs/basic/v1/examples/*.json",
        "../../../catalogs/mcp/v1/examples/*.json"
      ],
      "output": [
        "src/generated/examples-list.ts"
      ]
    },
    "copy-sandbox": {
      "command": "rm -rf public/a2ui-sandbox && mkdir -p public && cp -R ../../../typescript/catalogs/mcp/dist/sandbox public/a2ui-sandbox",
      "dependencies": [
        "../../../typescript/catalogs/mcp:build"
      ],
      "files": [
        "../../../typescript/catalogs/mcp/dist/sandbox/**"
      ],
      "output": [
        "public/a2ui-sandbox/**"
      ]
    },
    "build": {
      "command": "yarn generate-examples && tsc && vite build",
      "dependencies": [
        "generate:examples",
        "../../../typescript/web_core:build",
        "../../../typescript/catalogs/mcp:build",
        "../../markdown/markdown-it:build",
        "../:build",
        "copy-sandbox"
      ]
    },
    "test": {
      "command": "karma start karma.conf.cjs --single-run=true",
      "dependencies": [
        "build",
        "test:vite-compilation"
      ],
      "files": [
        "src/**/*",
        "tests/**/*",
        "karma.conf.cjs",
        "tsconfig.json"
      ]
    },
    "test:vite-compilation": {
      "command": "vitest run --environment jsdom tests/smoke-test.spec.ts",
      "dependencies": [
        "build"
      ]
    },
    "test:ci": {
      "dependencies": [
        "test"
      ]
    },
    "clean": {
      "command": "rm -rf dist .tsbuildinfo .wireit public/a2ui-sandbox"
    }
  },
  "dependencies": {
    "@a2ui/catalog-mcp": "workspace:*",
    "@a2ui/lit": "workspace:*",
    "@a2ui/markdown-it": "workspace:*",
    "@a2ui/web_core": "workspace:*",
    "@lit-labs/signals": "^0.3.0",
    "@lit/context": "^1.1.6",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/jasmine": "^6.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "gts": "^7.0.0",
    "jasmine-core": "^6.3.0",
    "jsdom": "^29.1.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-esbuild": "^2.3.0",
    "karma-jasmine": "^5.1.0",
    "prettier": "^3.8.4",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wireit": "^0.15.0-pre.2"
  }
}
