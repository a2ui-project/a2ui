{
  "schema": "catalog_definition.json",
  "tests": [
    {
      "description": "Valid catalog restricting component to top level",
      "valid": true,
      "data": {
        "catalogId": "https://example.com/catalog.json",
        "components": {
          "AppLayout": {
            "type": "object",
            "allowedParents": ["Surface"],
            "properties": {
              "component": {"const": "AppLayout"}
            }
          }
        }
      }
    },
    {
      "description": "Valid catalog allowing component at top level or in container",
      "valid": true,
      "data": {
        "catalogId": "https://example.com/catalog.json",
        "components": {
          "Card": {
            "type": "object",
            "allowedParents": ["Surface", "CanvasContainer"],
            "properties": {
              "component": {"const": "Card"}
            }
          }
        }
      }
    },
    {
      "description": "Invalid catalog defining reserved Surface component",
      "valid": false,
      "data": {
        "catalogId": "https://example.com/catalog.json",
        "components": {
          "Surface": {
            "type": "object",
            "allowedChildren": ["AppLayout", "FormRoot"]
          }
        }
      }
    },
    {
      "description": "Invalid catalog with non-array allowedParents",
      "valid": false,
      "data": {
        "catalogId": "https://example.com/catalog.json",
        "components": {
          "AppLayout": {
            "type": "object",
            "allowedParents": "Surface",
            "properties": {
              "component": {"const": "AppLayout"}
            }
          }
        }
      }
    },
    {
      "description": "Invalid catalog with non-array allowedChildren",
      "valid": false,
      "data": {
        "catalogId": "https://example.com/catalog.json",
        "components": {
          "Container": {
            "type": "object",
            "allowedChildren": "Text",
            "properties": {
              "component": {"const": "Container"}
            }
          }
        }
      }
    },
    {
      "description": "Invalid catalog with non-string items in allowedParents",
      "valid": false,
      "data": {
        "catalogId": "https://example.com/catalog.json",
        "components": {
          "AppLayout": {
            "type": "object",
            "allowedParents": [123],
            "properties": {
              "component": {"const": "AppLayout"}
            }
          }
        }
      }
    }
  ]
}
