{
  "schema": "agent_to_renderer.json",
  "tests": [
    {
      "description": "Valid @child single, static list, template list, Modal, Tabs, @action, and @functionCall",
      "valid": true,
      "data": {
        "version": "1.0",
        "updateComponents": {
          "surfaceId": "test_surface",
          "components": [
            {
              "id": "root",
              "component": "Card",
              "child": {"@child": "col"}
            },
            {
              "id": "col",
              "component": "Column",
              "children": {"@child": ["list1", "modal1", "tabs1", "btn_action", "btn_fn"]}
            },
            {
              "id": "list1",
              "component": "List",
              "children": {"@child": "row_tpl", "@path": "/items"}
            },
            {
              "id": "row_tpl",
              "component": "Text",
              "text": {"@path": "label"}
            },
            {
              "id": "modal1",
              "component": "Modal",
              "trigger": {"@child": "btn_action"},
              "content": {"@child": "modal_body"}
            },
            {
              "id": "modal_body",
              "component": "Text",
              "text": "Modal body"
            },
            {
              "id": "tabs1",
              "component": "Tabs",
              "tabs": [
                {
                  "title": "Tab 1",
                  "child": {"@child": "tab_body"}
                }
              ]
            },
            {
              "id": "tab_body",
              "component": "Text",
              "text": "Tab body"
            },
            {
              "id": "btn_action",
              "component": "Button",
              "child": {"@child": "btn_action_label"},
              "action": {
                "@action": {
                  "name": "submit",
                  "userMessage": {"@path": "/msg"},
                  "context": {
                    "id": "123",
                    "value": {"@path": "/val"},
                    "escaped": {"@@child": "lit"}
                  }
                }
              }
            },
            {
              "id": "btn_action_label",
              "component": "Text",
              "text": "Submit"
            },
            {
              "id": "btn_fn",
              "component": "Button",
              "child": {"@child": "btn_fn_label"},
              "action": {
                "@functionCall": {
                  "@call": "openUrl",
                  "args": {"url": "https://example.com"}
                }
              }
            },
            {
              "id": "btn_fn_label",
              "component": "Text",
              "text": "Open"
            }
          ]
        }
      }
