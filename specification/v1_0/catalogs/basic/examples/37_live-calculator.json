{
  "name": "Live Calculator",
  "description": "Example of client-side reactive computation: sliders write to the data model and bound function calls recompute locally, with no agent roundtrip.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "gallery-live-calculator",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "gallery-live-calculator",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "main_column"
          },
          {
            "id": "main_column",
            "component": "Column",
            "children": [
              "title",
              "subtitle",
              "subtotal_slider",
              "subtotal_text",
              "tip_slider",
              "tip_percent_text",
              "people_slider",
              "people_text",
              "divider",
              "tip_amount_row",
              "per_person_row",
              "total_row"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "## Bill Splitter"
          },
          {
            "id": "subtitle",
            "component": "Text",
            "text": "Drag any slider. Every amount below is recomputed on the client.",
            "variant": "caption"
          },
          {
            "id": "subtotal_slider",
            "component": "Slider",
            "label": "Subtotal",
            "value": {"path": "/order/subtotal"},
            "min": 0,
            "max": 200
          },
          {
            "id": "subtotal_text",
            "component": "Text",
            "text": {
              "call": "formatCurrency",
              "args": {
                "value": {"path": "/order/subtotal"},
                "currency": "USD"
              }
            },
            "variant": "body"
          },
          {
            "id": "tip_slider",
            "component": "Slider",
            "label": "Tip percentage",
            "value": {"path": "/order/tipPercent"},
            "min": 0,
            "max": 40
          },
          {
            "id": "tip_percent_text",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": {"value": "${/order/tipPercent}% tip"}
            },
            "variant": "body"
          },
          {
            "id": "people_slider",
            "component": "Slider",
            "label": "Splitting between",
            "value": {"path": "/order/people"},
            "min": 0,
            "max": 8
          },
          {
            "id": "people_text",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": {
                "value": "Splitting the tip ${clamp(value: ${/order/people}, min: 1, max: 8)} ways"
              }
            },
            "variant": "body"
          },
          {
            "id": "divider",
            "component": "Divider"
          },
          {
            "id": "tip_amount_row",
            "component": "Row",
            "children": ["tip_amount_label", "tip_amount_value"],
            "justify": "spaceBetween"
          },
          {
            "id": "tip_amount_label",
            "component": "Text",
            "text": "Tip",
            "variant": "body"
          },
          {
            "id": "tip_amount_value",
            "component": "Text",
            "text": {
              "call": "formatCurrency",
              "args": {
                "value": {
                  "call": "round",
                  "args": {
                    "value": {
                      "call": "multiply",
                      "args": {
                        "a": {"path": "/order/subtotal"},
                        "b": {
                          "call": "divide",
                          "args": {"a": {"path": "/order/tipPercent"}, "b": 100}
                        }
                      }
                    },
                    "decimals": 2
                  }
                },
                "currency": "USD"
              }
            },
            "variant": "body"
          },
          {
            "id": "per_person_row",
            "component": "Row",
            "children": ["per_person_label", "per_person_value"],
            "justify": "spaceBetween"
          },
          {
            "id": "per_person_label",
            "component": "Text",
            "text": "Tip per person",
            "variant": "body"
          },
          {
            "id": "per_person_value",
            "component": "Text",
            "text": {
              "call": "formatCurrency",
              "args": {
                "value": {
                  "call": "divide",
                  "args": {
                    "a": {
                      "call": "multiply",
                      "args": {
                        "a": {"path": "/order/subtotal"},
                        "b": {
                          "call": "divide",
                          "args": {"a": {"path": "/order/tipPercent"}, "b": 100}
                        }
                      }
                    },
                    "b": {
                      "call": "clamp",
                      "args": {"value": {"path": "/order/people"}, "min": 1, "max": 8}
                    }
                  }
                },
                "currency": "USD"
              }
            },
            "variant": "body"
          },
          {
            "id": "total_row",
            "component": "Row",
            "children": ["total_label", "total_value"],
            "justify": "spaceBetween"
          },
          {
            "id": "total_label",
            "component": "Text",
            "text": "**Total**",
            "variant": "body"
          },
          {
            "id": "total_value",
            "component": "Text",
            "text": {
              "call": "formatCurrency",
              "args": {
                "value": {
                  "call": "add",
                  "args": {
                    "a": {"path": "/order/subtotal"},
                    "b": {
                      "call": "multiply",
                      "args": {
                        "a": {"path": "/order/subtotal"},
                        "b": {
                          "call": "divide",
                          "args": {"a": {"path": "/order/tipPercent"}, "b": 100}
                        }
                      }
                    }
                  }
                },
                "currency": "USD"
              }
            },
            "variant": "body"
          }
        ]
      }
    },
    {
      "version": "v1.0",
      "updateDataModel": {
        "surfaceId": "gallery-live-calculator",
        "value": {
          "order": {
            "subtotal": 40,
            "tipPercent": 20,
            "people": 2
          }
        }
      }
    }
  ]
}
