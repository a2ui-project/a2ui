$/cookTime = "20 min cook"
$/image = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=300&h=180&fit=crop"
$/ingredients = [{text: "1 cup quinoa"}, {text: "2 cups water"}, {text: "1 cucumber, diced"}, {text: "1 cup cherry tomatoes, halved"}]
$/instructions = [{text: "1. Rinse quinoa and bring to a boil in water."}, {text: "2. Reduce heat and simmer for 15 minutes."}, {text: "3. Fluff with a fork and let cool."}, {text: "4. Mix with diced vegetables."}]
$/prepTime = "15 min prep"
$/rating = "4.9"
$/reviewCount = 1247
$/servings = "Serves 4"
$/title = "Mediterranean Quinoa Bowl"
root = Card(tabs-container)
tabs-container = Tabs([{title: "Overview", child: overview-col}, {title: "Ingredients", child: ingredients-list}, {title: "Instructions", child: instructions-list}])
overview-col = Column([recipe-image, overview-content])
recipe-image = Image($/image, _, "cover")
overview-content = Column([title, rating-row, times-row, servings])
title = Text($/title)
rating-row = Row([star-icon, rating, review-count], _, "center")
star-icon = Icon("star")
rating = Text($/rating, "body")
review-count = Text(formatString("(${formatNumber(value: ${/reviewCount})} ${pluralize(value: ${/reviewCount}, one: 'review', other: 'reviews')})"), "caption")
times-row = Row([prep-time, cook-time])
prep-time = Row([prep-icon, prep-text], _, "center")
prep-icon = Icon("calendarToday")
prep-text = Text($/prepTime, "caption")
cook-time = Row([cook-icon, cook-text], _, "center")
cook-icon = Icon("warning")
cook-text = Text($/cookTime, "caption")
servings = Text($/servings, "caption")
ingredients-list = Column(_template($/ingredients, item-template))
instructions-list = Column(_template($/instructions, item-template))
item-template = Text($text, "body")
