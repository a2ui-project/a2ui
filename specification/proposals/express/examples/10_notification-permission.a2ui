$/description = "Get alerts for order status changes"
$/icon = "check"
$/title = "Enable notification"
root = Card(main_column)
main_column = Column([icon, title, description, actions], "center")
icon = Icon($/icon)
title = Text($/title)
description = Text($/description, "body")
actions = Row([yes_btn, no_btn], justify="center")
yes_btn_text = Text("Yes")
yes_btn = Button(Event("accept"), yes_btn_text)
no_btn_text = Text("No")
no_btn = Button(Event("decline"), no_btn_text)
