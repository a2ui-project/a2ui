$/days = "14"
$/eventName = "Product Launch"
$/hours = "08"
$/minutes = "32"
$/targetDate = "2025-01-15"
root = Card(main-column)
main-column = Column([event-name, countdown-row, target-date], _, "center")
event-name = Text($/eventName)
countdown-row = Row([days-col, hours-col, minutes-col], "spaceAround")
days-col = Column([days-value, days-label], _, "center")
days-value = Text($/days)
days-label = Text("Days", "caption")
hours-col = Column([hours-value, hours-label], _, "center")
hours-value = Text($/hours)
hours-label = Text("Hours", "caption")
minutes-col = Column([minutes-value, minutes-label], _, "center")
minutes-value = Text($/minutes)
minutes-label = Text("Minutes", "caption")
target-date = Text(formatDate($/targetDate, "MMMM d, yyyy"), "body")
