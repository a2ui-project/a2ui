$/billingPeriod = ["annual"]
$/productName = "Design Suite Pro"
$/seats = "10 seats"
$/total = 1188.0
root = Card(main-column)
main-column = Column([title, product-name, divider1, options, divider2, total-row, actions])
title = Text("### Purchase License")
product-name = Text($/productName)
divider1 = Divider()
options = Column([seats-row, period-row])
seats-row = Row([seats-label, seats-value], "spaceBetween", "center")
seats-label = Text("Number of seats", "body")
seats-value = Text($/seats)
period-row = Row([period-label, period-picker], "spaceBetween", "center")
period-label = Text("Billing period", "body")
period-picker = ChoicePicker(_, "mutuallyExclusive", [{label: "Annual", value: "annual"}, {label: "Monthly", value: "monthly"}], $/billingPeriod, "chips")
divider2 = Divider()
total-row = Row([total-label, total-value], "spaceBetween", "center")
total-label = Text("#### Total")
total-value = Text(formatString("${formatCurrency(value: ${/total}, currency: 'USD')}/year"))
actions = Row([confirm-btn, cancel-btn])
confirm-btn-text = Text("Confirm Purchase")
confirm-btn = Button(confirm-btn-text, _, Event("confirm"))
cancel-btn-text = Text("Cancel")
cancel-btn = Button(cancel-btn-text, _, Event("cancel"))
