$/number = "#23"
$/playerImage = "https://images.unsplash.com/photo-1546519638-68e109498ffc?w=200&h=200&fit=crop"
$/playerName = "Marcus Johnson"
$/stat1/label = "PPG"
$/stat1/value = "28.4"
$/stat2/label = "RPG"
$/stat2/value = "7.2"
$/stat3/label = "APG"
$/stat3/value = "6.8"
$/team = "LA Lakers"
root = Card(main-column)
main-column = Column([player-image, player-info, divider, stats-row], _, "center")
player-image = Image($/playerImage, _, "cover")
player-info = Column([player-name, player-details], _, "center")
player-name = Text($/playerName)
player-details = Row([player-number, player-team], _, "center")
player-number = Text($/number)
player-team = Text($/team, "caption")
divider = Divider()
stats-row = Row([stat1, stat2, stat3], "spaceAround")
stat1 = Column([stat1-value, stat1-label], _, "center")
stat1-value = Text($/stat1/value)
stat1-label = Text($/stat1/label, "caption")
stat2 = Column([stat2-value, stat2-label], _, "center")
stat2-value = Text($/stat2/value)
stat2-label = Text($/stat2/label, "caption")
stat3 = Column([stat3-value, stat3-label], _, "center")
stat3-value = Text($/stat3/value)
stat3-label = Text($/stat3/label, "caption")
