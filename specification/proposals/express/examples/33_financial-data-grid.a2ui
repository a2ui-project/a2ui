$/assets = [{name: "Bitcoin", symbol: "BTC", price: 43500.25, change: 1.2, marketCap: 850000000000}, {name: "Ethereum", symbol: "ETH", price: 2250.5, change: -0.5, marketCap: 270000000000}, {name: "Solana", symbol: "SOL", price: 95.8, change: 5.4, marketCap: 40000000000}]
root = Card(main-column)
main-column = Column([header-row, grid-list], _, "stretch")
header-row = Row([col-asset, col-price, col-change, col-market-cap], _, "center")
col-asset = Text("Asset", "caption", 2)
col-price = Text("Price", "caption", 1)
col-change = Text("24h Change", "caption", 1)
col-market-cap = Text("Market Cap", "caption", 1.5)
grid-list = List(_template($/assets, row-template))
row-template = Row([asset-info, asset-price, asset-change, asset-market-cap], _, "center")
asset-info = Row([asset-icon, asset-name-col], _, "center", 2)
asset-icon = Icon("payment")
asset-name-col = Column([asset-name, asset-symbol])
asset-name = Text($name, "body")
asset-symbol = Text($symbol, "caption")
asset-price = Text(formatCurrency($price, "USD"), _, 1)
asset-change = Text(formatString("${change}%"), _, 1)
asset-market-cap = Text(formatCurrency($marketCap, "USD"), _, 1.5)
