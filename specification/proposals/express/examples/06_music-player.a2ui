$/album = "After Hours"
$/albumArt = "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=300&h=300&fit=crop"
$/artist = "The Weeknd"
$/currentTime = "1:48"
$/playIcon = "pause"
$/progress = 0.45
$/title = "Blinding Lights"
$/totalTime = "4:22"
root = Card(main_column)
main_column = Column([album_art, track_info, progress, time_row, controls], "center")
album_art = Image($/albumArt, _, "cover")
track_info = Column([song_title, artist], "center")
song_title = Text($/title)
artist = Text($/artist, "caption")
progress = Slider(1.0, $/progress, _, 0.0)
time_row = Row([current_time, total_time], justify="spaceBetween")
current_time = Text($/currentTime, "caption")
total_time = Text($/totalTime, "caption")
controls = Row([prev_btn, play_btn, next_btn], justify="center")
prev_btn_icon = Icon("skipPrevious")
prev_btn = Button(Event("previous"), prev_btn_icon)
play_btn_icon = Icon($/playIcon)
play_btn = Button(Event("playPause"), play_btn_icon)
next_btn_icon = Icon("skipNext")
next_btn = Button(Event("next"), next_btn_icon)
