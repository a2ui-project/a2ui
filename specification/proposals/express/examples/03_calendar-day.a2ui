$/date = "2025-12-28"
$/events = [{title: "Lunch", time: "12:00 - 12:45 PM"}, {title: "Q1 roadmap review", time: "1:00 - 2:00 PM"}, {title: "Team standup", time: "3:30 - 4:00 PM"}]
root = Card(main-column)
main-column = Column([header-row, divider, actions])
header-row = Row([date-col, events-col])
date-col = Column([day-name, day-number], _, "start")
day-name = Text(formatDate($/date, "EEEE"), "caption")
day-number = Text(formatDate($/date, "d"))
events-col = Column(_template($/events, event-template))
event-template = Column([event-title, event-time])
event-title = Text($title, "body")
event-time = Text($time, "caption")
divider = Divider()
actions = Row([add-btn, discard-btn])
add-btn-text = Text("Add to calendar")
add-btn = Button(add-btn-text, _, Event("add"))
discard-btn-text = Text("Discard")
discard-btn = Button(discard-btn-text, _, Event("discard"))
