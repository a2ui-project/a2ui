$/email = ""
$/password = ""
root = Card(main_column)
main_column = Column([header, email_field, password_field, login_btn, divider, signup_text])
header = Column([title, subtitle], "center")
title = Text("## Welcome back")
subtitle = Text("Sign in to your account", "caption")
email_field = TextField("Email", _, $/email, [?required("Email is required"), ?email("Please enter a valid email address")])
password_field = TextField("Password", _, $/password, "obscured", [?required("Password is required"), ?length(_, 8, "Password must be at least 8 characters long")])
login_btn_text = Text("Sign in")
login_btn = Button(Event("login", {email: $/email}), login_btn_text, ?and([email($/email), length($/password, _, 8)], "Please fix errors before signing in"))
divider = Divider()
signup_text = Row([no_account, signup_link], justify="center")
no_account = Text("Don't have an account?", "caption")
signup_link_text = Text("Sign up")
signup_link = Button(Event("signup"), signup_link_text)
