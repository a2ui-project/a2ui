$/arrivalTime = "2025-12-15T14:30:00Z"
$/date = "2025-12-15"
$/departureTime = "2025-12-15T10:15:00Z"
$/destination = "New York"
$/flightNumber = "OS 87"
$/origin = "Vienna"
$/status = "On Time"
root = Card(main-column)
main-column = Column([header-row, route-row, divider, times-row], _, "stretch")
header-row = Row([header-left, date], "spaceBetween", "center")
header-left = Row([flight-indicator, flight-number], _, "center")
flight-indicator = Icon("send")
flight-number = Text($/flightNumber)
date = Text(formatDate($/date, "E, MMM d"), "caption")
route-row = Row([origin, arrow, destination], _, "center")
origin = Text(formatString("## ${/origin}"))
arrow = Text("## →")
destination = Text(formatString("## ${/destination}"))
divider = Divider()
times-row = Row([departure-col, status-col, arrival-col], "spaceBetween")
departure-col = Column([departure-label, departure-time], _, "start")
departure-label = Text("Departs", "caption")
departure-time = Text(formatDate($/departureTime, "h:mm a"))
status-col = Column([status-label, status-value], _, "center")
status-label = Text("Status", "caption")
status-value = Text($/status, "body")
arrival-col = Column([arrival-label, arrival-time], _, "end")
arrival-label = Text("Arrives", "caption")
arrival-time = Text(formatDate($/arrivalTime, "h:mm a"))
