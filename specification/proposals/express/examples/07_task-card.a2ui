$/completed = false
$/description = "Review and approve the authentication module changes."
$/dueDate = "2025-12-15T17:00:00Z"
$/priorityIcon = "priority_high"
$/project = "Backend"
$/title = "Review pull request"
root = Card(main-row)
main-row = Row([status-checkbox, content, priority], _, "start")
status-checkbox = CheckBox("", $/completed)
content = Column([title, description, meta-row])
title = Text($/title)
description = Text($/description, "body")
meta-row = Row([due-date-input, project], _, "center")
due-date-input = DateTimeInput($/dueDate, true, true, _, _, "Due")
project = Text($/project, "caption")
priority = Icon($/priorityIcon)
