$/calories = 385
$/date = "2025-12-15T07:30:00Z"
$/distance = 5.2
$/duration = "32:15"
$/icon = "directions_run"
$/workoutType = "Morning Run"
root = Card(main-column)
main-column = Column([header, divider, metrics-row, date])
header = Row([workout-icon, title], _, "center")
workout-icon = Icon($/icon)
title = Text("### Workout Complete")
divider = Divider()
metrics-row = Row([duration-col, calories-col, distance-col], "spaceAround")
duration-col = Column([duration-value, duration-label], _, "center")
duration-value = Text($/duration)
duration-label = Text("Duration", "caption")
calories-col = Column([calories-value, calories-label], _, "center")
calories-value = Text(formatNumber($/calories))
calories-label = Text("Calories", "caption")
distance-col = Column([distance-value, distance-label], _, "center")
distance-value = Text(formatString("${/distance} km"))
distance-label = Text("Distance", "caption")
date = Text(formatDate($/date, "EEEE, MMM d 'at' h:mm a"), "caption")
