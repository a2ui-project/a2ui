$/calories = 312
$/distance = 3.8
$/goal = 10000
$/progress = 84
$/steps = 8432
root = Card(main-column)
main-column = Column([header, steps-display, goal-text, divider, stats-row], _, "center")
header = Row([steps-icon, title], _, "center")
steps-icon = Icon("person")
title = Text("#### Today's Steps")
steps-display = Text(formatNumber($/steps))
goal-text = Text(formatString("${/progress}% of ${formatNumber(value: ${/goal})} goal"), "body")
divider = Divider()
stats-row = Row([distance-col, calories-col], "spaceAround")
distance-col = Column([distance-value, distance-label], _, "center")
distance-value = Text(formatString("${/distance} mi"))
distance-label = Text("Distance", "caption")
calories-col = Column([calories-value, calories-label], _, "center")
calories-value = Text(formatNumber($/calories))
calories-label = Text("Calories", "caption")
