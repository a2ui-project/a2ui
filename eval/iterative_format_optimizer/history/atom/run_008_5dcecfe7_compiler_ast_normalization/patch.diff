": \"body\"\n        },\n        {\n          \"id\": \"node_0\",\n          \"component\": \"Card\",\n          \"child\": \"node_1\"\n        },\n        {\n          \"id\": \"node_1\",\n          \"component\": \"Column\",\n          \"align\": \"stretch\",\n          \"children\": [\n            \"node_2\",\n            \"node_3\",\n            \"node_4\"\n          ]\n        },\n        {\n          \"id\": \"node_4\",\n          \"component\": \"List\",\n          \"direction\": \"horizontal\",\n          \"align\": \"center\",\n          \"children\": {\n            \"componentId\": \"node_5\",\n            \"path\": \"/breeds\"\n          }\n        },\n        {\n          \"id\": \"node_5\",\n          \"component\": \"Column\",\n          \"align\": \"center\",\n          \"children\": [\n            \"node_6\",\n            \"node_7\"\n          ]\n        },\n        {\n          \"id\": \"node_7\",\n          \"component\": \"Text\",\n          \"text\": {\n            \"path\": \"/breed/name\"\n          },\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"node_6\",\n          \"component\": \"Image\",\n          \"url\": {\n            \"path\": \"/breed/url\"\n          },\n          \"description\": {\n            \"path\": \"/breed/name\"\n          },\n          \"variant\": \"avatar\"\n        },\n        {\n          \"id\": \"node_3\",\n          \"component\": \"Image\",\n          \"url\": \"https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&q=80&w=600\",\n          \"description\": \"Dog Breeds Header\",\n          \"variant\": \"header\"\n        },\n        {\n          \"id\": \"node_2\",\n          \"component\": \"Text\",\n          \"text\": \"**Famous Dog Breeds**\",\n          \"variant\": \"body\"\n        }\n      ],\n      \"dataModel\": {\n        \"breeds\": [\n          {\n            \"name\": \"Golden Retriever\",\n            \"url\": \"https://images.unsplash.com/