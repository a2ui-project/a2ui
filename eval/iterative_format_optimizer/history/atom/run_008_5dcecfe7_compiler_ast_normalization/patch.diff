 },\n          \"placeholder\": \"Enter username\",\n          \"variant\": \"shortText\"\n        },\n        {\n          \"id\": \"node_0\",\n          \"component\": \"Text\",\n          \"text\": \"# Login\"\n        }\n      ],\n      \"dataModel\": {\n        \"login\": {\n          \"username\": \"\",\n          \"password\": \"\",\n          \"rememberMe\": false\n        }\n      }\n    }\n  }\n]\n</a2ui-json>",
