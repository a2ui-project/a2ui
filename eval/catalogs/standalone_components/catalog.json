{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/specification/v0_9/catalogs/standalone_components/catalog.json",
  "title": "A2UI Standalone Components Catalog",
  "description": "Evaluation catalog of 10 standalone widget components for assistant chat cards.",
  "catalogId": "https://a2ui.org/specification/v0_9/catalogs/standalone_components/catalog.json",
  "components": {
    "FlightStatusCard": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "FlightStatusCard"
            },
            "flightNumber": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Flight number, e.g. UA 421",
              "positionalIndex": 0
            },
            "airline": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Airline name",
              "positionalIndex": 1
            },
            "origin": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Origin airport code",
              "positionalIndex": 2
            },
            "destination": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Destination airport code",
              "positionalIndex": 3
            },
            "departureTime": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Departure time string"
            },
            "status": {
              "type": "string",
              "enum": ["on_time", "delayed", "cancelled", "boarding"],
              "description": "Flight status"
            },
            "gate": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Departure gate"
            }
          },
          "required": ["component", "flightNumber", "airline", "origin", "destination", "status"]
        }
      ],
      "unevaluatedProperties": false
    },
    "StockTicker": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "StockTicker"
            },
            "symbol": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Stock ticker symbol",
              "positionalIndex": 0
            },
            "companyName": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Company name",
              "positionalIndex": 1
            },
            "price": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Current price",
              "positionalIndex": 2
            },
            "change": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Absolute price change"
            },
            "changePercent": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Percentage price change"
            },
            "currency": {
              "type": "string",
              "description": "Currency code (e.g. USD)"
            }
          },
          "required": ["component", "symbol", "price"]
        }
      ],
      "unevaluatedProperties": false
    },
    "WeatherWidget": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "WeatherWidget"
            },
            "city": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "City name",
              "positionalIndex": 0
            },
            "temperature": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Current temperature",
              "positionalIndex": 1
            },
            "condition": {
              "type": "string",
              "enum": ["sunny", "cloudy", "rainy", "snowy", "windy"],
              "description": "Weather condition"
            },
            "high": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Daily high temperature"
            },
            "low": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Daily low temperature"
            },
            "humidity": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Humidity percentage"
            },
            "unit": {
              "type": "string",
              "enum": ["celsius", "fahrenheit"],
              "default": "fahrenheit"
            }
          },
          "required": ["component", "city", "temperature", "condition"]
        }
      ],
      "unevaluatedProperties": false
    },
    "OrderTrackingTile": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "OrderTrackingTile"
            },
            "orderId": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Order identifier",
              "positionalIndex": 0
            },
            "carrier": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Shipping carrier name",
              "positionalIndex": 1
            },
            "status": {
              "type": "string",
              "enum": ["ordered", "shipped", "in_transit", "out_for_delivery", "delivered"],
              "description": "Current tracking status"
            },
            "estimatedDelivery": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Estimated delivery date or timeframe"
            },
            "trackingNumber": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Shipment tracking number"
            },
            "packageCount": {
              "type": "number",
              "description": "Number of packages"
            }
          },
          "required": ["component", "orderId", "status", "estimatedDelivery"]
        }
      ],
      "unevaluatedProperties": false
    },
    "RestaurantReservation": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "RestaurantReservation"
            },
            "restaurantName": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Name of the restaurant",
              "positionalIndex": 0
            },
            "date": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Reservation date (YYYY-MM-DD)",
              "positionalIndex": 1
            },
            "time": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Reservation time (HH:MM)",
              "positionalIndex": 2
            },
            "partySize": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Number of guests"
            },
            "confirmationCode": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Reservation confirmation code"
            },
            "tableType": {
              "type": "string",
              "enum": ["indoor", "outdoor", "bar", "booth"],
              "default": "indoor"
            }
          },
          "required": ["component", "restaurantName", "date", "time", "partySize"]
        }
      ],
      "unevaluatedProperties": false
    },
    "ProductCard": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "ProductCard"
            },
            "title": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Product title",
              "positionalIndex": 0
            },
            "price": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Product price",
              "positionalIndex": 1
            },
            "brand": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Product brand"
            },
            "rating": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Average review rating (1-5)"
            },
            "imageUrl": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "URL of product image"
            },
            "inStock": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
              "description": "Whether product is in stock"
            }
          },
          "required": ["component", "title", "price"]
        }
      ],
      "unevaluatedProperties": false
    },
    "UserProfileCard": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "UserProfileCard"
            },
            "name": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "User full name",
              "positionalIndex": 0
            },
            "role": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Job title or role",
              "positionalIndex": 1
            },
            "department": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Department or organization"
            },
            "email": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "User email address"
            },
            "avatarUrl": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Avatar image URL"
            },
            "online": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
              "description": "Online status"
            }
          },
          "required": ["component", "name", "role"]
        }
      ],
      "unevaluatedProperties": false
    },
    "AppointmentReminder": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "AppointmentReminder"
            },
            "title": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Appointment title or purpose",
              "positionalIndex": 0
            },
            "providerName": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Name of doctor or provider",
              "positionalIndex": 1
            },
            "dateTime": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Appointment date and time",
              "positionalIndex": 2
            },
            "location": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Office or facility location"
            },
            "notes": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Preparation instructions or notes"
            }
          },
          "required": ["component", "title", "dateTime"]
        }
      ],
      "unevaluatedProperties": false
    },
    "MetricsTile": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "MetricsTile"
            },
            "label": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Metric name",
              "positionalIndex": 0
            },
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Formatted metric value",
              "positionalIndex": 1
            },
            "changePercent": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Percentage change"
            },
            "trend": {
              "type": "string",
              "enum": ["up", "down", "neutral"],
              "description": "Direction of trend"
            },
            "period": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Time period comparison"
            }
          },
          "required": ["component", "label", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "MediaPlaybackTile": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "MediaPlaybackTile"
            },
            "trackTitle": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Track or episode title",
              "positionalIndex": 0
            },
            "artist": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Artist or author name",
              "positionalIndex": 1
            },
            "album": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Album or show name"
            },
            "durationSeconds": {
              "type": "number",
              "description": "Track duration in seconds"
            },
            "coverArtUrl": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Cover art image URL"
            },
            "isPlaying": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
              "description": "Whether currently playing"
            }
          },
          "required": ["component", "trackTitle", "artist"]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "functions": {
    "openUrl": {
      "type": "object",
      "description": "Opens a given URL in the browser.",
      "properties": {
        "call": {
          "const": "openUrl"
        },
        "args": {
          "type": "object",
          "properties": {
            "url": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            }
          },
          "required": ["url"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "CatalogComponentCommon": {
      "type": "object",
      "properties": {
        "weight": {
          "type": "number",
          "description": "The relative weight of this component within a Row or Column."
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "The primary brand color used for highlights (e.g., primary buttons, active borders). Format: Hexadecimal code (e.g., '#00BFFF').",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "iconUrl": {
          "type": "string",
          "format": "uri",
          "description": "A URL for an image that identifies the agent or tool associated with the surface."
        },
        "agentDisplayName": {
          "type": "string",
          "description": "Text to be displayed next to the surface to identify the agent or tool that created it."
        }
      },
      "additionalProperties": true
    },
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/FlightStatusCard"
        },
        {
          "$ref": "#/components/StockTicker"
        },
        {
          "$ref": "#/components/WeatherWidget"
        },
        {
          "$ref": "#/components/OrderTrackingTile"
        },
        {
          "$ref": "#/components/RestaurantReservation"
        },
        {
          "$ref": "#/components/ProductCard"
        },
        {
          "$ref": "#/components/UserProfileCard"
        },
        {
          "$ref": "#/components/AppointmentReminder"
        },
        {
          "$ref": "#/components/MetricsTile"
        },
        {
          "$ref": "#/components/MediaPlaybackTile"
        }
      ],
      "discriminator": {
        "propertyName": "component"
      }
    },
    "anyFunction": {
      "oneOf": [
        {
          "$ref": "#/functions/openUrl"
        }
      ]
    }
  }
}
