{
  "name": "@a2ui/cli",
  "version": "0.1.0",
  "description": "A2UI CLI developer tool and typesafe component generator",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "a2ui": "./dist/src/cli.js",
    "a2ui-cli": "./dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "yarn build",
    "build": "wireit",
    "build:tsc": "wireit",
    "test": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "wireit"
  },
  "wireit": {
    "test": {
      "command": "node --test --enable-source-maps dist/tests/**/*.test.js",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "dependencies": [
        "build:tsc"
      ]
    },
    "build:tsc": {
      "command": "tsc -b --pretty && chmod +x dist/src/cli.js",
      "dependencies": [
        "../../renderers/web_core:build"
      ],
      "files": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/"
      ],
      "clean": "if-file-deleted"
    },
    "clean": {
      "command": "rm -rf dist .tsbuildinfo .wireit"
    }
  },
  "dependencies": {
    "@a2ui/web_core": "workspace:*",
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "wireit": "^0.15.0-pre.2"
  }
}
