{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/conformance/conformance_schema.json",
  "title": "A2UI Conformance Test Suite Schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Unique name of the test case."
      },
      "description": {
        "type": "string",
        "description": "Optional description of what the test verifies."
      },
      "catalog": {
        "type": "object",
        "description": "Catalog configuration for the test.",
        "properties": {
          "version": {
            "type": "string",
            "enum": ["0.8", "0.9", "1.0"],
            "description": "Protocol version. Cases that behave differently across versions state it here so a harness can gate on it."
          },
          "s2c_schema": {
            "description": "Path to simplified schema file or inlined schema object. Defaults to null if not passed.",
            "oneOf": [
              {
                "type": "string",
                "description": "Path to simplified schema file."
              },
              {
                "type": "object",
                "description": "Inlined schema object."
              }
            ]
          },
          "catalog_schema": {
            "description": "Path to catalog file or inlined catalog object. Defaults to an empty object if not passed.",
            "oneOf": [
              {
                "type": "string",
                "description": "Path to catalog file."
              },
              {
                "type": "object",
                "description": "Inlined catalog object."
              }
            ]
          },
          "common_types_schema": {
            "description": "Path to common types schema file or inlined common types schema object. Defaults to an empty object if not passed.",
            "oneOf": [
              {
                "type": "string",
                "description": "Path to common types schema file."
              },
              {
                "type": "object",
                "description": "Inlined common types schema object."
              }
            ]
          }
        },
        "required": ["version"]
      },
      "action": {
        "type": "string",
        "description": "The action to perform.",
        "enum": [
          "process_chunk",
          "validate",
          "prune",
          "render",
          "load",
          "remove_strict_validation",
          "parse_full",
          "fix_payload",
          "has_parts",
          "select_catalog",
          "generate_prompt",
          "load_catalog",
          "convert_event",
          "create_a2ui_part",
          "is_a2ui_part",
          "try_activate_extension",
          "handle_rpc",
          "execute_tool",
          "get_extension",
          "try_activate",
          "select_newest",
          "verify_cuttable_keys",
          "accessibility_check",
          "data_model",
          "process_messages",
          "catalog_schema",
          "parse_expression_template",
          "from_format",
          "core_syntax",
          "from_catalog",
          "skill_set",
          "transform_catalog",
          "provide_catalog",
          "resolve_catalogs",
          "generate_prompt_snippet",
          "unwrap",
          "wrap",
          "compile",
          "decompile",
          "parse_response",
          "parse_chunk",
          "create_format",
          "create_processor"
        ]
      }
    },
    "required": ["name", "action"],
    "allOf": [
      {
        "oneOf": [
          {"$ref": "#/$defs/ProcessChunkTest"},
          {"$ref": "#/$defs/ValidateTest"},
          {"$ref": "#/$defs/PruneTest"},
          {"$ref": "#/$defs/RenderTest"},
          {"$ref": "#/$defs/LoadTest"},
          {"$ref": "#/$defs/RemoveStrictValidationTest"},
          {"$ref": "#/$defs/ParseFullTest"},
          {"$ref": "#/$defs/FixPayloadTest"},
          {"$ref": "#/$defs/HasPartsTest"},
          {"$ref": "#/$defs/SelectCatalogTest"},
          {"$ref": "#/$defs/GeneratePromptTest"},
          {"$ref": "#/$defs/LoadCatalogTest"},
          {"$ref": "#/$defs/ConvertEventTest"},
          {"$ref": "#/$defs/CreateA2uiPartTest"},
          {"$ref": "#/$defs/IsA2uiPartTest"},
          {"$ref": "#/$defs/TryActivateExtensionTest"},
          {"$ref": "#/$defs/HandleRpcTest"},
          {"$ref": "#/$defs/ExecuteToolTest"},
          {"$ref": "#/$defs/GetExtensionTest"},
          {"$ref": "#/$defs/TryActivateTest"},
          {"$ref": "#/$defs/SelectNewestTest"},
          {"$ref": "#/$defs/VerifyCuttableKeysTest"},
          {"$ref": "#/$defs/AccessibilityCheckTest"},
          {"$ref": "#/$defs/DataModelTest"},
          {"$ref": "#/$defs/ProcessMessagesTest"},
          {"$ref": "#/$defs/CatalogSchemaTest"},
          {"$ref": "#/$defs/ParseExpressionTemplateTest"},
          {"$ref": "#/$defs/FromFormatTest"},
          {"$ref": "#/$defs/CoreSyntaxTest"},
          {"$ref": "#/$defs/FromCatalogTest"},
          {"$ref": "#/$defs/SkillSetTest"},
          {"$ref": "#/$defs/TransformCatalogTest"},
          {"$ref": "#/$defs/ProvideCatalogTest"},
          {"$ref": "#/$defs/ResolveCatalogsTest"},
          {"$ref": "#/$defs/GeneratePromptSnippetTest"},
          {"$ref": "#/$defs/UnwrapTest"},
          {"$ref": "#/$defs/WrapTest"},
          {"$ref": "#/$defs/CompileTest"},
          {"$ref": "#/$defs/DecompileTest"},
          {"$ref": "#/$defs/ParseResponseTest"},
          {"$ref": "#/$defs/ParseChunkTest"},
          {"$ref": "#/$defs/CreateFormatTest"},
          {"$ref": "#/$defs/CreateProcessorTest"}
        ]
      }
    ]
  },
  "$defs": {
    "ProcessChunkTest": {
      "type": "object",
      "properties": {
        "action": {"const": "process_chunk"},
        "steps": {
          "type": "array",
          "description": "Steps for parser tests.",
          "items": {
            "type": "object",
            "properties": {
              "input": {
                "type": "string",
                "description": "Chunk of data to feed to process_chunk."
              },
              "expect": {
                "type": "array",
                "description": "Expected output parts.",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "a2ui": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              },
              "expect_error": {"$ref": "#/$defs/ExpectError"}
            },
            "required": ["input"],
            "oneOf": [
              {
                "required": ["expect"]
              },
              {
                "required": ["expect_error"]
              }
            ]
          }
        }
      },
      "required": ["steps"]
    },
    "ValidateTest": {
      "type": "object",
      "properties": {
        "action": {"const": "validate"}
      },
      "required": ["action"],
      "oneOf": [
        {
          "properties": {
            "steps": {
              "type": "array",
              "description": "Steps for validator tests.",
              "items": {
                "type": "object",
                "properties": {
                  "payload": {
                    "oneOf": [{"type": "object"}, {"type": "array", "items": {"type": "object"}}],
                    "description": "Payload to validate (single message or list of messages)."
                  },
                  "expect_error": {"$ref": "#/$defs/ExpectError"}
                },
                "required": ["payload"]
              }
            }
          },
          "required": ["steps"]
        },
        {
          "properties": {
            "payload": {
              "oneOf": [{"type": "object"}, {"type": "array", "items": {"type": "object"}}],
              "description": "Payload to validate (single message or list of messages)."
            },
            "expect_error": {"$ref": "#/$defs/ExpectError"}
          },
          "required": ["payload"]
        }
      ]
    },
    "PruneTest": {
      "type": "object",
      "properties": {
        "action": {"const": "prune"},
        "args": {
          "type": "object",
          "properties": {
            "allowed_components": {"type": "array", "items": {"type": "string"}},
            "allowed_messages": {"type": "array", "items": {"type": "string"}}
          }
        },
        "expect": {"type": "object"}
      },
      "required": ["args", "expect"]
    },
    "RenderTest": {
      "type": "object",
      "properties": {
        "action": {"const": "render"},
        "expect_output": {"type": "string"}
      },
      "required": ["expect_output"]
    },
    "LoadTest": {
      "type": "object",
      "properties": {
        "action": {"const": "load"},
        "args": {
          "type": "object",
          "properties": {
            "path": {"type": ["string", "null"]},
            "validate": {"type": "boolean"}
          },
          "required": ["path"]
        },
        "expect_output": {"type": "string"},
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["args"]
    },
    "RemoveStrictValidationTest": {
      "type": "object",
      "properties": {
        "action": {"const": "remove_strict_validation"},
        "args": {
          "type": "object",
          "properties": {
            "schema": {"type": "object"}
          },
          "required": ["schema"]
        },
        "expect": {
          "type": "object",
          "properties": {
            "schema": {"type": "object"}
          },
          "required": ["schema"]
        }
      },
      "required": ["args", "expect"]
    },
    "ParseFullTest": {
      "type": "object",
      "properties": {
        "action": {"const": "parse_full"},
        "input": {"type": "string"},
        "expect": {"type": "array"},
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["input"]
    },
    "FixPayloadTest": {
      "type": "object",
      "properties": {
        "action": {"const": "fix_payload"},
        "input": {"type": "string"},
        "expect": {}
      },
      "required": ["input", "expect"]
    },
    "HasPartsTest": {
      "type": "object",
      "properties": {
        "action": {"const": "has_parts"},
        "input": {"type": "string"},
        "expect": {"type": "boolean"}
      },
      "required": ["input", "expect"]
    },
    "SelectCatalogTest": {
      "type": "object",
      "properties": {
        "action": {"const": "select_catalog"},
        "args": {"type": "object"},
        "expect_selected": {"type": "string"},
        "expect_catalog_schema": {"type": "object"},
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["args"]
    },
    "GeneratePromptTest": {
      "type": "object",
      "properties": {
        "action": {"const": "generate_prompt"},
        "args": {"type": "object"},
        "expect_contains": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["args", "expect_contains"]
    },
    "LoadCatalogTest": {
      "type": "object",
      "properties": {
        "action": {"const": "load_catalog"},
        "catalog_configs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "path": {"type": "string"}
            },
            "required": ["name", "path"]
          }
        },
        "modifiers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "expect": {
          "type": "object",
          "properties": {
            "catalog_schema": {"type": "object"},
            "supported_catalog_ids": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      },
      "required": ["action", "catalog_configs"]
    },
    "ConvertEventTest": {
      "type": "object",
      "properties": {
        "action": {"const": "convert_event"},
        "args": {"type": "object"},
        "expect": {"type": "object"},
        "expect_empty": {"type": "boolean"}
      },
      "required": ["action", "args"]
    },
    "CreateA2uiPartTest": {
      "type": "object",
      "properties": {
        "action": {"const": "create_a2ui_part"},
        "args": {"type": "object"},
        "expect": {"type": "object"}
      },
      "required": ["action", "args", "expect"]
    },
    "IsA2uiPartTest": {
      "type": "object",
      "properties": {
        "action": {"const": "is_a2ui_part"},
        "args": {"type": "object"},
        "expect": {"type": "boolean"}
      },
      "required": ["action", "args", "expect"]
    },
    "TryActivateExtensionTest": {
      "type": "object",
      "properties": {
        "action": {"const": "try_activate_extension"},
        "args": {"type": "object"},
        "expect": {"type": "boolean"}
      },
      "required": ["action", "args", "expect"]
    },
    "HandleRpcTest": {
      "type": "object",
      "properties": {
        "action": {"const": "handle_rpc"},
        "args": {"type": "object"},
        "expect": {"type": "object"}
      },
      "required": ["action", "args", "expect"]
    },
    "ExecuteToolTest": {
      "type": "object",
      "properties": {
        "action": {"const": "execute_tool"},
        "args": {"type": "object"},
        "expect": {"type": "object"}
      },
      "required": ["action", "args", "expect"]
    },
    "GetExtensionTest": {
      "type": "object",
      "properties": {
        "action": {"const": "get_extension"},
        "args": {"type": "object"},
        "expect": {"type": "object"}
      },
      "required": ["action", "args", "expect"]
    },
    "TryActivateTest": {
      "type": "object",
      "properties": {
        "action": {"const": "try_activate"},
        "args": {"type": "object"},
        "expect": {"type": "object"}
      },
      "required": ["action", "args", "expect"]
    },
    "SelectNewestTest": {
      "type": "object",
      "properties": {
        "action": {"const": "select_newest"},
        "args": {"type": "object"},
        "expect": {"type": "object"}
      },
      "required": ["action", "args", "expect"]
    },
    "VerifyCuttableKeysTest": {
      "type": "object",
      "properties": {
        "action": {"const": "verify_cuttable_keys"},
        "expect": {
          "type": "object",
          "properties": {
            "custom_cuttable_keys": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "required": ["custom_cuttable_keys"]
        }
      },
      "required": ["action", "expect"]
    },
    "ParseExpressionTemplateTest": {
      "type": "object",
      "properties": {
        "action": {"const": "parse_expression_template"},
        "input": {
          "type": "string",
          "description": "Template string handed to the client-side expression parser."
        },
        "expect": {
          "type": "array",
          "description": "Expected parsed parts: literal strings, data bindings and function calls, with adjacent literals joined."
        },
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "input"]
    },
    "AccessibilityCheckTest": {
      "type": "object",
      "properties": {
        "action": {"const": "accessibility_check"},
        "surface": {
          "type": "object",
          "description": "Surface component structure being validated."
        },
        "assertions": {
          "type": "object",
          "description": "Assertions for axe-core rules and accessibility node tree checks.",
          "properties": {
            "axe_core": {
              "type": "array",
              "items": {"type": "string"},
              "description": "axe-core rule IDs expected to pass (e.g. 'button-name', 'aria-valid-attr-value')."
            },
            "accessibility_tree": {
              "type": "object",
              "description": "Expected accessibility node property values (e.g. label, description, live, hidden)."
            }
          }
        }
      },
      "required": ["action", "surface", "assertions"]
    },
    "DataModelTest": {
      "type": "object",
      "properties": {
        "action": {"const": "data_model"},
        "initial": {
          "description": "Initial contents of the data model. Defaults to an empty object."
        },
        "watch": {
          "type": "array",
          "description": "Paths observed for the duration of the case. A path may repeat to attach more than one observer.",
          "items": {"type": "string"}
        },
        "steps": {
          "type": "array",
          "description": "Operations applied to the model, in order.",
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "description": "The operation to apply.",
                "enum": ["get", "set", "delete", "dispose"]
              },
              "path": {
                "type": "string",
                "description": "JSON Pointer the operation targets. Required for every op except dispose."
              },
              "value": {"description": "Value to write. Only meaningful for set."},
              "expect": {
                "description": "Value the path is expected to hold. Only meaningful for get."
              },
              "expect_absent": {
                "type": "boolean",
                "description": "Whether the path is expected to hold no value. Only meaningful for get."
              },
              "expect_type": {
                "type": "string",
                "enum": ["list", "object"],
                "description": "Structural type the path is expected to hold. Only meaningful for get."
              },
              "expect_values": {
                "type": "object",
                "description": "Value each watched path holds after this step, keyed by path."
              },
              "expect_notified": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Watched paths whose observers fired for this step, one entry per observer that fired."
              },
              "expect_error": {"$ref": "#/$defs/ExpectError"}
            },
            "required": ["op"]
          }
        }
      },
      "required": ["steps"]
    },
    "CatalogSchemaTest": {
      "type": "object",
      "description": "Rebuilding a catalog document from a parsed catalog. The case names a source document rather than an SDK's own bundled catalog, so every implementation converts the same input and the assertions compare like with like.",
      "properties": {
        "action": {"const": "catalog_schema"},
        "expect": {
          "type": "object",
          "description": "Assertions about the rebuilt document. Each is optional; a case states only what it means to check.",
          "properties": {
            "metadata": {
              "type": "object",
              "description": "Top-level keys the rebuilt document must carry verbatim, such as `$schema`, `$id`, `title` and `catalogId`."
            },
            "absent_metadata": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Top-level keys the rebuilt document must not declare, because the source document did not."
            },
            "components": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Every component name the rebuilt document declares, and no others."
            },
            "functions": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Every function name the rebuilt document declares, and no others."
            },
            "unions_cover_all": {
              "type": "boolean",
              "description": "`$defs/anyComponent` and `$defs/anyFunction` reference exactly the components and functions the document declares, and `anyFunction` is absent when there are none."
            },
            "self_contained": {
              "type": "boolean",
              "description": "Every `#/` reference in the document resolves within it. References that leave the document, such as to `common_types.json`, are the validator's to resolve and are exempt."
            },
            "reparses_identically": {
              "type": "boolean",
              "description": "Parsing the rebuilt document and rebuilding it again yields the same document, so the conversion is a fixed point."
            }
          }
        }
      },
      "required": ["expect"]
    },
    "ProcessMessagesTest": {
      "type": "object",
      "description": "Behaviour of the message processor. Uses the case vocabulary of the v1_0 branch so the two suites of this name converge rather than conflict: camelCase keys, `messages` rather than `payload`, and an exhaustive `components` list per surface.",
      "properties": {
        "action": {"const": "process_messages"},
        "catalogPaths": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Catalog documents the case is written against, relative to the repository root. Harnesses register a native catalog under the id the messages use, because renderers build catalogs from code rather than from a JSON Schema document."
        },
        "messages": {
          "description": "A2UI messages to process, in order: either the bare list or a {messages: [...]} wrapper.",
          "oneOf": [
            {"type": "array", "items": {"type": "object"}},
            {
              "type": "object",
              "properties": {"messages": {"type": "array", "items": {"type": "object"}}},
              "required": ["messages"]
            }
          ]
        },
        "expect": {
          "type": "object",
          "description": "Expected state after the messages have been processed.",
          "properties": {
            "surfaces": {
              "type": "object",
              "description": "Expectations per surface, keyed by surface id.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "exists": {
                    "type": "boolean",
                    "description": "Whether the surface is open. False asserts it is not."
                  },
                  "catalogId": {"type": "string"},
                  "sendDataModel": {"type": "boolean"},
                  "theme": {"type": "object"},
                  "components": {
                    "type": "array",
                    "description": "Every component the surface holds, each entry the component's flattened properties. The list is exhaustive, so an empty one asserts the surface holds none.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {"type": "string"},
                        "component": {"type": "string"}
                      },
                      "required": ["id"]
                    }
                  },
                  "dataModel": {
                    "description": "Expected contents of the surface data model at the root."
                  }
                }
              }
            }
          }
        },
        "expectError": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["messages"]
    },
    "FromFormatTest": {
      "type": "object",
      "properties": {
        "action": {"const": "from_format"},
        "args": {"type": "object"},
        "expected_file": {"type": "string"}
      },
      "required": ["action", "args", "expected_file"]
    },
    "CoreSyntaxTest": {
      "type": "object",
      "properties": {
        "action": {"const": "core_syntax"},
        "args": {"type": "object"},
        "expected_file": {"type": "string"}
      },
      "required": ["action", "args", "expected_file"]
    },
    "FromCatalogTest": {
      "type": "object",
      "properties": {
        "action": {"const": "from_catalog"},
        "args": {"type": "object"},
        "expected_file": {"type": "string"}
      },
      "required": ["action", "args", "expected_file"]
    },
    "SkillSetTest": {
      "type": "object",
      "properties": {
        "action": {"const": "skill_set"},
        "args": {"type": "object"},
        "expected_skills": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["action", "args", "expected_skills"]
    },
    "AgentCatalogRef": {
      "description": "A catalog document, either a path relative to `conformance/` or the document inlined in the case.",
      "oneOf": [
        {
          "type": "string",
          "description": "Path to a catalog document, relative to `conformance/`."
        },
        {"type": "object", "description": "An inlined catalog document."}
      ]
    },
    "CatalogTransformerSpec": {
      "type": "object",
      "description": "One transformer, in the order it is applied. A case states the allowlist directly. Keeping everything is said by leaving the transformer out, so an empty allowlist keeps nothing.",
      "properties": {
        "component_pruning": {
          "type": "array",
          "items": {"type": "string"},
          "description": "The component names a ComponentPruningTransformer keeps."
        },
        "function_pruning": {
          "type": "array",
          "items": {"type": "string"},
          "description": "The function names a FunctionPruningTransformer keeps."
        }
      },
      "oneOf": [{"required": ["component_pruning"]}, {"required": ["function_pruning"]}],
      "additionalProperties": false
    },
    "CatalogRegistration": {
      "type": "object",
      "description": "A catalog as the agent registers it, which is a CatalogConfig: the pristine document plus the transformers applied before it reaches a prompt or a validator.",
      "properties": {
        "catalog": {"$ref": "#/$defs/AgentCatalogRef"},
        "transformers": {
          "type": "array",
          "items": {"$ref": "#/$defs/CatalogTransformerSpec"}
        }
      },
      "required": ["catalog"],
      "additionalProperties": false
    },
    "InferenceFormatName": {
      "type": "string",
      "enum": ["direct_json", "express"],
      "description": "The inference format strategy the case exercises."
    },
    "CatalogExpectation": {
      "type": "object",
      "description": "Assertions about one catalog. Each is optional, so a case states only what it means to check. The name lists are exhaustive: the catalog declares those names and no others.",
      "properties": {
        "catalog_id": {"type": "string"},
        "protocol_version": {
          "type": "string",
          "description": "The protocol version the catalog reports, written as the enum spells it, such as `v1.0`."
        },
        "components": {"type": "array", "items": {"type": "string"}},
        "functions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "RawResponsePart": {
      "type": "object",
      "description": "One token of an unwrapped response: conversational text or an uncompiled A2UI block, never both.",
      "properties": {
        "text": {"type": "string", "description": "Conversational text, as a TextPart."},
        "a2ui_raw": {
          "type": "string",
          "description": "The uncompiled format content between the sentinel tags, as a RawA2uiPart."
        },
        "is_final": {
          "type": "boolean",
          "default": true,
          "description": "Whether the part is closed. A block the model left unterminated states false."
        }
      },
      "oneOf": [{"required": ["text"]}, {"required": ["a2ui_raw"]}],
      "additionalProperties": false
    },
    "ResponsePart": {
      "type": "object",
      "description": "One part of a parsed response: conversational text or compiled A2UI messages, never both. This is the union the blueprint parser returns, so text that precedes a payload is its own part rather than a field on the payload's part.",
      "properties": {
        "text": {"type": "string"},
        "a2ui": {
          "type": "array",
          "items": {"type": "object"},
          "description": "Compiled AgentToRendererMessage objects."
        }
      },
      "oneOf": [{"required": ["text"]}, {"required": ["a2ui"]}],
      "additionalProperties": false
    },
    "TransformCatalogTest": {
      "type": "object",
      "description": "Applying catalog transformers to a pristine catalog.",
      "properties": {
        "action": {"const": "transform_catalog"},
        "args": {
          "type": "object",
          "properties": {
            "catalog": {"$ref": "#/$defs/AgentCatalogRef"},
            "transformers": {
              "type": "array",
              "items": {"$ref": "#/$defs/CatalogTransformerSpec"}
            }
          },
          "required": ["catalog"],
          "additionalProperties": false
        },
        "expect": {"$ref": "#/$defs/CatalogExpectation"},
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args"]
    },
    "ProvideCatalogTest": {
      "type": "object",
      "description": "Loading a catalog document through a catalog provider, including the identity and version checks the provider performs.",
      "properties": {
        "action": {"const": "provide_catalog"},
        "args": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["file_system"],
              "description": "Which provider loads the document. Only the file system provider is covered: an in memory provider is handed a document that a case would have to inline, which tests the harness that inlined it more than the provider."
            },
            "path": {
              "type": "string",
              "description": "Path relative to `conformance/`, for the file system provider."
            },
            "catalog_id": {
              "type": "string",
              "description": "The id the provider is constructed with. It is checked against the document only when the document states one, and supplies the id when the document does not."
            },
            "protocol_version": {
              "type": "string",
              "description": "The protocol version the provider is constructed with, checked against the document only when the document states one."
            }
          },
          "required": ["provider"],
          "additionalProperties": false
        },
        "expect": {"$ref": "#/$defs/CatalogExpectation"},
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args"]
    },
    "ResolveCatalogsTest": {
      "type": "object",
      "description": "Negotiating renderer capabilities against the catalogs an agent registered, and returning the transformed catalogs that are active for the session.",
      "properties": {
        "action": {"const": "resolve_catalogs"},
        "args": {
          "type": "object",
          "properties": {
            "catalogs": {
              "type": "array",
              "items": {"$ref": "#/$defs/CatalogRegistration"},
              "description": "The catalogs the agent registered, in registration order."
            },
            "renderer_capabilities": {
              "type": "object",
              "description": "The capabilities object as it arrives on the wire, keyed by protocol version. A case for a request that carries no capabilities at all leaves this out."
            },
            "accepts_inline_catalogs": {
              "type": "boolean",
              "default": false,
              "description": "Whether the agent accepts catalogs the renderer declares inline."
            }
          },
          "required": ["catalogs"],
          "additionalProperties": false
        },
        "expect": {
          "type": "object",
          "properties": {
            "active_catalog_ids": {
              "type": "array",
              "items": {"type": "string"},
              "description": "The ids of the active catalogs, compared without regard to order. Nothing in the protocol gives the sequence a meaning, so a harness compares these as a set."
            },
            "catalogs": {
              "type": "array",
              "items": {"$ref": "#/$defs/CatalogExpectation"},
              "description": "Assertions about each active catalog, matched to `active_catalog_ids` by `catalog_id` rather than by position."
            }
          },
          "additionalProperties": false
        },
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args"]
    },
    "GeneratePromptSnippetTest": {
      "type": "object",
      "description": "Rendering the system prompt snippet for a format and a set of active catalogs. Assertions are substrings rather than whole texts, because the wording around the catalog is an implementation's own.",
      "properties": {
        "action": {"const": "generate_prompt_snippet"},
        "args": {
          "type": "object",
          "properties": {
            "format": {"$ref": "#/$defs/InferenceFormatName"},
            "catalogs": {
              "type": "array",
              "items": {"$ref": "#/$defs/CatalogRegistration"}
            },
            "examples": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Prompt examples, each a path relative to `conformance/` to a JSON file holding the AgentToRendererMessage list for one turn."
            },
            "allowed_messages": {
              "type": "array",
              "items": {"type": "string"},
              "description": "The payload envelope names the format may describe, such as `createSurface`. Leaving it out means every envelope of the protocol version is available."
            }
          },
          "required": ["format", "catalogs"],
          "additionalProperties": false
        },
        "expect_contains": {"type": "array", "items": {"type": "string"}},
        "expect_absent": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Substrings the snippet must not carry, which is how a case checks that a pruned component never reaches the model."
        },
        "expect_deterministic": {
          "type": "boolean",
          "description": "Generating twice from the same inputs returns the same string."
        },
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args"]
    },
    "UnwrapTest": {
      "type": "object",
      "description": "Tokenizing a model response into ordered raw parts, before any payload is compiled.",
      "properties": {
        "action": {"const": "unwrap"},
        "args": {
          "type": "object",
          "properties": {"format": {"$ref": "#/$defs/InferenceFormatName"}},
          "required": ["format"],
          "additionalProperties": false
        },
        "input": {"type": "string", "description": "The raw text the model emitted."},
        "expect": {
          "type": "array",
          "items": {"$ref": "#/$defs/RawResponsePart"},
          "description": "The parts in the order the model emitted them."
        },
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args", "input"]
    },
    "WrapTest": {
      "type": "object",
      "description": "Writing raw parts back out as a model would have emitted them, which is how examples and transcripts are produced.",
      "properties": {
        "action": {"const": "wrap"},
        "args": {
          "type": "object",
          "properties": {"format": {"$ref": "#/$defs/InferenceFormatName"}},
          "required": ["format"],
          "additionalProperties": false
        },
        "parts": {
          "type": "array",
          "items": {"$ref": "#/$defs/RawResponsePart"}
        },
        "expect_output": {
          "type": "string",
          "description": "The exact string, for cases where the spelling is fixed by the format."
        },
        "expect_contains": {"type": "array", "items": {"type": "string"}},
        "expect_round_trip": {
          "type": "boolean",
          "description": "Unwrapping the output returns the parts the case supplied."
        },
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args", "parts"]
    },
    "CompileTest": {
      "type": "object",
      "description": "Compiling one raw format block into A2UI messages.",
      "properties": {
        "action": {"const": "compile"},
        "args": {
          "type": "object",
          "properties": {
            "format": {"$ref": "#/$defs/InferenceFormatName"},
            "catalog": {"$ref": "#/$defs/AgentCatalogRef"},
            "catalogs": {
              "type": "array",
              "items": {"$ref": "#/$defs/AgentCatalogRef"},
              "description": "For cases where the compiler needs more than one active catalog."
            }
          },
          "required": ["format"],
          "additionalProperties": false
        },
        "input": {
          "type": "string",
          "description": "The raw block content, without the sentinel tags."
        },
        "expect": {
          "type": "array",
          "items": {"type": "object"},
          "description": "The compiled AgentToRendererMessage objects."
        },
        "expect_present": {
          "type": "array",
          "items": {"type": "string"},
          "description": "JSON Pointers into the compiled messages that must hold a non-empty value whose spelling is not fixed by the protocol. A harness removes each of these from what the implementation produced, asserting on the way that it was there and not empty, and then compares what is left against `expect`. The `expect` block therefore omits them. This is for a value the format has to supply but the protocol does not dictate, such as the message on a check that was written without one."
        },
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args", "input"]
    },
    "DecompileTest": {
      "type": "object",
      "description": "Writing A2UI messages back into a format's own notation.",
      "properties": {
        "action": {"const": "decompile"},
        "args": {
          "type": "object",
          "properties": {
            "format": {"$ref": "#/$defs/InferenceFormatName"},
            "catalog": {"$ref": "#/$defs/AgentCatalogRef"}
          },
          "required": ["format"],
          "additionalProperties": false
        },
        "messages": {
          "type": "array",
          "items": {"type": "object"},
          "description": "The AgentToRendererMessage objects to write out."
        },
        "expect_output": {"type": "string"},
        "expect_contains": {"type": "array", "items": {"type": "string"}},
        "expect_round_trip": {
          "type": "boolean",
          "description": "Compiling the output returns the messages the case supplied."
        },
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args", "messages"]
    },
    "ParseResponseTest": {
      "type": "object",
      "description": "Parsing a whole model response into the text and payload parts an agent hands on, in the order the model emitted them.",
      "properties": {
        "action": {"const": "parse_response"},
        "args": {
          "type": "object",
          "properties": {
            "format": {"$ref": "#/$defs/InferenceFormatName"},
            "catalog": {"$ref": "#/$defs/AgentCatalogRef"},
            "catalogs": {
              "type": "array",
              "items": {"$ref": "#/$defs/AgentCatalogRef"}
            },
            "wrapped": {
              "type": "boolean",
              "default": true,
              "description": "Whether the response is expected to carry sentinel tags. A case with false hands the whole body to the compiler."
            }
          },
          "required": ["format"],
          "additionalProperties": false
        },
        "input": {"type": "string"},
        "expect": {
          "type": "array",
          "items": {"$ref": "#/$defs/ResponsePart"}
        },
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args", "input"]
    },
    "ParseChunkTest": {
      "type": "object",
      "description": "Feeding a response to a parser one chunk at a time. Each step states the parts that chunk yields, so a case fixes both what is emitted and when.",
      "properties": {
        "action": {"const": "parse_chunk"},
        "args": {
          "type": "object",
          "properties": {
            "format": {"$ref": "#/$defs/InferenceFormatName"},
            "catalog": {"$ref": "#/$defs/AgentCatalogRef"},
            "catalogs": {
              "type": "array",
              "items": {"$ref": "#/$defs/AgentCatalogRef"}
            },
            "progressive_keys": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Overrides the parser's default set of string keys that may be closed early while a value is still arriving."
            },
            "wrapped": {"type": "boolean", "default": true}
          },
          "required": ["format"],
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "input": {"type": "string", "description": "The chunk handed to the parser."},
              "expect": {
                "type": "array",
                "items": {"$ref": "#/$defs/ResponsePart"},
                "description": "The parts this chunk yields, which is the delta since the previous chunk and is empty when the parser is still buffering."
              },
              "expect_error": {"$ref": "#/$defs/ExpectError"}
            },
            "required": ["input"],
            "oneOf": [{"required": ["expect"]}, {"required": ["expect_error"]}]
          }
        },
        "expect_matches_single_shot": {
          "type": "boolean",
          "description": "Concatenating the chunks and parsing them in one call yields the same parts as the steps do together, so chunk boundaries change timing and nothing else."
        }
      },
      "required": ["action", "args", "steps"]
    },
    "CreateFormatTest": {
      "type": "object",
      "description": "Building an inference format from its factory and checking what the format hands back.",
      "properties": {
        "action": {"const": "create_format"},
        "args": {
          "type": "object",
          "properties": {
            "format": {"$ref": "#/$defs/InferenceFormatName"},
            "catalogs": {
              "type": "array",
              "items": {"$ref": "#/$defs/CatalogRegistration"}
            },
            "examples": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Prompt examples, each a path relative to `conformance/` to a JSON file holding the AgentToRendererMessage list for one turn."
            },
            "probe_chunks": {
              "type": "array",
              "items": {"type": "string"},
              "description": "A stream fed to one parser and then to a second parser built by the same format, which is how a case checks that the two share no buffer."
            }
          },
          "required": ["format", "catalogs"],
          "additionalProperties": false
        },
        "expect": {
          "type": "object",
          "properties": {
            "prompt_snippet_contains": {"type": "array", "items": {"type": "string"}},
            "prompt_snippet_absent": {"type": "array", "items": {"type": "string"}},
            "parsers_are_distinct": {
              "type": "boolean",
              "description": "Two calls to create a parser return two parsers rather than one shared instance."
            },
            "parser_state_isolated": {
              "type": "boolean",
              "description": "A parser built after another has consumed `probe_chunks` produces the same parts from those chunks as the first one did."
            }
          },
          "additionalProperties": false
        },
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args"]
    },
    "CreateProcessorTest": {
      "type": "object",
      "description": "Taking an agent's registered catalogs and a renderer's capabilities through to a request processor, and using that processor for a turn.",
      "properties": {
        "action": {"const": "create_processor"},
        "args": {
          "type": "object",
          "properties": {
            "catalogs": {
              "type": "array",
              "items": {"$ref": "#/$defs/CatalogRegistration"},
              "description": "The catalogs the generator holds for the life of the agent."
            },
            "examples": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Prompt examples held by the generator and checked against the active catalogs when a processor is created. Each is a path relative to `conformance/` to a JSON file holding the AgentToRendererMessage list for one turn."
            },
            "format": {"$ref": "#/$defs/InferenceFormatName"},
            "format_override": {
              "$ref": "#/$defs/InferenceFormatName",
              "description": "A format passed when the processor is created, overriding the generator's own."
            },
            "renderer_capabilities": {"type": "object"},
            "accepts_inline_catalogs": {"type": "boolean", "default": false}
          },
          "required": ["catalogs"],
          "additionalProperties": false
        },
        "expect": {
          "type": "object",
          "properties": {
            "active_catalog_ids": {"type": "array", "items": {"type": "string"}},
            "catalogs": {
              "type": "array",
              "items": {"$ref": "#/$defs/CatalogExpectation"},
              "description": "Assertions about each active catalog, aligned by position with `active_catalog_ids`, for cases that check what the processor holds rather than what its prompt says."
            },
            "prompt_snippet_contains": {"type": "array", "items": {"type": "string"}},
            "prompt_snippet_absent": {"type": "array", "items": {"type": "string"}},
            "generator_catalogs_unchanged": {
              "type": "boolean",
              "description": "The generator's own catalogs are the same after the processor was created as before, so one renderer's negotiation cannot affect the next."
            }
          },
          "additionalProperties": false
        },
        "then_parse": {
          "type": "object",
          "description": "A response parsed through the processor the case just created, for rules that only hold once negotiation has narrowed the catalogs. This sits beside `expect` rather than inside it because it is a call made on the processor, not a property read off it.",
          "properties": {
            "input": {"type": "string"},
            "wrapped": {"type": "boolean", "default": true},
            "expect": {
              "type": "array",
              "items": {"$ref": "#/$defs/ResponsePart"}
            },
            "expect_error": {"$ref": "#/$defs/ExpectError"}
          },
          "required": ["input"],
          "additionalProperties": false
        },
        "expect_error": {"$ref": "#/$defs/ExpectError"}
      },
      "required": ["action", "args"]
    },
    "ExpectError": {
      "oneOf": [
        {
          "type": "string",
          "description": "Expected error message (regex) if this step/action should fail."
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "ParseError",
                "ValidationError",
                "CatalogError",
                "IntegrityError",
                "RecursionError",
                "CompilationError",
                "DataError"
              ]
            },
            "message": {
              "type": "string",
              "description": "Expected error message (regex) if this step/action should fail."
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {"type": "string"},
                  "code": {"type": "string"}
                },
                "required": ["path", "code"]
              }
            }
          },
          "required": ["category"]
        }
      ]
    }
  }
}
