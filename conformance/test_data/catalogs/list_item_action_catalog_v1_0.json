{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/conformance/test_data/catalogs/list_item_action_catalog_v1_0.json",
  "protocolVersion": "1.0",
  "title": "Conformance List Item Action Catalog (v1.0)",
  "description": "A catalog whose component carries actions inside list items, for testing that an Express function call in a nested action slot compiles to a functionCall action.",
  "catalogId": "conformance/list_item_action",
  "components": {
    "Text": {
      "type": "object",
      "description": "Displays a run of text.",
      "properties": {
        "component": { "const": "Text" },
        "text": { "$ref": "common_types.json#/$defs/DynamicString" }
      },
      "required": ["component", "text"]
    },
    "Links": {
      "type": "object",
      "description": "A list of labelled links, each firing an action when chosen.",
      "properties": {
        "component": { "const": "Links" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "action": { "$ref": "common_types.json#/$defs/Action" }
            },
            "required": ["label", "action"]
          }
        },
        "primary": { "$ref": "common_types.json#/$defs/Action" }
      },
      "required": ["component", "items"]
    }
  },
  "functions": {
    "openUrl": {
      "type": "object",
      "description": "Opens a URL.",
      "returnType": "void",
      "properties": {
        "@call": { "const": "openUrl" },
        "args": {
          "type": "object",
          "properties": {
            "url": { "type": "string" }
          },
          "required": ["url"],
          "unevaluatedProperties": false
        }
      },
      "required": ["@call", "args"]
    }
  }
}
