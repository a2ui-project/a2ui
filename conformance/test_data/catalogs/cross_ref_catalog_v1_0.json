{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/conformance/test_data/catalogs/cross_ref_catalog_v1_0.json",
  "protocolVersion": "1.0",
  "title": "Conformance Cross-Reference Catalog (v1.0)",
  "description": "A catalog whose components and functions reference component definitions and property subschemas in simplified_catalog_v1_0.json via external $refs.",
  "catalogId": "conformance/cross_ref",
  "components": {
    "CustomText": {
      "type": "object",
      "description": "A text display with a required badge that inherits Text from simplified_catalog_v1_0.json.",
      "allOf": [
        { "$ref": "simplified_catalog_v1_0.json#/components/Text" }
      ],
      "properties": {
        "component": { "const": "CustomText" },
        "badge": { "$ref": "simplified_catalog_v1_0.json#/components/Text/properties/text" }
      },
      "required": ["component", "badge"]
    },
    "StyledCard": {
      "type": "object",
      "description": "A container card that inherits Card from simplified_catalog_v1_0.json and reuses Button's action property.",
      "allOf": [
        { "$ref": "simplified_catalog_v1_0.json#/components/Card" }
      ],
      "properties": {
        "component": { "const": "StyledCard" },
        "subtitle": { "type": "string" },
        "action": { "$ref": "simplified_catalog_v1_0.json#/components/Button/properties/action" }
      },
      "required": ["component", "subtitle", "action"]
    }
  },
  "functions": {
    "formatBadge": {
      "type": "object",
      "description": "Formats a badge label using a template string.",
      "returnType": "string",
      "properties": {
        "@call": { "const": "formatBadge" },
        "args": {
          "type": "object",
          "properties": {
            "value": { "$ref": "simplified_catalog_v1_0.json#/functions/formatString/properties/args/properties/value" }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        }
      },
      "required": ["@call", "args"]
    }
  },
  "$defs": {
    "anyComponent": {
      "oneOf": [
        { "$ref": "#/components/CustomText" },
        { "$ref": "#/components/StyledCard" }
      ],
      "discriminator": { "propertyName": "component" }
    },
    "anyFunction": {
      "oneOf": [
        { "$ref": "#/functions/formatBadge" }
      ]
    }
  }
}
