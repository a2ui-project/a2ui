{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/conformance/test_data/catalogs/event_property_catalog_v1_0.json",
  "protocolVersion": "1.0",
  "title": "Conformance Event Property Catalog (v1.0)",
  "description": "A catalog whose component and list items declare a plain event property beside an action, for testing that only an object whose single property is event or functionCall binds as an action.",
  "catalogId": "conformance/event_property",
  "components": {
    "Select": {
      "type": "object",
      "description": "Offers options, each a label or a label with the event it sends.",
      "properties": {
        "component": { "const": "Select" },
        "label": { "type": "string" },
        "event": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "event": { "type": "string" }
                },
                "required": ["label", "event"]
              }
            ]
          }
        },
        "action": { "$ref": "common_types.json#/$defs/Action" }
      },
      "required": ["component", "label", "event", "options", "action"]
    }
  }
}
