{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/conformance/test_data/catalogs/allowed_children_catalog_v1_0.json",
  "protocolVersion": "1.0",
  "title": "Conformance Allowed Children Catalog (v1.0)",
  "description": "A catalog whose Column declares allowedChildren, for the timing case of a container whose children arrive one per message, each checked against that constraint.",
  "catalogId": "conformance/allowed_children",
  "components": {
    "Column": {
      "type": "object",
      "description": "Lays out its children in a column. It may hold only Text children.",
      "allowedChildren": ["Text"],
      "properties": {
        "component": {"const": "Column"},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      },
      "required": ["component", "children"]
    },
    "Text": {
      "type": "object",
      "description": "Shows a line of text.",
      "properties": {
        "component": {"const": "Text"},
        "text": {"$ref": "common_types.json#/$defs/DynamicString"}
      },
      "required": ["component", "text"]
    }
  },
  "$defs": {
    "anyComponent": {
      "oneOf": [{"$ref": "#/components/Column"}, {"$ref": "#/components/Text"}]
    }
  }
}
