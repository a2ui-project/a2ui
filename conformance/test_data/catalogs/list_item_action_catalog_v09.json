{
  "$id": "https://a2ui.org/conformance/test_data/catalogs/list_item_action_catalog_v09.json",
  "catalogId": "conformance/list_item_action",
  "protocolVersion": "0.9",
  "components": {
    "Text": {
      "type": "object",
      "allOf": [
        { "$ref": "common_types.json#/$defs/ComponentCommon" }
      ],
      "properties": {
        "component": { "const": "Text" },
        "text": { "$ref": "common_types.json#/$defs/DynamicString" }
      },
      "required": [ "component", "text" ]
    },
    "Links": {
      "type": "object",
      "allOf": [
        { "$ref": "common_types.json#/$defs/ComponentCommon" }
      ],
      "properties": {
        "component": { "const": "Links" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "action": { "$ref": "common_types.json#/$defs/Action" }
            },
            "required": [ "label", "action" ]
          }
        },
        "primary": { "$ref": "common_types.json#/$defs/Action" }
      },
      "required": [ "component", "items" ]
    }
  },
  "functions": {
    "openUrl": {
      "type": "object",
      "description": "Opens a URL.",
      "returnType": "void",
      "properties": {
        "call": { "const": "openUrl" },
        "args": {
          "type": "object",
          "properties": {
            "url": { "type": "string" }
          },
          "required": [ "url" ]
        }
      },
      "required": [ "call", "args" ]
    }
  },
  "$defs": {
    "anyComponent": {
      "oneOf": [
        { "$ref": "#/components/Text" },
        { "$ref": "#/components/Links" }
      ],
      "discriminator": { "propertyName": "component" }
    }
  }
}
