[
  {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "s_defaultless"
    }
  },
  {
    "version": "1.0",
    "updateComponents": {
      "surfaceId": "s_defaultless",
      "components": [
        {
          "id": "root",
          "component": "FooPanel",
          "@catalogId": "https://example.com/catalogs/foo/v1/catalog.json",
          "children": {
            "@child": ["baz_1", "extra_bar_btn"]
          }
        },
        {
          "component": "FooHeader",
          "id": "baz_1__fooheader_1",
          "@catalogId": "https://example.com/catalogs/foo/v1/catalog.json",
          "title": {
            "@path": "/dashboard/headline"
          }
        },
        {
          "component": "BarBadge",
          "id": "baz_1__barbadge_1",
          "@catalogId": "https://example.com/catalogs/bar/v1/catalog.json",
          "tag": "LIVE"
        },
        {
          "component": "BarButton",
          "id": "baz_1__barbutton_1",
          "@catalogId": "https://example.com/catalogs/bar/v1/catalog.json",
          "label": "Deploy",
          "action": {
            "@action": {
              "name": "deploy_clicked",
              "userMessage": "Deploy release"
            }
          }
        },
        {
          "component": "FooPanel",
          "id": "baz_1",
          "@catalogId": "https://example.com/catalogs/foo/v1/catalog.json",
          "children": {
            "@child": ["baz_1__fooheader_1", "baz_1__barbadge_1", "baz_1__barbutton_1"]
          }
        },
        {
          "id": "extra_bar_btn",
          "component": "BarButton",
          "@catalogId": "https://example.com/catalogs/bar/v1/catalog.json",
          "label": "Cancel",
          "action": {
            "@action": {
              "name": "cancel_clicked"
            }
          }
        }
      ]
    }
  },
  {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "s_theme",
      "catalogId": "https://example.com/theme.json"
    }
  },
  {
    "version": "1.0",
    "updateComponents": {
      "surfaceId": "s_theme",
      "components": [
        {
          "id": "root",
          "component": "ThemeShell",
          "child": "baz_themed"
        },
        {
          "component": "FooHeader",
          "id": "baz_themed__fooheader_1",
          "@catalogId": "https://example.com/catalogs/foo/v1/catalog.json",
          "title": "Themed Dashboard"
        },
        {
          "component": "BarBadge",
          "id": "baz_themed__barbadge_1",
          "@catalogId": "https://example.com/catalogs/bar/v1/catalog.json",
          "tag": "CANARY"
        },
        {
          "component": "BarButton",
          "id": "baz_themed__barbutton_1",
          "@catalogId": "https://example.com/catalogs/bar/v1/catalog.json",
          "label": "Promote",
          "action": {
            "@action": {
              "name": "promote_clicked"
            }
          }
        },
        {
          "component": "FooPanel",
          "id": "baz_themed",
          "@catalogId": "https://example.com/catalogs/foo/v1/catalog.json",
          "children": {
            "@child": [
              "baz_themed__fooheader_1",
              "baz_themed__barbadge_1",
              "baz_themed__barbutton_1"
            ]
          }
        }
      ]
    }
  }
]
