[
  {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "conformance",
      "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "1.0",
    "updateComponents": {
      "surfaceId": "conformance",
      "components": [
        {
          "component": "Column",
          "id": "root",
          "children": ["metric_path", "metric_call"]
        },
        {
          "component": "Text",
          "id": "metric_path__text_1",
          "text": "CPU Usage",
          "variant": "caption"
        },
        {
          "component": "Text",
          "id": "metric_path__text_2",
          "text": {
            "@path": "/system/cpu"
          },
          "variant": "body"
        },
        {
          "component": "Column",
          "id": "metric_path__column_1",
          "children": ["metric_path__text_1", "metric_path__text_2"],
          "justify": "start",
          "align": "stretch"
        },
        {
          "component": "Card",
          "id": "metric_path",
          "child": "metric_path__column_1"
        },
        {
          "component": "Text",
          "id": "metric_call__text_1",
          "text": "Formatted CPU",
          "variant": "caption"
        },
        {
          "component": "Text",
          "id": "metric_call__text_2",
          "text": {
            "@call": "formatString",
            "args": {
              "value": "CPU: ${/system/cpu}%"
            }
          },
          "variant": "body"
        },
        {
          "component": "Column",
          "id": "metric_call__column_1",
          "children": ["metric_call__text_1", "metric_call__text_2"],
          "justify": "start",
          "align": "stretch"
        },
        {
          "component": "Card",
          "id": "metric_call",
          "child": "metric_call__column_1"
        }
      ]
    }
  }
]
