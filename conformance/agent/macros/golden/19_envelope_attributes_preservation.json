[
  {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "conformance",
      "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "1.0",
    "updateComponents": {
      "surfaceId": "conformance",
      "components": [
        {
          "component": "Column",
          "id": "root",
          "children": {
            "@child": ["btn_basic", "btn_standalone"]
          }
        },
        {
          "component": "Text",
          "id": "btn_basic__text_1",
          "text": "Submit",
          "variant": "body"
        },
        {
          "component": "Button",
          "id": "btn_basic",
          "child": {
            "@child": "btn_basic__text_1"
          },
          "variant": "primary",
          "action": {
            "@action": {
              "name": "submit_form"
            }
          },
          "@accessibility": {
            "label": "Submit form button",
            "description": "Submits the current form"
          },
          "@metadata": {
            "extensions": {
              "telemetry": {
                "traceId": "t1"
              }
            }
          }
        },
        {
          "component": "Text",
          "id": "btn_standalone__text_1",
          "text": "Cancel",
          "variant": "body"
        },
        {
          "component": "Button",
          "id": "btn_standalone",
          "child": {
            "@child": "btn_standalone__text_1"
          },
          "variant": "primary",
          "action": {
            "@action": {
              "name": "cancel_form"
            }
          },
          "@accessibility": {
            "label": "Cancel form button"
          }
        }
      ]
    }
  }
]
