{
  "core": {"include": ["core/*.yaml"]},
  "agent": {"include": ["agent/**/*.yaml"]},
  "extensions": {"include": ["extensions/**/*.yaml"]},
  "adapter": {
    "include": [
      "core/adapter_conformance.yaml",
      "core/accessibility.yaml",
      "adapter/markdown_subset.yaml",
      "adapter/adapter_conformance_v0_9.yaml"
    ]
  },
  "e2e": {
    "include": ["e2e/*.yaml", "e2e/v0_9_1/*.yaml"],
    "harnesses": [
      "python-agent",
      "ts-agent",
      "dart-agent",
      "lit",
      "react",
      "angular",
      "flutter",
      "swiftui"
    ]
  }
}
