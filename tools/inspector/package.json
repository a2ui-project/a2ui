{
  "name": "@a2ui/inspector",
  "private": true,
  "version": "0.8.1",
  "description": "A2UI Inspector",
  "main": "./dist/inspector.js",
  "types": "./dist/inspector.d.ts",
  "type": "module",
  "scripts": {
    "prepack": "yarn build",
    "build": "wireit",
    "build:tsc": "wireit",
    "dev": "yarn serve --watch",
    "test": "node -e 'const fs=require(\"fs\"); const path=require(\"path\"); function find(d){for(const f of fs.readdirSync(d)){const p=path.join(d,f);if(f===\"node_modules\"||f===\"dist\")continue;if(fs.statSync(p).isDirectory()){if(find(p))return true;}else if(f.includes(\".test.\")||f.includes(\".spec.\"))return true;}return false;} if(find(\".\")){require(\"child_process\").execSync(\"vitest run\",{stdio:\"inherit\"});}else{console.log(\"Workspace has no tests.\");}'",
    "serve": "wireit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "wireit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "wireit": {
    "serve": {
      "command": "vite dev",
      "dependencies": [
        "build"
      ],
      "service": true
    },
    "build": {
      "dependencies": [
        "build:tsc"
      ]
    },
    "build:tsc": {
      "command": "tsc -b --pretty",
      "env": {
        "FORCE_COLOR": "1"
      },
      "dependencies": [
        "../../typescript/renderers/lit:build:tsc"
      ],
      "files": [
        "**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/",
        "!dist/**/*.min.js{,.map}"
      ],
      "clean": "if-file-deleted"
    },
    "clean": {
      "command": "rm -rf dist .tsbuildinfo .wireit"
    }
  },
  "repository": {
    "directory": "tools/inspector",
    "type": "git",
    "url": "git+https://github.com/a2ui-project/a2ui.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "Google",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/a2ui-project/a2ui/issues"
  },
  "homepage": "https://github.com/a2ui-project/a2ui/tree/main/web#readme",
  "devDependencies": {
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "gts": "^7.0.0",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "wireit": "^0.15.0-pre.2"
  },
  "dependencies": {
    "@a2ui/lit": "workspace:*",
    "@a2ui/web_core": "workspace:*",
    "@lit-labs/signals": "^0.3.0",
    "@lit/context": "^1.1.6",
    "@types/node": "^25.9.3",
    "lit": "^3.3.3"
  }
}
