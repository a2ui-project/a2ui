limitations under the License.

Internal category markers, not translatable text. Keep this resource outside .lproj folders;
the resolver supplies the locale explicitly. "f" receives a Double, including fractional counts.
-->
<plist version="1.0">
<dict>
  <key>category</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>f</string>
      <key>few</key>
      <string>few</string>
      <key>many</key>
      <string>many</string>
      <key>one</key>
      <string>one</string>
      <key>other</key>
      <string>other</string>
      <key>two</key>
      <string>two</string>
      <key>zero</key>
      <string>zero</string>
    </dict>
  </dict>
</dict>
</plist>
