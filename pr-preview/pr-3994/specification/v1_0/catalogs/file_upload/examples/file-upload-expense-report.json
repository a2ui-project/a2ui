{
  "name": "File upload expense report",
  "description": "A form that collects receipt images with a FileUpload component and submits them with a Button, the same way as any other input. The surface is created on the basic catalog and the FileUpload component selects the file upload catalog with its own catalogId. The renderer writes the uploaded files to /expense/receipts as FileReference objects, the required check keeps the Submit button disabled until at least one upload has completed, and the submit action binds the same path into its context so the agent receives the file pointers together with the note.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "gallery-file-upload-expense-report",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "gallery-file-upload-expense-report",
        "value": {
          "expense": {
            "receipts": [],
            "note": ""
          }
        }
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "gallery-file-upload-expense-report",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["heading", "receipt_upload", "note_field", "submit_button"]
          },
          {
            "id": "heading",
            "component": "Text",
            "text": "### Submit an expense report"
          },
          {
            "id": "receipt_upload",
            "component": "FileUpload",
            "catalogId": "https://a2ui.org/specification/v1_0/catalogs/file_upload/catalog.json",
            "label": "Drop your receipts here or click to upload",
            "accept": "image/*, application/pdf",
            "maxSize": 10485760,
            "multiple": true,
            "value": {
              "@path": "/expense/receipts"
            },
            "checks": [
              {
                "condition": {
                  "@call": "required",
                  "args": {
                    "value": {
                      "@path": "/expense/receipts"
                    }
                  }
                },
                "message": "Upload at least one receipt."
              }
            ]
          },
          {
            "id": "note_field",
            "component": "TextField",
            "label": "Note",
            "placeholder": "What were these expenses for?",
            "value": {
              "@path": "/expense/note"
            }
          },
          {
            "id": "submit_button",
            "component": "Button",
            "child": "submit_button_label",
            "variant": "primary",
            "action": {
              "event": {
                "name": "submit_expense_report",
                "context": {
                  "receipts": {
                    "@path": "/expense/receipts"
                  },
                  "note": {
                    "@path": "/expense/note"
                  }
                }
              }
            }
          },
          {
            "id": "submit_button_label",
            "component": "Text",
            "text": "Submit"
          }
        ]
      }
    }
  ]
}
