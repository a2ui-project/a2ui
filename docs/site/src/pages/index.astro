import '../styles/tokens.css';
import StarlightHeader from '../components/StarlightHeader.astro';
import HeroChatGeneration from '../components/HeroChatGeneration.astro';
import ExpressiveUiStudio from '../components/ExpressiveUiStudio.astro';
import DesignSystemMorph from '../components/DesignSystemMorph.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A2UI — Give AI Agents a Real Interface</title>
    <meta
      name="description"
      content="The open declarative UI protocol for AI agents. Stream interactive, stateful surfaces that render natively in your own React, Flutter, SwiftUI, and Compose design systems."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('starlight-theme') || localStorage.getItem('a2ui-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body class="a2-page">
    <!-- Unified Sticky Navigation -->
    <header class="a2-topbar">
      <div class="a2-topbar__inner">
        <StarlightHeader />
      </div>
    </header>

    <main>
      <!-- =================================================================
           HERO: ARCHITECTURAL MASTHEAD + FREESTANDING ARTIFACT STAGE
           ================================================================= -->
      <section class="a2-hero" id="hero">
        <div class="a2-hero__grid-bg" aria-hidden="true"></div>

        <div class="a2-wrap">
          <div class="a2-masthead">
            <div class="a2-edition-line">
              <span>SPECIFICATION v1.0</span>
              <span class="a2-slash" aria-hidden="true">/</span>
              <span>AGENT-TO-UI PROTOCOL</span>
              <span class="a2-slash" aria-hidden="true">/</span>
              <a href={`${base}/specification/v1.0-a2ui/`}>APACHE 2.0 STANDARD →</a>
            </div>

            <div class="a2-masthead__split">
              <h1 class="a2-h1">
                Give AI agents a <span class="a2-serif-accent">real interface.</span>
              </h1>

              <div class="a2-masthead__right">
                <p class="a2-lead">
                  Agents stream pure declarative intent. Your app renders native, stateful UI — zero
                  scripts, zero bolted-on iframes.
                </p>

                <div class="a2-hero__actions">
                  <a href={`${base}/quickstart/`} class="a2-btn a2-btn--primary">
                    <span>Run in 5 Minutes</span>
                    <span aria-hidden="true">→</span>
                  </a>

                  <button
                    type="button"
                    class="a2-cmd-bar"
                    id="hero-copy-clone"
                    data-copy="git clone https://github.com/a2ui-project/a2ui.git"
                    aria-label="Copy git clone command"
                  >
                    <span class="a2-cmd-bar__sig">$</span>
                    <span class="a2-cmd-bar__code" id="hero-copy-txt">git clone a2ui-project/a2ui</span>
                    <span class="a2-cmd-bar__act" id="hero-copy-act">COPY</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Interactive 4-Artifact Stage -->
          <div class="a2-hero__stage">
            <HeroChatGeneration />
          </div>
        </div>
      </section>

      <!-- =================================================================
           § 01 — CORE CAPABILITIES (#use-cases)
           ================================================================= -->
      <section class="a2-section" id="use-cases">
        <div class="a2-wrap">
          <div class="a2-chapter">
            <div class="a2-chapter__rule">
              <span>§ 01 — CORE CAPABILITIES</span>
              <span>PROTOCOL PRIMITIVES</span>
            </div>
            <div class="a2-chapter__split">
              <h2 class="a2-h2">Four primitives behind every <span class="a2-serif-accent">live surface.</span></h2>
              <p class="a2-sec-sub">
                Stream progressively, bind state locally in 0ms, cut token payloads by 77%, and
                patch live views across turns.
              </p>
            </div>
          </div>

          <ExpressiveUiStudio />
        </div>
      </section>

      <!-- =================================================================
           § 02 — BRAND & PLATFORM CHAMELEON (#native-rendering)
           ================================================================= -->
      <section class="a2-section a2-section--alt" id="native-rendering">
        <div class="a2-wrap">
          <div class="a2-chapter">
            <div class="a2-chapter__rule">
              <span>§ 02 — HOST DESIGN SYSTEMS</span>
              <span>ZERO LLM CSS</span>
            </div>
            <div class="a2-chapter__split">
              <h2 class="a2-h2">Their intelligence. <span class="a2-serif-accent">Your design system.</span></h2>
              <p class="a2-sec-sub">
                Separate agent intent from presentation so one semantic stream renders natively
                across iOS, Android, Flutter, and Web.
              </p>
            </div>
          </div>

          <DesignSystemMorph />
        </div>
      </section>

      <!-- =================================================================
           § 03 — SIGNAL FIREWALL SCHEMATIC & AUTONOMY RULER (#architecture)
           ================================================================= -->
      <section class="a2-section" id="architecture">
        <div class="a2-wrap">
          <div class="a2-chapter">
            <div class="a2-chapter__rule">
              <span>§ 03 — TRUST &amp; AUTONOMY</span>
              <span>SAFE BY CONSTRUCTION</span>
            </div>
            <div class="a2-chapter__split">
              <h2 class="a2-h2">Agents propose intent. <span class="a2-serif-accent">You own the gate.</span></h2>
              <p class="a2-sec-sub">
                Remote agents never send executable code or raw DOM — every descriptor passes your
                registered host catalog first.
              </p>
            </div>

          </div>

          <!-- Architectural Signal Firewall Schematic (Zero Card Boxes, Zero Pills!) -->
          <div class="a2-schematic" role="img" aria-label="A2UI catalog firewall schematic showing allowlisted components mounting natively while scripts and inline styles are blocked at the host gate">
            <div class="a2-schematic__col">
              <span class="a2-sch-kicker">UNTRUSTED STREAM</span>
              <strong>Remote / Multi-Hop Agent</strong>
              <p>Flat JSON descriptors streamed over SSE, A2A, or MCP.</p>
            </div>

            <div class="a2-schematic__svg-wrap" aria-hidden="true">
              <svg viewBox="0 0 560 236" class="a2-sch-svg" fill="none">
                <!-- Center Catalog Gate -->
                <line x1="280" y1="12" x2="280" y2="224" stroke="var(--a2-accent)" stroke-width="2" />
                <rect x="226" y="4" width="108" height="22" fill="var(--a2-bg)" stroke="var(--a2-accent)" stroke-width="1" />
                <text x="280" y="18.5" text-anchor="middle" fill="var(--a2-accent)" font-family="var(--a2-font-mono)" font-size="9.5" font-weight="700" letter-spacing="1.2">CATALOG GATE</text>

                <!-- Allowed Signal 1 -->
                <line x1="12" y1="64" x2="548" y2="64" stroke="var(--a2-accent)" stroke-width="1.5" />
                <circle cx="280" cy="64" r="4" fill="var(--a2-accent)" />
                <text x="16" y="54" fill="var(--a2-text)" font-family="var(--a2-font-mono)" font-size="11">"ChoiceGroup"</text>
                <text x="544" y="54" text-anchor="end" fill="var(--a2-accent-strong)" font-family="var(--a2-font-mono)" font-size="11">✓ &lt;ChoiceGroup /&gt;</text>

                <!-- Allowed Signal 2 -->
                <line x1="12" y1="116" x2="548" y2="116" stroke="var(--a2-accent)" stroke-width="1.5" />
                <circle cx="280" cy="116" r="4" fill="var(--a2-accent)" />
                <text x="16" y="106" fill="var(--a2-text)" font-family="var(--a2-font-mono)" font-size="11">"AreaSeries"</text>
                <text x="544" y="106" text-anchor="end" fill="var(--a2-accent-strong)" font-family="var(--a2-font-mono)" font-size="11">✓ &lt;AreaSeries /&gt;</text>

                <!-- Blocked Signal 3 -->
                <line x1="12" y1="168" x2="274" y2="168" stroke="var(--a2-danger)" stroke-width="1.5" stroke-dasharray="4 3" />
                <line x1="274" y1="162" x2="286" y2="174" stroke="var(--a2-danger)" stroke-width="2" />
                <line x1="286" y1="162" x2="274" y2="174" stroke="var(--a2-danger)" stroke-width="2" />
                <text x="16" y="158" fill="var(--a2-text-muted)" font-family="var(--a2-font-mono)" font-size="11">&lt;script&gt;eval(...)&lt;/script&gt;</text>
                <text x="296" y="172" fill="var(--a2-danger)" font-family="var(--a2-font-mono)" font-size="10.5" font-weight="600">DROPPED · NOT IN SCHEMA</text>

                <!-- Blocked Signal 4 -->
                <line x1="12" y1="214" x2="274" y2="214" stroke="var(--a2-danger)" stroke-width="1.5" stroke-dasharray="4 3" />
                <line x1="274" y1="208" x2="286" y2="220" stroke="var(--a2-danger)" stroke-width="2" />
                <line x1="286" y1="208" x2="274" y2="220" stroke="var(--a2-danger)" stroke-width="2" />
                <text x="16" y="204" fill="var(--a2-text-muted)" font-family="var(--a2-font-mono)" font-size="11">style="position:fixed"</text>
                <text x="296" y="218" fill="var(--a2-danger)" font-family="var(--a2-font-mono)" font-size="10.5" font-weight="600">DROPPED · NO RAW CSS</text>
              </svg>
            </div>

            <div class="a2-schematic__col a2-schematic__col--right">
              <span class="a2-sch-kicker">HOST RUNTIME</span>
              <strong>Native Accessible Tree</strong>
              <p>Audited views with VoiceOver, keyboard focus, and local checks.</p>
            </div>
          </div>

          <!-- Open Horizontal Autonomy Ruler (#spectrum) -->
          <div class="a2-ruler-sec" id="spectrum">
            <div class="a2-ruler-sec__head">
              <div>
                <span class="a2-sch-kicker">PROGRESSIVE AUTONOMY DIAL</span>
                <h3 class="a2-h3">Choose how much creative latitude each workflow gets.</h3>
              </div>
              <a href={`${base}/concepts/catalogs/`} class="a2-mono-link">CATALOG ARCHITECTURE →</a>
            </div>

            <!-- Continuous 4-Stop Architectural Rail -->
            <div class="a2-rail" role="tablist" aria-label="Autonomy spectrum stops">
              <div class="a2-rail__line" aria-hidden="true"></div>

              <button type="button" role="tab" aria-selected="false" class="a2-stop" data-sp-idx="0">
                <span class="a2-stop__tick"></span>
                <span class="a2-stop__num">01</span>
                <strong>Locked Templates</strong>
              </button>

              <button type="button" role="tab" aria-selected="true" class="a2-stop is-active" data-sp-idx="1">
                <span class="a2-stop__tick"></span>
                <span class="a2-stop__num">02</span>
                <strong>Server @macros</strong>
              </button>

              <button type="button" role="tab" aria-selected="false" class="a2-stop" data-sp-idx="2">
                <span class="a2-stop__tick"></span>
                <span class="a2-stop__num">03</span>
                <strong>Composable Catalog</strong>
              </button>

              <button type="button" role="tab" aria-selected="false" class="a2-stop" data-sp-idx="3">
                <span class="a2-stop__tick"></span>
                <span class="a2-stop__num">04</span>
                <strong>MCP Sandboxes</strong>
              </button>
            </div>

            <div class="a2-ruler-readout">
              <div>
                <h4 class="a2-ruler-title" id="sp-title">
                  High-leverage domain cards with minimal token cost
                </h4>
                <p class="a2-ruler-desc" id="sp-desc">
                  The agent invokes a compact <code>@flightCard</code> or <code>@checkoutSummary</code> macro with 3–4 arguments. Your server expands it into a validated component tree in 0ms.
                </p>
                <div class="a2-ruler-uses" id="sp-examples">
                  BEST FOR: Boarding passes · Order summaries · Production approval gates
                </div>
              </div>

              <div class="a2-ruler-bars">
                <div class="a2-bar-item">
                  <div class="a2-bar-lbl">
                    <span>LAYOUT DETERMINISM</span>
                    <strong id="sp-det-val">90%</strong>
                  </div>
                  <div class="a2-bar-track">
                    <div class="a2-bar-fill a2-bar-fill--det" id="sp-det-bar" style="width: 90%"></div>
                  </div>
                </div>
                <div class="a2-bar-item">
                  <div class="a2-bar-lbl">
                    <span>GENERATIVE LATITUDE</span>
                    <strong id="sp-free-val">40%</strong>
                  </div>
                  <div class="a2-bar-track">
                    <div class="a2-bar-fill a2-bar-fill--free" id="sp-free-bar" style="width: 40%"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =================================================================
           § 04 — SWISS METRIC LEDGER & INTEGRATION FRAME (#why-a2ui)
           ================================================================= -->
      <section class="a2-section a2-section--alt" id="why-a2ui">
        <div class="a2-wrap">
          <!-- Hairline-Divided Swiss Typographic Figures (Zero Card Boxes!) -->
          <div class="a2-figures">
            <div class="a2-fig">
              <div class="a2-fig__num">0</div>
              <div class="a2-fig__cap">Arbitrary scripts or raw HTML injected by the model</div>
            </div>
            <div class="a2-fig">
              <div class="a2-fig__num">77%</div>
              <div class="a2-fig__cap">Smaller LLM token stream with A2UI Express shorthand</div>
            </div>
            <div class="a2-fig">
              <div class="a2-fig__num">0ms</div>
              <div class="a2-fig__cap">Client data-model bindings &amp; synchronous check rules</div>
            </div>
            <div class="a2-fig">
              <div class="a2-fig__num">6</div>
              <div class="a2-fig__cap">Native SDKs across React, Flutter, SwiftUI, Compose, Angular &amp; Lit</div>
            </div>
          </div>

          <div class="a2-dev-split">
            <div class="a2-dev-copy">
              <span class="a2-sch-kicker">§ 04 — DEVELOPER INTEGRATION</span>
              <h2 class="a2-h2">Wire up a catalog <span class="a2-serif-accent">in minutes.</span></h2>
              <p class="a2-sec-sub">
                Register the components already in your codebase, mount a surface, and stream
                A2UI Express or server <code>@macros</code>.
              </p>
              <div class="a2-dev-links">
                <a href={`${base}/guides/client-integration/`} class="a2-mono-link">CLIENT INTEGRATION →</a>
                <a href={`${base}/guides/agent-integration/`} class="a2-mono-link">AGENT GUIDE →</a>
              </div>
            </div>

            <div class="a2-code-frame">
              <span id="express" class="a2-anchor-pin" aria-hidden="true"></span>
              <span id="macros" class="a2-anchor-pin" aria-hidden="true"></span>

              <div class="a2-code-frame__tabs" role="tablist" aria-label="Integration code snippets">
                <button type="button" role="tab" aria-selected="true" class="a2-cf-tab is-active" data-cj-tab="mount">
                  01 / MOUNT
                </button>
                <button type="button" role="tab" aria-selected="false" class="a2-cf-tab" data-cj-tab="express">
                  02 / EXPRESS
                </button>
                <button type="button" role="tab" aria-selected="false" class="a2-cf-tab" data-cj-tab="macros">
                  03 / @MACROS
                </button>
              </div>

              <div class="a2-code-panel is-active" data-cj-panel="mount">
                <pre><code><span class="ck">import</span> &#123; A2UISurface, defineCatalog &#125; <span class="ck">from</span> <span class="cs">'@a2ui/react'</span>;

<span class="ck">const</span> catalog = <span class="cf">defineCatalog</span>(&#123;
  <span class="cc">BoardingPass</span>, <span class="cc">SeatPicker</span>, <span class="cc">RolloutGate</span>,
&#125;);

<span class="ck">export const</span> ChatTurn = (&#123; stream &#125;) =&gt; (
  &lt;<span class="cc">A2UISurface</span>
    catalog=&#123;catalog&#125;
    stream=&#123;stream&#125;
    onAction=&#123;sendToAgent&#125;
  /&gt;
);</code></pre>
              </div>

              <div class="a2-code-panel" data-cj-panel="express">
                <pre><code><span class="cm">// Compact shorthand — 77% fewer LLM tokens</span>
<span class="cf">surface</span>(<span class="cs">"rebook"</span>,
  <span class="cc">Card</span>(
    <span class="cc">FlightHeader</span>(&#123; flight: <span class="cs">"UA 428"</span>, route: <span class="cs">"SFO → JFK"</span> &#125;),
    <span class="cc">SeatPicker</span>(&#123; value: <span class="cf">path</span>(<span class="cs">"/seat"</span>) &#125;),
    <span class="cc">Button</span>(<span class="cs">"Confirm Change"</span>, &#123; action: <span class="cs">"rebook"</span> &#125;)
  )
)</code></pre>
              </div>

              <div class="a2-code-panel" data-cj-panel="macros">
                <pre><code><span class="cm">// Agent emits 4 lines; server expands in 0ms</span>
&#123;
  <span class="ck">"surfaceId"</span>: <span class="cs">"checkout"</span>,
  <span class="ck">"root"</span>: &#123;
    <span class="cc">"@orderCard"</span>: &#123; <span class="ck">"sku"</span>: <span class="cs">"M1-STUDIO"</span>, <span class="ck">"price"</span>: <span class="cn">349</span> &#125;
  &#125;
&#125;</code></pre>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =================================================================
           CLOSING ARCHITECTURAL BANNER
           ================================================================= -->
      <section class="a2-closing">
        <div class="a2-wrap">
          <div class="a2-closing__inner">
            <div>
              <span class="a2-sch-kicker">GET STARTED</span>
              <h2 class="a2-closing__title">
                Stop forcing human workflows through <span class="a2-serif-accent">plain text.</span>
              </h2>
            </div>

            <div class="a2-closing__btns">
              <a href={`${base}/quickstart/`} class="a2-btn a2-btn--primary">
                <span>Run the 5-Min Quickstart</span>
                <span aria-hidden="true">→</span>
              </a>
              <a href={`${base}/specification/v1.0-a2ui/`} class="a2-btn a2-btn--outline">
                Read v1.0 Specification
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="a2-footer">
      <div class="a2-wrap a2-footer__inner">
        <div class="a2-footer__brand">
          <strong>A2UI</strong>
          <span>/</span>
          <span>Apache 2.0 Open Source Project</span>
        </div>
        <nav class="a2-footer__links" aria-label="Footer links">
          <a href={`${base}/quickstart/`}>Quickstart</a>
          <a href={`${base}/concepts/overview/`}>Concepts</a>
          <a href={`${base}/renderers/`}>Renderers</a>
          <a href={`${base}/specification/v1.0-a2ui/`}>Specification</a>
          <a href="https://github.com/a2ui-project/a2ui" target="_blank" rel="noopener">GitHub</a>
          <a href="https://discord.gg/6fS2326966" target="_blank" rel="noopener">Discord</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (() => {
        /* Hero Copy Command */
        const copyBtn = document.getElementById('hero-copy-clone');
        const copyAct = document.getElementById('hero-copy-act');
        if (copyBtn && copyAct) {
          copyBtn.addEventListener('click', async () => {
            const cmd = copyBtn.getAttribute('data-copy') || '';
            try {
              await navigator.clipboard.writeText(cmd);
              copyAct.textContent = 'COPIED ✓';
              copyBtn.classList.add('is-copied');
              setTimeout(() => {
                copyAct.textContent = 'COPY';
                copyBtn.classList.remove('is-copied');
              }, 1800);
            } catch (e) {}
          });
        }

        /* Autonomy Ruler Stops */
        const bands = [
          {
            title: 'Zero layout surprises for regulated workflows',
            desc: 'Bind live agent data into pre-authored, pixel-locked UI templates. The agent populates values; the component hierarchy never mutates.',
            uses: 'BEST FOR: Wire transfers · Clinical orders · Identity verification',
            det: 100,
            free: 15,
          },
          {
            title: 'High-leverage domain cards with minimal token cost',
            desc: 'The agent invokes a compact @flightCard or @checkoutSummary macro with 3–4 arguments. Your server expands it into a validated component tree in 0ms.',
            uses: 'BEST FOR: Boarding passes · Order summaries · Production approval gates',
            det: 90,
            free: 40,
          },
          {
            title: 'Dynamic multi-component views assembled per prompt',
            desc: 'Let the model compose bespoke layouts from your allowlisted primitives — tabs, scrubbers, charts, choice grids, and validated forms.',
            uses: 'BEST FOR: Trip planners · Scenario simulators · Guided triage',
            det: 72,
            free: 82,
          },
          {
            title: 'Isolated interactive canvases alongside native views',
            desc: 'Mount sandboxed ui:// MCP Apps inside A2UI surfaces when a workflow calls for 3D WebGL configurators, vector maps, or custom shaders.',
            uses: 'BEST FOR: 3D CAD viewers · Geospatial maps · Live shader & data canvases',
            det: 55,
            free: 100,
          },
        ];

        const spTitle = document.getElementById('sp-title');
        const spDesc = document.getElementById('sp-desc');
        const spExamples = document.getElementById('sp-examples');
        const spDetVal = document.getElementById('sp-det-val');
        const spDetBar = document.getElementById('sp-det-bar');
        const spFreeVal = document.getElementById('sp-free-val');
        const spFreeBar = document.getElementById('sp-free-bar');

        document.querySelectorAll('[data-sp-idx]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const idx = Number(btn.getAttribute('data-sp-idx') || 1);
            const b = bands[idx];
            if (!b) return;
            document.querySelectorAll('[data-sp-idx]').forEach((el) => {
              const active = el === btn;
              el.classList.toggle('is-active', active);
              el.setAttribute('aria-selected', String(active));
            });
            if (spTitle) spTitle.textContent = b.title;
            if (spDesc) spDesc.textContent = b.desc;
            if (spExamples) spExamples.textContent = b.uses;
            if (spDetVal) spDetVal.textContent = `${b.det}%`;
            if (spDetBar) spDetBar.style.width = `${b.det}%`;
            if (spFreeVal) spFreeVal.textContent = `${b.free}%`;
            if (spFreeBar) spFreeBar.style.width = `${b.free}%`;
          });
        });

        /* Integration Code Tabs */
        const selectCodeTab = (key) => {
          document.querySelectorAll('[data-cj-tab]').forEach((t) => {
            const active = t.getAttribute('data-cj-tab') === key;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', String(active));
          });
          document.querySelectorAll('[data-cj-panel]').forEach((p) => {
            p.classList.toggle('is-active', p.getAttribute('data-cj-panel') === key);
          });
        };

        document.querySelectorAll('[data-cj-tab]').forEach((tab) => {
          tab.addEventListener('click', () => {
            selectCodeTab(tab.getAttribute('data-cj-tab') || 'mount');
          });
        });

        if (window.location.hash === '#express') selectCodeTab('express');
        if (window.location.hash === '#macros') selectCodeTab('macros');
      })();
