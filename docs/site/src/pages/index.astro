import '../styles/tokens.css';
import HeroChatGeneration from '../components/HeroChatGeneration.astro';
import HeroFormFactors from '../components/HeroFormFactors.astro';
import ProductionShowcase from '../components/ProductionShowcase.astro';
import RendererLogo from '../components/RendererLogo.astro';
import StarlightHeader from '../components/StarlightHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A2UI — Build delightful, fast, reliable agentic experiences</title>
    <meta
      name="description"
      content="An open-source generative UI framework with an agent-optimized streaming protocol, native web and mobile renderers, and multi-language agent SDKs."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/favicon.svg`} />
    <link
      rel="alternate"
      type="text/markdown"
      href={`${base}/llms.txt`}
      title="A2UI documentation index for LLMs"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved =
            localStorage.getItem('starlight-theme') || localStorage.getItem('a2ui-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body class="a2-page">
    <!-- Unified Sticky Navigation -->
    <header class="a2-topbar">
      <div class="a2-topbar__inner">
        <StarlightHeader />
      </div>
    </header>

    <main>
      <!-- =================================================================
           HERO: ARCHITECTURAL MASTHEAD + FREESTANDING ARTIFACT STAGE
           ================================================================= -->
      <section class="a2-hero" id="hero">
        <div class="a2-hero__grid-bg" aria-hidden="true"></div>

        <div class="a2-wrap">
          <div class="a2-masthead">
            <div class="a2-masthead__split">
              <div class="a2-masthead__copy">
                <h1 class="a2-h1 a2-h1--long">
                  Build delightful, fast, reliable<br>
                  <span class="a2-h-accent">agentic experiences.</span>
                </h1>

                <p class="a2-lead">
                  A2UI is a generative UI protocol that enables agents to
                  compose experiences tailored to each user's needs in real time.
                  Using an agent-optimized protocol and native framework renderers,
                  A2UI achieves low latency, predictability, and visual fidelity
                  across all screens.
                </p>

                <div class="a2-hero__actions">
                  <a href={`${base}/quickstart/`} class="a2-btn a2-btn--primary">
                    <span>Run in 5 Minutes</span>
                    <span aria-hidden="true">→</span>
                  </a>
                  <button
                    type="button"
                    class="a2-cmd-bar"
                    id="hero-copy-clone"
                    data-copy="npx skills add a2ui-project/a2ui"
                    aria-label="Copy command to install A2UI agent skills: npx skills add a2ui-project/a2ui"
                  >
                    <span class="a2-cmd-bar__sig" aria-hidden="true">$</span>
                    <span>npx skills add a2ui-project/a2ui</span>
                    <span class="a2-cmd-bar__act" id="hero-copy-act">COPY</span>
                  </button>
                </div>
              </div>

              <!-- One message, every form factor -->
              <div class="a2-masthead__visual">
                <HeroFormFactors />
              </div>
            </div>

            <!-- Renderer strip: the same stream renders natively in each of these -->
            <div class="a2-renderers">
              <span class="a2-renderers__lbl">RENDERS NATIVELY IN</span>
              <ul class="a2-renderers__list" aria-label="A2UI renderers">
                <li>
                  <a href="https://www.npmjs.com/package/@a2ui/react" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="react" size={20} /><span>React</span></a
                  >
                </li>
                <li>
                  <a href="https://www.npmjs.com/package/@a2ui/lit" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="lit" size={20} /><span>Lit</span></a
                  >
                </li>
                <li>
                  <a href="https://www.npmjs.com/package/@a2ui/angular" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="angular" size={20} /><span>Angular</span></a
                  >
                </li>
                <li>
                  <a href="https://pub.dev/packages/a2ui_flutter" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="flutter" size={20} /><span>Flutter</span></a
                  >
                </li>
                <li>
                  <a href="https://github.com/a2ui-project/a2ui/tree/main/swift/swiftui" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="swiftui" size={20} /><span>SwiftUI</span></a
                  >
                </li>
                <li>
                  <a href="https://developer.android.com/jetpack/androidx/releases/a2ui-compose" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="compose" size={20} /><span>Jetpack Compose</span></a
                  >
                </li>
                <li class="a2-renderers__more">
                  <a
                    href={`${base}/ecosystem/renderers/`}
                    title="Lynx, Svelte, Vue, Compose Multiplatform, Go TUI, and other community renderers"
                    ><span>and more community renderers</span><span aria-hidden="true">→</span></a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- =================================================================
           THE IDEA — INTERACTIVE STAGE (own section, alternate tone)
           ================================================================= -->
      <section class="a2-section a2-section--alt a2-section--stage" id="custom-ui">
        <span id="examples" class="a2-anchor-alias" aria-hidden="true"></span>
        <div class="a2-wrap">
          <div class="a2-chapter a2-chapter--stage">
            <div class="a2-chapter__stage-row">
              <h2 class="a2-h2">
                Custom UI for <span class="a2-h-accent">each user's intent.</span>
              </h2>
              <div class="a2-stage__actions">
                <a href={`${base}/build-with-a2ui/`} class="a2-btn a2-btn--primary">
                  <span>Build with A2UI</span>
                  <span aria-hidden="true">→</span>
                </a>
                <a
                  href="https://go.copilotkit.ai/a2ui-playground"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="a2-btn a2-btn--outline"
                >
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true" class="a2-ck-logo"><defs><linearGradient gradientUnits="userSpaceOnUse" id="home-ck-kite-0" x1="17.852" x2="14.202" y1="1.467" y2="11.504"><stop stop-color="#6430AB"/><stop offset="1" stop-color="#AA89D8"/></linearGradient><linearGradient gradientUnits="userSpaceOnUse" id="home-ck-kite-1" x1="15.024" x2="10.324" y1="7.125" y2="16.204"><stop stop-color="#005DBB"/><stop offset="1" stop-color="#3D92E8"/></linearGradient><linearGradient gradientUnits="userSpaceOnUse" id="home-ck-kite-2" x1="17.122" x2="15.707" y1="1.467" y2="5.892"><stop stop-color="#1B70C4"/><stop offset="1" stop-color="#54A4F2"/></linearGradient><linearGradient gradientUnits="userSpaceOnUse" id="home-ck-kite-3" x1="6.577" x2="21.506" y1="21.758" y2="21.758"><stop stop-color="#4497EA"/><stop offset=".255" stop-color="#1463B2"/><stop offset=".499" stop-color="#0A437D"/><stop offset=".667" stop-color="#2476C8"/><stop offset=".973" stop-color="#0C549A"/></linearGradient></defs><path d="M8.162 7.758c2.093-2.738 3.831-5.445 4.498-7.63a.093.093 0 01.14-.051c2.324 1.539 6.558 2.552 10.301 2.576a.09.09 0 01.085.124c-1.243 3.158-2.765 8.817-2.823 15.28-.001.095-.135.13-.183.046-2.131-3.729-8.955-8.968-11.982-10.205a.09.09 0 01-.036-.14z" fill="url(#home-ck-kite-0)"></path><path d="M15.223 6.083A61.492 61.492 0 018.25 7.827c-.045.008-.055.071-.012.089 3.05 1.267 9.84 6.492 11.952 10.206a.017.017 0 00.022.007.018.018 0 00.01-.024l-4.999-12.02z" fill="url(#home-ck-kite-1)"></path><path d="M12.81.07c2.8 1.528 6.037 2.214 10.33 2.575.028.002.036.039.012.051-.55.282-3.695 1.883-6.03 2.74-.626.23-1.256.443-1.876.64a.028.028 0 01-.033-.016L12.746.128c-.017-.04.027-.078.065-.058z" fill="url(#home-ck-kite-2)"></path><path d="M12.725.075c.046-.019.1.003.119.05l7.514 17.923a.091.091 0 01-.148.1l-.02-.03L12.675.195a.091.091 0 01.049-.12z" fill="#513C9F"></path><path d="M23.06 2.66c.044-.025.1-.01.125.034.025.044.009.1-.035.124v.001l-.008.004-.025.015-.1.054a41.384 41.384 0 01-1.811.92A47.05 47.05 0 0116.33 5.82c-1.954.674-3.97 1.197-5.497 1.552a66.27 66.27 0 01-2.38.507l-.138.026-.036.007h-.01l-.002.002a.091.091 0 11-.033-.18l.016.09-.015-.09h.002l.01-.002.035-.007.137-.025a66.16 66.16 0 002.373-.506c1.524-.354 3.533-.876 5.479-1.547a46.857 46.857 0 006.276-2.709c.166-.087.295-.156.381-.204l.099-.054.024-.014.008-.004z" fill="#513C9F"></path><path d="M13.838 2.272a.16.16 0 01.107.2l-2.72 9.055h6.4l.061.013a.16.16 0 010 .295l-.061.013h-6.541L.679 24.099l-.05.04a.16.16 0 01-.194-.245l10.43-12.285 2.773-9.23a.16.16 0 01.2-.107z" fill="#ABABAB"></path><path d="M7.809 21.461l-1.232.173c.638 1.69 1.949 2.427 3.514 2.427 3.831 0 2.661-4.334 4.883-4.334 1.61 0 .956 3.513 4.423 3.513 2.116 0 2.326-2.131 1.966-3.048l-.008-.016-.567-.868c-.037-.058-.127-.036-.133.032l-.106 1.053a1.01 1.01 0 00.003.219c.088.727.144 2.491-1.155 2.491-1.37 0-1.7-3.467-4.423-3.467-3.196 0-2.785 4.289-4.747 4.289-1.294 0-2.28-1.46-2.418-2.464z" fill="url(#home-ck-kite-3)"></path><defs><linearGradient gradientUnits="userSpaceOnUse" id="home-ck-kite-0" x1="17.852" x2="14.202" y1="1.467" y2="11.504"><stop stop-color="#6430AB"/><stop offset="1" stop-color="#AA89D8"/></linearGradient><linearGradient gradientUnits="userSpaceOnUse" id="home-ck-kite-1" x1="15.024" x2="10.324" y1="7.125" y2="16.204"><stop stop-color="#005DBB"/><stop offset="1" stop-color="#3D92E8"/></linearGradient><linearGradient gradientUnits="userSpaceOnUse" id="home-ck-kite-2" x1="17.122" x2="15.707" y1="1.467" y2="5.892"><stop stop-color="#1B70C4"/><stop offset="1" stop-color="#54A4F2"/></linearGradient><linearGradient gradientUnits="userSpaceOnUse" id="home-ck-kite-3" x1="6.577" x2="21.506" y1="21.758" y2="21.758"><stop stop-color="#4497EA"/><stop offset=".255" stop-color="#1463B2"/><stop offset=".499" stop-color="#0A437D"/><stop offset=".667" stop-color="#2476C8"/><stop offset=".973" stop-color="#0C549A"/></linearGradient></defs></svg>
                  <span>Playground</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Intent → Composed Screen Stage -->
          <div class="a2-hero__stage">
            <HeroChatGeneration />
          </div>
        </div>
      </section>

      <!-- =================================================================
           IN PRODUCTION — 1P & 3P BRANDS & PARTNER QUOTES
           ================================================================= -->
      <ProductionShowcase />

      <!-- =================================================================
           CLOSING ARCHITECTURAL BANNER
           ================================================================= -->
      <section class="a2-closing">
        <div class="a2-wrap">
          <div class="a2-closing__inner">
            <div class="a2-closing__copy">
              <h2 class="a2-closing__title">
                Stop building chatbots that render <span class="a2-closing__hi">walls of text.</span
                >
              </h2>

              <div class="a2-closing__btns">
                <a href={`${base}/quickstart/`} class="a2-btn a2-closing__primary">
                  <span>Run the 5-Min Quickstart</span>
                  <span aria-hidden="true">→</span>
                </a>
                <a href={`${base}/specification/v1.0-a2ui/`} class="a2-btn a2-closing__ghost">
                  Read v1.0 Specification
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="a2-footer">
      <div class="a2-wrap a2-footer__inner">
        <div class="a2-footer__brand">
          <strong>A2UI</strong>
          <span>/</span>
          <span>Apache 2.0 Open Source Project</span>
        </div>
        <nav class="a2-footer__links" aria-label="Footer links">
          <a href={`${base}/quickstart/`}>Quickstart</a>
          <a href={`${base}/build-with-a2ui/`}>Build with A2UI</a>
          <a href={`${base}/concepts/overview/`}>Concepts</a>
          <a href={`${base}/concepts/sdks/`}>SDKs</a>
          <a href={`${base}/specification/v1.0-a2ui/`}>Specification</a>
          <a href={`${base}/get-help/`}>Get Help</a>
          <a href={`${base}/llms.txt`}>llms.txt</a>
          <a href="https://github.com/a2ui-project/a2ui" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (() => {
        /* Hero Copy Command */
        const copyBtn = document.getElementById('hero-copy-clone');
        const copyAct = document.getElementById('hero-copy-act');
        if (copyBtn && copyAct) {
          copyBtn.addEventListener('click', async () => {
            const cmd = copyBtn.getAttribute('data-copy') || '';
            try {
              await navigator.clipboard.writeText(cmd);
              copyAct.textContent = 'COPIED ✓';
              copyBtn.classList.add('is-copied');
              setTimeout(() => {
                copyAct.textContent = 'COPY';
                copyBtn.classList.remove('is-copied');
              }, 1800);
            } catch (e) {}
          });
        }
      })();
    </script>

    <style>
      /* =======================================================================
     GLOBAL ARCHITECTURAL TOPOLOGY
     ======================================================================= */
      :global(*, *::before, *::after) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
        background: var(--a2-bg);
        color: var(--a2-text);
        font-family: var(--a2-font-sans);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .a2-page {
        margin: 0;
        background: var(--a2-bg);
        color: var(--a2-text);
        overflow-x: clip;
      }

      .a2-wrap {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 36px;
      }

      @media (max-width: 640px) {
        .a2-wrap {
          padding: 0 20px;
        }
      }

      /* Sticky Header */
      .a2-topbar {
        position: sticky;
        top: 0;
        z-index: 60;
        height: 64px;
        background: var(--a2-bg-nav);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--a2-border);
      }

      .a2-topbar__inner {
        max-width: 1280px;
        height: 100%;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* =======================================================================
     HERO: ASYMMETRIC EDITORIAL MASTHEAD (ZERO PILLS!)
     ======================================================================= */
      .a2-hero {
        position: relative;
        padding: 72px 0 72px;
        overflow: clip;
      }

      .a2-hero__grid-bg {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(to right, var(--a2-border-subtle) 1px, transparent 1px),
          linear-gradient(to bottom, var(--a2-border-subtle) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(ellipse 90% 60% at 50% 18%, #000 15%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 90% 60% at 50% 18%, #000 15%, transparent 75%);
        pointer-events: none;
      }

      .a2-masthead {
        position: relative;
        max-width: 100%;
        margin: 0 auto;
        padding-top: 24px;
      }

      .a2-masthead__split {
        display: grid;
        grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
        gap: 48px;
        align-items: center;
      }

      @media (max-width: 920px) {
        .a2-masthead__split {
          grid-template-columns: 1fr;
          gap: 48px;
        }
      }

      .a2-masthead__copy {
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      .a2-masthead__visual {
        min-width: 0;
      }

      .a2-h1 {
        margin: 0;
        font-family: var(--a2-font-display);
        font-size: clamp(2.85rem, 5.4vw, 4.55rem);
        font-weight: 700;
        line-height: 1.04;
        letter-spacing: var(--a2-tracking-display);
        color: var(--a2-text);
      }

      /* Headline emphasis: same face and weight, carried by colour only (no italics) */
      .a2-h-accent {
        color: var(--a2-heading-accent);
      }

      /* Longer headline beside the form-factor visual: the column sets the measure, so it holds 4 lines */
      .a2-h1--long {
        font-size: clamp(2.5rem, 3.9vw, 3.4rem);
        line-height: 1.06;
        max-width: none;
      }

      .a2-lead {
        margin: 0;
        padding-left: clamp(3px, 0.3vw, 4px);
        max-width: 52ch;
        font-size: 17px;
        line-height: 1.65;
        letter-spacing: var(--a2-tracking-body);
        color: var(--a2-text-secondary);
      }

      .a2-hero__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: 14px;
        padding-left: clamp(3px, 0.3vw, 4px);
      }

      /* Sharp Architectural Buttons (Zero Pill Rounding!) */
      .a2-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 44px;
        padding: 0 20px;
        border-radius: 3px;
        font-family: var(--a2-font-sans);
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .a2-btn--primary {
        background: var(--a2-cta-bg);
        color: var(--a2-cta-fg);
        border: 1px solid var(--a2-cta-bg);
      }

      .a2-btn--primary:hover {
        background: var(--a2-cta-hover);
        transform: translateY(-1px);
      }

      .a2-btn--outline {
        background: transparent;
        color: var(--a2-text);
        border: 1px solid var(--a2-border-strong);
      }

      .a2-btn--outline:hover {
        border-color: var(--a2-text);
      }

      .a2-cmd-bar {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 44px;
        padding: 0 14px;
        border-radius: 3px;
        border: 1px solid var(--a2-border-strong);
        background: var(--a2-surface);
        color: var(--a2-text);
        font-family: var(--a2-font-mono);
        font-size: 12.5px;
        cursor: pointer;
        transition: border-color 0.15s ease;
      }

      .a2-cmd-bar:hover {
        border-color: var(--a2-text);
      }

      .a2-cmd-bar.is-copied {
        border-color: var(--a2-success);
      }

      .a2-cmd-bar__sig {
        color: var(--a2-accent);
        user-select: none;
      }

      .a2-cmd-bar__act {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        padding-left: 10px;
        border-left: 1px solid var(--a2-border);
        color: var(--a2-text-muted);
      }

      .a2-cmd-bar.is-copied .a2-cmd-bar__act {
        color: var(--a2-success);
      }

      .a2-hero__stage {
        position: relative;
      }

      /* Renderer strip under the masthead (official targets) */
      .a2-renderers {
        display: flex;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;
        margin-top: 44px;
        margin-left: clamp(3px, 0.3vw, 4px);
        padding-top: 20px;
        border-top: 1px solid var(--a2-border);
      }

      .a2-renderers__lbl {
        font-family: var(--a2-font-mono);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--a2-text-muted);
        white-space: nowrap;
      }

      .a2-renderers__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px 0;
      }

      .a2-renderers__list li {
        display: flex;
        align-items: center;
      }

      .a2-renderers__list li + li::before {
        content: '';
        width: 1px;
        height: 16px;
        margin: 0 16px;
        background: var(--a2-border-strong);
      }

      .a2-renderers__list a {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--a2-text-secondary);
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 600;
        letter-spacing: -0.01em;
        transition: color 0.16s ease;
      }

      .a2-renderers__list a:hover {
        color: var(--a2-text);
      }

      .a2-renderers__list a:hover :global(.rmark) {
        color: var(--brand);
      }

      /* "and more…" rides in the same row as the official renderers (same divider, same type) */
      .a2-renderers__more a {
        gap: 7px;
        color: var(--a2-accent-strong);
        font-weight: 600;
      }

      .a2-renderers__more a:hover {
        color: var(--a2-accent);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      /* =======================================================================
     EDITORIAL CHAPTER HEADERS (TWO-COLUMN SWISS SPLIT)
     ======================================================================= */
      .a2-section {
        position: relative;
        padding: 128px 0 152px;
        border-top: 1px solid var(--a2-border-strong);
        scroll-margin-top: 72px;
      }

      .a2-section--alt {
        background: var(--a2-bg-alt);
      }

      /* The scroll stage keeps its own rhythm (sticky needs no overflow clipping here) */
      .a2-section--stage {
        padding: 112px 0 136px;
      }

      @media (max-width: 720px) {
        .a2-section {
          padding: 96px 0;
        }
      }

      .a2-chapter {
        margin-bottom: 88px;
      }

      .a2-anchor-alias {
        position: absolute;
        top: 0;
        left: 0;
        scroll-margin-top: 72px;
      }

      /* Header for the interactive stage — headline left, Build with A2UI/Playground CTAs right */
      .a2-chapter--stage {
        margin-bottom: 44px;
        scroll-margin-top: 84px;
      }

      .a2-chapter__stage-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px 32px;
      }

      .a2-stage__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
      }

      .a2-chapter__split {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 76px;
        align-items: end;
      }

      @media (max-width: 860px) {
        .a2-chapter__split {
          grid-template-columns: 1fr;
          gap: 14px;
        }
      }

      .a2-h2 {
        margin: 0;
        font-family: var(--a2-font-display);
        font-size: clamp(2.05rem, 3.6vw, 3rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: var(--a2-tracking-h2);
        color: var(--a2-text);
      }

      .a2-sec-sub {
        margin: 0;
        font-size: 16px;
        line-height: 1.62;
        color: var(--a2-text-secondary);
      }

      .a2-sec-sub code {
        font-family: var(--a2-font-mono);
        font-size: 13px;
        color: var(--a2-accent-strong);
      }

      /* =======================================================================
     CLOSING BANNER & MINIMAL FOOTER
     ======================================================================= */
      /* The closing is a full-bleed deep Google-blue field (Material blue 20 with a blue 50 sweep) —
     a bookend for the page in both themes */
      .a2-closing {
        position: relative;
        padding: 128px 0 136px;
        color: #ffffff;
        background-color: #062e6f;
        background-image:
          linear-gradient(135deg, rgba(27, 110, 243, 0.34), transparent 60%),
          radial-gradient(rgba(168, 199, 250, 0.22) 1px, transparent 1px);
        background-size:
          100% 100%,
          16px 16px;
        border-top: 1px solid rgba(168, 199, 250, 0.3);
      }

      .a2-closing__inner {
        display: flex;
        justify-content: center;
      }

      @media (max-width: 920px) {
        .a2-closing {
          padding: 96px 0 104px;
        }
      }

      /* Centred finale: headline on top, actions beneath, everything on one axis */
      .a2-closing__copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 40px;
      }

      .a2-closing__title {
        margin: 0;
        font-family: var(--a2-font-display);
        font-size: clamp(2.2rem, 4.4vw, 3.6rem);
        font-weight: 700;
        line-height: 1.06;
        letter-spacing: var(--a2-tracking-h2);
        max-width: 20ch;
        text-wrap: balance;
        color: #ffffff;
      }

      .a2-closing__hi {
        color: #a8c7fa;
        white-space: nowrap;
      }

      .a2-closing__btns {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
      }

      .a2-closing__primary {
        background: #ffffff;
        color: #062e6f;
        border: 1px solid #ffffff;
      }

      .a2-closing__primary:hover {
        background: #ffffff;
        transform: translateY(-1px);
      }

      .a2-closing__ghost {
        background: transparent;
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.4);
      }

      .a2-closing__ghost:hover {
        border-color: #ffffff;
      }

      .a2-footer {
        border-top: 1px solid var(--a2-border-strong);
        padding: 40px 0 56px;
      }

      .a2-footer__inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
      }

      .a2-footer__brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: var(--a2-text-muted);
      }

      .a2-footer__brand strong {
        color: var(--a2-text);
        font-weight: 650;
      }

      .a2-footer__links {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .a2-footer__links a {
        font-size: 13px;
        color: var(--a2-text-secondary);
        text-decoration: none;
      }

      .a2-footer__links a:hover {
        color: var(--a2-text);
      }
    </style>
  </body>
</html>
