import '../styles/tokens.css';
import CopilotKitLogo from '../components/CopilotKitLogo.astro';
import GenUiSpectrum from '../components/GenUiSpectrum.astro';
import HeroChatGeneration from '../components/HeroChatGeneration.astro';
import HeroFormFactors from '../components/HeroFormFactors.astro';
import RendererLogo from '../components/RendererLogo.astro';
import StarlightHeader from '../components/StarlightHeader.astro';
import TeamLogo from '../components/TeamLogo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A2UI — Build delightful, fast, reliable agentic experiences</title>
    <meta
      name="description"
      content="An open-source generative UI framework with an agent-optimized streaming protocol, native web and mobile renderers, and multi-language agent SDKs."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/favicon.svg`} />
    <link
      rel="alternate"
      type="text/markdown"
      href={`${base}/llms.txt`}
      title="A2UI documentation index for LLMs"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved =
            localStorage.getItem('starlight-theme') || localStorage.getItem('a2ui-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body class="a2-page">
    <!-- Unified Sticky Navigation -->
    <header class="a2-topbar">
      <div class="a2-topbar__inner">
        <StarlightHeader />
      </div>
    </header>

    <main>
      <!-- =================================================================
           HERO: ARCHITECTURAL MASTHEAD + FREESTANDING ARTIFACT STAGE
           ================================================================= -->
      <section class="a2-hero" id="hero">
        <div class="a2-hero__grid-bg" aria-hidden="true"></div>

        <div class="a2-wrap">
          <div class="a2-masthead">
            <div class="a2-masthead__split">
              <div class="a2-masthead__copy">
                <h1 class="a2-h1 a2-h1--long">
                  Build delightful, fast, reliable<br>
                  <span class="a2-h-accent">agentic experiences.</span>
                </h1>

                <p class="a2-lead">
                  A2UI is a generative UI protocol that enables agents to
                  compose experiences tailored to each user's needs in real time.
                  Using an agent-optimized protocol and native framework renderers,
                  A2UI achieves low latency, predictability, and visual fidelity
                  across all screens.
                </p>

                <div class="a2-hero__actions">
                  <a href={`${base}/quickstart/`} class="a2-btn a2-btn--primary">
                    <span>Run in 5 Minutes</span>
                    <span aria-hidden="true">→</span>
                  </a>
                  <a
                    href="https://go.copilotkit.ai/a2ui-playground"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="a2-btn a2-btn--outline"
                  >
                    <CopilotKitLogo idPrefix="hero-ck" />
                    <span>Playground</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                  <button
                    type="button"
                    class="a2-cmd-bar"
                    id="hero-copy-clone"
                    data-copy="npx skills add a2ui-project/a2ui"
                    aria-label="Copy command to install A2UI agent skills: npx skills add a2ui-project/a2ui"
                  >
                    <span class="a2-cmd-bar__sig" aria-hidden="true">$</span>
                    <span>npx skills add a2ui-project/a2ui</span>
                    <span class="a2-cmd-bar__act" id="hero-copy-act">COPY</span>
                  </button>
                </div>
              </div>

              <!-- One message, every form factor -->
              <div class="a2-masthead__visual">
                <HeroFormFactors />
              </div>
            </div>

            <!-- Team strip: products shipping A2UI, each linking to its story -->
            <div class="a2-renderers a2-renderers--teams">
              <span class="a2-renderers__lbl">SHIPPING IN</span>
              <ul class="a2-renderers__list" aria-label="Teams shipping A2UI">
                <li>
                  <a href={`${base}/built-with-a2ui/#alation`} title="Alation: Alation AIOS"
                    ><TeamLogo team="alation" size={18} idPrefix="hero-alation" /></a
                  >
                </li>
                <li>
                  <a href={`${base}/built-with-a2ui/#bytedance`} title="ByteDance: Lynx"
                    ><TeamLogo team="bytedance" size={18} idPrefix="hero-bytedance" /></a
                  >
                </li>
                <li>
                  <a href={`${base}/built-with-a2ui/#atlassian`} title="Atlassian: Jira"
                    ><TeamLogo team="atlassian" size={18} idPrefix="hero-atlassian" /></a
                  >
                </li>
                <li>
                  <a href={`${base}/built-with-a2ui/#gemini-enterprise`} title="Google Cloud: Gemini Enterprise"
                    ><TeamLogo team="google-cloud" size={18} idPrefix="hero-google-cloud" /></a
                  >
                </li>
                <li>
                  <a href={`${base}/built-with-a2ui/#gemini-notebook`} title="Gemini: Gemini Notebook"
                    ><TeamLogo team="gemini" size={18} idPrefix="hero-gemini" /></a
                  >
                </li>
                <li class="a2-renderers__more">
                  <a href={`${base}/built-with-a2ui/`}
                    ><span>See what they built</span><span aria-hidden="true">→</span></a
                  >
                </li>
              </ul>
            </div>

            <!-- Renderer strip: the same stream renders natively in each of these -->
            <div class="a2-renderers">
              <span class="a2-renderers__lbl">RENDERS NATIVELY IN</span>
              <ul class="a2-renderers__list" aria-label="A2UI renderers">
                <li>
                  <a href="https://www.npmjs.com/package/@a2ui/react" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="react" size={20} /><span>React</span></a
                  >
                </li>
                <li>
                  <a href="https://www.npmjs.com/package/@a2ui/lit" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="lit" size={20} /><span>Lit</span></a
                  >
                </li>
                <li>
                  <a href="https://www.npmjs.com/package/@a2ui/angular" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="angular" size={20} /><span>Angular</span></a
                  >
                </li>
                <li>
                  <a href="https://pub.dev/packages/a2ui_flutter" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="flutter" size={20} /><span>Flutter</span></a
                  >
                </li>
                <li>
                  <a href="https://github.com/a2ui-project/a2ui/tree/main/swift/swiftui" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="swiftui" size={20} /><span>SwiftUI</span></a
                  >
                </li>
                <li>
                  <a href="https://developer.android.com/jetpack/androidx/releases/a2ui-compose" target="_blank" rel="noopener noreferrer"
                    ><RendererLogo name="compose" size={20} /><span>Jetpack Compose</span></a
                  >
                </li>
                <li class="a2-renderers__more">
                  <a
                    href={`${base}/ecosystem/renderers/`}
                    title="Lynx, Svelte, Vue, Compose Multiplatform, Go TUI, and other community renderers"
                    ><span>and more community renderers</span><span aria-hidden="true">→</span></a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- =================================================================
           THE IDEA — INTERACTIVE STAGE (own section, alternate tone)
           ================================================================= -->
      <section class="a2-section a2-section--alt a2-section--stage" id="custom-ui">
        <span id="examples" class="a2-anchor-alias" aria-hidden="true"></span>
        <div class="a2-wrap">
          <div class="a2-chapter a2-chapter--stage">
            <div class="a2-chapter__stage-row">
              <h2 class="a2-h2">
                Custom UI for <span class="a2-h-accent">each user's intent.</span>
              </h2>
              <div class="a2-stage__actions">
                <a href={`${base}/built-with-a2ui/`} class="a2-btn a2-btn--primary">
                  <span>Built with A2UI</span>
                  <span aria-hidden="true">→</span>
                </a>
                <a
                  href="https://go.copilotkit.ai/a2ui-playground"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="a2-btn a2-btn--outline"
                >
                  <CopilotKitLogo idPrefix="stage-ck" />
                  <span>Playground</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Intent → Composed Screen Stage -->
          <div class="a2-hero__stage">
            <HeroChatGeneration />
          </div>
        </div>
      </section>

      <!-- =================================================================
           ARCHITECTURE — THE GENERATIVE UI SPECTRUM
           ================================================================= -->
      <GenUiSpectrum />

      <!-- =================================================================
           CLOSING ARCHITECTURAL BANNER
           ================================================================= -->
      <section class="a2-closing">
        <div class="a2-wrap">
          <div class="a2-closing__inner">
            <div class="a2-closing__copy">
              <h2 class="a2-closing__title">
                Stop building chatbots that render <span class="a2-closing__hi">walls of text.</span
                >
              </h2>

              <div class="a2-closing__btns">
                <a href={`${base}/quickstart/`} class="a2-btn a2-closing__primary">
                  <span>Run the 5-Min Quickstart</span>
                  <span aria-hidden="true">→</span>
                </a>
                <a href={`${base}/specification/v1.0-a2ui/`} class="a2-btn a2-closing__ghost">
                  Read v1.0 Specification
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="a2-footer">
      <div class="a2-wrap a2-footer__inner">
        <div class="a2-footer__brand">
          <strong>A2UI</strong>
          <span>/</span>
          <span>Apache 2.0 Open Source Project</span>
        </div>
        <nav class="a2-footer__links" aria-label="Footer links">
          <a href={`${base}/quickstart/`}>Quickstart</a>
          <a href={`${base}/built-with-a2ui/`}>Built with A2UI</a>
          <a href={`${base}/concepts/overview/`}>Concepts</a>
          <a href={`${base}/concepts/sdks/`}>SDKs</a>
          <a href={`${base}/specification/v1.0-a2ui/`}>Specification</a>
          <a href={`${base}/get-help/`}>Get Help</a>
          <a href={`${base}/llms.txt`}>llms.txt</a>
          <a href="https://github.com/a2ui-project/a2ui" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (() => {
        /* Hero Copy Command */
        const copyBtn = document.getElementById('hero-copy-clone');
        const copyAct = document.getElementById('hero-copy-act');
        if (copyBtn && copyAct) {
          copyBtn.addEventListener('click', async () => {
            const cmd = copyBtn.getAttribute('data-copy') || '';
            try {
              await navigator.clipboard.writeText(cmd);
              copyAct.textContent = 'COPIED ✓';
              copyBtn.classList.add('is-copied');
              setTimeout(() => {
                copyAct.textContent = 'COPY';
                copyBtn.classList.remove('is-copied');
              }, 1800);
            } catch (e) {}
          });
        }
      })();
    </script>

    <style>
      /* =======================================================================
     GLOBAL ARCHITECTURAL TOPOLOGY
     ======================================================================= */
      :global(*, *::before, *::after) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
        background: var(--a2-bg);
        color: var(--a2-text);
        font-family: var(--a2-font-sans);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .a2-page {
        margin: 0;
        background: var(--a2-bg);
        color: var(--a2-text);
        overflow-x: clip;
      }

      .a2-wrap {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 36px;
      }

      @media (max-width: 640px) {
        .a2-wrap {
          padding: 0 20px;
        }
      }

      /* Sticky Header */
      .a2-topbar {
        position: sticky;
        top: 0;
        z-index: 60;
        height: 64px;
        background: var(--a2-bg-nav);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--a2-border);
      }

      .a2-topbar__inner {
        max-width: 1280px;
        height: 100%;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* =======================================================================
     HERO: ASYMMETRIC EDITORIAL MASTHEAD (ZERO PILLS!)
     ======================================================================= */
      .a2-hero {
        position: relative;
        padding: 72px 0 72px;
        overflow: clip;
      }

      .a2-hero__grid-bg {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(to right, var(--a2-border-subtle) 1px, transparent 1px),
          linear-gradient(to bottom, var(--a2-border-subtle) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(ellipse 90% 60% at 50% 18%, #000 15%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 90% 60% at 50% 18%, #000 15%, transparent 75%);
        pointer-events: none;
      }

      .a2-masthead {
        position: relative;
        max-width: 100%;
        margin: 0 auto;
        padding-top: 24px;
      }

      .a2-masthead__split {
        display: grid;
        grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
        gap: 48px;
        align-items: center;
      }

      @media (max-width: 920px) {
        .a2-masthead__split {
          grid-template-columns: 1fr;
          gap: 48px;
        }
      }

      .a2-masthead__copy {
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      .a2-masthead__visual {
        min-width: 0;
      }

      .a2-h1 {
        margin: 0;
        font-family: var(--a2-font-display);
        font-size: clamp(2.85rem, 5.4vw, 4.55rem);
        font-weight: 700;
        line-height: 1.04;
        letter-spacing: var(--a2-tracking-display);
        color: var(--a2-text);
      }

      /* Headline emphasis: same face and weight, carried by colour only (no italics) */
      .a2-h-accent {
        color: var(--a2-heading-accent);
      }

      /* Longer headline beside the form-factor visual: the column sets the measure, so it holds 4 lines */
      .a2-h1--long {
        font-size: clamp(2.5rem, 3.9vw, 3.4rem);
        line-height: 1.06;
        max-width: none;
      }

      .a2-lead {
        margin: 0;
        padding-left: clamp(3px, 0.3vw, 4px);
        max-width: 52ch;
        font-size: 17px;
        line-height: 1.65;
        letter-spacing: var(--a2-tracking-body);
        color: var(--a2-text-secondary);
      }

      .a2-hero__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: 14px;
        padding-left: clamp(3px, 0.3vw, 4px);
      }

      /* Sharp Architectural Buttons (Zero Pill Rounding!) */
      .a2-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 44px;
        padding: 0 20px;
        border-radius: 3px;
        font-family: var(--a2-font-sans);
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .a2-btn--primary {
        background: var(--a2-cta-bg);
        color: var(--a2-cta-fg);
        border: 1px solid var(--a2-cta-bg);
      }

      .a2-btn--primary:hover {
        background: var(--a2-cta-hover);
        transform: translateY(-1px);
      }

      .a2-btn--outline {
        background: transparent;
        color: var(--a2-text);
        border: 1px solid var(--a2-border-strong);
      }

      .a2-btn--outline:hover {
        border-color: var(--a2-text);
      }

      .a2-cmd-bar {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 44px;
        padding: 0 14px;
        border-radius: 3px;
        border: 1px solid var(--a2-border-strong);
        background: var(--a2-surface);
        color: var(--a2-text);
        font-family: var(--a2-font-mono);
        font-size: 12.5px;
        cursor: pointer;
        transition: border-color 0.15s ease;
      }

      .a2-cmd-bar:hover {
        border-color: var(--a2-text);
      }

      .a2-cmd-bar.is-copied {
        border-color: var(--a2-success);
      }

      .a2-cmd-bar__sig {
        color: var(--a2-accent);
        user-select: none;
      }

      .a2-cmd-bar__act {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        padding-left: 10px;
        border-left: 1px solid var(--a2-border);
        color: var(--a2-text-muted);
      }

      .a2-cmd-bar.is-copied .a2-cmd-bar__act {
        color: var(--a2-success);
      }

      .a2-hero__stage {
        position: relative;
      }

      /* Renderer strip under the masthead (official targets) */
      .a2-renderers {
        display: flex;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;
        margin-top: 44px;
        margin-left: clamp(3px, 0.3vw, 4px);
        padding-top: 20px;
        border-top: 1px solid var(--a2-border);
      }

      /* The team strip sits directly above the renderer strip and shares its style */
      .a2-renderers--teams + .a2-renderers {
        margin-top: 0;
        padding-top: 14px;
        border-top: 0;
      }

      .a2-renderers--teams {
        padding-bottom: 14px;
        border-bottom: 1px dashed var(--a2-border);
      }

      .a2-renderers--teams .a2-renderers__list a :global(.team-logo__name) {
        font-weight: 600;
      }

      .a2-renderers--teams .a2-renderers__list a :global(.team-logo__wordmark) {
        height: 15px;
      }

      /* Logos stay muted like the renderer marks until hovered */
      .a2-renderers--teams .a2-renderers__list a :global(.team-logo__mark) {
        filter: grayscale(1);
        opacity: 0.75;
        transition:
          filter 0.15s ease,
          opacity 0.15s ease;
      }

      .a2-renderers--teams .a2-renderers__list a:hover :global(.team-logo__mark),
      .a2-renderers--teams .a2-renderers__list a:focus-visible :global(.team-logo__mark) {
        filter: none;
        opacity: 1;
      }

      /* Same label width in both strips so the two rows of logos line up */
      @media (min-width: 720px) {
        .a2-renderers__lbl {
          min-width: 9.5rem;
        }
      }

      .a2-renderers__lbl {
        font-family: var(--a2-font-mono);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--a2-text-muted);
        white-space: nowrap;
      }

      .a2-renderers__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px 0;
      }

      .a2-renderers__list li {
        display: flex;
        align-items: center;
      }

      .a2-renderers__list li + li::before {
        content: '';
        width: 1px;
        height: 16px;
        margin: 0 16px;
        background: var(--a2-border-strong);
      }

      .a2-renderers__list a {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--a2-text-secondary);
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 600;
        letter-spacing: -0.01em;
        transition: color 0.16s ease;
      }

      .a2-renderers__list a:hover {
        color: var(--a2-text);
      }

      .a2-renderers__list a:hover :global(.rmark) {
        color: var(--brand);
      }

      /* "and more…" rides in the same row as the official renderers (same divider, same type) */
      .a2-renderers__more a {
        gap: 7px;
        color: var(--a2-accent-strong);
        font-weight: 600;
      }

      .a2-renderers__more a:hover {
        color: var(--a2-accent);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      /* =======================================================================
     EDITORIAL CHAPTER HEADERS (TWO-COLUMN SWISS SPLIT)
     ======================================================================= */
      .a2-section {
        position: relative;
        padding: 128px 0 152px;
        border-top: 1px solid var(--a2-border-strong);
        scroll-margin-top: 72px;
      }

      .a2-section--alt {
        background: var(--a2-bg-alt);
      }

      /* The scroll stage keeps its own rhythm (sticky needs no overflow clipping here) */
      .a2-section--stage {
        padding: 112px 0 136px;
      }

      @media (max-width: 720px) {
        .a2-section {
          padding: 96px 0;
        }
      }

      .a2-chapter {
        margin-bottom: 88px;
      }

      .a2-anchor-alias {
        position: absolute;
        top: 0;
        left: 0;
        scroll-margin-top: 72px;
      }

      /* Header for the interactive stage — headline left, Built with A2UI/Playground CTAs right */
      .a2-chapter--stage {
        margin-bottom: 44px;
        scroll-margin-top: 84px;
      }

      .a2-chapter__stage-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px 32px;
      }

      .a2-stage__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
      }

      .a2-chapter__split {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 76px;
        align-items: end;
      }

      @media (max-width: 860px) {
        .a2-chapter__split {
          grid-template-columns: 1fr;
          gap: 14px;
        }
      }

      .a2-h2 {
        margin: 0;
        font-family: var(--a2-font-display);
