            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            try {
              localStorage.setItem('starlight-theme', next);
            } catch (_) {}
          });
        }

        const copyBtn = document.getElementById('a2-copy-prompt');
        if (copyBtn) {
          const placeholderPrompt = [
            'Integrate A2UI (the open Agent-to-UI protocol) into this application so our AI agent can stream stateful, native UI surfaces.',
            '',
            'Guidelines:',
            '- Always use the official A2UI Agent and Renderer SDKs (Python/TypeScript agent SDKs; Lit, React, Angular, Flutter, SwiftUI, or Jetpack Compose client renderers) rather than hand-rolling wire messages.',
            '- Consult the official A2UI documentation and specifications before writing code:',
            '  - Documentation & Quickstart: https://a2ui.org/quickstart/',
            '  - Protocol Specification (v1.0): https://a2ui.org/specification/v1.0-a2ui/',
            '  - LLM Context Reference: https://a2ui.org/llms.txt',
            '  - Official Repository & SDKs: https://github.com/a2ui-project/a2ui',
          ].join('\n');

          copyBtn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(placeholderPrompt);
              const originalText = copyBtn.textContent;
              copyBtn.textContent = '✓ Copied Agent Prompt!';
              setTimeout(() => {
                copyBtn.textContent = originalText;
              }, 2000);
            } catch (_) {}
          });
        }

        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            const searchLink = document.getElementById('a2-search-shortcut') || document.querySelector('.a2-search-pill');
            if (searchLink && searchLink.getAttribute('href')) {
              e.preventDefault();
              window.location.href = searchLink.getAttribute('href');
            }
          }
        });

        document.querySelectorAll('[role="tablist"]').forEach((tablist) => {
          tablist.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
            const idx = tabs.indexOf(document.activeElement);
            if (idx === -1) return;
            e.preventDefault();
            const nextIdx = e.key === 'ArrowRight' ? (idx + 1) % tabs.length : (idx - 1 + tabs.length) % tabs.length;
            tabs[nextIdx].focus();
            tabs[nextIdx].click();
          });
        });

        // 2. Travel Booking Interactive Surface
        const state = { outPax: 1, retPax: 2, premium: false, bags: true, booked: false };
        function renderTravel() {
          const outUnit = state.premium ? 455 + 280 : 455;
          const retUnit = state.premium ? 498 + 280 : 498;
          const outSub = outUnit * state.outPax;
          const retSub = retUnit * state.retPax;
          const total = outSub + retSub + (state.bags ? 65 : 0);

          document.getElementById('out-pax-label').textContent = state.outPax + (state.outPax === 1 ? ' Passenger' : ' Passengers');
          document.getElementById('ret-pax-label').textContent = state.retPax + (state.retPax === 1 ? ' Passenger' : ' Passengers');
          document.getElementById('out-price').textContent = '€' + outSub.toLocaleString();
          document.getElementById('ret-price').textContent = '€' + retSub.toLocaleString() + ' (€' + retUnit + ' × ' + state.retPax + ')';
          document.getElementById('travel-total').textContent = '€' + total.toLocaleString();
          document.getElementById('datamodel-code').textContent =
            `$/outbound/pax = ${state.outPax}  ·  $/return/pax = ${state.retPax}  ·  $/cabin = "${state.premium ? 'premium' : 'economy'}"  ·  $/totalEur = ${total}`;
        }

        document.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-action]');
          if (!btn) return;
          const act = btn.getAttribute('data-action');
          if (act === 'out-inc') state.outPax = Math.min(6, state.outPax + 1);
          if (act === 'out-dec') state.outPax = Math.max(1, state.outPax - 1);
          if (act === 'ret-inc') state.retPax = Math.min(6, state.retPax + 1);
          if (act === 'ret-dec') state.retPax = Math.max(1, state.retPax - 1);
          if (act === 'toggle-premium') {
            state.premium = !state.premium;
            btn.classList.toggle('is-active', state.premium);
          }
          if (act === 'toggle-bags') {
            state.bags = !state.bags;
            btn.classList.toggle('is-active', state.bags);
          }
          if (act === 'book-trip') {
            btn.textContent = '✓ Confirmed (actionResponse #A2UI-849)';
          }
          renderTravel();
        });

