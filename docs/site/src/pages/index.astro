        document.querySelectorAll('[data-plat]').forEach((tab) => {
          tab.addEventListener('click', () => {
            const key = tab.getAttribute('data-plat');
            const data = platforms[key];
            if (!data) return;
            document.querySelectorAll('[data-plat]').forEach((t) => {
              const active = t === tab;
              t.classList.toggle('is-active', active);
              t.setAttribute('aria-selected', String(active));
            });
            document.getElementById('plat-chrome-label').textContent = data.chrome;
            document.getElementById('plat-pkg-label').textContent = data.pkg;
            document.getElementById('plat-code-title').textContent = data.title;
            document.getElementById('plat-code-badge').textContent = data.badge;
            document.getElementById('plat-code-pre').textContent = data.code;
          });
        });
      })();
    </script>
