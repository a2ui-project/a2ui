import '../styles/tokens.css';
import StarlightHeader from '../components/StarlightHeader.astro';
import HeroChatGeneration from '../components/HeroChatGeneration.astro';
import RendererLogo from '../components/RendererLogo.astro';
import HeroFormFactors from '../components/HeroFormFactors.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A2UI — Give agents a way to build the screen each customer actually needs</title>
    <meta
      name="description"
      content="The open declarative UI protocol for AI agents. Agents compose native, per-customer screens from components you already approved — rendered in React, Lit, Angular, Flutter, SwiftUI, and Jetpack Compose."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved =
            localStorage.getItem('starlight-theme') || localStorage.getItem('a2ui-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body class="a2-page">
    <!-- Unified Sticky Navigation -->
    <header class="a2-topbar">
      <div class="a2-topbar__inner">
        <StarlightHeader />
      </div>
    </header>

    <main>
      <!-- =================================================================
           HERO: ARCHITECTURAL MASTHEAD + FREESTANDING ARTIFACT STAGE
           ================================================================= -->
      <section class="a2-hero" id="hero">
        <div class="a2-hero__grid-bg" aria-hidden="true"></div>

        <div class="a2-wrap">
          <div class="a2-masthead">
            <div class="a2-masthead__split">
              <div class="a2-masthead__copy">
                <h1 class="a2-h1 a2-h1--long">
                  Give agents a way to build the screen <span class="a2-h-accent"
                    >each customer actually&nbsp;needs.</span
                  >
                </h1>

                <p class="a2-lead">
                  Empower your agents to compose native, per-customer screens from components your
                  team already approved. Same app, a different composition for every person and
                  every intent.
                </p>

                <div class="a2-hero__actions">
                  <a href={`${base}/quickstart/`} class="a2-btn a2-btn--primary">
                    <span>Run in 5 Minutes</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>

              <!-- One message, every form factor -->
              <div class="a2-masthead__visual">
                <HeroFormFactors />
              </div>
            </div>

            <!-- Renderer strip: the same stream renders natively in each of these -->
            <div class="a2-renderers">
              <span class="a2-renderers__lbl">RENDERS NATIVELY IN</span>
              <ul class="a2-renderers__list" aria-label="Official A2UI renderers">
                <li>
                  <a href={`${base}/concepts/renderer-sdks/`}
                    ><RendererLogo name="react" size={20} /><span>React</span></a
                  >
                </li>
                <li>
                  <a href={`${base}/concepts/renderer-sdks/`}
                    ><RendererLogo name="lit" size={20} /><span>Lit</span></a
                  >
                </li>
                <li>
                  <a href={`${base}/concepts/renderer-sdks/`}
                    ><RendererLogo name="angular" size={20} /><span>Angular</span></a
                  >
                </li>
                <li>
                  <a href={`${base}/concepts/renderer-sdks/`}
                    ><RendererLogo name="flutter" size={20} /><span>Flutter</span></a
                  >
                </li>
                <li>
                  <a href={`${base}/concepts/renderer-sdks/`}
                    ><RendererLogo name="swiftui" size={20} /><span>SwiftUI</span></a
                  >
                </li>
                <li>
                  <a href={`${base}/concepts/renderer-sdks/`}
                    ><RendererLogo name="compose" size={20} /><span>Jetpack Compose</span></a
                  >
                </li>
              </ul>
              <a href={`${base}/ecosystem/renderers/`} class="a2-renderers__more"
                >+ Vue, Svelte, React Native &amp; more from the community →</a
              >
            </div>
          </div>
        </div>
      </section>

      <!-- =================================================================
           THE IDEA — SCROLL STAGE (own section, alternate tone)
           ================================================================= -->
      <section class="a2-section a2-section--alt a2-section--stage" id="custom-ui">
        <div class="a2-wrap">
          <div class="a2-chapter a2-chapter--stage">
            <div class="a2-chapter__split">
              <h2 class="a2-h2">
                Custom UI for <span class="a2-h-accent">each user’s intent.</span>
              </h2>
            </div>
          </div>

          <!-- Intent → Composed Screen Stage -->
          <div class="a2-hero__stage">
            <HeroChatGeneration />
          </div>
        </div>
      </section>

      <!-- =================================================================
           TRUST & AUTONOMY — SIGNAL FIREWALL SCHEMATIC & AUTONOMY RULER (#architecture)
           ================================================================= -->
      <section class="a2-section" id="architecture">
        <div class="a2-wrap">
          <div class="a2-chapter">
            <div class="a2-chapter__split">
              <h2 class="a2-h2">
                Agents propose intent. <span class="a2-h-accent">You own the gate.</span>
              </h2>
              <p class="a2-sec-sub">
                Remote agents never send executable code or raw DOM — every descriptor passes your
                registered host catalog first.
              </p>
            </div>
          </div>

          <!-- Architectural Signal Firewall Schematic (Zero Card Boxes, Zero Pills!) -->
          <div
            class="a2-schematic"
            role="img"
            aria-label="A2UI catalog firewall schematic showing allowlisted components mounting natively while scripts and inline styles are blocked at the host gate"
          >
            <div class="a2-schematic__col">
              <span class="a2-sch-kicker">UNTRUSTED STREAM</span>
              <strong>Remote / Multi-Hop Agent</strong>
              <p>Flat JSON descriptors streamed over SSE, A2A, or MCP.</p>
            </div>

            <div class="a2-schematic__svg-wrap" aria-hidden="true">
              <svg viewBox="0 0 560 236" class="a2-sch-svg" fill="none">
                <!-- Center Catalog Gate -->
                <line x1="280" y1="12" x2="280" y2="224" stroke="var(--a2-accent)" stroke-width="2"
                ></line>
                <rect
                  x="226"
                  y="4"
                  width="108"
                  height="22"
                  fill="var(--a2-bg)"
                  stroke="var(--a2-accent)"
                  stroke-width="1"></rect>
                <text
                  x="280"
                  y="18.5"
                  text-anchor="middle"
                  fill="var(--a2-accent)"
                  font-family="var(--a2-font-mono)"
                  font-size="9.5"
                  font-weight="700"
                  letter-spacing="1.2">CATALOG GATE</text
                >

                <!-- Allowed Signal 1 -->
                <line x1="12" y1="64" x2="548" y2="64" stroke="var(--a2-accent)" stroke-width="1.5"
                ></line>
                <circle cx="280" cy="64" r="4" fill="var(--a2-accent)"></circle>
                <text
                  x="16"
                  y="54"
                  fill="var(--a2-text)"
                  font-family="var(--a2-font-mono)"
                  font-size="11">"ChoiceGroup"</text
                >
                <text
                  x="544"
                  y="54"
                  text-anchor="end"
                  fill="var(--a2-accent-strong)"
                  font-family="var(--a2-font-mono)"
                  font-size="11">✓ &lt;ChoiceGroup /&gt;</text
                >

                <!-- Allowed Signal 2 -->
                <line
                  x1="12"
                  y1="116"
                  x2="548"
                  y2="116"
                  stroke="var(--a2-accent)"
                  stroke-width="1.5"></line>
                <circle cx="280" cy="116" r="4" fill="var(--a2-accent)"></circle>
                <text
                  x="16"
                  y="106"
                  fill="var(--a2-text)"
                  font-family="var(--a2-font-mono)"
                  font-size="11">"AreaSeries"</text
                >
                <text
                  x="544"
                  y="106"
                  text-anchor="end"
                  fill="var(--a2-accent-strong)"
                  font-family="var(--a2-font-mono)"
                  font-size="11">✓ &lt;AreaSeries /&gt;</text
                >

                <!-- Blocked Signal 3 -->
                <line
                  x1="12"
                  y1="168"
                  x2="274"
                  y2="168"
                  stroke="var(--a2-danger)"
                  stroke-width="1.5"
                  stroke-dasharray="4 3"></line>
                <line x1="274" y1="162" x2="286" y2="174" stroke="var(--a2-danger)" stroke-width="2"
                ></line>
                <line x1="286" y1="162" x2="274" y2="174" stroke="var(--a2-danger)" stroke-width="2"
                ></line>
                <text
                  x="16"
                  y="158"
                  fill="var(--a2-text-muted)"
                  font-family="var(--a2-font-mono)"
                  font-size="11">&lt;script&gt;eval(...)&lt;/script&gt;</text
                >
                <text
                  x="296"
                  y="172"
                  fill="var(--a2-danger)"
                  font-family="var(--a2-font-mono)"
                  font-size="10.5"
                  font-weight="600">DROPPED · NOT IN SCHEMA</text
                >

                <!-- Blocked Signal 4 -->
                <line
                  x1="12"
                  y1="214"
                  x2="274"
                  y2="214"
                  stroke="var(--a2-danger)"
                  stroke-width="1.5"
                  stroke-dasharray="4 3"></line>
                <line x1="274" y1="208" x2="286" y2="220" stroke="var(--a2-danger)" stroke-width="2"
                ></line>
                <line x1="286" y1="208" x2="274" y2="220" stroke="var(--a2-danger)" stroke-width="2"
                ></line>
                <text
                  x="16"
                  y="204"
                  fill="var(--a2-text-muted)"
                  font-family="var(--a2-font-mono)"
                  font-size="11">style="position:fixed"</text
                >
                <text
                  x="296"
                  y="218"
                  fill="var(--a2-danger)"
                  font-family="var(--a2-font-mono)"
                  font-size="10.5"
                  font-weight="600">DROPPED · NO RAW CSS</text
                >
              </svg>
            </div>

            <div class="a2-schematic__col a2-schematic__col--right">
              <span class="a2-sch-kicker">HOST RUNTIME</span>
              <strong>Native Accessible Tree</strong>
              <p>Audited views with VoiceOver, keyboard focus, and local checks.</p>
            </div>
          </div>

          <!-- Open Horizontal Autonomy Ruler (#spectrum) -->
          <div class="a2-ruler-sec" id="spectrum">
            <div class="a2-ruler-sec__head">
              <div>
                <span class="a2-sch-kicker">PROGRESSIVE AUTONOMY DIAL</span>
                <h3 class="a2-h3">Choose how much creative latitude each workflow gets.</h3>
              </div>
              <a href={`${base}/concepts/catalogs/`} class="a2-mono-link">CATALOG ARCHITECTURE →</a>
            </div>

            <!-- Continuous 4-Stop Architectural Rail -->
            <div class="a2-rail" role="tablist" aria-label="Autonomy spectrum stops">
              <div class="a2-rail__line" aria-hidden="true"></div>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                class="a2-stop"
                data-sp-idx="0"
              >
                <span class="a2-stop__tick"></span>
                <span class="a2-stop__num">01</span>
                <strong>Locked Templates</strong>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="true"
                class="a2-stop is-active"
                data-sp-idx="1"
              >
                <span class="a2-stop__tick"></span>
                <span class="a2-stop__num">02</span>
                <strong>Server @macros</strong>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                class="a2-stop"
                data-sp-idx="2"
              >
                <span class="a2-stop__tick"></span>
                <span class="a2-stop__num">03</span>
                <strong>Composable Catalog</strong>
              </button>

              <button
                type="button"
                role="tab"
                aria-selected="false"
                class="a2-stop"
                data-sp-idx="3"
              >
                <span class="a2-stop__tick"></span>
                <span class="a2-stop__num">04</span>
                <strong>MCP Sandboxes</strong>
              </button>
            </div>

            <div class="a2-ruler-readout">
              <div>
                <h4 class="a2-ruler-title" id="sp-title">
                  High-leverage domain cards with minimal token cost
                </h4>
                <p class="a2-ruler-desc" id="sp-desc">
                  The agent invokes a compact <code>@flightCard</code> or <code
                    >@checkoutSummary</code
                  > macro with 3–4 arguments. Your server expands it into a validated component tree in
                  0ms.
                </p>
                <div class="a2-ruler-uses" id="sp-examples">
                  BEST FOR: Boarding passes · Order summaries · Production approval gates
                </div>
              </div>

              <div class="a2-ruler-bars">
                <div class="a2-bar-item">
                  <div class="a2-bar-lbl">
                    <span>LAYOUT DETERMINISM</span>
                    <strong id="sp-det-val">90%</strong>
                  </div>
                  <div class="a2-bar-track">
                    <div class="a2-bar-fill a2-bar-fill--det" id="sp-det-bar" style="width: 90%">
                    </div>
                  </div>
                </div>
                <div class="a2-bar-item">
                  <div class="a2-bar-lbl">
                    <span>GENERATIVE LATITUDE</span>
                    <strong id="sp-free-val">40%</strong>
                  </div>
                  <div class="a2-bar-track">
                    <div class="a2-bar-fill a2-bar-fill--free" id="sp-free-bar" style="width: 40%">
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =================================================================
           CLOSING ARCHITECTURAL BANNER
           ================================================================= -->
      <section class="a2-closing">
        <div class="a2-wrap">
          <div class="a2-closing__inner">
            <div class="a2-closing__copy">
              <h2 class="a2-closing__title">
                Stop building chatbots that render <span class="a2-closing__hi">walls of text.</span
                >
              </h2>

              <div class="a2-closing__btns">
                <a href={`${base}/quickstart/`} class="a2-btn a2-closing__primary">
                  <span>Run the 5-Min Quickstart</span>
                  <span aria-hidden="true">→</span>
                </a>
                <a href={`${base}/specification/v1.0-a2ui/`} class="a2-btn a2-closing__ghost">
                  Read v1.0 Specification
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="a2-footer">
      <div class="a2-wrap a2-footer__inner">
        <div class="a2-footer__brand">
          <strong>A2UI</strong>
          <span>/</span>
          <span>Apache 2.0 Open Source Project</span>
        </div>
        <nav class="a2-footer__links" aria-label="Footer links">
          <a href={`${base}/quickstart/`}>Quickstart</a>
          <a href={`${base}/concepts/overview/`}>Concepts</a>
          <a href={`${base}/concepts/renderer-sdks/`}>Renderers</a>
          <a href={`${base}/specification/v1.0-a2ui/`}>Specification</a>
          <a href="https://github.com/a2ui-project/a2ui" target="_blank" rel="noopener">GitHub</a>
          <a href="https://discord.gg/6fS2326966" target="_blank" rel="noopener">Discord</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (() => {
        /* Hero Copy Command */
        const copyBtn = document.getElementById('hero-copy-clone');
        const copyAct = document.getElementById('hero-copy-act');
        if (copyBtn && copyAct) {
          copyBtn.addEventListener('click', async () => {
            const cmd = copyBtn.getAttribute('data-copy') || '';
            try {
              await navigator.clipboard.writeText(cmd);
              copyAct.textContent = 'COPIED ✓';
              copyBtn.classList.add('is-copied');
              setTimeout(() => {
                copyAct.textContent = 'COPY';
                copyBtn.classList.remove('is-copied');
              }, 1800);
            } catch (e) {}
          });
        }

        /* Autonomy Ruler Stops */
        const bands = [
          {
            title: 'Zero layout surprises for regulated workflows',
            desc: 'Bind live agent data into pre-authored, pixel-locked UI templates. The agent populates values; the component hierarchy never mutates.',
            uses: 'BEST FOR: Wire transfers · Clinical orders · Identity verification',
            det: 100,
            free: 15,
          },
          {
            title: 'High-leverage domain cards with minimal token cost',
            desc: 'The agent invokes a compact @flightCard or @checkoutSummary macro with 3–4 arguments. Your server expands it into a validated component tree in 0ms.',
            uses: 'BEST FOR: Boarding passes · Order summaries · Production approval gates',
            det: 90,
            free: 40,
          },
          {
            title: 'Dynamic multi-component views assembled per prompt',
            desc: 'Let the model compose bespoke layouts from your allowlisted primitives — tabs, scrubbers, charts, choice grids, and validated forms.',
            uses: 'BEST FOR: Trip planners · Scenario simulators · Guided triage',
            det: 72,
            free: 82,
          },
          {
            title: 'Isolated interactive canvases alongside native views',
            desc: 'Mount sandboxed ui:// MCP Apps inside A2UI surfaces when a workflow calls for 3D WebGL configurators, vector maps, or custom shaders.',
            uses: 'BEST FOR: 3D CAD viewers · Geospatial maps · Live shader & data canvases',
            det: 55,
            free: 100,
          },
        ];

        const spTitle = document.getElementById('sp-title');
        const spDesc = document.getElementById('sp-desc');
        const spExamples = document.getElementById('sp-examples');
        const spDetVal = document.getElementById('sp-det-val');
        const spDetBar = document.getElementById('sp-det-bar');
        const spFreeVal = document.getElementById('sp-free-val');
        const spFreeBar = document.getElementById('sp-free-bar');

        document.querySelectorAll('[data-sp-idx]').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = Number(btn.getAttribute('data-sp-idx') || 1);
            const b = bands[idx];
            if (!b) return;
            document.querySelectorAll('[data-sp-idx]').forEach(el => {
              const active = el === btn;
              el.classList.toggle('is-active', active);
              el.setAttribute('aria-selected', String(active));
            });
            if (spTitle) spTitle.textContent = b.title;
            if (spDesc) spDesc.textContent = b.desc;
            if (spExamples) spExamples.textContent = b.uses;
            if (spDetVal) spDetVal.textContent = `${b.det}%`;
            if (spDetBar) spDetBar.style.width = `${b.det}%`;
            if (spFreeVal) spFreeVal.textContent = `${b.free}%`;
            if (spFreeBar) spFreeBar.style.width = `${b.free}%`;
          });
        });
      })();
    </script>

    <style>
      /* =======================================================================
     GLOBAL ARCHITECTURAL TOPOLOGY
     ======================================================================= */
      :global(*, *::before, *::after) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
        background: var(--a2-bg);
        color: var(--a2-text);
        font-family: var(--a2-font-sans);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .a2-page {
        margin: 0;
        background: var(--a2-bg);
        color: var(--a2-text);
        overflow-x: clip;
      }

      .a2-wrap {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 36px;
      }

      @media (max-width: 640px) {
        .a2-wrap {
          padding: 0 20px;
        }
      }

      /* Sticky Header */
      .a2-topbar {
        position: sticky;
        top: 0;
        z-index: 60;
        height: 64px;
        background: var(--a2-bg-nav);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--a2-border);
      }

      .a2-topbar__inner {
        max-width: 1280px;
        height: 100%;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* =======================================================================
     HERO: ASYMMETRIC EDITORIAL MASTHEAD (ZERO PILLS!)
     ======================================================================= */
      .a2-hero {
        position: relative;
        padding: 72px 0 72px;
        overflow: clip;
      }

      .a2-hero__grid-bg {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(to right, var(--a2-border-subtle) 1px, transparent 1px),
          linear-gradient(to bottom, var(--a2-border-subtle) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(ellipse 90% 60% at 50% 18%, #000 15%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 90% 60% at 50% 18%, #000 15%, transparent 75%);
        pointer-events: none;
      }

      .a2-masthead {
        position: relative;
        max-width: 100%;
        margin: 0 auto;
        padding-top: 24px;
      }

      .a2-masthead__split {
        display: grid;
        grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
        gap: 48px;
        align-items: center;
      }

      @media (max-width: 920px) {
        .a2-masthead__split {
          grid-template-columns: 1fr;
          gap: 48px;
        }
      }

      .a2-masthead__copy {
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      .a2-masthead__visual {
        min-width: 0;
      }

      .a2-h1 {
        margin: 0;
        font-family: var(--a2-font-display);
        font-size: clamp(2.85rem, 5.4vw, 4.55rem);
        font-weight: 700;
        line-height: 1.04;
        letter-spacing: var(--a2-tracking-display);
        color: var(--a2-text);
      }

      /* Headline emphasis: same face and weight, carried by colour only (no italics) */
      .a2-h-accent {
        color: var(--a2-heading-accent);
      }

      /* Longer headline beside the form-factor visual: the column sets the measure, so it holds 4 lines */
      .a2-h1--long {
        font-size: clamp(2.5rem, 3.9vw, 3.4rem);
        line-height: 1.06;
        max-width: none;
      }

      .a2-lead {
        margin: 0;
        max-width: 52ch;
        font-size: 17px;
        line-height: 1.65;
        letter-spacing: var(--a2-tracking-body);
        color: var(--a2-text-secondary);
      }

      .a2-hero__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: 14px;
      }

      /* Sharp Architectural Buttons (Zero Pill Rounding!) */
      .a2-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 44px;
        padding: 0 20px;
        border-radius: 3px;
        font-family: var(--a2-font-sans);
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .a2-btn--primary {
        background: var(--a2-cta-bg);
        color: var(--a2-cta-fg);
        border: 1px solid var(--a2-cta-bg);
      }

      .a2-btn--primary:hover {
        background: var(--a2-cta-hover);
        transform: translateY(-1px);
      }

      .a2-btn--outline {
        background: transparent;
        color: var(--a2-text);
        border: 1px solid var(--a2-border-strong);
      }

      .a2-btn--outline:hover {
        border-color: var(--a2-text);
      }

      .a2-cmd-bar {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 44px;
        padding: 0 14px;
        border-radius: 3px;
        border: 1px solid var(--a2-border-strong);
        background: var(--a2-surface);
        color: var(--a2-text);
        font-family: var(--a2-font-mono);
        font-size: 12.5px;
        cursor: pointer;
        transition: border-color 0.15s ease;
      }

      .a2-cmd-bar:hover {
        border-color: var(--a2-text);
      }

      .a2-cmd-bar.is-copied {
        border-color: var(--a2-success);
      }

      .a2-cmd-bar__sig {
        color: var(--a2-accent);
        user-select: none;
      }

      .a2-cmd-bar__act {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        padding-left: 10px;
        border-left: 1px solid var(--a2-border);
        color: var(--a2-text-muted);
      }

      .a2-cmd-bar.is-copied .a2-cmd-bar__act {
        color: var(--a2-success);
      }

      .a2-hero__stage {
        position: relative;
      }

      /* Renderer strip under the masthead (official targets) */
      .a2-renderers {
        display: flex;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;
        margin-top: 44px;
        padding-top: 20px;
        border-top: 1px solid var(--a2-border);
      }

      .a2-renderers__lbl {
        font-family: var(--a2-font-mono);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--a2-text-muted);
        white-space: nowrap;
      }

      .a2-renderers__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px 0;
      }

      .a2-renderers__list li {
        display: flex;
        align-items: center;
      }

      .a2-renderers__list li + li::before {
        content: '';
        width: 1px;
        height: 16px;
        margin: 0 16px;
        background: var(--a2-border-strong);
      }

      .a2-renderers__list a {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--a2-text-secondary);
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 600;
        letter-spacing: -0.01em;
        transition: color 0.16s ease;
      }

      .a2-renderers__list a:hover {
        color: var(--a2-text);
      }

      .a2-renderers__list a:hover :global(.rmark) {
        color: var(--brand);
      }

      .a2-renderers__more {
        margin-left: auto;
        font-family: var(--a2-font-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--a2-accent-strong);
        text-decoration: none;
        white-space: nowrap;
      }

      .a2-renderers__more:hover {
        text-decoration: underline;
      }

      @media (max-width: 920px) {
        .a2-renderers__more {
          margin-left: 0;
          white-space: normal;
          line-height: 1.6;
        }
      }

      /* =======================================================================
     EDITORIAL CHAPTER HEADERS (TWO-COLUMN SWISS SPLIT)
     ======================================================================= */
      .a2-section {
        position: relative;
        padding: 128px 0 152px;
        border-top: 1px solid var(--a2-border-strong);
        scroll-margin-top: 72px;
      }

      .a2-section--alt {
        background: var(--a2-bg-alt);
      }

      .a2-section--alt + .a2-section {
        border-top-color: var(--a2-border-strong);
      }

      /* The scroll stage keeps its own rhythm (sticky needs no overflow clipping here) */
      .a2-section--stage {
        padding: 112px 0 136px;
      }

      @media (max-width: 720px) {
        .a2-section {
          padding: 96px 0;
        }
      }

      .a2-chapter {
        margin-bottom: 88px;
      }

      /* Header for the scroll stage — tighter than a full chapter (no rule row above any chapter now) */
      .a2-chapter--stage {
        margin-bottom: 40px;
        scroll-margin-top: 84px;
      }

      .a2-chapter__split {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 76px;
        align-items: end;
      }

      @media (max-width: 860px) {
        .a2-chapter__split {
          grid-template-columns: 1fr;
          gap: 14px;
        }
      }

      .a2-h2 {
        margin: 0;
        font-family: var(--a2-font-display);
        font-size: clamp(2.05rem, 3.6vw, 3rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: var(--a2-tracking-h2);
        color: var(--a2-text);
      }

      .a2-h3 {
        margin: 4px 0 0;
        font-family: var(--a2-font-display);
        font-size: clamp(1.35rem, 2.2vw, 1.75rem);
        font-weight: 620;
        line-height: 1.2;
        letter-spacing: var(--a2-tracking-h3);
      }

      .a2-sec-sub {
        margin: 0;
        font-size: 16px;
        line-height: 1.62;
        color: var(--a2-text-secondary);
      }

      .a2-sec-sub code {
        font-family: var(--a2-font-mono);
        font-size: 13px;
        color: var(--a2-accent-strong);
      }

      .a2-sch-kicker {
        display: block;
        font-family: var(--a2-font-mono);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--a2-accent);
        margin-bottom: 6px;
      }

      .a2-mono-link {
        font-family: var(--a2-font-mono);
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--a2-text);
        text-decoration: none;
        border-bottom: 1px solid var(--a2-border-strong);
        padding-bottom: 3px;
        transition:
          border-color 0.15s ease,
          color 0.15s ease;
      }

      .a2-mono-link:hover {
        color: var(--a2-accent-strong);
        border-bottom-color: var(--a2-accent-strong);
      }

      /* =======================================================================
     TRUST & AUTONOMY — SIGNAL FIREWALL SCHEMATIC + HORIZONTAL AUTONOMY RULER
     ======================================================================= */
      .a2-schematic {
        display: grid;
        grid-template-columns: 230px 1fr 230px;
        gap: 52px;
        align-items: center;
        padding: 64px 0;
        border-top: 1px solid var(--a2-border);
        border-bottom: 1px solid var(--a2-border);
        margin-bottom: 128px;
      }

      @media (max-width: 960px) {
        .a2-schematic {
          grid-template-columns: 1fr;
        }
        .a2-schematic__col--right {
          text-align: left !important;
        }
      }

      .a2-schematic__col strong {
        display: block;
        font-size: 16px;
        margin-bottom: 6px;
      }

      .a2-schematic__col p {
        margin: 0;
        font-size: 13.5px;
        line-height: 1.55;
        color: var(--a2-text-secondary);
      }

      .a2-schematic__col--right {
        text-align: right;
      }

      .a2-sch-svg {
        width: 100%;
        height: auto;
        display: block;
      }

      /* Autonomy Ruler */
      .a2-ruler-sec {
        scroll-margin-top: 84px;
      }

      .a2-ruler-sec__head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 24px;
        margin-bottom: 52px;
      }

      .a2-rail {
        position: relative;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin-bottom: 52px;
      }

      .a2-rail__line {
        position: absolute;
        top: 7px;
        left: 0;
        right: 0;
        height: 1px;
        background: var(--a2-border-strong);
      }

      @media (max-width: 760px) {
        .a2-rail {
          grid-template-columns: repeat(2, 1fr);
          gap: 16px;
        }
        .a2-rail__line {
          display: none;
        }
      }

      .a2-stop {
        appearance: none;
        position: relative;
        border: none;
        background: transparent;
        padding: 0 12px 0 0;
        text-align: left;
        color: var(--a2-text-muted);
        font-family: inherit;
        cursor: pointer;
        transition: color 0.16s ease;
      }

      .a2-stop:hover {
        color: var(--a2-text);
      }

      .a2-stop__tick {
        display: block;
        width: 14px;
        height: 14px;
        background: var(--a2-bg);
        border: 2px solid var(--a2-border-strong);
        margin-bottom: 12px;
        transition: all 0.18s ease;
      }

      .a2-stop.is-active {
        color: var(--a2-text);
      }

      .a2-stop.is-active .a2-stop__tick {
        background: var(--a2-accent);
        border-color: var(--a2-accent);
        transform: scale(1.15);
      }

      .a2-stop__num {
        display: block;
        font-family: var(--a2-font-mono);
        font-size: 10.5px;
        color: var(--a2-accent);
        margin-bottom: 3px;
      }

      .a2-stop strong {
        font-size: 14.5px;
        font-weight: 600;
      }

      .a2-ruler-readout {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 72px;
        align-items: center;
        padding-top: 40px;
        border-top: 1px solid var(--a2-border);
      }

      @media (max-width: 820px) {
        .a2-ruler-readout {
          grid-template-columns: 1fr;
          gap: 24px;
        }
      }

      .a2-ruler-title {
        margin: 0 0 8px;
        font-size: 19px;
        font-weight: 620;
        letter-spacing: -0.02em;
      }

      .a2-ruler-desc {
        margin: 0 0 14px;
        font-size: 14.5px;
        line-height: 1.6;
        color: var(--a2-text-secondary);
      }

      .a2-ruler-desc code {
        font-family: var(--a2-font-mono);
        font-size: 12.5px;
        color: var(--a2-accent-strong);
      }

      .a2-ruler-uses {
        font-family: var(--a2-font-mono);
        font-size: 11px;
        letter-spacing: 0.04em;
        color: var(--a2-text-muted);
      }

      .a2-ruler-bars {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .a2-bar-lbl {
        display: flex;
        justify-content: space-between;
        font-family: var(--a2-font-mono);
        font-size: 10.5px;
        letter-spacing: 0.06em;
        color: var(--a2-text-muted);
        margin-bottom: 6px;
      }

      .a2-bar-lbl strong {
        color: var(--a2-text);
      }

      .a2-bar-track {
        height: 6px;
        background: var(--a2-border-strong);
      }

      .a2-bar-fill {
        height: 100%;
        transition: width 0.28s cubic-bezier(0.2, 0.9, 0.3, 1);
      }
      .a2-bar-fill--det {
        background: var(--a2-accent);
      }
      .a2-bar-fill--free {
        background: var(--a2-blue);
      }

      /* =======================================================================
     CLOSING BANNER & MINIMAL FOOTER
     ======================================================================= */
      /* The closing is a full-bleed field in the same deep-teal material as the demo stage —
     a bookend for the page in both themes */
      .a2-closing {
        position: relative;
        padding: 128px 0 136px;
        color: #f8fafc;
        background-color: #0a2c2a;
        background-image:
          linear-gradient(135deg, rgba(20, 184, 166, 0.22), transparent 58%),
          radial-gradient(rgba(45, 212, 191, 0.26) 1px, transparent 1px);
        background-size:
          100% 100%,
          16px 16px;
        border-top: 1px solid rgba(45, 212, 191, 0.3);
      }

      .a2-closing__inner {
        display: flex;
        justify-content: center;
      }

      @media (max-width: 920px) {
        .a2-closing {
          padding: 96px 0 104px;
        }
      }

      /* Centred finale: headline on top, actions beneath, everything on one axis */
      .a2-closing__copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 40px;
      }

      .a2-closing__title {
        margin: 0;
        font-family: var(--a2-font-display);
        font-size: clamp(2.2rem, 4.4vw, 3.6rem);
        font-weight: 700;
        line-height: 1.06;
        letter-spacing: var(--a2-tracking-h2);
        max-width: 20ch;
        text-wrap: balance;
        color: #f8fafc;
      }

      .a2-closing__hi {
        color: #2dd4bf;
        white-space: nowrap;
      }

      .a2-closing__btns {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
      }

      .a2-closing__primary {
        background: #f8fafc;
        color: #071a19;
        border: 1px solid #f8fafc;
      }

      .a2-closing__primary:hover {
        background: #ffffff;
        transform: translateY(-1px);
      }

      .a2-closing__ghost {
        background: transparent;
        color: #f8fafc;
        border: 1px solid rgba(248, 250, 252, 0.38);
      }

      .a2-closing__ghost:hover {
        border-color: #f8fafc;
      }

      .a2-footer {
        border-top: 1px solid var(--a2-border-strong);
        padding: 40px 0 56px;
      }

      .a2-footer__inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
      }

      .a2-footer__brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: var(--a2-text-muted);
      }

      .a2-footer__brand strong {
        color: var(--a2-text);
        font-weight: 650;
      }

      .a2-footer__links {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .a2-footer__links a {
        font-size: 13px;
        color: var(--a2-text-secondary);
        text-decoration: none;
      }

      .a2-footer__links a:hover {
        color: var(--a2-text);
      }
    </style>
  </body>
</html>
