                    <div class="a2-code-window" style="margin-bottom: 12px;">
                      <pre class="a2-code-pre"><code><span class="a2-tok-kw">@macro</span>(description=<span class="a2-tok-str">"Flight status card"</span>)
<span class="a2-tok-kw">def</span> <span class="a2-tok-comp">flight_card</span>(
  flight: str, date: str, origin: str,
  dest: str, departs: str,
  arrives: str, status: str
) -&gt; Card:
  <span class="a2-tok-kw">return</span> <span class="a2-tok-comp">Card</span>(<span class="a2-tok-comp">Column</span>([
    <span class="a2-tok-comp">Row</span>([<span class="a2-tok-comp">Icon</span>(<span class="a2-tok-str">"send"</span>), <span class="a2-tok-comp">Text</span>(flight)]),
    <span class="a2-tok-comp">Row</span>([<span class="a2-tok-comp">Text</span>(origin), <span class="a2-tok-comp">Text</span>(<span class="a2-tok-str">"→"</span>), <span class="a2-tok-comp">Text</span>(dest)]),
    <span class="a2-tok-comp">Divider</span>(),
    <span class="a2-tok-comp">Row</span>([<span class="a2-tok-comp">Text</span>(departs), <span class="a2-tok-comp">Text</span>(status)]),
  ]))</code></pre>
