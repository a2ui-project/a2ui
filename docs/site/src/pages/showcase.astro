        font-size: 11.5px;
        line-height: 1.45;
        color: var(--a2-text-muted);
      }

      .s-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 12px 18px;
        background: var(--a2-surface-subtle);
        border-top: 1px solid var(--a2-border);
      }

      .s-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
      }

      .s-text-link {
        font-size: 13px;
        font-weight: 600;
        color: var(--a2-accent);
        text-decoration: none;
      }

      .s-text-link:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .s-card__cta {
        height: 34px;
        padding: 0 13px;
        font-size: 12.5px;
        gap: 7px;
        background: var(--a2-surface);
      }

      .s-notes {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 40px;
        margin-top: 52px;
        padding-top: 36px;
        border-top: 1px solid var(--a2-border);
      }

      @media (max-width: 760px) {
        .s-notes {
          grid-template-columns: 1fr;
          gap: 24px;
          margin-top: 40px;
          padding-top: 28px;
        }
      }

      .s-notes__heading {
        margin: 0 0 8px;
        font-family: var(--a2-font-display);
        font-size: 17px;
        font-weight: 700;
        letter-spacing: var(--a2-tracking-h3);
        color: var(--a2-text);
      }

      .s-notes p {
        margin: 0;
        font-size: 14px;
        line-height: 1.62;
        color: var(--a2-text-secondary);
      }

      .s-notes a {
        color: var(--a2-accent);
        font-weight: 600;
        text-decoration: none;
      }

      .s-notes a:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .a2-footer {
        border-top: 1px solid var(--a2-border-strong);
        padding: 40px 0 56px;
      }

      .a2-footer__inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
      }

      .a2-footer__brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: var(--a2-text-muted);
      }

      .a2-footer__brand strong {
        color: var(--a2-text);
        font-weight: 650;
      }

      .a2-footer__links {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .a2-footer__links a {
        font-size: 13px;
        color: var(--a2-text-secondary);
        text-decoration: none;
      }

      .a2-footer__links a:hover {
        color: var(--a2-text);
      }

      .s-lightbox {
        width: min(1040px, calc(100vw - 32px));
        max-height: calc(100vh - 32px);
        margin: auto;
        padding: 0;
        border: 1px solid var(--a2-border-strong);
        border-radius: var(--a2-radius-sm);
        background: var(--a2-surface);
        color: var(--a2-text);
        box-shadow: var(--a2-shadow-lg);
        overflow: hidden;
      }

      .s-lightbox[open] {
        display: flex;
        flex-direction: column;
      }

      .s-lightbox::backdrop {
        background: rgba(10, 12, 16, 0.76);
        backdrop-filter: blur(4px);
      }

      .s-lightbox__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 16px;
        background: var(--a2-code-header);
        border-bottom: 1px solid var(--a2-border);
        flex-shrink: 0;
      }

      .s-lightbox__title {
        font-family: var(--a2-font-display);
        font-size: 15px;
        font-weight: 700;
        color: var(--a2-text);
      }

      .s-lightbox__close {
        height: 32px;
        padding: 0 12px;
        font-size: 12.5px;
        background: var(--a2-surface);
      }

      .s-lightbox__stage {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1 1 auto;
        min-height: 0;
        background: var(--a2-code-bg);
        overflow: hidden;
      }

      .s-lightbox__stage video,
      .s-lightbox__stage img {
        display: block;
        max-width: 100%;
        max-height: calc(100vh - 196px);
        width: auto;
        height: auto;
        object-fit: contain;
      }

      .s-lightbox__stage [hidden] {
        display: none;
      }

      .s-lightbox__caption {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 12px 16px;
        background: var(--a2-surface-subtle);
        border-top: 1px solid var(--a2-border);
        flex-shrink: 0;
        font-size: 13px;
        color: var(--a2-text-secondary);
      }

      @media (max-width: 520px) {
        .s-featured__bar {
          padding: 8px 10px;
        }
        .s-featured__host span:first-child {
          display: none;
        }
        .s-filter-btn {
          height: 34px;
          padding: 0 10px;
          font-size: 12px;
        }
        .s-card__body {
          padding: 15px;
        }
        .s-card__footer {
          padding: 11px 15px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        :global(html) {
          scroll-behavior: auto;
        }
        .a2-btn,
        .s-featured__viewport img,
        .s-featured__launch,
        .s-stage img,
        .s-filter-btn,
        .s-icon-btn {
          transition: none;
        }
        .a2-btn--primary:hover,
        .s-featured__viewport:hover img,
        .s-stage:hover img,
        .s-featured__launch {
          transform: none;
        }
      }
    </style>
  </body>
</html>
