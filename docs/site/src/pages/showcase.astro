    <script is:inline>
      (() => {
        const filterBtns = Array.from(document.querySelectorAll('[data-filter]'));
        const cards = Array.from(document.querySelectorAll('[data-showcase-card]'));
        const liveRegion = document.getElementById('s-filter-live');
        const validCategories = new Set(
          filterBtns.map((btn) => btn.getAttribute('data-filter')).filter(Boolean)
        );

        const applyFilter = (category, { announce = false, syncUrl = false } = {}) => {
          const target = validCategories.has(category) ? category : 'all';
          let visibleCount = 0;

          cards.forEach((card) => {
            const match = target === 'all' || card.getAttribute('data-category') === target;
            card.hidden = !match;
            if (match) visibleCount += 1;
          });

          let activeLabel = 'All';
          filterBtns.forEach((btn) => {
            const isMatch = btn.getAttribute('data-filter') === target;
            btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
            if (isMatch) {
              const labelSpan = btn.querySelector('span');
              if (labelSpan) activeLabel = labelSpan.textContent || 'All';
            }
          });

          if (syncUrl) {
            const url = new URL(window.location.href);
            if (target === 'all') {
              url.searchParams.delete('category');
            } else {
              url.searchParams.set('category', target);
            }
            if (url.toString() !== window.location.href) {
              window.history.pushState(null, '', url.toString());
            }
          }

          if (announce && liveRegion) {
            liveRegion.textContent = `Showing ${visibleCount} ${
              visibleCount === 1 ? 'example' : 'examples'
            } in ${activeLabel}.`;
          }
        };

        const syncCategoryFromUrl = () => {
          const cat = new URLSearchParams(window.location.search).get('category') || 'all';
          applyFilter(cat, { announce: false, syncUrl: false });
        };

        syncCategoryFromUrl();
        window.addEventListener('popstate', syncCategoryFromUrl);

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const cat = btn.getAttribute('data-filter') || 'all';
            applyFilter(cat, { announce: true, syncUrl: true });
          });
        });

        const lightbox = document.getElementById('s-lightbox');
        const lbTitle = document.getElementById('s-lb-title');
        const lbClose = document.getElementById('s-lb-close');
        const lbVideo = document.getElementById('s-lb-video');
        const lbImg = document.getElementById('s-lb-img');
        const lbCaption = document.getElementById('s-lb-caption');
        const lbLink = document.getElementById('s-lb-link');
        let lastOpener = null;

        const resetMedia = () => {
          if (lbVideo) {
            try {
              lbVideo.pause();
            } catch (e) {}
            if (lbVideo.hasAttribute('src')) {
              lbVideo.removeAttribute('src');
              try {
                lbVideo.load();
              } catch (e) {}
            }
            lbVideo.removeAttribute('poster');
            lbVideo.hidden = true;
          }
          if (lbImg) {
            lbImg.removeAttribute('src');
            lbImg.alt = '';
            lbImg.hidden = true;
          }
        };

        document.querySelectorAll('[data-open-lightbox]').forEach((opener) => {
          opener.addEventListener('click', () => {
            if (!lightbox || typeof lightbox.showModal !== 'function') return;
            lastOpener = opener;
            resetMedia();

            const title = opener.getAttribute('data-lb-title') || '';
            const imgSrc = opener.getAttribute('data-lb-img') || '';
            const imgAlt = opener.getAttribute('data-lb-alt') || '';
            const videoSrc = opener.getAttribute('data-lb-video') || '';
            const caption = opener.getAttribute('data-lb-caption') || '';
            const linkHref = opener.getAttribute('data-lb-link-href') || '';
            const linkLabel = opener.getAttribute('data-lb-link-label') || '';
            const isExternal = opener.getAttribute('data-lb-link-external') === 'true';

            if (lbTitle) lbTitle.textContent = title;
            if (lbCaption) lbCaption.textContent = caption;
            if (lbLink) {
              lbLink.href = linkHref;
              lbLink.textContent = linkLabel;
              if (isExternal) {
                lbLink.setAttribute('target', '_blank');
                lbLink.setAttribute('rel', 'noopener noreferrer');
              } else {
                lbLink.removeAttribute('target');
                lbLink.removeAttribute('rel');
              }
            }

            if (videoSrc && lbVideo) {
              lbVideo.poster = imgSrc;
              lbVideo.src = videoSrc;
              lbVideo.hidden = false;
              lightbox.showModal();
              if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                lbVideo.play().catch(() => {});
              }
            } else if (imgSrc && lbImg) {
              lbImg.src = imgSrc;
              lbImg.alt = imgAlt;
              lbImg.hidden = false;
              lightbox.showModal();
            }
          });
        });

        const closeLightbox = () => {
          resetMedia();
          if (lightbox && lightbox.open) {
            lightbox.close();
          }
        };

        if (lbClose) {
          lbClose.addEventListener('click', closeLightbox);
        }

        if (lightbox) {
          lightbox.addEventListener('cancel', (e) => {
            e.preventDefault();
            closeLightbox();
          });
          lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox && (e.clientX !== 0 || e.clientY !== 0)) {
              const rect = lightbox.getBoundingClientRect();
              const isOutside =
                e.clientX < rect.left ||
                e.clientX > rect.right ||
                e.clientY < rect.top ||
                e.clientY > rect.bottom;
              if (isOutside) closeLightbox();
            }
          });
          lightbox.addEventListener('close', () => {
            resetMedia();
            if (
              lastOpener &&
              document.contains(lastOpener) &&
              typeof lastOpener.focus === 'function'
            ) {
              lastOpener.focus();
            }
            lastOpener = null;
          });
        }
      })();
    </script>

