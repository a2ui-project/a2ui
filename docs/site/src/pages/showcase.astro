  { id: 'all', label: 'All', count: entries.length },
  ...(Object.entries(categoryLabels) as [CategoryId, string][]).map(([id, label]) => ({
    id,
    label,
    count: entries.filter((entry) => entry.category === id).length,
  })),
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Showcase | A2UI</title>
    <meta
      name="description"
      content="Explore interactive playgrounds, multi-renderer reference samples, MCP mini-apps, custom catalogs, and community demos built with the A2UI protocol."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved =
            localStorage.getItem('starlight-theme') || localStorage.getItem('a2ui-theme');
          document.documentElement.setAttribute(
            'data-theme',
            saved === 'dark' || saved === 'light' ? saved : 'light'
          );
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body class="a2-page">
    <header class="a2-topbar">
      <div class="a2-topbar__inner">
        <StarlightHeader />
      </div>
    </header>

    <main data-pagefind-body>
      <section class="a2-hero s-hero" id="hero">
        <div class="a2-hero__grid-bg" aria-hidden="true"></div>

        <div class="a2-wrap">
          <div class="a2-masthead s-masthead">
            <div class="a2-masthead__split">
              <div class="a2-masthead__copy s-hero__copy">
                <h1 class="a2-h1 s-h1">
                  Explore what agents build <span class="a2-h-accent">with&nbsp;A2UI.</span>
                </h1>

                <p class="a2-lead s-lead">
                  Prompt live playgrounds in the browser, run multi-renderer reference agents
                  locally, or inspect custom catalogs and MCP surfaces across web and mobile.
                </p>

                <div class="a2-hero__actions">
                  <a
                    href="https://go.copilotkit.ai/a2ui-playground"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="a2-btn a2-btn--primary"
                  >
                    <span>Open playground</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                  <a href={`${base}/quickstart/`} class="a2-btn a2-btn--outline">
                    <span>Run quickstart</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>

              <div class="a2-masthead__visual">
                <div class="s-featured">
                  <div class="s-featured__bar">
                    <div class="s-featured__title-wrap">
                      <span class="s-featured__title">CopilotKit A2UI Playground</span>
                      <span class="s-ver">v1.0</span>
                    </div>
                    <div class="s-featured__bar-actions">
                      <button
                        type="button"
                        class="s-icon-btn"
                        data-open-lightbox
                        data-lb-title="CopilotKit A2UI Playground"
                        data-lb-img={`${base}/assets/showcase/copilotkit-playground.webp`}
                        data-lb-alt="CopilotKit A2UI Playground rendering a Q3 Regional Sales Performance dashboard beside 13 lines of streamed A2UI Express."
                        data-lb-caption="Hosted playground by CopilotKit: prompt an agent, inspect A2UI Express and JSON side by side, and switch design systems live."
                        data-lb-link-href="https://go.copilotkit.ai/a2ui-playground"
                        data-lb-link-label="Open playground ↗"
                        data-lb-link-external="true"
                        title="Expand preview"
                        aria-label="Expand CopilotKit A2UI Playground preview"
                      >
                        <svg
                          width="13"
                          height="13"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <polyline points="15 3 21 3 21 9"></polyline>
                          <polyline points="9 21 3 21 3 15"></polyline>
                          <line x1="21" y1="3" x2="14" y2="10"></line>
                          <line x1="3" y1="21" x2="10" y2="14"></line>
                        </svg>
                      </button>
                      <a
                        href="https://go.copilotkit.ai/a2ui-playground"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="s-featured__host"
                      >
                        <span>go.copilotkit.ai</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                  </div>

                  <a
                    href="https://go.copilotkit.ai/a2ui-playground"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="s-featured__viewport"
                    aria-label="Launch CopilotKit A2UI Playground in a new tab"
                  >
                    <img
                      src={`${base}/assets/showcase/copilotkit-playground.webp`}
                      alt="CopilotKit A2UI Playground rendering a Q3 Regional Sales Performance dashboard beside 13 lines of streamed A2UI Express."
                      width="1280"
                      height="800"
                      fetchpriority="high"
                      decoding="async"
                    />
                    <span class="s-featured__launch" aria-hidden="true">
                      Launch live playground ↗
                    </span>
                  </a>

                  <p class="s-featured__caption">
                    Stream A2UI Express and JSON side by side in the browser and repaint the same
                    agent response across design systems.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        class="a2-section a2-section--alt s-gallery"
        id="gallery"
        aria-labelledby="s-gallery-heading"
      >
        <div class="a2-wrap">
          <div class="s-gallery__head">
            <div class="s-gallery__heading-group">
              <h2 class="a2-h2 s-gallery__title" id="s-gallery-heading">
                Runnable <span class="a2-h-accent">examples and tools.</span>
              </h2>
              <p class="s-gallery__sub">
                Click any preview to inspect full-screen screenshots or watch recorded walkthroughs.
              </p>
            </div>

            <div class="s-filters" role="group" aria-label="Filter examples by category">
              {
                categories.map((cat, idx) => (
                  <button
                    type="button"
                    class="s-filter-btn"
                    data-filter={cat.id}
                    aria-pressed={idx === 0 ? 'true' : 'false'}
                  >
                    <span>{cat.label}</span>
                    <span class="s-filter-btn__count">{cat.count}</span>
                  </button>
                ))
              }
            </div>
            <span class="s-sr-only" id="s-filter-live" aria-live="polite"></span>
          </div>

          <div class="s-grid" id="s-grid">
            {
              entries.map((item) => (
                <article
                  class="s-card"
                  id={item.slug}
                  data-showcase-card
                  data-category={item.category}
                >
                  <div class="s-card__meta">
                    <span class="s-cat">{categoryLabels[item.category]}</span>

                    <div class="s-card__badges">
                      {item.renderers && item.renderers.length > 0 && (
                        <span class="s-rmarks">
                          {item.renderers.map((r) => (
                            <RendererLogo name={r} size={14} />
                          ))}
                        </span>
                      )}
                      <span class="s-ver">{item.versions}</span>
                    </div>
                  </div>

                  <button
                    type="button"
                    class="s-stage"
                    data-open-lightbox
                    data-lb-title={item.title}
                    data-lb-img={item.imgSrc}
                    data-lb-alt={item.imgAlt}
                    data-lb-video={item.videoSrc || ''}
                    data-lb-caption={item.caption}
                    data-lb-link-href={item.primaryAction.href}
                    data-lb-link-label={
                      item.primaryAction.external
                        ? `${item.primaryAction.label} ↗`
                        : `${item.primaryAction.label} →`
                    }
                    data-lb-link-external={item.primaryAction.external ? 'true' : 'false'}
                    aria-label={
                      item.videoSrc
                        ? `Play ${item.title} walkthrough video (${item.videoDuration})`
                        : `Expand ${item.title} screenshot preview`
                    }
                  >
                    <img
                      src={item.imgSrc}
                      alt={item.imgAlt}
                      width="1280"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                    {item.videoSrc ? (
                      <span class="s-stage__badge s-stage__badge--video" aria-hidden="true">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                          <polygon points="6,4 20,12 6,20" />
                        </svg>
                        <span>Walkthrough · {item.videoDuration}</span>
                      </span>
                    ) : (
                      <span class="s-stage__badge" aria-hidden="true">
                        Preview
                      </span>
                    )}
                  </button>

                  <div class="s-card__body">
                    <div>
                      <h3 class="s-card__title">{item.title}</h3>
                      <p class="s-card__summary">{item.summary}</p>
                    </div>
                    <p class="s-card__stack">{item.stack}</p>
                  </div>

                  <div class="s-card__footer">
                    <div class="s-links">
                      {item.secondaryLinks.map((lnk) => (
                        <a
                          href={lnk.href}
                          target={lnk.external ? '_blank' : undefined}
                          rel={lnk.external ? 'noopener noreferrer' : undefined}
                          class="s-text-link"
                        >
                          {lnk.label}{' '}
                          <span aria-hidden="true">{lnk.external ? '↗' : '→'}</span>
                        </a>
                      ))}
                    </div>

                    <a
                      href={item.primaryAction.href}
                      target={item.primaryAction.external ? '_blank' : undefined}
                      rel={item.primaryAction.external ? 'noopener noreferrer' : undefined}
                      class="a2-btn a2-btn--outline s-card__cta"
                    >
                      <span>{item.primaryAction.label}</span>
                      <span aria-hidden="true">{item.primaryAction.external ? '↗' : '→'}</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>

          <div
            class="s-notes"
            role="region"
            aria-label="Additional renderers and submission guidelines"
          >
            <div>
              <h3 class="s-notes__heading">More renderers and adapters</h3>
              <p>
                Looking for Vue, SwiftUI/AppKit, React Native, Compose Multiplatform, terminal UIs,
                or server libraries? Browse all community packages in the{' '}
                <a href={`${base}/ecosystem/renderers/`}>Community Projects</a>{' '}
                directory.
              </p>
            </div>

            <div>
              <h3 class="s-notes__heading">Share what you built</h3>
              <p>
