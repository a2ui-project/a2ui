import '../styles/tokens.css';

import RendererLogo from '../components/RendererLogo.astro';
import StarlightHeader from '../components/StarlightHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type CategoryId = 'playgrounds' | 'samples' | 'mcp' | 'community';
type RendererName =
  | 'react'
  | 'lit'
  | 'angular'
  | 'flutter'
  | 'swiftui'
  | 'compose'
  | 'vue'
  | 'svelte';

interface ShowcaseLink {
  label: string;
  href: string;
  external?: boolean;
}

interface ShowcaseEntry {
  slug: string;
  title: string;
  category: CategoryId;
  versions: string;
  renderers?: RendererName[];
  stack: string;
  summary: string;
  imgSrc: string;
  imgAlt: string;
  caption: string;
  videoSrc?: string;
  videoDuration?: string;
  primaryAction: ShowcaseLink;
  secondaryLinks: ShowcaseLink[];
}

const categoryLabels: Record<CategoryId, string> = {
  playgrounds: 'Playgrounds & Tools',
  samples: 'Official Samples',
  mcp: 'MCP & Catalogs',
  community: 'Community',
};

