<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Get Help | A2UI</title>
    <meta
      name="description"
      content="Add the officially supported A2UI skill to your coding agent, or work with independent companies offering consulting services on A2UI."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved =
            localStorage.getItem('starlight-theme') || localStorage.getItem('a2ui-theme');
          document.documentElement.setAttribute(
            'data-theme',
            saved === 'dark' || saved === 'light' ? saved : 'light'
          );
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body class="a2-page">
    <header class="a2-topbar">
      <div class="a2-topbar__inner">
        <StarlightHeader />
      </div>
    </header>

    <main data-pagefind-body>
      <section class="a2-hero c-hero">
        <div class="a2-hero__grid-bg" aria-hidden="true"></div>
        <div class="a2-wrap c-hero__inner">
          <h1 class="a2-h1 c-h1">
            Get help <span class="a2-h-accent">with&nbsp;A2UI.</span>
          </h1>

          <div class="c-skill-bar" role="region" aria-labelledby="c-skill-heading">
            <div class="c-row-copy">
              <h2 class="c-row-q" id="c-skill-heading">Using a coding agent?</h2>{' '}
              <p class="c-row-p">
                Add our{' '}
                <a
                  href="https://github.com/a2ui-project/a2ui/blob/main/skills/a2ui/SKILL.md"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="c-inline-link">officially supported skill</a
                >{' '}
                and ask questions or co-create.
              </p>
            </div>

            <button
              type="button"
              class="a2-cmd-bar c-cmd-bar"
              id="c-copy-skill"
              data-copy="npx skills add a2ui-project/a2ui"
              aria-label="Copy npx skills add a2ui-project/a2ui command"
            >
              <span class="a2-cmd-bar__sig" aria-hidden="true">$</span>
              <span class="c-cmd-bar__txt">npx skills add a2ui-project/a2ui</span>
              <span class="a2-cmd-bar__act" id="c-copy-skill-label" aria-live="polite">COPY</span>
            </button>
          </div>
        </div>
      </section>

      <section
        class="a2-section a2-section--alt c-directory"
        id="consultants"
        aria-labelledby="c-dir-heading"
      >
        <div class="a2-wrap">
          <div class="c-dir-head">
            <div class="c-row-copy">
              <h2 class="c-row-q" id="c-dir-heading">Want to work with proven experts?</h2>{' '}
              <p class="c-row-p">
                These independent companies offer consulting services on A2UI.
              </p>
            </div>

            <div class="c-sort" role="group" aria-label="Consultancy sort order">
              <button
                type="button"
                class="c-sort__btn"
                id="c-sort-random"
                aria-pressed="true"
                title="Randomize consultancy order (click again to reshuffle)"
              >
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="16 3 21 3 21 8"></polyline>
                  <line x1="4" y1="20" x2="21" y2="3"></line>
                  <polyline points="21 16 21 21 16 21"></polyline>
                  <line x1="15" y1="15" x2="21" y2="21"></line>
                  <line x1="4" y1="4" x2="9" y2="9"></line>
                </svg>
                <span>Random</span>
              </button>
              <button
                type="button"
                class="c-sort__btn"
                id="c-sort-alpha"
                aria-pressed="false"
                title="Sort consultancies alphabetically (A to Z)"
              >
                <span>A–Z</span>
              </button>
              <span class="c-sr-only" id="c-sort-live" aria-live="polite"></span>
            </div>
          </div>

          <div class="c-grid" id="c-grid">
            {
              consultants.map((item, idx) => (
                <article
                  class="c-card"
                  data-card
                  data-slug={item.slug}
                  data-alpha-index={String(idx)}
                  data-agency-name={item.agency}
                  data-app-name={`${item.appName} · ${item.appTagline}`}
                  data-agency-url={item.agencyUrl}
                  data-video-src={item.videoSrc}
                  data-video-caption={item.videoCaption}
                  data-primary-src={item.primaryImg}
                  data-primary-alt={item.primaryAlt}
                  data-primary-caption={item.primaryCaption}
                  data-catalog-src={item.catalogImg}
                  data-catalog-alt={item.catalogAlt}
                  data-catalog-caption={item.catalogCaption}
                >
                  <div class="c-card__head">
                    <a
                      href={item.agencyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="c-agency-brand"
                      aria-label={`${item.agency} website (opens in new tab)`}
                    >
                      <img
                        src={item.logoLight}
                        alt={item.agency}
                        class="c-agency-logo c-agency-logo--light"
                        style={`height: ${item.logoHeight}px;`}
                        decoding="async"
                      />
                      <img
                        src={item.logoDark}
                        alt={item.agency}
                        class="c-agency-logo c-agency-logo--dark"
                        style={`height: ${item.logoHeight}px;`}
                        decoding="async"
                      />
                    </a>
                    <span class="c-domain">{item.domain}</span>
                  </div>

                  <div class="c-stage">
                    <div class="c-stage__bar">
                      <div class="c-tabs" role="tablist" aria-label={`${item.appName} views`}>
                        <button
                          type="button"
                          role="tab"
                          id={`tab-${item.slug}-video`}
                          aria-controls={`pane-${item.slug}-video`}
                          aria-selected="true"
                          tabindex="0"
                          class="c-tab is-active"
                          data-media-tab="video"
                        >
                          {item.videoLabel}
                        </button>
                        <button
                          type="button"
                          role="tab"
                          id={`tab-${item.slug}-primary`}
                          aria-controls={`pane-${item.slug}-primary`}
                          aria-selected="false"
                          tabindex="-1"
                          class="c-tab"
                          data-media-tab="primary"
                        >
                          App UI
                        </button>
                        <button
                          type="button"
                          role="tab"
                          id={`tab-${item.slug}-catalog`}
                          aria-controls={`pane-${item.slug}-catalog`}
                          aria-selected="false"
                          tabindex="-1"
                          class="c-tab"
                          data-media-tab="catalog"
                        >
                          Catalog
                        </button>
                      </div>

                      <div class="c-stage__actions">
                        <button
                          type="button"
                          class="c-icon-btn"
                          data-video-toggle
                          title="Pause or play video"
                          aria-label={`Pause ${item.appName} preview video`}
                        >
                          <svg
                            data-icon-pause
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                          >
                            <rect x="6" y="5" width="4" height="14" rx="1" />
                            <rect x="14" y="5" width="4" height="14" rx="1" />
                          </svg>
                          <svg
                            data-icon-play
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                            hidden
                          >
                            <polygon points="7,5 19,12 7,19" />
                          </svg>
                        </button>
                        <button
                          type="button"
                          class="c-icon-btn"
                          data-expand-btn
                          title="Expand preview"
                          aria-label={`Expand ${item.appName} preview`}
                        >
                          <svg
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <polyline points="15 3 21 3 21 9" />
                            <polyline points="9 21 3 21 3 15" />
                            <line x1="21" y1="3" x2="14" y2="10" />
                            <line x1="3" y1="21" x2="10" y2="14" />
                          </svg>
                        </button>
                      </div>
                    </div>

                    <div class="c-viewport">
                      <div
                        class="c-pane"
                        role="tabpanel"
                        id={`pane-${item.slug}-video`}
                        aria-labelledby={`tab-${item.slug}-video`}
                        data-media-pane="video"
                      >
                        <video
                          src={item.videoSrc}
                          poster={item.primaryImg}
                          width="1280"
                          height="800"
                          muted
                          loop
                          playsinline
                          disablepictureinpicture
                          disableremoteplayback
                          preload="metadata"
                        />
                      </div>
                      <div
                        class="c-pane c-pane--clickable"
                        role="tabpanel"
                        id={`pane-${item.slug}-primary`}
                        aria-labelledby={`tab-${item.slug}-primary`}
                        data-media-pane="primary"
                        hidden
                      >
                        <img
                          src={item.primaryImg}
                          alt={item.primaryAlt}
                          width="1280"
                          height="800"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div
                        class="c-pane c-pane--clickable"
                        role="tabpanel"
                        id={`pane-${item.slug}-catalog`}
                        aria-labelledby={`tab-${item.slug}-catalog`}
                        data-media-pane="catalog"
                        hidden
                      >
                        <img
                          src={item.catalogImg}
                          alt={item.catalogAlt}
                          width="1280"
                          height="800"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                  </div>

                  <div class="c-card__body">
                    <div>
                      <h3 class="c-app-title">
                        {item.appName} <span class="c-app-tagline">· {item.appTagline}</span>
                      </h3>
                      <p class="c-summary">{item.summary}</p>
                    </div>

                    <dl class="c-meta">
                      <div>
                        <dt>STACK</dt>
                        <dd>{item.stack}</dd>
                      </div>
                      <div>
                        <dt>CATALOG</dt>
                        <dd>{item.catalog}</dd>
                      </div>
                    </dl>
                  </div>

                  <div class="c-card__footer">
                    <div class="c-links">
                      <a
                        href={item.demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="c-text-link"
                      >
                        Live demo <span aria-hidden="true">↗</span>
                      </a>
                      {item.catalogUrl && (
                        <a
                          href={item.catalogUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="c-text-link"
                        >
                          Catalog <span aria-hidden="true">↗</span>
                        </a>
                      )}
                      {item.figmaUrl && (
                        <a
                          href={item.figmaUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="c-text-link"
                        >
                          Figma <span aria-hidden="true">↗</span>
                        </a>
                      )}
                      <a
                        href={item.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="c-text-link"
                      >
                        GitHub <span aria-hidden="true">↗</span>
                      </a>
                    </div>

                    <a
                      href={item.agencyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="a2-btn a2-btn--outline c-card__cta"
                    >
                      <span>Visit {item.agency}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
          <script is:inline>
            (() => {
              const grid = document.getElementById('c-grid');
              if (!grid) return;
              const items = Array.from(grid.children);
              for (let i = items.length - 1; i > 0; i -= 1) {
                const j = Math.floor(Math.random() * (i + 1));
                const tmp = items[i];
                items[i] = items[j];
                items[j] = tmp;
              }
              const frag = document.createDocumentFragment();
              items.forEach((c) => frag.appendChild(c));
              grid.appendChild(frag);
            })();
          </script>

          <div
            class="c-notes"
            role="region"
            aria-label="Directory governance and contribution"
          >
