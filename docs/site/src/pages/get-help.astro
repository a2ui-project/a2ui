    <dialog class="c-lightbox" id="c-lightbox" aria-labelledby="c-lb-title">
      <div class="c-lightbox__head">
        <span class="c-lightbox__title" id="c-lb-title"></span>
        <button type="button" class="a2-btn a2-btn--outline c-lightbox__close" id="c-lb-close">
          Close
        </button>
      </div>
      <div class="c-lightbox__stage">
        <video id="c-lb-video" controls loop muted playsinline preload="none" hidden></video>
        <img id="c-lb-img" alt="" hidden />
      </div>
