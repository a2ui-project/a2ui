      }

      .c-domain {
        display: inline-flex;
        align-items: center;
        padding: 2px 7px;
        border-radius: 3px;
        border: 1px solid var(--a2-border-strong);
        background: var(--a2-surface);
        font-family: var(--a2-font-mono);
        font-size: 11px;
        font-weight: 500;
        color: var(--a2-text-secondary);
        white-space: nowrap;
      }

      .c-stage__bar {
        padding: 7px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        background: var(--a2-code-header);
        border-bottom: 1px solid var(--a2-border);
      }

      .c-tabs,
      .c-stage__actions,
      .c-links {
        display: flex;
        align-items: center;
      }

      .c-tabs {
        gap: 4px;
      }

      .c-tab {
        padding: 4px 10px;
        border-radius: 3px;
        border: 1px solid transparent;
        background: transparent;
        color: var(--a2-text-secondary);
        font-family: var(--a2-font-sans);
        font-size: 12.5px;
        font-weight: 500;
        line-height: 1.3;
        white-space: nowrap;
        cursor: pointer;
        transition:
          color 0.14s ease,
          background-color 0.14s ease,
          border-color 0.14s ease;
      }

      .c-tab:hover {
        color: var(--a2-text);
      }

      .c-tab.is-active {
        background: var(--a2-surface);
        border-color: var(--a2-border-strong);
        color: var(--a2-text);
        font-weight: 600;
      }

      .c-stage__actions {
        gap: 6px;
      }

      .c-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border-radius: 3px;
        border: 1px solid var(--a2-border-strong);
        background: var(--a2-surface);
        color: var(--a2-text-secondary);
        cursor: pointer;
        transition:
          color 0.15s ease,
          border-color 0.15s ease;
      }

      .c-icon-btn:hover {
        color: var(--a2-text);
        border-color: var(--a2-text);
      }

      .c-viewport {
        background: var(--a2-code-bg);
        border-bottom: 1px solid var(--a2-border);
      }

      .c-pane {
        aspect-ratio: 16 / 10;
        overflow: hidden;
      }

      .c-pane--clickable {
        cursor: zoom-in;
      }

      .c-pane video,
      .c-pane img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .c-card__body {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex: 1;
        gap: 14px;
        padding: 18px 18px 16px;
      }

      .c-app-title {
        margin: 0 0 8px;
        font-family: var(--a2-font-display);
        font-size: 18px;
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: var(--a2-tracking-h3);
        color: var(--a2-text);
      }

      .c-app-tagline {
        font-weight: 500;
        color: var(--a2-text-muted);
      }

      .c-summary,
      .c-notes p {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        color: var(--a2-text-secondary);
        text-wrap: pretty;
      }

      .c-meta {
        margin: 0;
        padding-top: 12px;
        border-top: 1px solid var(--a2-border);
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 16px;
      }

      .c-meta dt {
        font-family: var(--a2-font-mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: var(--a2-tracking-mono-wide);
        color: var(--a2-text-muted);
        margin: 0 0 3px;
      }

      .c-meta dd {
        margin: 0;
        font-size: 13px;
        font-weight: 500;
        line-height: 1.4;
        color: var(--a2-text);
      }

      .c-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 12px 18px;
        background: var(--a2-surface-subtle);
        border-top: 1px solid var(--a2-border);
      }

      .c-links {
        gap: 14px;
        flex-wrap: wrap;
      }

      .c-text-link,
      .c-notes a {
        font-size: 13px;
        font-weight: 600;
        color: var(--a2-accent);
        text-decoration: none;
      }

      .c-text-link:hover,
      .c-notes a:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .c-card__cta {
        height: 34px;
        padding: 0 13px;
        font-size: 12.5px;
        gap: 7px;
        background: var(--a2-surface);
      }

      .c-notes {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 40px;
        margin-top: 52px;
        padding-top: 36px;
        border-top: 1px solid var(--a2-border);
      }

      .c-notes__heading {
        margin: 0 0 8px;
        font-family: var(--a2-font-display);
        font-size: 17px;
        font-weight: 700;
        letter-spacing: var(--a2-tracking-h3);
        color: var(--a2-text);
      }

      .c-notes a {
        font-size: 14px;
      }

      .c-lightbox {
        width: min(1040px, calc(100vw - 32px));
        max-height: calc(100vh - 32px);
        margin: auto;
        padding: 0;
        border: 1px solid var(--a2-border-strong);
        border-radius: var(--a2-radius-sm);
        background: var(--a2-surface);
        color: var(--a2-text);
        box-shadow: var(--a2-shadow-lg);
        overflow: hidden;
      }

      .c-lightbox::backdrop {
        background: rgba(11, 14, 20, 0.76);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
      }

      .c-lightbox__head,
      .c-lightbox__caption {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 12px 16px;
      }

      .c-lightbox__head {
        background: var(--a2-code-header);
        border-bottom: 1px solid var(--a2-border);
      }

      .c-lightbox__title {
        font-family: var(--a2-font-display);
        font-size: 15px;
        font-weight: 700;
        color: var(--a2-text);
      }

      .c-lightbox__close {
        height: 32px;
        padding: 0 12px;
        font-size: 12.5px;
        background: var(--a2-surface);
      }

      .c-lightbox__stage {
        background: var(--a2-code-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        max-height: calc(100vh - 156px);
        overflow: hidden;
      }

      .c-lightbox__stage video,
      .c-lightbox__stage img {
        display: block;
        max-width: 100%;
        max-height: calc(100vh - 156px);
        width: auto;
        height: auto;
        object-fit: contain;
      }

      .c-lightbox__caption {
        background: var(--a2-surface-subtle);
        border-top: 1px solid var(--a2-border);
        font-size: 13px;
        line-height: 1.5;
        color: var(--a2-text-secondary);
      }

      :is(
          .a2-btn,
          .a2-cmd-bar,
          .c-tab,
          .c-icon-btn,
          .c-sort__btn,
          .c-inline-link,
          .c-text-link,
          .c-notes a,
          .c-agency-brand,
          .a2-footer__links a
        ):focus-visible {
        outline: 2px solid var(--a2-accent);
        outline-offset: 2px;
      }

      @media (prefers-reduced-motion: reduce) {
        :global(html) {
          scroll-behavior: auto;
        }

        .a2-btn,
        .a2-cmd-bar,
        .c-sort__btn,
        .c-tab,
        .c-icon-btn,
        .c-inline-link {
          transition: none;
        }
      }

      @media (max-width: 900px) {
        .c-grid {
          grid-template-columns: 1fr;
          gap: 20px;
        }
      }

      @media (max-width: 760px) {
        .c-directory {
          padding: 28px 0 64px;
        }

        .c-notes {
          grid-template-columns: 1fr;
          gap: 24px;
          margin-top: 40px;
          padding-top: 28px;
        }
      }

      @media (max-width: 560px) {
        .c-meta {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 480px) {
        .c-cmd-bar {
          width: 100%;
          justify-content: space-between;
          padding: 0 10px;
          gap: 6px;
          font-size: 11px;
        }

        .c-cmd-bar__txt {
          overflow: hidden;
          text-overflow: ellipsis;
        }

        .c-stage__bar {
          padding: 6px 10px;
        }

        .c-tab {
          padding: 4px 8px;
          font-size: 12px;
        }
      }
    </style>
  </body>
</html>
