        <span id="c-lb-caption"></span>
        <a
          id="c-lb-agency-link"
          href="https://a2ui.org"
          target="_blank"
          rel="noopener noreferrer"
          class="c-text-link"
        ></a>
      </div>
    </dialog>

    <script is:inline>
      (() => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const grid = document.getElementById('c-grid');
        const cards = Array.from(document.querySelectorAll('[data-card]'));
        const sortRandomBtn = document.getElementById('c-sort-random');
        const sortAlphaBtn = document.getElementById('c-sort-alpha');
        const sortLive = document.getElementById('c-sort-live');
        const copySkillBtn = document.getElementById('c-copy-skill');
        const copySkillLabel = document.getElementById('c-copy-skill-label');

        if (copySkillBtn && copySkillLabel) {
          let copyTimer = 0;
          copySkillBtn.addEventListener('click', async () => {
            const cmd = copySkillBtn.getAttribute('data-copy') || '';
            try {
              await navigator.clipboard.writeText(cmd);
              copySkillLabel.textContent = 'COPIED ✓';
              copySkillBtn.classList.add('is-copied');
              window.clearTimeout(copyTimer);
              copyTimer = window.setTimeout(() => {
                copySkillLabel.textContent = 'COPY';
                copySkillBtn.classList.remove('is-copied');
              }, 1800);
            } catch (e) {}
          });
        }

        function syncToggleIcon(card, paused) {
          const toggle = card.querySelector('[data-video-toggle]');
          if (!toggle) return;
          const pauseIcon = toggle.querySelector('[data-icon-pause]');
          const playIcon = toggle.querySelector('[data-icon-play]');
          if (pauseIcon) pauseIcon.toggleAttribute('hidden', paused);
          if (playIcon) playIcon.toggleAttribute('hidden', !paused);
          const app = card.getAttribute('data-app-name') || 'preview';
          toggle.setAttribute('aria-label', `${paused ? 'Play' : 'Pause'} ${app} video`);
        }

        function syncVisibleVideos() {
          const vh = window.innerHeight || document.documentElement.clientHeight;
          cards.forEach((card) => {
            const vid = card.querySelector('video');
            if (!vid) return;
            const activeTab = card.querySelector('.c-tab.is-active');
            const onVideoTab = !activeTab || activeTab.getAttribute('data-media-tab') === 'video';
            const userPaused = card.getAttribute('data-user-paused') === 'true';
            const rect = card.getBoundingClientRect();
            const inView = rect.bottom > 40 && rect.top < vh - 40;
            if (!prefersReducedMotion && inView && onVideoTab && !userPaused) {
              vid.play().catch(() => {});
              syncToggleIcon(card, false);
            } else {
              vid.pause();
              syncToggleIcon(card, prefersReducedMotion || userPaused || !onVideoTab);
            }
          });
        }

        if (prefersReducedMotion) {
          cards.forEach((card) => {
            card.setAttribute('data-user-paused', 'true');
            const vid = card.querySelector('video');
            if (vid) vid.pause();
            syncToggleIcon(card, true);
          });
        } else {
          syncVisibleVideos();
          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  const card = entry.target;
                  const vid = card.querySelector('video');
                  if (!vid) return;
                  const activeTab = card.querySelector('.c-tab.is-active');
                  const onVideoTab =
                    !activeTab || activeTab.getAttribute('data-media-tab') === 'video';
                  const userPaused = card.getAttribute('data-user-paused') === 'true';
                  if (entry.isIntersecting && onVideoTab && !userPaused) {
                    vid.play().catch(() => {});
                    syncToggleIcon(card, false);
                  } else if (!entry.isIntersecting && !vid.paused) {
                    vid.pause();
                  }
                });
              },
              { threshold: 0.25 }
            );
            cards.forEach((card) => observer.observe(card));
          }
        }

        if (sortRandomBtn && sortAlphaBtn && grid) {
          const setSortMode = (isRandom) => {
            sortRandomBtn.setAttribute('aria-pressed', isRandom ? 'true' : 'false');
            sortAlphaBtn.setAttribute('aria-pressed', isRandom ? 'false' : 'true');
          };

          sortRandomBtn.addEventListener('click', () => {
            const prevTop = Array.from(grid.children)
              .slice(0, 2)
              .map((c) => c.getAttribute('data-slug'))
              .join(',');
            let shuffled = cards.slice();
            for (let attempt = 0; attempt < 6; attempt += 1) {
              shuffled = cards.slice();
              for (let i = shuffled.length - 1; i > 0; i -= 1) {
                const j = Math.floor(Math.random() * (i + 1));
                const tmp = shuffled[i];
                shuffled[i] = shuffled[j];
                shuffled[j] = tmp;
              }
              const nextTop = shuffled
                .slice(0, 2)
                .map((c) => c.getAttribute('data-slug'))
                .join(',');
              if (nextTop !== prevTop || cards.length <= 2) break;
            }
            const frag = document.createDocumentFragment();
            shuffled.forEach((c) => frag.appendChild(c));
            grid.appendChild(frag);
            setSortMode(true);
            syncVisibleVideos();
            if (sortLive) sortLive.textContent = 'Showing consultancies in random order.';
          });

          sortAlphaBtn.addEventListener('click', () => {
            const sorted = cards
              .slice()
              .sort(
                (a, b) =>
                  Number(a.getAttribute('data-alpha-index')) -
                  Number(b.getAttribute('data-alpha-index'))
              );
            const frag = document.createDocumentFragment();
            sorted.forEach((c) => frag.appendChild(c));
            grid.appendChild(frag);
            setSortMode(false);
            syncVisibleVideos();
            if (sortLive) sortLive.textContent = 'Sorted consultancies alphabetically, A to Z.';
          });
        }

        cards.forEach((card) => {
          const tabs = Array.from(card.querySelectorAll('[data-media-tab]'));
          const panes = Array.from(card.querySelectorAll('[data-media-pane]'));
          const video = card.querySelector('video');
          const toggleBtn = card.querySelector('[data-video-toggle]');

          function activateTab(tab) {
            const target = tab.getAttribute('data-media-tab');
            tabs.forEach((t) => {
              const active = t === tab;
              t.classList.toggle('is-active', active);
              t.setAttribute('aria-selected', String(active));
              t.setAttribute('tabindex', active ? '0' : '-1');
            });
            panes.forEach((p) => {
              const active = p.getAttribute('data-media-pane') === target;
              p.toggleAttribute('hidden', !active);
            });
            if (toggleBtn) {
              toggleBtn.hidden = target !== 'video';
            }
            if (video) {
              if (
                target === 'video' &&
                !prefersReducedMotion &&
                card.getAttribute('data-user-paused') !== 'true'
              ) {
                video.play().catch(() => {});
                syncToggleIcon(card, false);
              } else {
                video.pause();
              }
            }
          }

          tabs.forEach((tab) => {
            tab.addEventListener('click', () => activateTab(tab));
          });

          const tablist = card.querySelector('[role="tablist"]');
          if (tablist) {
            tablist.addEventListener('keydown', (e) => {
              const idx = tabs.indexOf(document.activeElement);
              if (idx === -1) return;
              let next = -1;
              if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
              else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
              else if (e.key === 'Home') next = 0;
              else if (e.key === 'End') next = tabs.length - 1;
              if (next === -1) return;
              e.preventDefault();
              tabs[next].focus();
              activateTab(tabs[next]);
            });
          }

          if (toggleBtn && video) {
            toggleBtn.addEventListener('click', () => {
              if (video.paused) {
                card.setAttribute('data-user-paused', 'false');
                video.play().catch(() => {});
                syncToggleIcon(card, false);
              } else {
                card.setAttribute('data-user-paused', 'true');
                video.pause();
                syncToggleIcon(card, true);
              }
            });
          }
        });

        const dialog = document.getElementById('c-lightbox');
        const lbTitle = document.getElementById('c-lb-title');
        const lbClose = document.getElementById('c-lb-close');
        const lbVideo = document.getElementById('c-lb-video');
        const lbImg = document.getElementById('c-lb-img');
        const lbCaption = document.getElementById('c-lb-caption');
        const lbAgencyLink = document.getElementById('c-lb-agency-link');
        let lastTrigger = null;

        function resetLightboxMedia() {
          if (lbVideo) {
            lbVideo.pause();
            lbVideo.hidden = true;
            lbVideo.removeAttribute('src');
            lbVideo.load();
          }
          if (lbImg) {
            lbImg.hidden = true;
            lbImg.removeAttribute('src');
            lbImg.setAttribute('alt', '');
          }
        }

        function closeLightbox() {
          resetLightboxMedia();
          if (dialog && dialog.open) {
            dialog.close();
          }
        }

        function openLightboxForCard(card, triggerEl) {
          if (!dialog || !lbTitle || !lbVideo || !lbImg || !lbCaption || !lbAgencyLink) return;
          lastTrigger = triggerEl || document.activeElement;
          resetLightboxMedia();

          const activeTab = card.querySelector('.c-tab.is-active');
          const mode = activeTab ? activeTab.getAttribute('data-media-tab') : 'video';
          const agencyName = card.getAttribute('data-agency-name') || '';
          const appName = card.getAttribute('data-app-name') || '';
          const agencyUrl = card.getAttribute('data-agency-url') || 'https://a2ui.org';

          lbTitle.textContent = `${agencyName} · ${appName}`;
          lbAgencyLink.textContent = `Visit ${agencyName} ↗`;
          lbAgencyLink.setAttribute('href', agencyUrl);

          if (mode === 'video') {
            lbVideo.hidden = false;
            lbVideo.setAttribute('src', card.getAttribute('data-video-src') || '');
            lbCaption.textContent = card.getAttribute('data-video-caption') || '';
            dialog.showModal();
            if (!prefersReducedMotion) {
              lbVideo.play().catch(() => {});
            }
          } else {
            lbImg.hidden = false;
            const srcAttr = mode === 'catalog' ? 'data-catalog-src' : 'data-primary-src';
            const altAttr = mode === 'catalog' ? 'data-catalog-alt' : 'data-primary-alt';
            const capAttr = mode === 'catalog' ? 'data-catalog-caption' : 'data-primary-caption';
            lbImg.setAttribute('src', card.getAttribute(srcAttr) || '');
            lbImg.setAttribute('alt', card.getAttribute(altAttr) || '');
            lbCaption.textContent = card.getAttribute(capAttr) || '';
            dialog.showModal();
          }
        }

        cards.forEach((card) => {
          const expandBtn = card.querySelector('[data-expand-btn]');
          if (expandBtn) {
            expandBtn.addEventListener('click', () => openLightboxForCard(card, expandBtn));
          }
          card.querySelectorAll('.c-pane--clickable').forEach((pane) => {
            pane.addEventListener('click', () => openLightboxForCard(card, expandBtn || pane));
          });
        });

        if (lbClose) {
          lbClose.addEventListener('click', closeLightbox);
        }

        if (dialog) {
          dialog.addEventListener('cancel', (e) => {
            e.preventDefault();
            closeLightbox();
          });
          dialog.addEventListener('click', (e) => {
            if (e.target === dialog && (e.clientX !== 0 || e.clientY !== 0)) {
              const rect = dialog.getBoundingClientRect();
              const isOutside =
                e.clientX < rect.left ||
                e.clientX > rect.right ||
                e.clientY < rect.top ||
                e.clientY > rect.bottom;
              if (isOutside) closeLightbox();
            }
          });
          dialog.addEventListener('close', () => {
            resetLightboxMedia();
            if (
              lastTrigger &&
              document.contains(lastTrigger) &&
              typeof lastTrigger.focus === 'function'
            ) {
              lastTrigger.focus();
            }
            lastTrigger = null;
          });
        }
      })();
    </script>

