  }

  .hc-context__item {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .hc-context__k {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
  }

  .hc-catalog-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .hc-catalog-chips code,
  .hc-surface-id {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 5px;
    border-radius: 4px;
    background: rgba(30, 41, 59, 0.8);
    color: #e2e8f0;
    border: 1px solid rgba(100, 116, 139, 0.45);
  }

  .hc-surface-id {
    color: #5eead4;
    border-color: rgba(45, 212, 191, 0.35);
  }

  /* Fixed-height code stream box prevents page height shifts during 5s stream */
  .hc-stream-viewport {
    position: relative;
    background: var(--code-bg);
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 9px 12px;
  }

  .hc-code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.4px;
    line-height: 1.4;
    color: #e2e8f0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .hc-code--jsonl {
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .hc-chunk {
    display: block;
    padding: 3px 8px;
    margin-bottom: 4px;
    border-left: 2px solid rgba(71, 85, 105, 0.7);
    border-radius: 0 6px 6px 0;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .hc-chunk.is-streaming {
    border-left-color: #2dd4bf;
    background: rgba(20, 184, 166, 0.1);
  }

  .hc-chunk.is-done {
    border-left-color: rgba(45, 212, 191, 0.48);
  }

  .hc-c {
    color: #94a3b8;
  }
  .hc-kw {
    color: #38bdf8;
    font-weight: 700;
  }
  .hc-fn {
    color: #2dd4bf;
    font-weight: 600;
  }
  .hc-comp {
    color: #f8fafc;
    font-weight: 600;
  }
  .hc-path {
    color: #7dd3fc;
  }
  .hc-str {
    color: #fcd34d;
  }
  .hc-num {
    color: #34d399;
    font-weight: 600;
  }

  .hc-caret {
    display: none;
    width: 7px;
    height: 13px;
    background: #2dd4bf;
    vertical-align: text-bottom;
    margin-left: 2px;
    animation: hc-blink 0.8s steps(2, start) infinite;
  }

  .hc-caret.is-visible {
    display: inline-block;
  }

  @keyframes hc-blink {
    to {
      visibility: hidden;
    }
