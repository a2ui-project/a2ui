<span class="hc-comp">hero_card</span> = <span class="hc-fn">Card</span>(<span class="hc-fn">Column</span>([<span class="hc-fn">Image</span>(<span class="hc-str">"https://example.com/kyoto.jpg"</span>, variant=<span class="hc-str">"header"</span>), <span class="hc-fn">Text</span>(<span class="hc-str">"Kyoto Weekend Escape"</span>)]))
