<style>
  .hc-shell {
    --hc-phone-bg: #0b1324;
    --hc-phone-card: #121e36;
    --hc-phone-card-subtle: #0e182c;
    --hc-phone-border: #223252;
    --hc-phone-text: #f8fafc;
    --hc-phone-muted: #94a3b8;
    --hc-phone-chip-bg: #172542;

    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    text-align: left;
  }

  :global(:root[data-theme='light']) .hc-shell {
    --hc-phone-bg: #f4f7fb;
    --hc-phone-card: #ffffff;
    --hc-phone-card-subtle: #f8fafc;
    --hc-phone-border: #dbe3ef;
    --hc-phone-text: #0f172a;
    --hc-phone-muted: #475569;
    --hc-phone-chip-bg: #eef2f7;
  }

  .hc-shell [hidden] {
    display: none !important;
  }

  .hc-shell :is(button, input, [tabindex='0']):focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  .hc-agent :is(button, [tabindex='0']):focus-visible,
  .hc-datamodel :is(button, [tabindex='0']):focus-visible {
    outline-color: #5eead4;
  }

  /* --- Top 3-Step Summary Bar --- */
  .hc-nutshell {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 14px;
    padding: 14px 22px;
    background: var(--surface-subtle);
    border-bottom: 1px solid var(--border);
  }

  .hc-step {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    min-width: 0;
  }

  .hc-step__num {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .hc-step__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .hc-step__text strong {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }

  .hc-step__text span {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.42;
  }

  .hc-step__text code {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-strong);
  }

  .hc-step__arrow {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 15px;
    user-select: none;
  }

  /* --- Main Split Stage --- */
  .hc-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) 170px 392px;
    gap: 16px;
    padding: 22px;
    align-items: stretch;
  }

  /* --- Left Column: Agent Server + Client State --- */
  .hc-left-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 816px;
    min-width: 0;
  }

  .hc-agent {
    background: var(--surface-subtle);
    border: 1px solid var(--border);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
  }

  .hc-agent__head {
    padding: 10px 14px;
    background: var(--code-header);
    color: #f8fafc;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hc-agent__title-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hc-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #14b8a6;
    box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.22);
    transition: background-color 0.2s ease;
  }

  .hc-live-dot.is-streaming {
    background: #fbbf24;
    box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.25);
  }

  .hc-agent__badge {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 2px 7px;
    border-radius: 4px;
    background: rgba(20, 184, 166, 0.22);
    color: #5eead4;
  }

  .hc-agent__title {
    font-size: 13px;
    font-weight: 700;
    color: #f1f5f9;
  }

  .hc-fmt-tabs {
    display: inline-flex;
    background: rgba(2, 6, 23, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.28);
