</style>

<script is:inline>
  (function () {
    const root = document.getElementById('hero-chat-visual');
    if (!root) return;

    const DURATION_MS = 4200;

    // 3 synchronized stages matching the 3 Express cards (hero, options, summary)
    const STAGES = [
      { idx: 0, codeStart: 80, codeEnd: 1250, uiAppear: 1250 },
      { idx: 1, codeStart: 1350, codeEnd: 2850, uiAppear: 2850 },
      { idx: 2, codeStart: 2950, codeEnd: 4120, uiAppear: 4120 },
    ];

    function q(sel) {
      return root.querySelector(sel);
    }

    function qa(sel) {
      return Array.from(root.querySelectorAll(sel));
    }

    function indexCodeContainer(preEl) {
      return Array.from(preEl.querySelectorAll('.hc-chunk')).map((chunkEl) => {
        const nodes = [];
        let total = 0;
        const walker = document.createTreeWalker(chunkEl, NodeFilter.SHOW_TEXT);
        let current = walker.nextNode();
        while (current) {
          const full = current.nodeValue || '';
          nodes.push({ node: current, full, start: total, end: total + full.length });
          total += full.length;
          current = walker.nextNode();
        }
        return { el: chunkEl, nodes, total };
      });
    }

    const expressPre = q('#hc-code-express');
    const expressChunks = indexCodeContainer(expressPre);

    const caretExpress = q('[data-hc-el="caret-express"]');
    const agentDot = q('[data-hc-el="agent-dot"]');
    const agentLead = q('[data-hc-el="agent-lead"]');
    const surfaceCard = q('[data-hc-el="surface-card"]');
    const skeleton = q('[data-hc-el="skeleton"]');
    const restartBtn = q('#hc-restart-btn');
    const chatConfirm = q('#hc-chat-confirm');

    const wireStream = q('[data-hc-el="wire-stream"]');
    const wireAction = q('[data-hc-el="wire-action"]');

    const uiStageEls = qa('[data-ui-stage]');
    const dmEls = qa('[data-dm-stage]');

    const INITIAL_EST_USD = 1090;
    const model = {
      guests: 2,
      cabin: 'reserved',
      onsen: true,
      estUsd: INITIAL_EST_USD,
      held: false,
    };

    const flashTimers = new Map();
    let actionPulseTimer = 0;

    const visibleUiSet = new Set([0, 1, 2]);

    let elapsedMs = DURATION_MS;
    let isPlaying = false;
    let hasUserOrAutoStarted = false;
    let rafId = 0;
    let lastTs = 0;

    function computeTotalUsd() {
      const railPerGuest = model.cabin === 'green' ? 167 : 135;
      const railCost = railPerGuest * model.guests;
      const extraGuestStay = Math.max(0, model.guests - 2) * 140;
      const stayCost = 725 + extraGuestStay + (model.onsen ? 95 : 0);
      return railCost + stayCost;
    }

    function applyCodeProgress(chunks, caretEl, ms) {
      let activeChunkEl = null;
      chunks.forEach((chunk, i) => {
        const cfg = STAGES[i];
        if (ms < cfg.codeStart) {
          chunk.el.hidden = true;
          chunk.el.classList.remove('is-streaming', 'is-done');
          return;
        }
        chunk.el.hidden = false;
        const ratio = Math.min(1, (ms - cfg.codeStart) / (cfg.codeEnd - cfg.codeStart));
        const charBudget = ratio >= 1 ? chunk.total : Math.floor(ratio * chunk.total);

        for (let k = 0; k < chunk.nodes.length; k++) {
          const item = chunk.nodes[k];
          if (charBudget >= item.end) {
            if (item.node.nodeValue !== item.full) item.node.nodeValue = item.full;
          } else if (charBudget <= item.start) {
            if (item.node.nodeValue !== '') item.node.nodeValue = '';
          } else {
            item.node.nodeValue = item.full.slice(0, charBudget - item.start);
          }
        }

        const streamingThis = ratio < 1 && ms < DURATION_MS;
        chunk.el.classList.toggle('is-streaming', streamingThis);
        chunk.el.classList.toggle('is-done', ratio >= 1);
        if (streamingThis) activeChunkEl = chunk.el;
      });

      if (activeChunkEl && isPlaying) {
        activeChunkEl.appendChild(caretEl);
        caretEl.classList.add('is-visible');
      } else {
        caretEl.classList.remove('is-visible');
      }
    }

    function syncActionFeedback(clamped) {
      const showHeld = model.held && clamped >= STAGES[2].uiAppear;
      chatConfirm.hidden = !showHeld;
      wireAction.classList.toggle('is-sent', showHeld);
      if (!showHeld) {
        wireAction.classList.remove('is-pulsing');
      }
    }

    function renderTimeline(ms) {
      const clamped = Math.max(0, Math.min(DURATION_MS, ms));
      const streaming = clamped < DURATION_MS;

      agentDot.classList.toggle('is-streaming', streaming && isPlaying);

      applyCodeProgress(expressChunks, caretExpress, clamped);

      agentLead.classList.toggle('is-hidden-stage', clamped < 120);
      surfaceCard.classList.toggle('is-hidden-stage', clamped < 240);
      surfaceCard.classList.toggle('is-streaming', streaming && clamped >= 240);

      uiStageEls.forEach((el) => {
        const idx = Number(el.getAttribute('data-ui-stage'));
        const cfg = STAGES[idx];
        const show = clamped >= cfg.uiAppear;
        if (show) {
          el.classList.remove('is-hidden-stage');
          if (!visibleUiSet.has(idx)) {
            visibleUiSet.add(idx);
            el.classList.remove('is-entering');
            void el.offsetWidth;
            el.classList.add('is-entering');
          }
        } else {
          visibleUiSet.delete(idx);
          el.classList.remove('is-entering');
          el.classList.add('is-hidden-stage');
        }
      });

      skeleton.hidden = !(clamped >= 240 && clamped < STAGES[2].uiAppear);

      dmEls.forEach((el) => {
        const reqStage = Number(el.getAttribute('data-dm-stage'));
        const ready = clamped >= STAGES[reqStage].codeEnd;
        el.classList.toggle('is-pending', !ready);
      });

      wireStream.classList.toggle('is-pulsing', streaming && clamped >= 80);
      wireStream.classList.toggle('is-sent', clamped >= 80);

      syncActionFeedback(clamped);
    }

    function tick(now) {
      if (!isPlaying) return;
      if (!lastTs) lastTs = now;
      const dt = Math.min(now - lastTs, 100);
      lastTs = now;
      elapsedMs = Math.min(DURATION_MS, elapsedMs + dt);
      renderTimeline(elapsedMs);
      if (elapsedMs >= DURATION_MS) {
        isPlaying = false;
        renderTimeline(DURATION_MS);
        return;
      }
      rafId = requestAnimationFrame(tick);
    }

    function resetModelState() {
      model.guests = 2;
      model.cabin = 'reserved';
      model.onsen = true;
      model.estUsd = INITIAL_EST_USD;
      model.held = false;
      if (actionPulseTimer) {
        clearTimeout(actionPulseTimer);
        actionPulseTimer = 0;
      }
      flashTimers.forEach((tid) => clearTimeout(tid));
      flashTimers.clear();
      dmEls.forEach((el) => el.classList.remove('is-flash'));
      wireAction.classList.remove('is-pulsing', 'is-sent');
      renderMobileDataModel();
    }

    function startPlayback() {
      hasUserOrAutoStarted = true;
      cancelAnimationFrame(rafId);
      resetModelState();
      elapsedMs = 0;
      visibleUiSet.clear();
      isPlaying = true;
      lastTs = 0;
      renderTimeline(elapsedMs);
      rafId = requestAnimationFrame(tick);
    }

    restartBtn.addEventListener('click', () => {
      startPlayback();
    });

    function flashDataModelPill(id) {
      const el = q(`#${id}`);
      if (!el) return;
      if (flashTimers.has(id)) {
        clearTimeout(flashTimers.get(id));
      }
      el.classList.remove('is-flash');
      void el.offsetWidth;
      el.classList.add('is-flash');
      const tid = setTimeout(() => {
        el.classList.remove('is-flash');
        flashTimers.delete(id);
      }, 450);
      flashTimers.set(id, tid);
    }

    function renderMobileDataModel() {
      const guestSlider = q('#hc-guest-slider');
      guestSlider.value = String(model.guests);
      guestSlider.setAttribute('aria-valuetext', String(model.guests));
      q('#hc-guests-label').textContent = String(model.guests);

      const onsenBtn = q('#hc-onsen-btn');
      onsenBtn.classList.toggle('is-checked', model.onsen);
      onsenBtn.setAttribute('aria-checked', String(model.onsen));

      qa('[data-cabin]').forEach((btn) => {
        const sel = btn.getAttribute('data-cabin') === model.cabin;
        btn.classList.toggle('is-selected', sel);
        btn.setAttribute('aria-checked', String(sel));
        btn.tabIndex = sel ? 0 : -1;
      });

      model.estUsd = computeTotalUsd();
      q('#hc-total-price').textContent = `$${model.estUsd.toLocaleString('en-US')}`;

      const holdBtn = q('#hc-hold-btn');
      const holdLbl = q('#hc-hold-btn-label');
      holdBtn.classList.toggle('is-confirmed', model.held);
      holdLbl.textContent = model.held ? '✓ Itinerary Held' : 'Hold Itinerary';

      syncActionFeedback(elapsedMs);

      q('#hc-dm-guests-val').textContent = String(model.guests);
      q('#hc-dm-cabin-val').textContent = `["${model.cabin}"]`;
      q('#hc-dm-onsen-val').textContent = String(model.onsen);
      q('#hc-dm-total-val').textContent = String(model.estUsd);
    }

    function markLocalEdit(pillId) {
      model.held = false;
      if (actionPulseTimer) {
        clearTimeout(actionPulseTimer);
        actionPulseTimer = 0;
      }
      wireAction.classList.remove('is-pulsing', 'is-sent');
      renderMobileDataModel();
      flashDataModelPill(pillId);
      flashDataModelPill('hc-dm-total');
    }

    qa('[role="radiogroup"]').forEach((group) => {
      group.addEventListener('keydown', (e) => {
        if (
          e.key !== 'ArrowRight' &&
          e.key !== 'ArrowDown' &&
          e.key !== 'ArrowLeft' &&
          e.key !== 'ArrowUp'
        ) {
          return;
        }
        const radios = Array.from(group.querySelectorAll('[role="radio"]'));
        const idx = radios.indexOf(document.activeElement);
        if (idx === -1) return;
        e.preventDefault();
        const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : -1;
        const next = radios[(idx + dir + radios.length) % radios.length];
        next.focus();
        next.click();
      });
    });

    qa('[data-cabin]').forEach((btn) => {
      btn.addEventListener('click', () => {
        model.cabin = btn.getAttribute('data-cabin');
        markLocalEdit('hc-dm-cabin');
      });
    });

    q('#hc-guest-slider').addEventListener('input', (e) => {
      model.guests = Math.max(1, Math.min(4, Number(e.target.value)));
      markLocalEdit('hc-dm-guests');
    });

    q('#hc-onsen-btn').addEventListener('click', () => {
      model.onsen = !model.onsen;
      markLocalEdit('hc-dm-onsen');
    });

    q('#hc-hold-btn').addEventListener('click', () => {
      model.held = true;
      renderMobileDataModel();
      flashDataModelPill('hc-dm-total');
      q('[data-hc-el="confirm-total"]').textContent = `$${model.estUsd.toLocaleString('en-US')}`;
      if (actionPulseTimer) clearTimeout(actionPulseTimer);
      wireAction.classList.add('is-pulsing', 'is-sent');
      actionPulseTimer = setTimeout(() => {
        wireAction.classList.remove('is-pulsing');
        actionPulseTimer = 0;
      }, 900);
    });

    renderMobileDataModel();

    const prefersReducedMotion =
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      renderTimeline(DURATION_MS);
    } else if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              observer.disconnect();
              if (!hasUserOrAutoStarted) {
                startPlayback();
              }
            }
          });
        },
        { threshold: 0.25 },
      );
      observer.observe(root);
    } else {
      startPlayback();
    }
  })();
</script>
