---

<div class="hm-root" id="hero-chat-visual" role="region" aria-label="Abstract Generative UI structural modes">
  <!-- Architectural Mode Ledger (Zero Pills — Clean 4-Column Structural Index) -->
  <div class="hm-ledger" role="tablist" aria-label="Select a Generative UI mode">
    <button type="button" role="tab" aria-selected="true" class="hm-ledger__item is-active" data-hm-mode="chat">
      <span class="hm-ledger__idx">01 // THREADED</span>
      <strong class="hm-ledger__title">In-Chat Stream</strong>
    </button>

    <button type="button" role="tab" aria-selected="false" class="hm-ledger__item" data-hm-mode="sidebar">
      <span class="hm-ledger__idx">02 // SPLIT-PANE</span>
      <strong class="hm-ledger__title">Copilot Sidebar</strong>
    </button>

    <button type="button" role="tab" aria-selected="false" class="hm-ledger__item" data-hm-mode="dashboard">
      <span class="hm-ledger__idx">03 // ADAPTIVE</span>
      <strong class="hm-ledger__title">Dynamic Dashboard</strong>
    </button>

    <button type="button" role="tab" aria-selected="false" class="hm-ledger__item" data-hm-mode="canvas">
      <span class="hm-ledger__idx">04 // MULTI-SURFACE</span>
      <strong class="hm-ledger__title">Spatial Canvas</strong>
    </button>
  </div>

  <!-- Minimal Architectural Caption + Lens Switch -->
  <div class="hm-meta-bar">
    <p class="hm-meta-bar__desc" id="hm-mode-desc">
      <span class="hm-meta-bar__tag">MODE 01</span>
      Interactive A2UI surface injected directly inside a chronological message stream.
    </p>

    <div class="hm-lens" role="group" aria-label="Switch viewport lens">
      <button type="button" class="hm-lens__btn is-active" data-hm-lens="ui">Visual Mode</button>
      <button type="button" class="hm-lens__btn" data-hm-lens="wire">Wire JSON</button>
    </div>
  </div>

  <!-- =====================================================================
       ABSTRACT HOST VIEWPORT STAGE
       ===================================================================== -->
  <div class="hm-stage">
    <!-- LENS 1: INTERACTIVE STRUCTURAL MODES -->
    <div class="hm-lens-view is-active" data-hm-view="ui">

      <!-- =================================================================
           MODE 01: IN-CHAT STREAM (THREADED INLINE SURFACE)
           ================================================================= -->
      <div class="hm-scene is-active" data-hm-panel="chat">
        <div class="hm-frame hm-frame--chat">
          <div class="hm-frame__chrome">
            <span class="hm-chrome-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="hm-chrome-label">HOST // CONVERSATION THREAD</span>
            <span class="hm-chrome-meta">surfaceId: "turn_04"</span>
          </div>

          <div class="hm-chat-viewport">
            <!-- Abstract Prior User Turn (Quiet Wireframe) -->
            <div class="hm-skel-turn hm-skel-turn--user" aria-hidden="true">
              <div class="hm-skel-bubble">
                <span class="hm-skel-line hm-skel-line--w72"></span>
                <span class="hm-skel-line hm-skel-line--w44"></span>
              </div>
              <span class="hm-skel-avatar">U</span>
            </div>

            <!-- Abstract Agent Intro Line -->
            <div class="hm-skel-turn" aria-hidden="true">
              <span class="hm-skel-avatar hm-skel-avatar--ai">AI</span>
              <div class="hm-skel-lines">
                <span class="hm-skel-line hm-skel-line--w56"></span>
              </div>
            </div>

            <!-- MOUNTED INLINE A2UI SURFACE (High-Contrast Focal Element) -->
            <div class="hm-a2-surface hm-chat-surface">
              <div class="hm-a2-surface__bar">
                <span>A2UI INLINE SURFACE</span>
                <span id="hm-chat-readout">PRESET B · 72% WEIGHT</span>
              </div>

              <div class="hm-chat-presets" role="radiogroup" aria-label="Abstract configuration preset">
                <button type="button" class="hm-preset" data-chat-preset="PRESET A" data-chat-val="38">
                  <svg viewBox="0 0 36 20" aria-hidden="true">
                    <rect x="2" y="11" width="6" height="7" fill="currentColor" opacity="0.5" />
                    <rect x="12" y="7" width="6" height="11" fill="currentColor" opacity="0.75" />
                    <rect x="22" y="3" width="6" height="15" fill="currentColor" />
                  </svg>
                  <strong>Preset A</strong>
                  <span>Low latency</span>
                </button>

                <button type="button" class="hm-preset is-selected" data-chat-preset="PRESET B" data-chat-val="72">
                  <svg viewBox="0 0 36 20" aria-hidden="true">
                    <rect x="2" y="5" width="6" height="13" fill="currentColor" opacity="0.65" />
                    <rect x="12" y="2" width="6" height="16" fill="currentColor" />
                    <rect x="22" y="6" width="6" height="12" fill="currentColor" opacity="0.65" />
                  </svg>
                  <strong>Preset B</strong>
                  <span>Balanced</span>
                </button>

                <button type="button" class="hm-preset" data-chat-preset="PRESET C" data-chat-val="94">
                  <svg viewBox="0 0 36 20" aria-hidden="true">
                    <rect x="2" y="3" width="6" height="15" fill="currentColor" />
                    <rect x="12" y="3" width="6" height="15" fill="currentColor" />
                    <rect x="22" y="2" width="6" height="16" fill="currentColor" />
                  </svg>
                  <strong>Preset C</strong>
                  <span>Max depth</span>
                </button>
              </div>

              <div class="hm-chat-controls">
                <div class="hm-slider-group">
                  <div class="hm-slider-group__lbl">
                    <span>PARAMETER WEIGHT</span>
                    <strong id="hm-chat-pct">72%</strong>
                  </div>
                  <input type="range" id="hm-chat-slider" class="hm-range" min="10" max="100" value="72" aria-label="Parameter weight" />
                </div>

                <button type="button" class="hm-cta" id="hm-chat-commit">
                  <span>Commit in Thread</span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>

            <!-- Quiet Composer Skeleton at Base -->
            <div class="hm-chat-composer" aria-hidden="true">
              <span class="hm-skel-line hm-skel-line--w32"></span>
              <span class="hm-composer-enter">↵</span>
            </div>
          </div>
        </div>
      </div>

      <!-- =================================================================
           MODE 02: COPILOT SIDEBAR (DOCKED SPLIT-PANE WORKSPACE)
           ================================================================= -->
      <div class="hm-scene" data-hm-panel="sidebar">
        <div class="hm-frame">
          <div class="hm-frame__chrome">
            <span class="hm-chrome-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="hm-chrome-label">HOST // PRIMARY WORKSPACE + DOCKED A2UI SIDEBAR</span>
            <span class="hm-chrome-meta">surfaceId: "copilot_rail"</span>
          </div>

          <div class="hm-sidebar-split">
            <!-- Left: Host Application Document / Canvas (Mutates Live!) -->
            <div class="hm-doc-stage">
              <div class="hm-doc-stage__hdr" aria-hidden="true">
                <span>HOST ARTIFACT CANVAS</span>
                <span id="hm-doc-state-lbl">SPLIT · 16PX GAP</span>
              </div>

              <div class="hm-doc-canvas is-accented" id="hm-doc-canvas" data-layout="split" style="--doc-gap: 16px;">
                <div class="hm-doc-block hm-doc-block--hero">
                  <span class="hm-skel-line hm-skel-line--w44"></span>
                  <span class="hm-skel-line hm-skel-line--w72"></span>
                </div>
                <div class="hm-doc-block hm-doc-block--a">
                  <span class="hm-doc-glyph"></span>
                  <span class="hm-skel-line hm-skel-line--w56"></span>
                </div>
                <div class="hm-doc-block hm-doc-block--b">
                  <span class="hm-doc-glyph"></span>
                  <span class="hm-skel-line hm-skel-line--w44"></span>
                </div>
                <div class="hm-doc-block hm-doc-block--c">
                  <span class="hm-skel-line hm-skel-line--w72"></span>
                  <span class="hm-skel-line hm-skel-line--w32"></span>
                </div>
              </div>
            </div>

            <!-- Right: Docked A2UI Copilot Surface -->
            <aside class="hm-a2-surface hm-copilot-pane" aria-label="Docked A2UI Copilot controls">
              <div class="hm-a2-surface__bar">
                <span>A2UI SIDEBAR</span>
                <span>LIVE STEERING</span>
              </div>

              <div class="hm-skel-lines hm-copilot-prompt" aria-hidden="true">
                <span class="hm-skel-line hm-skel-line--w72"></span>
                <span class="hm-skel-line hm-skel-line--w44"></span>
              </div>

              <div class="hm-ctrl-block">
                <span class="hm-ctrl-lbl">CANVAS TOPOLOGY</span>
                <div class="hm-seg-row" role="radiogroup" aria-label="Canvas topology">
                  <button type="button" class="hm-seg" data-sb-layout="editorial">Editorial</button>
                  <button type="button" class="hm-seg is-selected" data-sb-layout="split">Split</button>
                  <button type="button" class="hm-seg" data-sb-layout="bento">Bento</button>
                </div>
              </div>

              <div class="hm-ctrl-block">
                <div class="hm-slider-group__lbl">
                  <span>GRID SPACING</span>
                  <strong id="hm-sb-gap-val">16px</strong>
                </div>
                <input type="range" id="hm-sb-gap" class="hm-range" min="6" max="28" value="16" aria-label="Workspace grid spacing" />
              </div>

              <div class="hm-ctrl-block hm-ctrl-block--row">
                <span>Focal Accent</span>
                <button type="button" class="hm-switch is-on" id="hm-sb-accent" role="switch" aria-checked="true">
                  <span>ON</span>
                </button>
              </div>
            </aside>
          </div>
        </div>
      </div>

      <!-- =================================================================
           MODE 03: DYNAMIC DASHBOARD (INTENT-ASSEMBLED COMMAND SURFACE)
           ================================================================= -->
      <div class="hm-scene" data-hm-panel="dashboard">
        <div class="hm-frame">
          <div class="hm-frame__chrome">
            <span class="hm-chrome-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="hm-chrome-label">HOST // ADAPTIVE COMMAND VIEWPORT</span>
            <span class="hm-chrome-meta">surfaceId: "dash_grid"</span>
          </div>

          <div class="hm-dash-stage">
            <!-- Top Intent Switcher -->
            <div class="hm-dash-intent">
              <span class="hm-ctrl-lbl">ACTIVE INTENT ›</span>
              <div class="hm-seg-row" role="tablist" aria-label="Dashboard intent">
                <button type="button" class="hm-seg is-selected" data-db-intent="overview">System Overview</button>
                <button type="button" class="hm-seg" data-db-intent="anomaly">Anomaly Triage</button>
                <button type="button" class="hm-seg" data-db-intent="capacity">Capacity Allocation</button>
              </div>
            </div>

            <!-- Self-Assembling A2UI Dashboard Grid -->
            <div class="hm-a2-surface hm-dash-grid" id="hm-dash-grid" data-intent="overview">
              <div class="hm-a2-surface__bar hm-dash-grid__bar">
                <span>A2UI ASSEMBLED SURFACE</span>
                <span id="hm-db-schema-tag">3 MODULES MOUNTED</span>
              </div>

              <!-- Module A: Primary Telemetry Plot -->
              <div class="hm-db-card hm-db-card--chart">
                <div class="hm-db-card__hdr">
                  <span id="hm-db-chart-title">SIGNAL THROUGHPUT</span>
                  <strong id="hm-db-kpi-main">98.4%</strong>
                </div>

                <svg viewBox="0 0 380 120" class="hm-db-svg" aria-hidden="true">
                  <line x1="0" y1="30" x2="380" y2="30" stroke="var(--a2-border)" stroke-dasharray="2 4" />
                  <line x1="0" y1="90" x2="380" y2="90" stroke="var(--a2-border)" stroke-dasharray="2 4" />
                  <!-- Live movable threshold line -->
                  <line id="hm-db-thresh-line" x1="0" y1="54" x2="380" y2="54" stroke="var(--a2-accent)" stroke-width="1.2" stroke-dasharray="5 4" />
                  <path id="hm-db-area" d="M8 96 C85 88, 160 62, 245 48 C305 38, 340 28, 372 22 L372 114 L8 114 Z" fill="var(--a2-accent-soft)" />
                  <path id="hm-db-curve" d="M8 96 C85 88, 160 62, 245 48 C305 38, 340 28, 372 22" fill="none" stroke="var(--a2-accent)" stroke-width="2.4" />
                </svg>
              </div>

              <!-- Module B: Abstract Distribution Bars -->
              <div class="hm-db-card">
                <div class="hm-db-card__hdr">
                  <span>NODE DISTRIBUTION</span>
                  <strong id="hm-db-kpi-sub">4 ACTIVE</strong>
                </div>
                <div class="hm-db-bars" id="hm-db-bars" aria-hidden="true">
                  <i style="height: 78%"></i>
                  <i style="height: 54%"></i>
                  <i style="height: 92%" class="is-hi"></i>
                  <i style="height: 64%"></i>
                  <i style="height: 42%"></i>
                  <i style="height: 84%"></i>
                </div>
              </div>

              <!-- Module C: Live Bound Threshold Control -->
              <div class="hm-db-card">
                <div class="hm-db-card__hdr">
                  <span>ALERT CEILING</span>
                  <strong id="hm-db-floor-val">0.68</strong>
                </div>
                <input type="range" id="hm-db-floor" class="hm-range" min="20" max="90" value="68" aria-label="Alert ceiling threshold" />
                <span class="hm-db-hint">Binds threshold line in 0ms</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- =================================================================
           MODE 04: SPATIAL CANVAS (MULTI-SURFACE GRAPH WORKSPACE)
           ================================================================= -->
      <div class="hm-scene" data-hm-panel="canvas">
        <div class="hm-frame">
          <div class="hm-frame__chrome">
            <span class="hm-chrome-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="hm-chrome-label">HOST // INFINITE SPATIAL CANVAS</span>
            <span class="hm-chrome-meta">3 LINKED A2UI SURFACES</span>
          </div>

          <div class="hm-canvas-field">
            <!-- SVG Bezier Signal Connectors -->
            <svg class="hm-canvas-wires" viewBox="0 0 1000 280" preserveAspectRatio="none" aria-hidden="true">
              <path d="M 306 142 C 326 142, 328 118, 348 118" fill="none" stroke="var(--a2-accent)" stroke-width="2" stroke-dasharray="4 3" />
              <path d="M 652 118 C 672 118, 674 156, 694 156" fill="none" stroke="var(--a2-accent)" stroke-width="2" />
              <circle cx="306" cy="142" r="4.5" fill="var(--a2-accent)" />
              <circle cx="348" cy="118" r="4.5" fill="var(--a2-accent)" />
              <circle cx="652" cy="118" r="4.5" fill="var(--a2-accent)" />
              <circle cx="694" cy="156" r="4.5" fill="var(--a2-accent)" />
            </svg>

            <div class="hm-canvas-nodes">
              <!-- Node 01: Signal Source -->
              <div class="hm-a2-surface hm-node hm-node--1">
                <div class="hm-a2-surface__bar">
                  <span>SURFACE 01</span>
                  <span>SOURCE</span>
                </div>
                <div class="hm-node__opts" role="radiogroup" aria-label="Canvas source wave">
                  <button type="button" class="hm-seg is-selected" data-cv-src="1.0" data-cv-lbl="WAVE α">Wave α</button>
                  <button type="button" class="hm-seg" data-cv-src="1.45" data-cv-lbl="WAVE β">Wave β</button>
                </div>
              </div>

              <!-- Node 02: Transform Operator -->
              <div class="hm-a2-surface hm-node hm-node--2">
                <div class="hm-a2-surface__bar">
                  <span>SURFACE 02</span>
                  <span>TRANSFORM</span>
                </div>
                <div class="hm-slider-group__lbl">
                  <span>GAIN</span>
                  <strong id="hm-cv-gain-lbl">1.8×</strong>
                </div>
                <input type="range" id="hm-cv-gain" class="hm-range" min="10" max="30" value="18" aria-label="Spatial transform gain" />
              </div>

              <!-- Node 03: Live Output Synthesis -->
              <div class="hm-a2-surface hm-node hm-node--3">
                <div class="hm-a2-surface__bar">
                  <span>SURFACE 03</span>
                  <span id="hm-cv-out-lbl">WAVE α · 86 HZ</span>
                </div>
                <div class="hm-cv-spectrum" id="hm-cv-bars" aria-hidden="true">
                  <i style="height: 36%"></i>
                  <i style="height: 62%"></i>
                  <i style="height: 88%"></i>
                  <i style="height: 54%"></i>
                  <i style="height: 94%"></i>
                  <i style="height: 70%"></i>
                  <i style="height: 44%"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- ===================================================================
         LENS 2: DECLARATIVE A2UI WIRE JSON
         =================================================================== -->
    <div class="hm-lens-view" data-hm-view="wire">
      <div class="hm-wire-sheet">
        <div class="hm-wire-sheet__hdr">
          <span>A2UI v1.0 STREAMED DESCRIPTOR // ZERO SCRIPTS</span>
          <span id="hm-wire-target">MODE 01 · IN-CHAT STREAM</span>
        </div>
        <pre class="hm-wire-sheet__code" id="hm-wire-code"><code>&#123; "createSurface": &#123; "surfaceId": "turn_04", "mount": "chat.inline", "catalogId": "core.v1" &#125; &#125;
&#123; "updateComponents": &#123; "surfaceId": "turn_04", "components": [
    &#123; "id": "root", "component": "ChoiceGroup", "options": ["Preset A", "Preset B", "Preset C"], "value": &#123; "path": "/preset" &#125; &#125;,
    &#123; "id": "weight", "component": "Slider", "value": &#123; "path": "/weight" &#125; &#125;,
    &#123; "id": "commit", "component": "Button", "label": "Commit in Thread", "action": "applyTurn" &#125;
] &#125; &#125;</code></pre>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.getElementById('hero-chat-visual');
    if (!root) return;

    const modeMeta = {
      chat: {
        tag: 'MODE 01',
        desc: 'Interactive A2UI surface injected directly inside a chronological message stream.',
        target: 'MODE 01 · IN-CHAT STREAM',
        wire: `{ "createSurface": { "surfaceId": "turn_04", "mount": "chat.inline", "catalogId": "core.v1" } }
{ "updateComponents": { "surfaceId": "turn_04", "components": [
    { "id": "root", "component": "ChoiceGroup", "options": ["Preset A", "Preset B", "Preset C"], "value": { "path": "/preset" } },
    { "id": "weight", "component": "Slider", "value": { "path": "/weight" } },
    { "id": "commit", "component": "Button", "label": "Commit in Thread", "action": "applyTurn" }
] } }`,
      },
      sidebar: {
        tag: 'MODE 02',
        desc: 'Persistent side-panel surface docked beside a primary workspace to steer live artifacts.',
        target: 'MODE 02 · COPILOT SIDEBAR',
        wire: `{ "createSurface": { "surfaceId": "copilot_rail", "mount": "workspace.sidebar", "catalogId": "editor.v1" } }
{ "updateComponents": { "surfaceId": "copilot_rail", "components": [
    { "id": "topology", "component": "SegmentedControl", "options": ["Editorial", "Split", "Bento"], "value": { "path": "/layout" } },
    { "id": "gap", "component": "Slider", "min": 6, "max": 28, "value": { "path": "/gridGap" } },
    { "id": "focus", "component": "Switch", "label": "Focal Accent", "value": { "path": "/accent" } }
] } }`,
      },
      dashboard: {
        tag: 'MODE 03',
        desc: 'Command surface that dynamically composes KPIs, plots, and bound controls per user intent.',
        target: 'MODE 03 · DYNAMIC DASHBOARD',
        wire: `{ "createSurface": { "surfaceId": "dash_grid", "mount": "command.grid", "catalogId": "telemetry.v1" } }
{ "updateComponents": { "surfaceId": "dash_grid", "components": [
    { "id": "plot", "component": "AreaSeries", "series": { "path": "/signal" }, "ceiling": { "path": "/ceiling" } },
    { "id": "dist", "component": "BarDistribution", "bins": { "path": "/nodes" } },
    { "id": "ctrl", "component": "ThresholdSlider", "value": { "path": "/ceiling" } }
] } }`,
      },
      canvas: {
        tag: 'MODE 04',
        desc: 'Connected micro-surfaces floating on a 2D spatial graph with live cross-surface state.',
        target: 'MODE 04 · SPATIAL CANVAS',
        wire: `{ "createSurface": { "surfaceId": "node_01", "mount": "canvas.node", "position": [80, 110] } }
{ "createSurface": { "surfaceId": "node_02", "mount": "canvas.node", "position": [365, 84] } }
{ "createSurface": { "surfaceId": "node_03", "mount": "canvas.node", "position": [655, 126] } }
{ "updateDataModel": { "path": "/graph/gain", "value": 1.8 } }`,
      },
    };

    const descEl = document.getElementById('hm-mode-desc');
    const wireTarget = document.getElementById('hm-wire-target');
    const wireCode = document.getElementById('hm-wire-code');
    const tabBtns = root.querySelectorAll('[data-hm-mode]');
    const panels = root.querySelectorAll('[data-hm-panel]');
    const lensBtns = root.querySelectorAll('[data-hm-lens]');
    const lensViews = root.querySelectorAll('[data-hm-view]');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-hm-mode') || 'chat';
        const m = modeMeta[key];
        if (!m) return;
        tabBtns.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach((p) => p.classList.toggle('is-active', p.getAttribute('data-hm-panel') === key));
        if (descEl) {
          descEl.innerHTML = `<span class="hm-meta-bar__tag">${m.tag}</span> ${m.desc}`;
        }
        if (wireTarget) wireTarget.textContent = m.target;
        if (wireCode) wireCode.textContent = m.wire;
      });
    });

    lensBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lens = btn.getAttribute('data-hm-lens') || 'ui';
        lensBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        lensViews.forEach((v) => v.classList.toggle('is-active', v.getAttribute('data-hm-view') === lens));
      });
    });

    /* --- Mode 01: In-Chat Stream --- */
    let chatPreset = 'PRESET B';
    const chatSlider = document.getElementById('hm-chat-slider');
    const chatPct = document.getElementById('hm-chat-pct');
    const chatReadout = document.getElementById('hm-chat-readout');
    const chatCommit = document.getElementById('hm-chat-commit');

    const syncChat = () => {
      const val = chatSlider ? chatSlider.value : '72';
      if (chatPct) chatPct.textContent = `${val}%`;
      if (chatReadout) chatReadout.textContent = `${chatPreset} · ${val}% WEIGHT`;
      if (chatCommit) {
        chatCommit.classList.remove('is-done');
        chatCommit.innerHTML = '<span>Commit in Thread</span><span aria-hidden="true">→</span>';
      }
    };

    root.querySelectorAll('[data-chat-preset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        chatPreset = btn.getAttribute('data-chat-preset') || 'PRESET B';
        const v = btn.getAttribute('data-chat-val') || '72';
        root.querySelectorAll('[data-chat-preset]').forEach((b) => b.classList.toggle('is-selected', b === btn));
        if (chatSlider) chatSlider.value = v;
        syncChat();
      });
    });
    if (chatSlider) chatSlider.addEventListener('input', syncChat);
    if (chatCommit) {
      chatCommit.addEventListener('click', () => {
        chatCommit.classList.add('is-done');
        chatCommit.innerHTML = `<span>✓ Applied · ${chatPreset}</span>`;
      });
    }

    /* --- Mode 02: Copilot Sidebar --- */
    const docCanvas = document.getElementById('hm-doc-canvas');
    const docStateLbl = document.getElementById('hm-doc-state-lbl');
    const sbGap = document.getElementById('hm-sb-gap');
    const sbGapVal = document.getElementById('hm-sb-gap-val');
    const sbAccent = document.getElementById('hm-sb-accent');
    let sbLayout = 'split';

    const syncSidebar = () => {
      const gap = sbGap ? sbGap.value : '16';
      if (sbGapVal) sbGapVal.textContent = `${gap}px`;
      if (docCanvas) {
        docCanvas.setAttribute('data-layout', sbLayout);
        docCanvas.style.setProperty('--doc-gap', `${gap}px`);
      }
      if (docStateLbl) docStateLbl.textContent = `${sbLayout.toUpperCase()} · ${gap}PX GAP`;
    };

    root.querySelectorAll('[data-sb-layout]').forEach((btn) => {
      btn.addEventListener('click', () => {
        sbLayout = btn.getAttribute('data-sb-layout') || 'split';
        root.querySelectorAll('[data-sb-layout]').forEach((b) => b.classList.toggle('is-selected', b === btn));
        syncSidebar();
      });
    });
    if (sbGap) sbGap.addEventListener('input', syncSidebar);
    if (sbAccent && docCanvas) {
      sbAccent.addEventListener('click', () => {
        const on = sbAccent.classList.toggle('is-on');
        sbAccent.setAttribute('aria-checked', on ? 'true' : 'false');
        sbAccent.innerHTML = `<span>${on ? 'ON' : 'OFF'}</span>`;
        docCanvas.classList.toggle('is-accented', on);
      });
    }

    /* --- Mode 03: Dynamic Dashboard --- */
    const dashConfigs = {
      overview: {
        title: 'SIGNAL THROUGHPUT',
        kpi: '98.4%',
        sub: '4 ACTIVE',
        curve: 'M8 96 C85 88, 160 62, 245 48 C305 38, 340 28, 372 22',
        bars: [78, 54, 92, 64, 42, 84],
        hi: 2,
      },
      anomaly: {
        title: 'DRIFT VARIANCE',
        kpi: '0.14σ',
        sub: '1 SPIKE',
        curve: 'M8 88 C75 86, 145 82, 210 24 C265 76, 320 74, 372 70',
        bars: [32, 38, 96, 44, 30, 36],
        hi: 2,
      },
      capacity: {
        title: 'CLUSTER HEADROOM',
        kpi: '64.0%',
        sub: '12 SHARDS',
        curve: 'M8 72 C95 66, 175 58, 255 44 C315 36, 345 34, 372 30',
        bars: [62, 68, 74, 70, 82, 88],
        hi: 5,
      },
    };

    const dbGrid = document.getElementById('hm-dash-grid');
    const dbTitle = document.getElementById('hm-db-chart-title');
    const dbKpi = document.getElementById('hm-db-kpi-main');
    const dbSub = document.getElementById('hm-db-kpi-sub');
    const dbCurve = document.getElementById('hm-db-curve');
    const dbArea = document.getElementById('hm-db-area');
    const dbBars = document.querySelectorAll('#hm-db-bars i');
    const dbFloor = document.getElementById('hm-db-floor');
    const dbFloorVal = document.getElementById('hm-db-floor-val');
    const dbThreshLine = document.getElementById('hm-db-thresh-line');

    root.querySelectorAll('[data-db-intent]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-db-intent') || 'overview';
        const cfg = dashConfigs[key] || dashConfigs.overview;
        root.querySelectorAll('[data-db-intent]').forEach((b) => b.classList.toggle('is-selected', b === btn));
        if (dbGrid) dbGrid.setAttribute('data-intent', key);
        if (dbTitle) dbTitle.textContent = cfg.title;
        if (dbKpi) dbKpi.textContent = cfg.kpi;
        if (dbSub) dbSub.textContent = cfg.sub;
        if (dbCurve) dbCurve.setAttribute('d', cfg.curve);
        if (dbArea) dbArea.setAttribute('d', `${cfg.curve} L372 114 L8 114 Z`);
        dbBars.forEach((bar, idx) => {
          bar.style.height = `${cfg.bars[idx] || 50}%`;
          bar.classList.toggle('is-hi', idx === cfg.hi);
        });
      });
    });

    if (dbFloor) {
      dbFloor.addEventListener('input', () => {
        const v = Number(dbFloor.value);
        if (dbFloorVal) dbFloorVal.textContent = (v / 100).toFixed(2);
        const y = Math.round(108 - ((v - 20) / 70) * 84);
        if (dbThreshLine) {
          dbThreshLine.setAttribute('y1', String(y));
          dbThreshLine.setAttribute('y2', String(y));
        }
      });
    }

    /* --- Mode 04: Spatial Canvas --- */
    let cvMult = 1.0;
    let cvName = 'WAVE α';
    const cvGain = document.getElementById('hm-cv-gain');
    const cvGainLbl = document.getElementById('hm-cv-gain-lbl');
    const cvOutLbl = document.getElementById('hm-cv-out-lbl');
    const cvBars = document.querySelectorAll('#hm-cv-bars i');
    const baseSpec = [26, 46, 68, 40, 74, 52, 32];

    const syncCanvas = () => {
      const gain = cvGain ? Number(cvGain.value) / 10 : 1.8;
      if (cvGainLbl) cvGainLbl.textContent = `${gain.toFixed(1)}×`;
      const hz = Math.round(48 * cvMult * (gain / 1.0));
      if (cvOutLbl) cvOutLbl.textContent = `${cvName} · ${hz} HZ`;
      cvBars.forEach((b, idx) => {
        const h = Math.min(98, Math.max(16, Math.round(baseSpec[idx] * cvMult * (gain / 1.6))));
        b.style.height = `${h}%`;
      });
    };

    root.querySelectorAll('[data-cv-src]').forEach((btn) => {
      btn.addEventListener('click', () => {
        cvMult = Number(btn.getAttribute('data-cv-src') || '1.0');
        cvName = btn.getAttribute('data-cv-lbl') || 'WAVE α';
        root.querySelectorAll('[data-cv-src]').forEach((b) => b.classList.toggle('is-selected', b === btn));
        syncCanvas();
      });
    });
    if (cvGain) cvGain.addEventListener('input', syncCanvas);
  })();
</script>

