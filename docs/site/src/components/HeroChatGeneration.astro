const mermaidSpec = `
sequenceDiagram
  actor User as Mobile Chat User
  participant App as Mobile Renderer SDK
  participant Agent as Agent + A2UI Agent SDK
  User->>Agent: "Plan a weekend in Kyoto for 2 with bullet train and a ryokan stay."
  Agent-->>App: Stream <a2ui> Express (surface "kyoto_trip": hero, options, summary)
  App-->>User: Progressively mounts native UI cards bound to local dataModel
  User->>App: Adjusts cabin chips, Guests slider, Private Onsen checkbox (0ms local dataModel sync)
  User->>App: Taps Hold Itinerary
  App->>Agent: Event("confirm_trip", {guests, cabin, onsen})
`;
---

<div
  class="hc-shell"
  id="hero-chat-visual"
  role="region"
  aria-label="How A2UI streams interactive mobile chat interfaces"
>
  <div class="hc-stage">
    <!-- LEFT: Quiet, Soft-Toned A2UI Express Stream + Single-Line Local dataModel Strip -->
    <div class="hc-left-col">
      <div class="hc-agent">
        <div class="hc-agent__head">
          <div class="hc-agent__title-group">
            <span class="hc-live-dot" data-hc-el="agent-dot" aria-hidden="true"></span>
            <span class="hc-agent__title">A2UI Express stream</span>
            <code class="hc-surface-id">kyoto_trip</code>
          </div>

          <button
            type="button"
            class="hc-restart-btn"
            id="hc-restart-btn"
            title="Restart stream"
            aria-label="Restart UI generation stream"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
              <path d="M3 3v5h5" />
            </svg>
          </button>
        </div>

        <!-- Streaming Express Viewport -->
        <div class="hc-stream-viewport" data-hc-el="stream-viewport">
          <pre
            class="hc-code"
            id="hc-code-express"
            tabindex="0"
            aria-label="A2UI Express stream"
          ><span class="hc-chunk" data-chunk="0"><span class="hc-kw">&lt;a2ui&gt;</span>
<span class="hc-fn">surface</span>(<span class="hc-str">"kyoto_trip"</span>)
<span class="hc-comp">root</span> = <span class="hc-fn">Column</span>([<span class="hc-comp">hero</span>, <span class="hc-comp">options</span>, <span class="hc-comp">summary</span>])

<span class="hc-comp">hero</span> = <span class="hc-fn">Card</span>(<span class="hc-fn">Column</span>([
  <span class="hc-fn">Image</span>(<span class="hc-str">"https://example.com/kyoto.jpg"</span>, variant=<span class="hc-str">"header"</span>),
  <span class="hc-fn">Text</span>(<span class="hc-str">"Kyoto Weekend Escape · Oct 16–18"</span>)
]))
</span><span class="hc-chunk" data-chunk="1"><span class="hc-path">$/cabin</span> = [<span class="hc-str">"reserved"</span>]
<span class="hc-path">$/guests</span> = <span class="hc-num">2</span>
<span class="hc-path">$/onsen</span> = <span class="hc-num">true</span>
<span class="hc-comp">options</span> = <span class="hc-fn">Card</span>(<span class="hc-fn">Column</span>([
  <span class="hc-fn">Row</span>([<span class="hc-fn">Icon</span>(<span class="hc-str">"arrowForward"</span>), <span class="hc-fn">Text</span>(<span class="hc-str">"Shinkansen · Tokyo → Kyoto"</span>)]),
  <span class="hc-fn">ChoicePicker</span>(
    options=[
      &#123;label: <span class="hc-str">"Reserved"</span>, value: <span class="hc-str">"reserved"</span>&#125;,
      &#123;label: <span class="hc-str">"Green Car"</span>, value: <span class="hc-str">"green"</span>&#125;
    ],
    value=<span class="hc-path">$/cabin</span>, displayStyle=<span class="hc-str">"chips"</span>
  ),
  <span class="hc-fn">Slider</span>(<span class="hc-str">"Guests"</span>, <span class="hc-num">1</span>, <span class="hc-num">4</span>, <span class="hc-path">$/guests</span>, <span class="hc-num">3</span>),
  <span class="hc-fn">CheckBox</span>(<span class="hc-str">"Private Onsen (+$95)"</span>, <span class="hc-path">$/onsen</span>)
]))
</span><span class="hc-chunk" data-chunk="2"><span class="hc-path">$/total</span> = <span class="hc-num">1090</span>
<span class="hc-comp">summary</span> = <span class="hc-fn">Card</span>(<span class="hc-fn">Column</span>([
  <span class="hc-fn">Row</span>(
    [<span class="hc-fn">Text</span>(<span class="hc-str">"Estimated Total"</span>), <span class="hc-fn">Text</span>(<span class="hc-fn">formatCurrency</span>(<span class="hc-path">$/total</span>, <span class="hc-str">"USD"</span>, <span class="hc-num">0</span>))],
    <span class="hc-str">"spaceBetween"</span>
  ),
  <span class="hc-fn">Button</span>(
    <span class="hc-fn">Text</span>(<span class="hc-str">"Hold Itinerary"</span>), <span class="hc-str">"primary"</span>,
    <span class="hc-kw">Event</span>(<span class="hc-str">"confirm_trip"</span>, &#123;guests: <span class="hc-path">$/guests</span>, cabin: <span class="hc-path">$/cabin</span>, onsen: <span class="hc-path">$/onsen</span>&#125;)
  )
]))
<span class="hc-kw">&lt;/a2ui&gt;</span></span><span class="hc-caret" data-hc-el="caret-express" aria-hidden="true"></span></pre>
        </div>

        <!-- Subtle Single-Line Local dataModel Footer -->
        <div class="hc-datamodel" id="hc-datamodel-box" aria-label="Local client dataModel">
          <span class="hc-datamodel__label">dataModel</span>
          <div class="hc-datamodel__pills">
            <span class="hc-dm-kv" data-dm-stage="1" id="hc-dm-cabin">
              <code>/cabin</code>: <strong id="hc-dm-cabin-val">["reserved"]</strong>
            </span>
            <span class="hc-dm-kv" data-dm-stage="1" id="hc-dm-guests">
              <code>/guests</code>: <strong id="hc-dm-guests-val">2</strong>
            </span>
            <span class="hc-dm-kv" data-dm-stage="1" id="hc-dm-onsen">
              <code>/onsen</code>: <strong id="hc-dm-onsen-val">true</strong>
            </span>
            <span class="hc-dm-kv hc-dm-kv--accent" data-dm-stage="2" id="hc-dm-total">
              <code>/total</code>: <strong id="hc-dm-total-val">1090</strong>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- CENTER: Slim, Minimal Stream Connector -->
    <div class="hc-bridge" aria-hidden="true">
      <div class="hc-bridge__pills">
        <div class="hc-wire-pill" data-hc-el="wire-stream">
          <span class="hc-wire-pill__name">stream</span>
          <span class="hc-wire-pill__dir hc-dir-desk">→</span>
          <span class="hc-wire-pill__dir hc-dir-stack">↑</span>
        </div>
        <div class="hc-wire-pill hc-wire-pill--return" data-hc-el="wire-action">
          <span class="hc-wire-pill__dir hc-dir-desk">←</span>
          <span class="hc-wire-pill__dir hc-dir-stack">↓</span>
          <span class="hc-wire-pill__name">action</span>
        </div>
      </div>
    </div>

    <!-- RIGHT: Spacious, Prominent Mobile Chat UI (100% 1-to-1 with Express) -->
    <div class="hc-device-col">
      <div class="hc-phone">
        <div class="hc-phone__screen">
          <!-- Minimal Chat Header -->
          <div class="hc-appbar">
            <div class="hc-appbar__avatar" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2L12 3z" />
              </svg>
            </div>
            <div class="hc-appbar__name">Travel Concierge</div>
          </div>

          <!-- Chat Conversation -->
          <div class="hc-chat">
            <!-- User Prompt Bubble -->
            <div class="hc-msg-user">
              <div class="hc-msg-user__bubble">
                Plan a weekend in Kyoto for 2 with bullet train and a ryokan stay.
              </div>
            </div>

            <!-- Agent Response + 1-to-1 Streamed A2UI Surface -->
            <div class="hc-msg-agent" id="hc-agent-reply">
              <div class="hc-msg-agent__lead" data-hc-el="agent-lead">
                Here's a customizable weekend itinerary:
              </div>

              <!-- Root Column([hero, options, summary]) -->
              <div class="hc-surface" data-hc-el="surface-card">
                <!-- CARD 1: hero = Card(Column([Image(..., variant="header"), Text("Kyoto Weekend Escape · Oct 16–18")])) -->
                <div class="hc-ui-stage hc-card hc-card--hero" data-ui-stage="0">
                  <div class="hc-hero-img" aria-hidden="true">
                    <svg
                      class="hc-hero-art"
                      viewBox="0 0 400 94"
                      preserveAspectRatio="xMaxYMid slice"
                    >
                      <defs>
                        <linearGradient id="hc-kyoto-sky" x1="0" y1="0" x2="1" y2="1">
                          <stop offset="0%" stop-color="#0f253e" />
                          <stop offset="58%" stop-color="#1e3f5a" />
                          <stop offset="100%" stop-color="#8b4c39" />
                        </linearGradient>
                        <linearGradient id="hc-sun-glow" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.75" />
                          <stop offset="100%" stop-color="#f59e0b" stop-opacity="0" />
                        </linearGradient>
                      </defs>
                      <rect width="400" height="94" fill="url(#hc-kyoto-sky)" />
                      <circle cx="318" cy="36" r="24" fill="url(#hc-sun-glow)" />
                      <circle cx="318" cy="32" r="10" fill="#fde68a" opacity="0.88" />
                      <path
                        d="M0 70 Q65 42 135 58 T275 52 T400 60 L400 94 L0 94 Z"
                        fill="#152a42"
                        opacity="0.82"
                      />
                      <path
                        d="M0 78 Q100 58 195 72 T400 66 L400 94 L0 94 Z"
                        fill="#0c192a"
                      />
                      <!-- Pagoda silhouette -->
                      <g fill="#081220" transform="translate(268, 22)">
                        <rect x="11" y="0" width="2" height="9" />
                        <path d="M3 12 L12 7 L21 12 Z" />
                        <path d="M1 20 L12 14 L23 20 Z" />
                        <path d="M-1 29 L12 22 L25 29 Z" />
                        <rect x="7" y="29" width="10" height="24" />
                      </g>
                      <!-- Torii gate -->
                      <g transform="translate(326, 38)">
                        <path d="M2 8 Q18 4 34 8 L33 12 Q18 9 3 12 Z" fill="#dc2626" />
                        <rect x="6" y="15" width="24" height="3" rx="1" fill="#ef4444" />
                        <rect x="9" y="11" width="3.2" height="34" fill="#dc2626" />
                        <rect x="23.8" y="11" width="3.2" height="34" fill="#dc2626" />
                      </g>
                    </svg>
                  </div>
                  <div class="hc-hero-title">Kyoto Weekend Escape · Oct 16–18</div>
                </div>

                <!-- CARD 2: options = Card(Column([Row([Icon("arrowForward"), Text(...)]), ChoicePicker(...), Slider(...), CheckBox(...)])) -->
                <div class="hc-ui-stage hc-card" data-ui-stage="1">
                  <!-- Row([Icon("arrowForward"), Text("Shinkansen · Tokyo → Kyoto")]) -->
                  <div class="hc-row-inline">
                    <span class="hc-icon-arrow" aria-hidden="true">→</span>
                    <span class="hc-card__title">Shinkansen · Tokyo → Kyoto</span>
                  </div>

                  <!-- ChoicePicker(options=[...], value=$/cabin, displayStyle="chips") -->
                  <div class="hc-chips" role="radiogroup" aria-label="Shinkansen cabin class">
                    <button
                      type="button"
                      role="radio"
                      aria-checked="true"
                      tabindex="0"
                      class="hc-chip is-selected"
                      data-cabin="reserved"
                    >
                      Reserved
                    </button>
                    <button
                      type="button"
                      role="radio"
                      aria-checked="false"
                      tabindex="-1"
                      class="hc-chip"
                      data-cabin="green"
                      id="hc-green-chip"
                    >
                      Green Car
                    </button>
                  </div>

                  <!-- Slider("Guests", 1, 4, $/guests, 3) -->
                  <div class="hc-slider-row">
                    <label class="hc-slider-row__lbl" for="hc-guest-slider">
                      <span>Guests</span>
                      <strong id="hc-guests-label">2</strong>
                    </label>
                    <input
                      type="range"
                      id="hc-guest-slider"
                      class="hc-guest-slider"
                      min="1"
                      max="4"
                      step="1"
                      value="2"
                      aria-valuetext="2"
                    />
                  </div>

                  <!-- CheckBox("Private Onsen (+$95)", $/onsen) -->
                  <button
                    type="button"
                    role="checkbox"
                    aria-checked="true"
                    class="hc-checkbox is-checked"
                    id="hc-onsen-btn"
                  >
                    <span class="hc-checkbox__box" aria-hidden="true">✓</span>
                    <span class="hc-checkbox__label">Private Onsen (+$95)</span>
                  </button>
                </div>

                <!-- CARD 3: summary = Card(Column([Row([Text("Estimated Total"), Text(formatCurrency(...))], "spaceBetween"), Button(...)])) -->
                <div class="hc-ui-stage hc-card hc-card--summary" data-ui-stage="2">
                  <div class="hc-total-row">
                    <span class="hc-total-row__label">Estimated Total</span>
                    <strong class="hc-total-row__val" id="hc-total-price">$1,090</strong>
                  </div>

                  <button type="button" class="hc-cta-btn" id="hc-hold-btn">
                    <span id="hc-hold-btn-label">Hold Itinerary</span>
                  </button>
                </div>

                <!-- Streaming Skeleton Placeholder -->
                <div class="hc-skeleton" data-hc-el="skeleton" hidden aria-hidden="true">
                  <div class="hc-skeleton__bar hc-skeleton__bar--w60"></div>
                  <div class="hc-skeleton__bar hc-skeleton__bar--w90"></div>
                </div>
              </div>

              <!-- Subtle Action Sent Pill (Appears when Hold Itinerary is clicked) -->
              <div class="hc-chat-confirm" id="hc-chat-confirm" hidden>
                ✓ Sent <code>confirm_trip</code> (<span data-hc-el="confirm-total">$1,090</span>)
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden Machine-Readable Diagram Spec -->
  <script
    type="text/vnd.mermaid"
    data-agent-diagram="spec"
    style="display: none;"
    set:html={mermaidSpec.trim().replace(/<\//g, '<\\/')}
  />
</div>

<style>
  .hc-shell {
    --hc-phone-bg: #0c1527;
    --hc-phone-card: #132038;
    --hc-phone-card-subtle: #0f1a2f;
    --hc-phone-border: #243554;
    --hc-phone-text: #f8fafc;
    --hc-phone-muted: #94a3b8;
    --hc-phone-chip-bg: #182744;

    /* Calm, softer code surface and muted syntax tokens */
    --hc-code-bg: #0c1424;
    --hc-code-head: #101a2e;
    --hc-syn-base: #94a3b8;
    --hc-syn-comp: #cbd5e1;
    --hc-syn-fn: #5eead4;
    --hc-syn-kw: #7dd3fc;
    --hc-syn-path: #93c5fd;
    --hc-syn-str: #cbd5e1;
    --hc-syn-num: #6ee7b7;

    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    text-align: left;
  }

  :global(:root[data-theme='light']) .hc-shell {
    --hc-phone-bg: #f4f7fb;
    --hc-phone-card: #ffffff;
    --hc-phone-card-subtle: #f8fafc;
    --hc-phone-border: #dbe3ef;
    --hc-phone-text: #0f172a;
    --hc-phone-muted: #475569;
    --hc-phone-chip-bg: #eef2f7;

    --hc-code-bg: #f8fafc;
    --hc-code-head: #f1f5f9;
    --hc-syn-base: #64748b;
    --hc-syn-comp: #334155;
    --hc-syn-fn: #0f766e;
    --hc-syn-kw: #0369a1;
    --hc-syn-path: #0284c7;
    --hc-syn-str: #475569;
    --hc-syn-num: #059669;
  }

  .hc-shell [hidden] {
    display: none !important;
  }

  .hc-shell :is(button, input, [tabindex='0']):focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  /* --- Main Stage: Compact Code Left · Slim Bridge · Prominent Mobile UI Right --- */
  .hc-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 86px 444px;
    gap: 16px;
    padding: 22px 24px;
    align-items: center;
  }

  /* --- Left Column: Quiet Express Stream + Single-Line dataModel Footer --- */
  .hc-left-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .hc-agent {
    background: var(--hc-code-bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hc-agent__head {
    padding: 9px 14px;
    background: var(--hc-code-head);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--border);
  }

  .hc-agent__title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hc-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.75;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hc-live-dot.is-streaming {
    background: var(--amber);
    opacity: 1;
    box-shadow: 0 0 0 3px var(--amber-soft);
  }

  .hc-agent__title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .hc-surface-id {
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--surface);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .hc-restart-btn {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.2s ease;
  }

  .hc-restart-btn:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .hc-restart-btn:active {
    transform: rotate(-45deg);
  }

  .hc-stream-viewport {
    position: relative;
    padding: 12px 14px;
    min-height: 446px;
    display: flex;
    align-items: flex-start;
  }

  .hc-code {
    margin: 0;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 10.4px;
    line-height: 1.44;
    color: var(--hc-syn-base);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .hc-chunk {
    display: block;
    padding: 3px 8px;
    margin-bottom: 4px;
    border-left: 2px solid transparent;
    border-radius: 0 5px 5px 0;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .hc-chunk.is-streaming {
    border-left-color: var(--accent);
    background: var(--accent-soft);
  }

  .hc-chunk.is-done {
    border-left-color: var(--border-strong);
  }

  .hc-kw {
    color: var(--hc-syn-kw);
    font-weight: 600;
  }
  .hc-fn {
    color: var(--hc-syn-fn);
    font-weight: 500;
  }
  .hc-comp {
    color: var(--hc-syn-comp);
    font-weight: 500;
  }
  .hc-path {
    color: var(--hc-syn-path);
  }
  .hc-str {
    color: var(--hc-syn-str);
  }
  .hc-num {
    color: var(--hc-syn-num);
  }

  .hc-caret {
    display: none;
    width: 6px;
    height: 13px;
    background: var(--accent);
    vertical-align: text-bottom;
    margin-left: 2px;
    animation: hc-blink 0.8s steps(2, start) infinite;
  }

  .hc-caret.is-visible {
    display: inline-block;
  }

  @keyframes hc-blink {
    to {
      visibility: hidden;
    }
  }

  /* Quiet Single-Line Local dataModel Strip */
  .hc-datamodel {
    padding: 9px 14px;
    background: var(--hc-code-head);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hc-datamodel__label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    flex-shrink: 0;
  }

  .hc-datamodel__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .hc-dm-kv {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2.5px 7px;
    border-radius: 5px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    white-space: nowrap;
    transition: opacity 0.25s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .hc-dm-kv.is-pending {
    opacity: 0.35;
  }

  .hc-dm-kv code {
    color: var(--hc-syn-path);
  }

  .hc-dm-kv strong {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .hc-dm-kv--accent {
    border-color: var(--accent-border);
    background: var(--accent-soft);
  }

  .hc-dm-kv--accent strong {
    color: var(--accent-strong);
  }

  .hc-dm-kv.is-flash {
    border-color: var(--amber);
    background: var(--amber-soft);
  }

  /* --- Center Column: Slim Wire Connector --- */
  .hc-bridge {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hc-bridge::before {
    content: '';
    position: absolute;
    left: -14px;
    right: -14px;
    top: 50%;
    height: 1px;
    border-top: 1.5px dashed var(--border-strong);
    z-index: 0;
  }

  .hc-bridge__pills {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
