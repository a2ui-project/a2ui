</span><span class="hc-chunk" data-chunk="1"><span class="hc-c"># 2. Shinkansen route &amp; cabin ChoicePicker</span>
<span class="hc-path">$/train/cabin</span> = [<span class="hc-str">"reserved"</span>]
<span class="hc-comp">train_card</span> = <span class="hc-fn">Card</span>(<span class="hc-fn">Column</span>([<span class="hc-fn">Row</span>([<span class="hc-fn">Icon</span>(<span class="hc-str">"arrowForward"</span>), <span class="hc-fn">Text</span>(<span class="hc-str">"Nozomi 27 · 08:30 → 10:42"</span>)]),
