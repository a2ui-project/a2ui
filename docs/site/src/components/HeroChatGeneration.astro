  }

  /* horizontal brace under the device: the constant shell */
  .ic-brace {
    position: relative;
    width: 440px;
    max-width: 100%;
    margin-top: 12px;
    padding-top: 9px;
    border-top: 1px solid rgba(248, 250, 252, 0.42);
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    text-align: center;
  }

  .ic-brace::before,
  .ic-brace::after {
    content: '';
    position: absolute;
    top: 0;
    width: 1px;
    height: 8px;
    background: rgba(248, 250, 252, 0.42);
  }

  .ic-brace::before { left: 0; }
  .ic-brace::after { right: 0; }

  .ic-brace__t {
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #f8fafc;
    white-space: nowrap;
  }

  .ic-brace__s {
    font-size: 11px;
    color: rgba(248, 250, 252, 0.68);
    white-space: nowrap;
  }

  /* --- Device + constant shell --- */
  .ic-device {
    width: 328px;
    max-width: 100%;
    background: var(--a2-bg);
    border: 1px solid var(--a2-border-strong);
    border-radius: 28px;
    box-shadow: 0 34px 80px -20px rgba(0, 0, 0, 0.72);
    padding: 12px 14px 12px;
    display: flex;
    flex-direction: column;
  }

  .ic-device__status {
    height: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 8px;
    font-family: var(--a2-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    color: var(--a2-text-muted);
  }

  .ic-device__sig {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
  }

  .ic-device__sig i {
    width: 3px;
    background: var(--a2-text-muted);
    display: block;
  }
  .ic-device__sig i:nth-child(1) { height: 5px; }
  .ic-device__sig i:nth-child(2) { height: 8px; }
  .ic-device__sig i:nth-child(3) { height: 11px; }

  .ic-shell-hdr {
    margin-top: 8px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px;
    border-bottom: 1px solid var(--a2-border);
  }

  .ic-shell-brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--a2-text);
  }

  .ic-shell-brand svg {
    width: 15px;
    height: 15px;
    color: var(--a2-accent);
  }

  .ic-shell-bell {
    width: 16px;
    height: 16px;
    color: var(--a2-text-muted);
  }

  /* Thread: sent prompt on top, composed surface below (fixed height keeps the shell stable) */
  .ic-thread {
    margin-top: 10px;
    height: 432px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ic-sent {
    position: relative;
    z-index: 3;
    align-self: flex-end;
    height: 46px;
    max-width: 88%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    padding: 6px 11px;
    border: 1px solid var(--a2-accent-border);
    border-radius: 12px 12px 3px 12px;
    background: var(--a2-accent-soft);
  }

  .ic-sent p {
    margin: 0;
    font-size: 11px;
    line-height: 1.3;
    color: var(--a2-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ic-sent.is-fly {
    animation: icFlyUp 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes icFlyUp {
    from { transform: translateY(386px) scale(0.96); opacity: 0; }
    30% { opacity: 1; }
    to { transform: none; opacity: 1; }
  }

  .ic-zone {
    position: relative;
    flex: 1;
    min-height: 0;
    box-sizing: border-box;
    padding: 14px 10px 10px;
    border: 1px dashed var(--a2-accent-border);
  }

  .ic-zone__tag {
    position: absolute;
    top: -7px;
    left: 10px;
    padding: 0 5px;
    background: var(--a2-bg);
    font-family: var(--a2-font-mono);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-accent-strong);
  }

  /* Composing skeleton */
  .ic-zone__skel {
    position: absolute;
    inset: 14px 10px 10px;
    display: none;
    flex-direction: column;
    gap: 12px;
    z-index: 2;
  }

  .ic-zone.is-composing .ic-zone__skel { display: flex; }
  .ic-zone.is-composing .ic-screen { visibility: hidden; }

  .ic-zone__skel-lbl {
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-accent-strong);
    margin-bottom: 4px;
  }

  .ic-zone__skel i {
    display: block;
    height: 14px;
    background: var(--a2-border-strong);
    animation: icShimmer 0.9s ease-in-out infinite;
  }

  .ic-zone__skel i:nth-child(3) { animation-delay: 0.12s; }
  .ic-zone__skel i:nth-child(4) { animation-delay: 0.24s; }
  .ic-zone__skel i:nth-child(5) { animation-delay: 0.36s; }

  @keyframes icShimmer {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.9; }
  }

  /* Composer */
  .ic-composer {
    margin-top: 10px;
    height: 46px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 8px 0 10px;
    border: 1px solid var(--a2-border-strong);
    border-radius: 12px;
    background: var(--a2-surface);
    transition: border-color 0.18s ease;
  }

  .ic-composer.is-typing { border-color: var(--a2-accent); }

  .ic-composer__ico {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border: 1.5px solid var(--a2-text-muted);
    border-radius: 50%;
  }

  .ic-composer__txt {
    flex: 1;
    min-width: 0;
    font-size: 11px;
    line-height: 1.3;
    color: var(--a2-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #ic-composer-text:empty::before {
    content: attr(data-placeholder);
    color: var(--a2-text-muted);
  }

  .ic-caret {
    display: none;
    width: 1.5px;
    height: 11px;
    margin-left: 1px;
    vertical-align: -2px;
    background: var(--a2-accent-strong);
    animation: icCaret 0.8s steps(1) infinite;
  }

  .ic-composer.is-typing .ic-caret { display: inline-block; }

  @keyframes icCaret { 50% { opacity: 0; } }

  .ic-composer__send {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--a2-border-strong);
    color: var(--a2-text);
    font-size: 13px;
    font-weight: 700;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  .ic-composer.is-sent .ic-composer__send {
    background: var(--a2-accent);
    color: #04201d;
  }

  .ic-tabbar {
    margin-top: 8px;
    height: 46px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    text-align: center;
    font-family: var(--a2-font-sans);
    font-size: 9.5px;
    font-weight: 600;
    color: var(--a2-text-muted);
  }

  .ic-tabbar span.is-on { color: var(--a2-accent-strong); }

  .ic-tab-ico {
    display: block;
    width: 14px;
    height: 14px;
    margin: 0 auto 4px;
    border: 1.5px solid currentColor;
    border-radius: 3px;
  }

  .ic-tab-ico--assist { border-radius: 50%; }
  .ic-tab-ico--orders { height: 11px; width: 16px; }
  .ic-tab-ico--you { border-radius: 50%; width: 12px; height: 12px; }

  /* =======================================================================
     COMPOSED SCREENS (four structurally different surfaces)
     ======================================================================= */
  .ic-screen {
    display: none;
    height: 100%;
    flex-direction: column;
    gap: 10px;
  }

  .ic-screen.is-active {
    display: flex;
    animation: icFade 0.22s ease-out;
  }

  @keyframes icFade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ic-greet {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 2px 2px 0;
  }

  .ic-greet strong {
    font-size: 15.5px;
    font-weight: 640;
    letter-spacing: -0.02em;
    color: var(--a2-text);
  }

  .ic-greet span {
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-lbl {
    font-family: var(--a2-font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-accent-strong);
  }

  .ic-cta {
    appearance: none;
    margin-top: auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 16px;
    border: 1px solid var(--a2-cta-bg);
    border-radius: 3px;
    background: var(--a2-cta-bg);
    color: var(--a2-cta-fg);
    font-family: var(--a2-font-sans);
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .ic-cta:hover { background: var(--a2-cta-hover); }

  .ic-cta.is-done {
    justify-content: center;
    background: var(--a2-success);
    border-color: var(--a2-success);
    color: #ffffff;
  }

  /* 01 · recipe + grid + meter */
  .ic-recipe {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px 11px;
    border: 1px solid var(--a2-accent-border);
    background: var(--a2-accent-soft);
  }

  .ic-recipe strong {
    font-family: var(--a2-font-display);
    font-size: 17px;
    font-weight: 660;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--a2-text);
  }

  .ic-recipe__meta {
    font-size: 10.5px;
    color: var(--a2-text-secondary);
  }

  .ic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .ic-gtile {
    appearance: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 8px 8px 7px;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-surface);
    color: var(--a2-text);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .ic-gtile:hover { border-color: var(--a2-accent); }

  .ic-gtile b {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ic-gtile span {
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-gtile.is-off {
    opacity: 0.4;
    border-style: dashed;
  }

  .ic-gtile.is-off b { text-decoration: line-through; }

  .ic-gtile.is-pantry {
    border-style: dashed;
    background: transparent;
    color: var(--a2-text-muted);
    cursor: default;
  }

  .ic-gtile.is-pantry span { color: var(--a2-accent-strong); font-weight: 700; font-size: 8.5px; letter-spacing: 0.08em; }

  .ic-meter {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ic-meter__track {
    height: 6px;
    background: var(--a2-border);
  }

  .ic-meter__track i {
    display: block;
    height: 100%;
    background: var(--a2-accent);
    transition: width 0.25s ease;
  }

  .ic-meter__lbl {
    display: flex;
    justify-content: space-between;
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-meter__lbl span:first-child {
    font-weight: 700;
    color: var(--a2-text);
  }

  /* 02 · compare bars + deltas + toggle */
  .ic-bars2 {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 9px 12px 10px;
    border: 1px solid var(--a2-border);
    background: var(--a2-surface-subtle);
  }

  .ic-bars2 > div {
    display: grid;
    grid-template-columns: 52px 1fr 38px;
    align-items: center;
    gap: 8px;
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-bars2__track {
    height: 14px;
    background: var(--a2-border);
  }

  .ic-bars2__track i {
    display: block;
    height: 100%;
    background: var(--a2-text-muted);
  }

  .ic-bars2 .is-hi .ic-bars2__track i { background: var(--a2-accent); }
  .ic-bars2 .is-hi b, .ic-bars2 .is-hi span { color: var(--a2-text); }

  .ic-bars2 b {
    text-align: right;
    font-size: 11px;
    font-weight: 700;
  }

  .ic-deltas {
    display: flex;
    flex-direction: column;
  }

  .ic-deltas > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 6px 2px;
    border-top: 1px solid var(--a2-border);
  }

  .ic-deltas > div:last-child { border-bottom: 1px solid var(--a2-border); }

  .ic-deltas > div > span {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
  }

  .ic-deltas strong {
    font-size: 12px;
    font-weight: 600;
    color: var(--a2-text);
    white-space: nowrap;
  }

  .ic-deltas em {
    font-style: normal;
    font-size: 10.5px;
    color: var(--a2-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ic-deltas b {
    font-family: var(--a2-font-mono);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--a2-coral);
    white-space: nowrap;
  }

  .ic-toggle-row {
    appearance: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-surface);
    color: var(--a2-text);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ic-toggle-row strong {
    display: block;
    font-size: 12px;
    font-weight: 600;
  }

  .ic-toggle-row em {
    font-style: normal;
    font-size: 10.5px;
    color: var(--a2-accent-strong);
  }

  .ic-toggle-row i {
    position: relative;
    width: 32px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 9px;
    background: var(--a2-border-strong);
    transition: background-color 0.18s ease;
  }

  .ic-toggle-row i::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.18s ease;
  }

  .ic-toggle-row.is-on i { background: var(--a2-accent); }
  .ic-toggle-row.is-on i::after { transform: translateX(14px); }

  /* 03 · timeline + checklist */
  .ic-tl3 {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 6px 0 2px;
  }

  .ic-tl3::before {
    content: '';
    position: absolute;
    left: 16%;
    right: 16%;
    top: 11px;
    height: 1px;
    background: var(--a2-border-strong);
  }

  .ic-tl3 span {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    text-align: center;
  }

  .ic-tl3 i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--a2-border-strong);
    background: var(--a2-bg);
  }

  .ic-tl3 .is-done i { background: var(--a2-accent); border-color: var(--a2-accent); }
  .ic-tl3 .is-live i { border-color: var(--a2-accent-strong); box-shadow: 0 0 0 3px var(--a2-accent-soft); }

  .ic-tl3 b {
    font-family: var(--a2-font-mono);
    font-size: 9px;
    font-weight: 700;
    color: var(--a2-text);
  }

  .ic-tl3 em {
    font-style: normal;
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-checklist {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--a2-border);
  }

  .ic-ck {
    appearance: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 2px;
    border: none;
    border-bottom: 1px solid var(--a2-border);
    background: transparent;
    color: var(--a2-text);
    font-family: inherit;
    font-size: 12px;
    text-align: left;
    cursor: pointer;
  }

  .ic-ck i {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    border: 1.5px solid var(--a2-border-strong);
    border-radius: 3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ic-ck.is-done { color: var(--a2-text-muted); }
  .ic-ck.is-done span { text-decoration: line-through; }

  .ic-ck.is-done i {
    background: var(--a2-accent);
    border-color: var(--a2-accent);
  }

  .ic-ck.is-done i::after {
    content: '✓';
    font-size: 9px;
    font-weight: 700;
    color: #04201d;
  }

  .ic-ck b {
    margin-left: 6px;
    font-family: var(--a2-font-mono);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--a2-amber);
    border: 1px solid var(--a2-amber-border);
    padding: 1px 4px;
  }

  /* 04 · item + stepper + choices */
  .ic-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px 12px 11px;
    border: 1px solid var(--a2-accent-border);
    background: var(--a2-accent-soft);
  }

  .ic-item__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 13px;
    font-weight: 600;
    color: var(--a2-text);
  }

  .ic-item__row b {
    font-family: var(--a2-font-mono);
    font-size: 12px;
  }

  .ic-stepper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .ic-stepper > span {
    font-family: var(--a2-font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-text-muted);
  }

  .ic-stepper > div {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ic-stepper button {
    appearance: none;
    width: 26px;
    height: 26px;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-bg);
    color: var(--a2-text);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
  }

  .ic-stepper strong {
    min-width: 18px;
    text-align: center;
    font-family: var(--a2-font-mono);
    font-size: 16px;
    font-weight: 700;
    color: var(--a2-text);
  }

  .ic-stepper em {
    font-style: normal;
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-choice2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .ic-choice {
    appearance: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 11px;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-surface);
    color: var(--a2-text);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .ic-choice span {
    font-family: var(--a2-font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-text-muted);
  }

  .ic-choice strong {
    font-family: var(--a2-font-display);
    font-size: 18px;
    font-weight: 680;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .ic-choice em {
    font-style: normal;
    font-size: 10.5px;
    color: var(--a2-text-muted);
  }

  .ic-choice.is-on {
    border-color: var(--a2-accent);
    background: var(--a2-accent-soft);
  }

  .ic-choice.is-on span { color: var(--a2-accent-strong); }

