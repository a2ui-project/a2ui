---

<div class="ic-root" id="hero-chat-visual" role="region" aria-label="One app screen whose surface is composed differently for each customer intent">
  <div class="ic-split">
    <!-- =================================================================
         INTENTS — four requests, one screen. Auto-plays; click/swipe to pick.
         ================================================================= -->
    <div class="ic-picker">
      <div class="ic-steps" id="ic-steps">
        <button type="button" class="ic-step is-active" data-ic="dinner" aria-pressed="true">
          <span class="ic-step__idx">01 <em>PLAN</em></span>
          <span class="ic-step__q">“Dinner for four tonight, one vegetarian, under $40.”</span>
          <span class="ic-step__desc">A recipe that fits the diet and the budget, a basket built from it, pantry items skipped, and the 5:30 slot booked — as one screen.</span>
          <span class="ic-step__bar" aria-hidden="true"></span>
        </button>

        <button type="button" class="ic-step" data-ic="bill" aria-pressed="false">
          <span class="ic-step__idx">02 <em>EXPLAIN</em></span>
          <span class="ic-step__q">“Why was last week’s order $23 more than usual?”</span>
          <span class="ic-step__desc">Same screen, different shape: a comparison, the three lines that moved, and a switch that stops it happening again.</span>
          <span class="ic-step__bar" aria-hidden="true"></span>
        </button>

        <button type="button" class="ic-step" data-ic="party" aria-pressed="false">
          <span class="ic-step__idx">03 <em>HOST</em></span>
          <span class="ic-step__q">“Hosting twelve kids Saturday afternoon — help me not forget anything.”</span>
          <span class="ic-step__desc">Now it’s a plan: a timeline to the party, a checklist seeded from the RSVPs, and the two nut allergies already flagged.</span>
          <span class="ic-step__bar" aria-hidden="true"></span>
        </button>

        <button type="button" class="ic-step" data-ic="eggs" aria-pressed="false">
          <span class="ic-step__idx">04 <em>FIX</em></span>
          <span class="ic-step__q">“Half the eggs arrived cracked.”</span>
          <span class="ic-step__desc">No form, no ticket. The item is already found, you say how many, pick refund or replace, done.</span>
          <span class="ic-step__bar" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <!-- =================================================================
         RIGHT: STICKY STAGE — THE SAME ASSIST SCREEN
         ================================================================= -->
    <!-- The phone, on its own -->
    <div class="ic-stage">
        <div class="ic-device" inert aria-hidden="true">
          <div class="ic-device__status" aria-hidden="true">
            <span>9:41</span>
            <span class="ic-device__sig"><i></i><i></i><i></i></span>
          </div>

          <!-- Constant app header -->
          <div class="ic-shell-hdr" aria-hidden="true">
            <span class="ic-shell-brand">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 6.5h11l-1.2 6.5h-8.6z"/><path d="M5.5 6.5 8 2.5l2.5 4"/></svg>
              Marigold Market
            </span>
            <svg class="ic-shell-bell" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 11h8l-1-1.4V7a3 3 0 0 0-6 0v2.6L4 11z"/><path d="M6.8 13a1.3 1.3 0 0 0 2.4 0"/></svg>
          </div>

          <!-- Chat thread: the sent prompt rises to the top, the composed surface answers below -->
          <div class="ic-thread">
            <div class="ic-sent" id="ic-sent" aria-live="polite">
              <p id="ic-sent-text">Dinner for four tonight, one vegetarian, under $40.</p>
            </div>

            <!-- The one surface slot that A2UI composes -->
            <div class="ic-zone">
            <span class="ic-zone__tag" aria-hidden="true">A2UI SURFACE · assist_zone</span>

            <div class="ic-zone__skel" aria-hidden="true">
              <span class="ic-zone__skel-lbl">COMPOSING FROM INTENT…</span>
              <i style="width: 58%"></i>
              <i style="width: 100%; height: 72px"></i>
              <i style="width: 100%; height: 40px"></i>
            </div>

            <!-- 01 · PLAN: one recipe, one action -->
            <div class="ic-screen is-active" data-ic-screen="dinner">
              <header class="ic-greet">
                <strong>Tonight · 4 servings</strong>
                <span>Vegetarian · under $40 · 5:30pm slot open</span>
              </header>

              <div class="ic-recipe">
                <span class="ic-lbl">PICKED FOR YOU</span>
                <strong>Sheet-pan gnocchi &amp; peppers</strong>
                <span class="ic-recipe__meta">32 min · 5 items · $24.92</span>
              </div>

              <button type="button" class="ic-cta" data-ic-cta data-done="✓ Added · arrives 5:30pm">
                <span>Add 5 items · $24.92</span><span aria-hidden="true">→</span>
              </button>
            </div>

            <!-- 02 · EXPLAIN: the comparison, one action -->
            <div class="ic-screen" data-ic-screen="bill">
              <header class="ic-greet">
                <strong>Last week vs. usual</strong>
                <span>Salmon was up 18% · raspberries out of season</span>
              </header>

              <div class="ic-bars2" aria-hidden="true">
                <div><span>USUAL</span><div class="ic-bars2__track"><i style="width: 79%"></i></div><b>$86</b></div>
                <div class="is-hi"><span>LAST WK</span><div class="ic-bars2__track"><i style="width: 100%"></i></div><b>$109</b></div>
              </div>

              <button type="button" class="ic-cta" data-ic-cta data-done="✓ Weekly cap set · $90">
                <span>Set a $90 weekly cap</span><span aria-hidden="true">→</span>
              </button>
            </div>

            <!-- 03 · HOST: a short checklist, one action -->
            <div class="ic-screen" data-ic-screen="party">
              <header class="ic-greet">
                <strong>Saturday · 12 kids</strong>
                <span>2 nut allergies flagged from your list</span>
              </header>

              <div class="ic-checklist" id="ic-pt-list" role="group" aria-label="Party checklist">
                <button type="button" class="ic-ck is-done"><i></i><span>Cake · ordered Tuesday</span></button>
                <button type="button" class="ic-ck"><i></i><span>Nut-free snacks ×2 <b>ALLERGY</b></span></button>
                <button type="button" class="ic-ck"><i></i><span>Ice · pick up Sat 1pm</span></button>
              </div>

              <button type="button" class="ic-cta" id="ic-pt-cta" data-ic-cta data-done="✓ Added · Sat 10am delivery">
                <span>Add the 2 missing · Sat 10am</span><span aria-hidden="true">→</span>
              </button>
            </div>

            <!-- 04 · FIX: refund or replace, one action -->
            <div class="ic-screen" data-ic-screen="eggs">
              <header class="ic-greet">
                <strong>Organic eggs · 6 of 12 cracked</strong>
                <span>Order #7731 · delivered 8:12am</span>
              </header>

              <div class="ic-choice2" role="group" aria-label="Resolution">
                <button type="button" class="ic-choice is-on" data-eg-choice="refund"><span>REFUND</span><strong>$3.25</strong><em>back on card today</em></button>
                <button type="button" class="ic-choice" data-eg-choice="replace"><span>REPLACE</span><strong>Tomorrow</strong><em>7–9am · free</em></button>
              </div>

              <button type="button" class="ic-cta" id="ic-eg-cta" data-ic-cta data-done="✓ Done · sorry about that">
                <span>Refund $3.25 now</span><span aria-hidden="true">→</span>
              </button>
            </div>
          </div>

          </div>

          <!-- Constant composer: where the intent is typed, then sent -->
          <div class="ic-composer" id="ic-composer" aria-hidden="true">
            <span class="ic-composer__ico"></span>
            <span class="ic-composer__txt"><span id="ic-composer-text" data-placeholder="Ask Marigold anything…"></span><i class="ic-caret"></i></span>
            <span class="ic-composer__send">↑</span>
          </div>

          <!-- Constant tab bar -->
          <nav class="ic-tabbar" aria-hidden="true">
            <span><i class="ic-tab-ico ic-tab-ico--shop"></i>Shop</span>
            <span class="is-on"><i class="ic-tab-ico ic-tab-ico--assist"></i>Assist</span>
            <span><i class="ic-tab-ico ic-tab-ico--orders"></i>Orders</span>
            <span><i class="ic-tab-ico ic-tab-ico--you"></i>You</span>
          </nav>
        </div>
    </div>
  </div>

  <!-- ===================================================================
       WHAT THE AGENT COMPOSES FROM — THREE OPEN COLUMNS, LINE ILLUSTRATIONS
       =================================================================== -->
  <div class="ic-sources">
    <div class="ic-sources__grid">
      <!-- 01 · Customer intent: a sentence on a plane, the parts that matter drawn out into structure -->
      <div class="ic-source">
        <svg class="ic-art" viewBox="0 0 320 160" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
          <path class="ln mark" d="M20 26h8M24 22v8M286 136h8M290 132v8" />
          <polygon class="plane" points="96,56 236,56 190,114 50,114" />
          <circle class="ln" cx="236" cy="56" r="2" />
          <line class="ln ln-strong" x1="85" y1="70" x2="140" y2="70" />
          <line class="acc w2" x1="148" y1="70" x2="196" y2="70" />
          <line class="ln ln-strong" x1="74" y1="84" x2="130" y2="84" />
          <line class="acc w2" x1="138" y1="84" x2="178" y2="84" />
          <line class="ln ln-strong" x1="63" y1="98" x2="120" y2="98" />
          <rect class="acc-fill ic-art__caret" x="123" y="93" width="1.5" height="10" />
          <path class="ln dash" d="M196 70 C 222 70, 236 48, 262 48" />
          <path class="ln dash" d="M178 84 L 262 84" />
          <path class="ln dash" d="M120 98 C 170 98, 215 120, 262 120" />
          <line class="ln" x1="262" y1="40" x2="262" y2="128" />
          <rect class="acc-fill" x="265" y="45" width="6" height="6" />
          <rect class="acc-fill" x="265" y="81" width="6" height="6" />
          <rect class="node" x="265" y="117" width="6" height="6" />
        </svg>

        <h3>Built for personalization</h3>
        <p>Your agent constructs UI that adapts to each user's unique needs and preferences.</p>
      </div>

      <!-- 02 · Your catalog: a locked isometric grid; three parts lifted into the surface -->
      <div class="ic-source">
        <svg class="ic-art" viewBox="0 0 320 160" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
          <path class="ln mark" d="M286 136h8M290 132v8" />
          <path class="ln" d="M24 140l6 6M30 140l-6 6" />
          <!-- floor grid -->
          <polygon class="plane" points="160,44 298,95 160,146 22,95" />
          <path class="ln" d="M206 61L68 112M252 78L114 129" />
          <path class="ln" d="M114 61L252 112M68 78L206 129" />
          <!-- picked cells -->
          <polygon class="soft-fill acc" points="114,61 160,78 114,95 68,78" />
          <polygon class="soft-fill acc" points="160,78 206,95 160,112 114,95" />
          <polygon class="soft-fill acc" points="252,78 298,95 252,112 206,95" />
          <!-- risers into the composed layer -->
          <path class="ln dash" d="M114 78V34M160 95V51M252 95V51" />
          <path class="ln dash" d="M114 34L160 51L252 51" />
          <rect class="acc-fill" x="111" y="31" width="6" height="6" />
          <rect class="acc-fill" x="157" y="48" width="6" height="6" />
          <rect class="acc-fill" x="249" y="48" width="6" height="6" />
          <!-- lock -->
          <rect class="ln ln-strong" x="26" y="34" width="11" height="8" rx="1" />
          <path class="ln ln-strong" d="M28 34v-2.5a3.5 3.5 0 0 1 7 0V34" />
        </svg>

        <h3>Your catalog</h3>
        <p>Your design system, locked. Agents place only components you registered.</p>
      </div>

      <!-- 03 · Swappable formats: Express, direct JSON or your own DSL all compile to one wire message -->
      <div class="ic-source">
        <svg class="ic-art" viewBox="0 0 320 160" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
          <path class="ln mark" d="M20 26h8M24 22v8M286 136h8M290 132v8" />
          <!-- three ways the model can write the UI -->
          <rect class="plane" x="24" y="30" width="92" height="26" rx="3" />
          <rect class="plane" x="24" y="67" width="92" height="26" rx="3" />
          <rect class="plane" x="24" y="104" width="92" height="26" rx="3" />
          <text class="lbl" x="34" y="47">&#123; "json" &#125;</text>
          <text class="lbl" x="34" y="84">&lt;a2ui&gt; express</text>
          <text class="lbl" x="34" y="121">your format</text>
          <!-- all of them meet at the compiler -->
          <path class="ln dash" d="M116 43 C146 43 150 80 176 80" />
          <path class="ln dash" d="M116 80 H176" />
          <path class="ln dash" d="M116 117 C146 117 150 80 176 80" />
          <rect class="node" x="170" y="74" width="12" height="12" transform="rotate(45 176 80)" />
          <rect class="acc-fill ic-art__blink" x="173.5" y="77.5" width="5" height="5" transform="rotate(45 176 80)" />
          <!-- one wire message out -->
          <line class="acc ic-art__flow" x1="183" y1="80" x2="226" y2="80" />
          <path class="acc" d="M222 76l4 4-4 4" />
          <text class="lbl lbl--tiny" x="184" y="98">ONE WIRE</text>
          <!-- the same component, whichever way it was written -->
          <rect class="plane" x="232" y="50" width="68" height="60" rx="3" />
          <path class="ln-strong ln" d="M242 63h36" />
          <path class="ln" d="M242 72h26M242 80h30" />
          <rect class="acc-fill" x="242" y="92" width="48" height="9" rx="1" />
        </svg>

        <h3>Swappable formats</h3>
        <p>Let the model write A2UI Express, direct JSON, or a format of your own — every one compiles to the same wire messages.</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.getElementById('hero-chat-visual');
    if (!root) return;

    const intents = {
      dinner: {
        idx: '01',
        quote: 'Dinner for four tonight, one vegetarian, under $40.',
      },
      bill: {
        idx: '02',
        quote: 'Why was last week’s order $23 more than usual?',
      },
      party: {
        idx: '03',
        quote: 'Hosting twelve kids Saturday afternoon — help me not forget anything.',
      },
      eggs: {
        idx: '04',
        quote: 'Half the eggs arrived cracked.',
      },
    };

    const steps = root.querySelectorAll('[data-ic]');
    const screens = root.querySelectorAll('[data-ic-screen]');
    const zone = root.querySelector('.ic-zone');
    const composer = document.getElementById('ic-composer');
    const composerText = document.getElementById('ic-composer-text');
    const sentBubble = document.getElementById('ic-sent');
    const sentText = document.getElementById('ic-sent-text');
    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const narrow = window.matchMedia ? window.matchMedia('(max-width: 920px)') : { matches: false };

    /* --- Intent -> typed into the composer -> surface composes -> renders --- */
    let timers = [];
    let current = 'dinner';
    const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };

    const showScreen = (key) => {
      screens.forEach((s) => s.classList.toggle('is-active', s.getAttribute('data-ic-screen') === key));
    };

    const composeZone = (key) => {
      if (!zone || reduceMotion) { showScreen(key); return; }
      zone.classList.add('is-composing');
      timers.push(setTimeout(() => {
        showScreen(key);
        zone.classList.remove('is-composing');
      }, 760));
    };

    /* The typed prompt leaves the composer and rises into the thread as a sent message */
    const sendPrompt = (text) => {
      if (sentText) sentText.textContent = text;
      if (composerText) composerText.textContent = '';
      if (sentBubble && !reduceMotion) {
        sentBubble.classList.remove('is-fly');
        void sentBubble.offsetWidth;
        sentBubble.classList.add('is-fly');
      }
    };

    const typeIntoComposer = (text, done) => {
      if (!composer || !composerText || reduceMotion) {
        done();
        return;
      }
      composer.classList.remove('is-sent');
      composer.classList.add('is-typing');
      composerText.textContent = '';
      const chars = Array.from(text);
      let i = 0;
      const step = () => {
        i += 1;
        composerText.textContent = chars.slice(0, i).join('');
        if (i < chars.length) {
          timers.push(setTimeout(step, 12));
        } else {
          composer.classList.remove('is-typing');
          composer.classList.add('is-sent');
          timers.push(setTimeout(() => composer.classList.remove('is-sent'), 700));
          done();
        }
      };
      step();
    };

    const setIntent = (key, animate, force) => {
      const d = intents[key];
      if (!d || (key === current && animate && !force)) return;
      current = key;
      clearTimers();
      steps.forEach((s) => {
        const on = s.getAttribute('data-ic') === key;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-pressed', on ? 'true' : 'false');
      });

      if (!animate) {
        if (sentText) sentText.textContent = d.quote;
        if (composerText) composerText.textContent = '';
        showScreen(key);
        return;
      }
      typeIntoComposer(d.quote, () => {
        sendPrompt(d.quote);
        composeZone(key);
      });
    };

    /* --- Autoplay: the four intents take turns on the same screen; click or swipe to pick one --- */
    const order = Array.from(steps).map((st) => st.getAttribute('data-ic') || 'dinner');
    const strip = document.getElementById('ic-steps');
    const HOLD = 5100;            // ms per intent: typing + composing + reading time
    let holdTimer = 0;
    let inView = true;
    root.style.setProperty('--ic-hold', `${HOLD}ms`);

    const stripScrollTo = (st, smooth) => {
      if (!strip || !narrow.matches) return;
      const left = st.offsetLeft - (strip.clientWidth - st.offsetWidth) / 2;
      strip.scrollTo({ left: Math.max(0, left), behavior: smooth && !reduceMotion ? 'smooth' : 'auto' });
    };

    const restartBar = () => {
      const live = root.querySelector('.ic-step.is-active .ic-step__bar');
      if (!live) return;
      live.style.animation = 'none';
      void live.offsetWidth;
      live.style.removeProperty('animation');
    };

    const armNext = () => {
      clearTimeout(holdTimer);
      if (reduceMotion || !inView || document.hidden) return;
      holdTimer = setTimeout(() => {
        const i = order.indexOf(current);
        go(order[(i + 1) % order.length], true);
      }, HOLD);
    };

    const go = (key, animate) => {
      setIntent(key, animate);
      const st = root.querySelector(`.ic-step[data-ic="${key}"]`);
      if (st) stripScrollTo(st, true);
      restartBar();
      armNext();
    };

    // click (desktop list / narrow cards) selects and restarts the clock
    steps.forEach((st) => {
      st.addEventListener('click', () => {
        const key = st.getAttribute('data-ic') || 'dinner';
        if (key === current) return;
        go(key, true);
      });
    });

    // narrow: a manual swipe selects whichever card snaps to the centre
    if (strip) {
      let scrollEndTimer = 0;
      let programmatic = false;
      const onSettle = () => {
        if (!narrow.matches) return;
        const mid = strip.scrollLeft + strip.clientWidth / 2;
        let best = null;
        let bestDist = Infinity;
        steps.forEach((st) => {
          const c = st.offsetLeft + st.offsetWidth / 2;
          const dist = Math.abs(c - mid);
          if (dist < bestDist) { bestDist = dist; best = st; }
        });
        if (!best) return;
        const key = best.getAttribute('data-ic') || 'dinner';
        if (key !== current) go(key, true);
      };
      strip.addEventListener('scroll', () => {
        clearTimeout(scrollEndTimer);
        scrollEndTimer = setTimeout(onSettle, 140);
      }, { passive: true });
    }

    // only run while the section is on screen and the tab is visible
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          const was = inView;
          inView = e.isIntersecting;
          if (inView && !was) { restartBar(); armNext(); }
          if (!inView) clearTimeout(holdTimer);
        });
      }, { threshold: 0.25 }).observe(root);
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) clearTimeout(holdTimer); else { restartBar(); armNext(); }
    });
    if (narrow.addEventListener) narrow.addEventListener('change', () => {
      const st = root.querySelector('.ic-step.is-active');
      if (st) stripScrollTo(st, false);
    });

    // the first request plays itself once the section is reached
    if (!reduceMotion && 'IntersectionObserver' in window) {
      let kicked = false;
      const kick = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (kicked || !e.isIntersecting) return;
          kicked = true;
          setIntent(current, true, true);
          restartBar();
          armNext();
          kick.disconnect();
        });
      }, { threshold: 0.35 });
      kick.observe(root);
    } else {
      armNext();
    }

  })();
</script>

<style>
  /* Scroll-driven: each intent is typed, sent up the thread, and answered by a composed surface. */
  .ic-root {
    width: 100%;
    color: var(--a2-text);
  }

  /* =======================================================================
     SPLIT: INTENT LIST | STAGE  (auto-plays; no scroll-jacking, no sticky)
     ======================================================================= */
  .ic-split {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(0, 1.1fr);
    gap: 56px;
    align-items: center;
  }

  /* --- Intents: a vertical list beside the phone; the live one unfolds and runs a progress line --- */
  .ic-picker {
    padding-top: 6px;
  }

  .ic-steps {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--a2-border-strong);
  }

  .ic-step {
    appearance: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 0 24px;
    border: none;
    border-bottom: 1px solid var(--a2-border);
    background: transparent;
    color: var(--a2-text);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ic-step:not(.is-active) {
    opacity: 0.5;
  }

  .ic-step:not(.is-active):hover {
    opacity: 0.8;
  }

  .ic-step__idx {
    font-family: var(--a2-font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-text-muted);
  }

  .ic-step__idx em {
    font-style: normal;
    margin-left: 8px;
    color: var(--a2-accent);
  }

  .ic-step__q {
    font-family: var(--a2-font-display);
    font-weight: 600;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.3;
    letter-spacing: var(--a2-tracking-h3);
    color: var(--a2-text);
  }

  /* description unfolds for the live intent only */
  .ic-step__desc {
    display: block;
    font-size: 14px;
    line-height: 1.58;
    color: var(--a2-text-secondary);
    max-width: 44ch;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
