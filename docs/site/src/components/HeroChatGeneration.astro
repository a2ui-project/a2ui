---

<div class="ic-root" id="hero-chat-visual" role="region" aria-label="One app screen whose surface is composed uniquely for each intent as you scroll">
  <div class="ic-split">
    <!-- Live wire: the active intent flows into the phone's composer -->
    <svg class="ic-wire-svg" id="ic-wire-svg" aria-hidden="true">
      <path id="ic-wire-path" d="" />
      <circle id="ic-wire-a" r="3.5" />
      <circle id="ic-wire-b" r="3.5" />
    </svg>

    <!-- =================================================================
         LEFT: SCROLL STEPS — EACH INTENT IS SENT TO THE SAME SCREEN
         ================================================================= -->
    <div class="ic-picker">
      <div class="ic-picker__head">
        <span class="ic-kicker">SCROLL — EACH INTENT IS SENT TO THE SAME SCREEN</span>
      </div>

      <div class="ic-steps">
        <button type="button" class="ic-step is-active" data-ic="dinner" aria-pressed="true">
          <span class="ic-step__idx">01 <em>PLAN</em></span>
          <span class="ic-step__q">“Dinner for four tonight, one vegetarian, under $40.”</span>
          <span class="ic-step__desc">A recipe that fits the diet and the budget, a basket built from it, pantry items skipped, and the 5:30 slot booked — as one screen.</span>
          <span class="ic-step__state"><span class="ic-step__state-off">↓ SCROLL TO SEND</span><span class="ic-step__state-on">SENT ●</span></span>
        </button>

        <button type="button" class="ic-step" data-ic="bill" aria-pressed="false">
          <span class="ic-step__idx">02 <em>EXPLAIN</em></span>
          <span class="ic-step__q">“Why was last week’s order $23 more than usual?”</span>
          <span class="ic-step__desc">Same screen, different shape: a comparison, the three lines that moved, and a switch that stops it happening again.</span>
          <span class="ic-step__state"><span class="ic-step__state-off">↓ SCROLL TO SEND</span><span class="ic-step__state-on">SENT ●</span></span>
        </button>

        <button type="button" class="ic-step" data-ic="party" aria-pressed="false">
          <span class="ic-step__idx">03 <em>HOST</em></span>
          <span class="ic-step__q">“Hosting twelve kids Saturday afternoon — help me not forget anything.”</span>
          <span class="ic-step__desc">Now it’s a plan: a timeline to the party, a checklist seeded from the RSVPs, and the two nut allergies already flagged.</span>
          <span class="ic-step__state"><span class="ic-step__state-off">↓ SCROLL TO SEND</span><span class="ic-step__state-on">SENT ●</span></span>
        </button>

        <button type="button" class="ic-step" data-ic="eggs" aria-pressed="false">
          <span class="ic-step__idx">04 <em>FIX</em></span>
          <span class="ic-step__q">“Half the eggs arrived cracked.”</span>
          <span class="ic-step__desc">No form, no ticket. The item is already found, you say how many, pick refund or replace, done.</span>
          <span class="ic-step__state"><span class="ic-step__state-off">↓ SCROLL TO SEND</span><span class="ic-step__state-on">SENT ●</span></span>
        </button>
      </div>
    </div>

    <!-- =================================================================
         RIGHT: STICKY STAGE — THE SAME ASSIST SCREEN
         ================================================================= -->
    <div class="ic-stage">
      <div class="ic-stage__bar">
        <span class="ic-stage__tag">✦ MARIGOLD MARKET · ASSIST SCREEN</span>
        <div class="ic-lens" role="group" aria-label="Switch between the rendered screen and the wire payload">
          <button type="button" class="ic-lens__btn is-active" data-ic-lens="screen">SCREEN</button>
          <button type="button" class="ic-lens__btn" data-ic-lens="wire">WIRE JSON</button>
        </div>
      </div>

      <!-- Rendered screen -->
      <div class="ic-lens-view is-active" data-ic-view="screen">
        <div class="ic-callout ic-callout--zone" aria-hidden="true">
          <span class="ic-callout__t">A2UI SURFACE</span>
          <span class="ic-callout__s">Composed from intent <b id="ic-zone-who">01</b></span>
        </div>

        <div class="ic-device">
          <div class="ic-device__status" aria-hidden="true">
            <span>9:41</span>
            <span class="ic-device__sig"><i></i><i></i><i></i></span>
          </div>

          <!-- Constant app header -->
          <div class="ic-shell-hdr" aria-hidden="true">
            <span class="ic-shell-brand">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 6.5h11l-1.2 6.5h-8.6z"/><path d="M5.5 6.5 8 2.5l2.5 4"/></svg>
              Marigold Market
            </span>
            <svg class="ic-shell-bell" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 11h8l-1-1.4V7a3 3 0 0 0-6 0v2.6L4 11z"/><path d="M6.8 13a1.3 1.3 0 0 0 2.4 0"/></svg>
          </div>

          <!-- The one surface slot that A2UI composes -->
          <div class="ic-zone">
            <span class="ic-zone__tag" aria-hidden="true">A2UI SURFACE · assist_zone</span>

            <div class="ic-zone__skel" aria-hidden="true">
              <span class="ic-zone__skel-lbl">COMPOSING FROM INTENT…</span>
              <i style="width: 58%"></i>
              <i style="width: 100%; height: 104px"></i>
              <i style="width: 88%"></i>
              <i style="width: 76%"></i>
            </div>

            <!-- 01 · PLAN: recipe + ingredient grid + budget meter -->
            <div class="ic-screen is-active" data-ic-screen="dinner">
              <header class="ic-greet">
                <strong>Tonight · 4 servings</strong>
                <span>1 vegetarian · under $40 · 5:30pm slot open</span>
              </header>

              <div class="ic-recipe">
                <span class="ic-lbl">PICKED FOR YOU</span>
                <strong>Sheet-pan gnocchi &amp; peppers</strong>
                <span class="ic-recipe__meta">32 min · vegetarian ✓ · uses your pantry basil</span>
              </div>

              <div class="ic-grid" id="ic-dn-grid" role="group" aria-label="Ingredients">
                <button type="button" class="ic-gtile" data-price="7.98"><b>Gnocchi ×2</b><span>$7.98</span></button>
                <button type="button" class="ic-gtile" data-price="4.47"><b>Peppers ×3</b><span>$4.47</span></button>
                <button type="button" class="ic-gtile" data-price="4.99"><b>Feta</b><span>$4.99</span></button>
                <button type="button" class="ic-gtile" data-price="3.99"><b>Cherry toms</b><span>$3.99</span></button>
                <button type="button" class="ic-gtile" data-price="3.49"><b>Ciabatta</b><span>$3.49</span></button>
                <button type="button" class="ic-gtile is-pantry" data-price="0" disabled><b>Basil · oil</b><span>IN PANTRY</span></button>
              </div>

              <div class="ic-meter">
                <div class="ic-meter__track"><i id="ic-dn-fill" style="width: 62%"></i></div>
                <div class="ic-meter__lbl"><span id="ic-dn-total">$24.92</span><span>BUDGET $40</span></div>
              </div>

              <button type="button" class="ic-cta" id="ic-dn-cta" data-ic-cta data-done="✓ Added · arrives 5:30pm">
                <span>Add 5 items · $24.92</span><span aria-hidden="true">→</span>
              </button>
            </div>

            <!-- 02 · EXPLAIN: comparison bars + delta ledger + toggle -->
            <div class="ic-screen" data-ic-screen="bill">
              <header class="ic-greet">
                <strong>Last week vs. usual</strong>
                <span>Order #7702 · $109.40 · usual week ≈ $86</span>
              </header>

              <div class="ic-bars2" aria-hidden="true">
                <div><span>USUAL</span><div class="ic-bars2__track"><i style="width: 79%"></i></div><b>$86</b></div>
                <div class="is-hi"><span>LAST WK</span><div class="ic-bars2__track"><i style="width: 100%"></i></div><b>$109</b></div>
              </div>

              <div class="ic-deltas">
                <div><span><strong>Salmon ×2</strong><em>price up 18%</em></span><b>+$14.00</b></div>
                <div><span><strong>1-hour window</strong><em>instead of 2-hour</em></span><b>+$5.00</b></div>
                <div><span><strong>Raspberries</strong><em>out of season</em></span><b>+$4.40</b></div>
              </div>

              <button type="button" class="ic-toggle-row is-on" id="ic-bl-toggle" aria-pressed="true">
                <span><strong>Swap to frozen salmon next week</strong><em id="ic-bl-save">Saves about $9</em></span>
                <i></i>
              </button>

              <button type="button" class="ic-cta" data-ic-cta data-done="✓ Weekly cap set · $90">
                <span>Set a $90 weekly cap</span><span aria-hidden="true">→</span>
              </button>
            </div>

            <!-- 03 · HOST: timeline + checklist -->
            <div class="ic-screen" data-ic-screen="party">
              <header class="ic-greet">
                <strong>Saturday · 12 kids</strong>
                <span>12 RSVPs · 2 nut allergies flagged from your list</span>
              </header>

              <div class="ic-tl3" aria-hidden="true">
                <span class="is-done"><i></i><b>FRI</b><em>Order</em></span>
                <span class="is-live"><i></i><b>SAT 10AM</b><em>Delivery</em></span>
                <span><i></i><b>SAT 2PM</b><em>Party</em></span>
              </div>

              <div class="ic-checklist" id="ic-pt-list" role="group" aria-label="Party checklist">
                <button type="button" class="ic-ck is-done"><i></i><span>Cake · ordered Tuesday</span></button>
                <button type="button" class="ic-ck is-done"><i></i><span>Juice boxes ×24</span></button>
                <button type="button" class="ic-ck"><i></i><span>Nut-free snacks ×2 <b>ALLERGY</b></span></button>
                <button type="button" class="ic-ck"><i></i><span>Plates, cups, napkins</span></button>
                <button type="button" class="ic-ck"><i></i><span>Ice · pick up Sat 1pm</span></button>
              </div>

              <button type="button" class="ic-cta" id="ic-pt-cta" data-ic-cta data-done="✓ Added · Sat 10am delivery">
                <span>Add the 3 missing · Sat 10am</span><span aria-hidden="true">→</span>
              </button>
            </div>

            <!-- 04 · FIX: item + stepper + two choices -->
            <div class="ic-screen" data-ic-screen="eggs">
              <header class="ic-greet">
                <strong>Order #7731 · this morning</strong>
                <span>Delivered 8:12am · 14 items · no photo needed</span>
              </header>

              <div class="ic-item">
                <div class="ic-item__row"><strong>Organic eggs · dozen</strong><b>$6.49</b></div>
                <div class="ic-stepper">
                  <span>HOW MANY CRACKED?</span>
                  <div><button type="button" id="ic-eg-minus" aria-label="Fewer">−</button><strong id="ic-eg-n">6</strong><button type="button" id="ic-eg-plus" aria-label="More">+</button><em>of 12</em></div>
                </div>
              </div>

              <div class="ic-choice2" role="group" aria-label="Resolution">
                <button type="button" class="ic-choice is-on" data-eg-choice="refund"><span>REFUND</span><strong id="ic-eg-refund">$3.25</strong><em>back on card today</em></button>
                <button type="button" class="ic-choice" data-eg-choice="replace"><span>REPLACE</span><strong>Tomorrow</strong><em>7–9am · free</em></button>
              </div>

              <div class="ic-trust" aria-hidden="true">
                <div><b>0</b><span>PRIOR CLAIMS</span></div>
                <div><b>13</b><span>ITEMS FINE</span></div>
                <div><b>Instant</b><span>NO REVIEW</span></div>
              </div>

              <button type="button" class="ic-cta" id="ic-eg-cta" data-ic-cta data-done="✓ Done · sorry about that">
                <span>Refund $3.25 now</span><span aria-hidden="true">→</span>
              </button>
            </div>
          </div>

          <!-- Constant composer: where the intent actually arrives -->
          <div class="ic-composer" id="ic-composer" aria-hidden="true">
            <span class="ic-composer__ico"></span>
            <span class="ic-composer__txt"><span id="ic-composer-text">Dinner for four tonight, one vegetarian, under $40.</span><i class="ic-caret"></i></span>
            <span class="ic-composer__send">↑</span>
          </div>

          <!-- Constant tab bar -->
          <nav class="ic-tabbar" aria-hidden="true">
            <span><i class="ic-tab-ico ic-tab-ico--shop"></i>Shop</span>
            <span class="is-on"><i class="ic-tab-ico ic-tab-ico--assist"></i>Assist</span>
            <span><i class="ic-tab-ico ic-tab-ico--orders"></i>Orders</span>
            <span><i class="ic-tab-ico ic-tab-ico--you"></i>You</span>
          </nav>
        </div>

        <div class="ic-brace" aria-hidden="true">
          <span class="ic-brace__t">YOUR APP SHELL</span>
          <span class="ic-brace__s">Header, composer, tabs — same for everyone</span>
        </div>
      </div>

      <!-- The declarative stream behind it -->
      <div class="ic-lens-view" data-ic-view="wire">
        <pre class="ic-wire" id="ic-wire"><code>&#123; "createSurface": &#123; "surfaceId": "assist_zone", "catalogId": "marigold.v1" &#125; &#125;
&#123; "updateDataModel": &#123; "path": "/",
    "value": &#123; "servings": 4, "diet": ["vegetarian"], "budget": 40, "pantry": ["basil", "olive oil"] &#125; &#125; &#125;
&#123; "updateComponents": &#123; "surfaceId": "assist_zone", "components": [
    &#123; "id": "pick", "component": "RecipeCard",
      "title": "Sheet-pan gnocchi &amp; peppers", "minutes": 32 &#125;,
    &#123; "id": "basket", "component": "IngredientGrid",
      "items": &#123; "path": "/basket" &#125;, "skipPantry": true &#125;,
    &#123; "id": "meter", "component": "BudgetMeter",
      "value": &#123; "path": "/total" &#125;, "cap": &#123; "path": "/budget" &#125; &#125;,
    &#123; "id": "cta", "component": "Button",
      "label": "Add 5 items", "action": "addToBasket" &#125;
] &#125; &#125;</code></pre>
      </div>
    </div>
  </div>

  <!-- ===================================================================
       WHAT THE AGENT COMPOSES FROM (ILLUSTRATED 3-COLUMN DATUM ROW)
       =================================================================== -->
  <div class="ic-sources">
    <div class="ic-sources__head">
      <span class="ic-kicker">WHAT THE AGENT COMPOSES FROM</span>
      <span class="ic-sources__eq" aria-hidden="true">
        INTENT <b>+</b> CATALOG <b>+</b> CONTEXT <b>→</b> ONE SCREEN
      </span>
    </div>

    <div class="ic-sources__grid">
      <!-- 01 · CUSTOMER INTENT -->
      <div class="ic-source">
        <div class="ic-fig ic-fig--intent" aria-hidden="true">
          <span class="ic-fig__quote">“</span>

          <div class="ic-utter is-active" data-ic-utter="dinner">
            <p><mark>Dinner for four</mark> tonight, <mark>one vegetarian</mark>, <mark>under $40</mark>.</p>
            <span class="ic-trail"><b>TAPPED</b> Home <i>→</i> Recipes <i>→</i> Tonight</span>
          </div>
          <div class="ic-utter" data-ic-utter="bill">
            <p>Why was <mark>last week’s order</mark> <mark>$23 more</mark> than usual?</p>
            <span class="ic-trail"><b>TAPPED</b> Orders <i>→</i> #7702 <i>→</i> Receipt</span>
          </div>
          <div class="ic-utter" data-ic-utter="party">
            <p>Hosting <mark>twelve kids</mark> <mark>Saturday afternoon</mark> — help me <mark>not forget anything</mark>.</p>
            <span class="ic-trail"><b>TAPPED</b> Home <i>→</i> Occasions <i>→</i> Kids party</span>
          </div>
          <div class="ic-utter" data-ic-utter="eggs">
            <p><mark>Half the eggs</mark> arrived <mark>cracked</mark>.</p>
            <span class="ic-trail"><b>TAPPED</b> Orders <i>→</i> #7731 <i>→</i> Help</span>
          </div>
        </div>

        <div class="ic-source__head">
          <span class="ic-source__idx">01</span>
          <h3>Customer intent</h3>
        </div>
        <p>What they asked for, in their own words — plus what they tapped on the way here.</p>
        <div class="ic-chips" id="ic-src-intent">
          <span>servings: 4</span><span>diet: 1 vegetarian</span><span>budget: $40</span>
        </div>
      </div>

      <!-- 02 · YOUR CATALOG -->
      <div class="ic-source">
        <div class="ic-fig ic-fig--catalog" aria-hidden="true">
          <svg class="ic-sheet" viewBox="0 0 360 150" fill="none">
            <text x="10" y="13" class="ic-sheet__hdr">MARIGOLD DESIGN SYSTEM · 8 REGISTERED</text>
            <g class="ic-sheet__lock">
              <rect x="337" y="8" width="13" height="9" rx="1.5" />
              <path d="M339.5 8 V6.2 a4 4 0 0 1 8 0 V8" />
              <text x="331" y="15" text-anchor="end" class="ic-sheet__hdr ic-sheet__hdr--on">LOCKED</text>
            </g>

            <g class="ic-tile-svg is-on">
              <rect x="10" y="24" width="76" height="44" rx="2" />
              <rect x="18" y="33" width="34" height="3" class="ic-ink" />
              <rect x="18" y="41" width="52" height="2" class="ic-ink-soft" />
              <rect x="18" y="50" width="22" height="8" rx="1" class="ic-ink-fill" />
              <text x="80" y="35" text-anchor="end" class="ic-tick">✓</text>
              <text x="48" y="80" text-anchor="middle" class="ic-sheet__lbl">CARD</text>
            </g>
            <g class="ic-tile-svg is-on">
              <rect x="98" y="24" width="76" height="44" rx="2" />
              <rect x="110" y="50" width="7" height="11" class="ic-ink-soft" />
              <rect x="121" y="42" width="7" height="19" class="ic-ink-soft" />
              <rect x="132" y="35" width="7" height="26" class="ic-ink-fill" />
              <rect x="143" y="46" width="7" height="15" class="ic-ink-soft" />
              <rect x="154" y="31" width="7" height="30" class="ic-ink-fill" />
              <text x="168" y="35" text-anchor="end" class="ic-tick">✓</text>
              <text x="136" y="80" text-anchor="middle" class="ic-sheet__lbl">CHART</text>
            </g>
            <g class="ic-tile-svg">
              <rect x="186" y="24" width="76" height="44" rx="2" />
              <rect x="196" y="33" width="24" height="24" rx="1" class="ic-ink-soft" />
              <rect x="224" y="33" width="28" height="3" class="ic-ink-soft" />
              <rect x="224" y="41" width="20" height="2" class="ic-ink-soft" />
              <text x="224" y="80" text-anchor="middle" class="ic-sheet__lbl">GRID TILE</text>
            </g>
            <g class="ic-tile-svg is-on">
              <rect x="274" y="24" width="76" height="44" rx="2" />
              <rect x="286" y="37" width="52" height="18" rx="2" class="ic-ink-fill" />
              <rect x="298" y="45" width="28" height="2.5" class="ic-ink-inverse" />
              <text x="344" y="35" text-anchor="end" class="ic-tick">✓</text>
              <text x="312" y="80" text-anchor="middle" class="ic-sheet__lbl">BUTTON</text>
            </g>

            <g class="ic-tile-svg">
              <rect x="10" y="92" width="76" height="44" rx="2" />
              <rect x="18" y="101" width="6" height="6" class="ic-ink-soft" />
              <rect x="28" y="103" width="40" height="2" class="ic-ink-soft" />
              <rect x="18" y="111" width="6" height="6" class="ic-ink-soft" />
              <rect x="28" y="113" width="34" height="2" class="ic-ink-soft" />
              <rect x="18" y="121" width="6" height="6" class="ic-ink-soft" />
              <rect x="28" y="123" width="44" height="2" class="ic-ink-soft" />
              <text x="48" y="148" text-anchor="middle" class="ic-sheet__lbl">CHECKLIST</text>
            </g>
            <g class="ic-tile-svg">
              <rect x="98" y="92" width="76" height="44" rx="2" />
              <rect x="120" y="106" width="32" height="16" rx="8" class="ic-ink-soft-stroke" />
              <circle cx="144" cy="114" r="5.5" class="ic-ink-fill" />
              <text x="136" y="148" text-anchor="middle" class="ic-sheet__lbl">TOGGLE</text>
            </g>
            <g class="ic-tile-svg">
              <rect x="186" y="92" width="76" height="44" rx="2" />
              <rect x="200" y="106" width="14" height="14" rx="1" class="ic-ink-soft-stroke" />
              <rect x="217" y="111" width="14" height="3" class="ic-ink-soft" />
              <rect x="234" y="106" width="14" height="14" rx="1" class="ic-ink-soft-stroke" />
              <text x="224" y="148" text-anchor="middle" class="ic-sheet__lbl">STEPPER</text>
            </g>
            <g class="ic-tile-svg is-blocked">
              <rect x="274" y="92" width="76" height="44" rx="2" stroke-dasharray="4 3" />
              <text x="312" y="119" text-anchor="middle" class="ic-raw">&lt;/&gt;</text>
              <line x1="296" y1="124" x2="328" y2="104" class="ic-raw-strike" />
              <text x="312" y="148" text-anchor="middle" class="ic-sheet__lbl ic-sheet__lbl--no">RAW HTML · ✕</text>
            </g>
          </svg>
        </div>

        <div class="ic-source__head">
          <span class="ic-source__idx">02</span>
          <h3>Your catalog</h3>
        </div>
        <p>Your design system, locked. Agents place only components you registered — never raw HTML.</p>
        <div class="ic-chips" id="ic-src-catalog">
          <span>RecipeCard</span><span>IngredientGrid</span><span>BudgetMeter</span>
        </div>
      </div>

      <!-- 03 · LIVE CONTEXT -->
      <div class="ic-source">
        <div class="ic-fig ic-fig--context" aria-hidden="true">
          <div class="ic-pulse">
            <svg viewBox="0 0 72 72">
              <circle cx="36" cy="36" r="30" class="ic-pulse__ring ic-pulse__ring--a" />
              <circle cx="36" cy="36" r="30" class="ic-pulse__ring ic-pulse__ring--b" />
              <circle cx="36" cy="36" r="18" class="ic-pulse__orbit" />
              <line x1="36" y1="36" x2="36" y2="21" class="ic-pulse__hand" />
              <circle cx="36" cy="36" r="4" class="ic-pulse__core" />
            </svg>
            <span class="ic-clock" id="ic-clock">17:05:32</span>
            <span class="ic-clock__lbl">NOW</span>
          </div>

          <div class="ic-signals is-active" data-ic-ctx="dinner">
            <div><span>PANTRY</span><strong>Basil &amp; olive oil on hand</strong></div>
            <div><span>DELIVERY</span><strong>5:30pm slot open</strong></div>
            <div><span>HISTORY</span><strong>Vegetarian in 3 of last 5 orders</strong></div>
          </div>
          <div class="ic-signals" data-ic-ctx="bill">
            <div><span>ORDER</span><strong>#7702 · $109.40</strong></div>
            <div><span>BASELINE</span><strong>12-week average $86</strong></div>
            <div><span>PRICES</span><strong>Salmon +18% this week</strong></div>
          </div>
          <div class="ic-signals" data-ic-ctx="party">
            <div><span>RSVPS</span><strong>12 confirmed · 2 nut allergies</strong></div>
            <div><span>ORDERS</span><strong>Cake · ordered Tuesday</strong></div>
            <div><span>SLOTS</span><strong>Sat 10am delivery open</strong></div>
          </div>
          <div class="ic-signals" data-ic-ctx="eggs">
            <div><span>ORDER</span><strong>#7731 · delivered 8:12am</strong></div>
            <div><span>ITEM</span><strong>Organic eggs ×12 · $6.49</strong></div>
            <div><span>ACCOUNT</span><strong>No prior claims · instant refund</strong></div>
          </div>
        </div>

        <div class="ic-source__head">
          <span class="ic-source__idx">03</span>
          <h3>Live context</h3>
        </div>
        <p>What’s true right now, bound into the data model — pantry, prices, orders, time.</p>
        <div class="ic-chips" id="ic-src-context">
          <span>/pantry: 2 items</span><span>/slot: "17:30"</span><span>/budget: 40</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.getElementById('hero-chat-visual');
    if (!root) return;

    const intents = {
      dinner: {
        idx: '01',
        quote: 'Dinner for four tonight, one vegetarian, under $40.',
        intent: ['servings: 4', 'diet: 1 vegetarian', 'budget: $40'],
        catalog: ['RecipeCard', 'IngredientGrid', 'BudgetMeter'],
        context: ['/pantry: 2 items', '/slot: "17:30"', '/budget: 40'],
        wire: `{ "createSurface": { "surfaceId": "assist_zone", "catalogId": "marigold.v1" } }
{ "updateDataModel": { "path": "/",
    "value": { "servings": 4, "diet": ["vegetarian"], "budget": 40, "pantry": ["basil", "olive oil"] } } }
{ "updateComponents": { "surfaceId": "assist_zone", "components": [
    { "id": "pick", "component": "RecipeCard",
      "title": "Sheet-pan gnocchi & peppers", "minutes": 32 },
    { "id": "basket", "component": "IngredientGrid",
      "items": { "path": "/basket" }, "skipPantry": true },
    { "id": "meter", "component": "BudgetMeter",
      "value": { "path": "/total" }, "cap": { "path": "/budget" } },
    { "id": "cta", "component": "Button",
      "label": "Add 5 items", "action": "addToBasket" }
] } }`,
      },
      bill: {
        idx: '02',
        quote: 'Why was last week’s order $23 more than usual?',
        intent: ['ask: explain', 'compare: usual week', 'delta: +$23'],
        catalog: ['CompareBars', 'DeltaList', 'Toggle'],
        context: ['/usual: 86.00', '/last: 109.40', '/priceChanges: 2'],
        wire: `{ "createSurface": { "surfaceId": "assist_zone", "catalogId": "marigold.v1" } }
{ "updateDataModel": { "path": "/",
    "value": { "usual": 86.00, "last": 109.40, "drivers": 3, "swapFrozen": true } } }
{ "updateComponents": { "surfaceId": "assist_zone", "components": [
    { "id": "cmp", "component": "CompareBars",
      "a": { "path": "/usual" }, "b": { "path": "/last" } },
    { "id": "why", "component": "DeltaList", "items": { "path": "/deltas" } },
    { "id": "swap", "component": "Toggle",
      "label": "Swap to frozen salmon next week", "value": { "path": "/swapFrozen" } },
    { "id": "cta", "component": "Button",
      "label": "Set a $90 weekly cap", "action": "setCap" }
] } }`,
      },
      party: {
        idx: '03',
        quote: 'Hosting twelve kids Saturday afternoon — help me not forget anything.',
        intent: ['event: kids party', 'guests: 12', 'when: sat pm'],
        catalog: ['Timeline', 'Checklist', 'Button'],
        context: ['/rsvp: 12', '/allergies: ["nuts"]', '/cake: "ordered"'],
        wire: `{ "createSurface": { "surfaceId": "assist_zone", "catalogId": "marigold.v1" } }
{ "updateDataModel": { "path": "/",
    "value": { "guests": 12, "allergies": ["nuts"], "cake": "ordered", "slot": "sat-10" } } }
{ "updateComponents": { "surfaceId": "assist_zone", "components": [
    { "id": "when", "component": "Timeline",
      "stops": ["Fri order", "Sat 10am delivery", "Sat 2pm party"], "active": 1 },
    { "id": "todo", "component": "Checklist",
      "items": { "path": "/checklist" }, "flag": { "path": "/allergies" } },
    { "id": "cta", "component": "Button",
      "label": "Add the 3 missing", "action": "addMissing" }
] } }`,
      },
      eggs: {
        idx: '04',
        quote: 'Half the eggs arrived cracked.',
        intent: ['issue: damaged item', 'item: eggs', 'qty: about half'],
        catalog: ['ItemRow', 'Stepper', 'ChoiceCards'],
        context: ['/order: 7731', '/item: "eggs"', '/claims: 0'],
        wire: `{ "createSurface": { "surfaceId": "assist_zone", "catalogId": "marigold.v1" } }
{ "updateDataModel": { "path": "/",
    "value": { "order": 7731, "item": "Organic eggs", "unitPrice": 6.49, "cracked": 6 } } }
{ "updateComponents": { "surfaceId": "assist_zone", "components": [
    { "id": "item", "component": "ItemRow", "name": { "path": "/item" }, "price": { "path": "/unitPrice" } },
    { "id": "qty", "component": "Stepper",
      "label": "How many cracked?", "max": 12, "value": { "path": "/cracked" } },
    { "id": "pick", "component": "ChoiceCards",
      "options": ["refund", "replace"], "value": { "path": "/resolution" } },
    { "id": "cta", "component": "Button",
      "label": "Refund now", "action": "resolve" }
] } }`,
      },
    };

    const steps = root.querySelectorAll('[data-ic]');
    const screens = root.querySelectorAll('[data-ic-screen]');
    const utters = root.querySelectorAll('[data-ic-utter]');
    const ctxSets = root.querySelectorAll('[data-ic-ctx]');
    const zone = root.querySelector('.ic-zone');
    const zoneWho = document.getElementById('ic-zone-who');
    const composer = document.getElementById('ic-composer');
    const composerText = document.getElementById('ic-composer-text');
    const wireEl = document.getElementById('ic-wire');
    const srcIntent = document.getElementById('ic-src-intent');
    const srcCatalog = document.getElementById('ic-src-catalog');
    const srcContext = document.getElementById('ic-src-context');
    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const renderChips = (el, list) => {
      if (!el) return;
      el.textContent = '';
      list.forEach((t) => {
        const s = document.createElement('span');
        s.textContent = t;
        el.appendChild(s);
      });
    };

    /* --- Live wire from the active step into the phone's composer --- */
    const split = root.querySelector('.ic-split');
    const wireSvg = document.getElementById('ic-wire-svg');
    const wirePath = document.getElementById('ic-wire-path');
    const wireA = document.getElementById('ic-wire-a');
    const wireB = document.getElementById('ic-wire-b');
    let wireAllowed = true;
    let wireRaf = 0;

    const drawWire = () => {
      wireRaf = 0;
      if (!wireSvg || !split || !wirePath) return;
      const row = root.querySelector('.ic-step.is-active .ic-step__q');
      if (!wireAllowed || !row || !composer || window.innerWidth < 920) {
        wireSvg.style.display = 'none';
        return;
      }
      const sb = split.getBoundingClientRect();
      const rb = row.getBoundingClientRect();
      const tb = composer.getBoundingClientRect();
      if (!sb.width || !tb.width) {
        wireSvg.style.display = 'none';
        return;
      }
      wireSvg.setAttribute('viewBox', `0 0 ${sb.width} ${sb.height}`);
      wireSvg.style.width = `${sb.width}px`;
      wireSvg.style.height = `${sb.height}px`;
      const x1 = rb.right - sb.left + 10;
      const y1 = rb.top + rb.height / 2 - sb.top;
      const x2 = tb.left - sb.left + 2;
      const y2 = tb.top + tb.height / 2 - sb.top;
      const dx = Math.max(48, (x2 - x1) * 0.55);
      wirePath.setAttribute('d', `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`);
      if (wireA) { wireA.setAttribute('cx', String(x1)); wireA.setAttribute('cy', String(y1)); }
      if (wireB) { wireB.setAttribute('cx', String(x2)); wireB.setAttribute('cy', String(y2)); }
      wireSvg.style.display = 'block';
    };

    const scheduleWire = () => {
      if (wireRaf) return;
      wireRaf = requestAnimationFrame(drawWire);
    };
    window.addEventListener('resize', scheduleWire);
    window.addEventListener('scroll', scheduleWire, { passive: true });
    if ('ResizeObserver' in window && split) new ResizeObserver(scheduleWire).observe(split);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(scheduleWire);

    /* --- Intent -> typed into the composer -> surface composes -> renders --- */
    let timers = [];
    let current = 'dinner';
    const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };

    const showScreen = (key) => {
      screens.forEach((s) => s.classList.toggle('is-active', s.getAttribute('data-ic-screen') === key));
    };

    const composeZone = (key) => {
      if (!zone || reduceMotion) { showScreen(key); return; }
      zone.classList.add('is-composing');
      timers.push(setTimeout(() => {
        showScreen(key);
        zone.classList.remove('is-composing');
      }, 420));
    };

    const typeIntoComposer = (text, done) => {
      if (!composer || !composerText || reduceMotion) {
        if (composerText) composerText.textContent = text;
        done();
        return;
      }
      composer.classList.remove('is-sent');
      composer.classList.add('is-typing');
      composerText.textContent = '';
      const chars = Array.from(text);
      let i = 0;
      const step = () => {
        i += 1;
        composerText.textContent = chars.slice(0, i).join('');
        if (i < chars.length) {
          timers.push(setTimeout(step, 12));
        } else {
          composer.classList.remove('is-typing');
          composer.classList.add('is-sent');
          timers.push(setTimeout(() => composer.classList.remove('is-sent'), 700));
          done();
        }
      };
      step();
    };

    const setIntent = (key, animate) => {
      const d = intents[key];
      if (!d || (key === current && animate)) return;
      current = key;
      clearTimers();
      steps.forEach((s) => {
        const on = s.getAttribute('data-ic') === key;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      utters.forEach((u) => u.classList.toggle('is-active', u.getAttribute('data-ic-utter') === key));
      ctxSets.forEach((c) => c.classList.toggle('is-active', c.getAttribute('data-ic-ctx') === key));
      if (zoneWho) zoneWho.textContent = d.idx;
      if (wireEl) wireEl.textContent = d.wire;
      renderChips(srcIntent, d.intent);
      renderChips(srcCatalog, d.catalog);
      renderChips(srcContext, d.context);
      scheduleWire();

      if (!animate) {
        if (composerText) composerText.textContent = d.quote;
        showScreen(key);
        return;
      }
      typeIntoComposer(d.quote, () => composeZone(key));
    };

    /* Scrolling sends each intent: a step activates when it crosses the middle band of the viewport */
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) setIntent(e.target.getAttribute('data-ic') || 'dinner', true);
          });
        },
        { rootMargin: '-42% 0px -42% 0px', threshold: 0 }
      );
      steps.forEach((s) => io.observe(s));
    }

    steps.forEach((s) => {
      s.addEventListener('click', () => {
        const key = s.getAttribute('data-ic') || 'dinner';
        setIntent(key, true);
        s.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      });
    });
    scheduleWire();

    /* --- In-surface interactions (bound locally, no round trips) --- */
    const money = (n) => `$${n.toFixed(2)}`;

    // 01 · basket tiles + budget meter
    const dnTiles = root.querySelectorAll('.ic-gtile:not(.is-pantry)');
    const dnFill = document.getElementById('ic-dn-fill');
    const dnTotal = document.getElementById('ic-dn-total');
    const dnCta = document.getElementById('ic-dn-cta');
    const syncDinner = () => {
      let total = 0; let count = 0;
      dnTiles.forEach((t) => {
        if (t.classList.contains('is-off')) return;
        total += Number(t.getAttribute('data-price') || 0);
        count += 1;
      });
      if (dnFill) dnFill.style.width = `${Math.min(100, (total / 40) * 100)}%`;
      if (dnTotal) dnTotal.textContent = money(total);
      if (dnCta && !dnCta.classList.contains('is-done')) {
        dnCta.innerHTML = `<span>Add ${count} item${count === 1 ? '' : 's'} · ${money(total)}</span><span aria-hidden="true">→</span>`;
      }
    };
    dnTiles.forEach((t) => t.addEventListener('click', () => { t.classList.toggle('is-off'); if (dnCta) dnCta.classList.remove('is-done'); syncDinner(); }));

    // 02 · frozen-salmon toggle
    const blToggle = document.getElementById('ic-bl-toggle');
    const blSave = document.getElementById('ic-bl-save');
    if (blToggle) {
      blToggle.addEventListener('click', () => {
        const on = blToggle.classList.toggle('is-on');
        blToggle.setAttribute('aria-pressed', on ? 'true' : 'false');
        if (blSave) blSave.textContent = on ? 'Saves about $9' : 'Keep fresh · no change';
      });
    }

    // 03 · checklist
    const ptItems = root.querySelectorAll('.ic-ck');
    const ptCta = document.getElementById('ic-pt-cta');
    const syncParty = () => {
      const missing = Array.from(ptItems).filter((i) => !i.classList.contains('is-done')).length;
      if (!ptCta || ptCta.classList.contains('is-done')) return;
      ptCta.innerHTML = missing
        ? `<span>Add the ${missing} missing · Sat 10am</span><span aria-hidden="true">→</span>`
        : '<span>Everything’s covered · nothing to add</span>';
    };
    ptItems.forEach((i) => i.addEventListener('click', () => { i.classList.toggle('is-done'); if (ptCta) ptCta.classList.remove('is-done'); syncParty(); }));

    // 04 · cracked-egg stepper + refund/replace choice
    let eggs = 6; let egChoice = 'refund';
    const egN = document.getElementById('ic-eg-n');
    const egRefund = document.getElementById('ic-eg-refund');
    const egCta = document.getElementById('ic-eg-cta');
    const syncEggs = () => {
      const refund = (6.49 / 12) * eggs;
      if (egN) egN.textContent = String(eggs);
      if (egRefund) egRefund.textContent = money(refund);
      if (egCta && !egCta.classList.contains('is-done')) {
        egCta.innerHTML = egChoice === 'refund'
          ? `<span>Refund ${money(refund)} now</span><span aria-hidden="true">→</span>`
          : `<span>Replace ${eggs} eggs · tomorrow 7–9am</span><span aria-hidden="true">→</span>`;
      }
    };
    const egMinus = document.getElementById('ic-eg-minus');
    const egPlus = document.getElementById('ic-eg-plus');
    if (egMinus) egMinus.addEventListener('click', () => { eggs = Math.max(1, eggs - 1); if (egCta) egCta.classList.remove('is-done'); syncEggs(); });
    if (egPlus) egPlus.addEventListener('click', () => { eggs = Math.min(12, eggs + 1); if (egCta) egCta.classList.remove('is-done'); syncEggs(); });
    root.querySelectorAll('[data-eg-choice]').forEach((b) => {
      b.addEventListener('click', () => {
        egChoice = b.getAttribute('data-eg-choice') || 'refund';
        root.querySelectorAll('[data-eg-choice]').forEach((x) => x.classList.toggle('is-on', x === b));
        if (egCta) egCta.classList.remove('is-done');
        syncEggs();
      });
    });

    /* One-tap primary actions resolve in place */
    root.querySelectorAll('[data-ic-cta]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('is-done')) return;
        btn.classList.add('is-done');
        btn.textContent = btn.getAttribute('data-done') || '✓ Done';
      });
    });

    /* Live clock in the context instrument */
    const clock = document.getElementById('ic-clock');
    const tick = () => {
      if (!clock) return;
      const d = new Date();
      clock.textContent = [d.getHours(), d.getMinutes(), d.getSeconds()]
        .map((n) => String(n).padStart(2, '0'))
        .join(':');
    };
    tick();
    setInterval(tick, 1000);

    /* Screen / Wire lens */
    const lensBtns = root.querySelectorAll('[data-ic-lens]');
    const lensViews = root.querySelectorAll('[data-ic-view]');
    lensBtns.forEach((b) => {
      b.addEventListener('click', () => {
        const lens = b.getAttribute('data-ic-lens') || 'screen';
        lensBtns.forEach((x) => x.classList.toggle('is-active', x === b));
        lensViews.forEach((v) => v.classList.toggle('is-active', v.getAttribute('data-ic-view') === lens));
        wireAllowed = lens === 'screen';
        scheduleWire();
      });
    });
  })();
</script>

<style>
  /* Scroll-driven: each intent is sent to the same sticky Assist screen (Marigold Market, v2) */
  .ic-root {
    width: 100%;
    color: var(--a2-text);
  }

  .ic-kicker {
    font-family: var(--a2-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--a2-text-muted);
  }

  /* =======================================================================
     SPLIT: SCROLLING STEPS | STICKY STAGE
     ======================================================================= */
  .ic-split {
    position: relative;
    display: grid;
    grid-template-columns: minmax(300px, 0.88fr) minmax(0, 1.12fr);
    gap: 64px;
    align-items: start;
  }

  @media (max-width: 920px) {
    .ic-split {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* --- Steps --- */
  .ic-picker {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 4vh 0 22vh;
  }

  @media (max-width: 920px) {
    .ic-picker {
      order: 2;
      padding: 0 0 8vh;
    }
  }

  .ic-steps {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .ic-steps::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--a2-border-strong);
  }

  .ic-step {
    appearance: none;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    min-height: 56vh;
    padding: 24px 0 24px 40px;
    border: none;
    background: transparent;
    color: var(--a2-text);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    opacity: 0.38;
    transition: opacity 0.35s ease;
  }

  @media (max-width: 920px) {
    .ic-step {
      min-height: 0;
      padding: 28px 0 28px 40px;
    }
  }

  .ic-step:hover {
    opacity: 0.7;
  }

  .ic-step.is-active {
    opacity: 1;
  }

  .ic-step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 15px;
    height: 15px;
    margin-top: -8px;
    border-radius: 50%;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-bg);
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ic-step.is-active::before {
    background: var(--a2-accent);
    border-color: var(--a2-accent);
    box-shadow: 0 0 0 5px var(--a2-accent-soft);
  }

  .ic-step__idx {
    font-family: var(--a2-font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-text-muted);
  }

  .ic-step__idx em {
    font-style: normal;
    margin-left: 8px;
    color: var(--a2-accent);
  }

  .ic-step__q {
    font-family: var(--a2-font-serif);
    font-style: italic;
    font-size: clamp(22px, 2.1vw, 28px);
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: var(--a2-text);
    max-width: 18ch;
  }

  .ic-step__desc {
    font-size: 14.5px;
    line-height: 1.58;
    color: var(--a2-text-secondary);
    max-width: 42ch;
  }

  .ic-step__state {
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-text-muted);
    margin-top: 4px;
  }

  .ic-step__state-on {
    display: none;
    color: var(--a2-accent-strong);
  }

  .ic-step.is-active .ic-step__state-off { display: none; }
  .ic-step.is-active .ic-step__state-on { display: inline; }

  /* --- Live intent wire --- */
  .ic-wire-svg {
    position: absolute;
    left: 0;
    top: 0;
    display: none;
    overflow: visible;
    pointer-events: none;
    z-index: 3;
  }

  .ic-wire-svg path {
    fill: none;
    stroke: var(--a2-accent);
    stroke-width: 1.6;
    stroke-dasharray: 5 6;
    animation: icFlow 1.1s linear infinite;
  }

  .ic-wire-svg circle {
    fill: var(--a2-accent);
  }

  @keyframes icFlow {
    to { stroke-dashoffset: -22; }
  }

  /* --- Stage (sticky, deep teal field) --- */
  .ic-stage {
    position: sticky;
    top: 84px;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(45, 212, 191, 0.22);
    background-color: #0a2c2a;
    background-image:
      linear-gradient(135deg, rgba(20, 184, 166, 0.22), transparent 58%),
      radial-gradient(rgba(45, 212, 191, 0.26) 1px, transparent 1px);
    background-size: 100% 100%, 16px 16px;
    overflow: hidden;
  }

  @media (max-width: 920px) {
    .ic-stage {
      position: relative;
      top: auto;
      order: 1;
    }
  }

  .ic-stage__bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px 0;
  }

  .ic-stage__tag {
    font-family: var(--a2-font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 6px 10px;
    background: #f8fafc;
    color: #071a19;
  }

  .ic-lens {
    display: flex;
    gap: 16px;
  }

  .ic-lens__btn {
    appearance: none;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    padding: 4px 0;
    font-family: var(--a2-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(248, 250, 252, 0.55);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .ic-lens__btn:hover { color: #f8fafc; }

  .ic-lens__btn.is-active {
    color: #f8fafc;
    border-bottom-color: var(--a2-accent-strong);
  }

  .ic-lens-view {
    display: none;
    flex: 1;
    position: relative;
  }

  .ic-lens-view.is-active {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 24px 18px;
  }

  .ic-lens-view[data-ic-view='wire'].is-active {
    justify-content: center;
    min-height: 640px;
  }

  /* Blueprint callout for the composed zone (wide viewports) */
  .ic-callout {
    position: absolute;
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 104px;
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  @media (min-width: 1180px) {
    .ic-callout { display: flex; }
  }

  .ic-callout::before,
  .ic-callout::after {
    content: '';
    position: absolute;
    left: 0;
    width: 8px;
    height: 1px;
    background: var(--a2-accent-strong);
  }

  .ic-callout::before { top: 0; }
  .ic-callout::after { bottom: 0; }

  .ic-callout__t {
    font-weight: 700;
    color: var(--a2-accent-strong);
  }

  .ic-callout__s {
    font-family: var(--a2-font-sans);
    font-size: 11px;
    letter-spacing: 0;
    line-height: 1.35;
    color: rgba(248, 250, 252, 0.68);
  }

  .ic-callout__s b {
    font-weight: 600;
    color: #f8fafc;
  }

  /* zone top = view pad 20 + border 1 + pad 12 + status 16 + 8 + hdr 36 + 10 */
  .ic-callout--zone {
    right: 14px;
    top: 103px;
    height: 372px;
    padding-left: 12px;
    border-left: 1px solid var(--a2-accent-strong);
  }

  /* horizontal brace under the device: the constant shell */
  .ic-brace {
    position: relative;
    width: 440px;
    max-width: 100%;
    margin-top: 12px;
    padding-top: 9px;
    border-top: 1px solid rgba(248, 250, 252, 0.42);
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    text-align: center;
  }

  .ic-brace::before,
  .ic-brace::after {
    content: '';
    position: absolute;
    top: 0;
    width: 1px;
    height: 8px;
    background: rgba(248, 250, 252, 0.42);
  }

  .ic-brace::before { left: 0; }
  .ic-brace::after { right: 0; }

  .ic-brace__t {
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #f8fafc;
    white-space: nowrap;
  }

  .ic-brace__s {
    font-size: 11px;
    color: rgba(248, 250, 252, 0.68);
    white-space: nowrap;
  }

  /* --- Device + constant shell --- */
  .ic-device {
    width: 328px;
    max-width: 100%;
    background: var(--a2-bg);
    border: 1px solid var(--a2-border-strong);
    border-radius: 28px;
    box-shadow: 0 34px 80px -20px rgba(0, 0, 0, 0.72);
    padding: 12px 14px 12px;
    display: flex;
    flex-direction: column;
  }

  .ic-device__status {
    height: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 8px;
    font-family: var(--a2-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    color: var(--a2-text-muted);
  }

  .ic-device__sig {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
  }

  .ic-device__sig i {
    width: 3px;
    background: var(--a2-text-muted);
    display: block;
  }
  .ic-device__sig i:nth-child(1) { height: 5px; }
  .ic-device__sig i:nth-child(2) { height: 8px; }
  .ic-device__sig i:nth-child(3) { height: 11px; }

  .ic-shell-hdr {
    margin-top: 8px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px;
    border-bottom: 1px solid var(--a2-border);
  }

  .ic-shell-brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--a2-text);
  }

  .ic-shell-brand svg {
    width: 15px;
    height: 15px;
    color: var(--a2-accent);
  }

  .ic-shell-bell {
    width: 16px;
    height: 16px;
    color: var(--a2-text-muted);
  }

  .ic-zone {
    position: relative;
    margin-top: 10px;
    height: 372px;
    box-sizing: border-box;
    padding: 14px 10px 10px;
    border: 1px dashed var(--a2-accent-border);
  }

  .ic-zone__tag {
    position: absolute;
    top: -7px;
    left: 10px;
    padding: 0 5px;
    background: var(--a2-bg);
    font-family: var(--a2-font-mono);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-accent-strong);
  }

  /* Composing skeleton */
  .ic-zone__skel {
    position: absolute;
    inset: 14px 10px 10px;
    display: none;
    flex-direction: column;
    gap: 12px;
    z-index: 2;
  }

  .ic-zone.is-composing .ic-zone__skel { display: flex; }
  .ic-zone.is-composing .ic-screen { visibility: hidden; }

  .ic-zone__skel-lbl {
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-accent-strong);
    margin-bottom: 4px;
  }

  .ic-zone__skel i {
    display: block;
    height: 14px;
    background: var(--a2-border-strong);
    animation: icShimmer 0.9s ease-in-out infinite;
  }

  .ic-zone__skel i:nth-child(3) { animation-delay: 0.12s; }
  .ic-zone__skel i:nth-child(4) { animation-delay: 0.24s; }
  .ic-zone__skel i:nth-child(5) { animation-delay: 0.36s; }

  @keyframes icShimmer {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.9; }
  }

  /* Composer */
  .ic-composer {
    margin-top: 10px;
    height: 46px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 8px 0 10px;
    border: 1px solid var(--a2-border-strong);
    border-radius: 12px;
    background: var(--a2-surface);
    transition: border-color 0.18s ease;
  }

  .ic-composer.is-typing { border-color: var(--a2-accent); }

  .ic-composer__ico {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border: 1.5px solid var(--a2-text-muted);
    border-radius: 50%;
  }

  .ic-composer__txt {
    flex: 1;
    min-width: 0;
    font-size: 11px;
    line-height: 1.3;
    color: var(--a2-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ic-caret {
    display: none;
    width: 1.5px;
    height: 11px;
    margin-left: 1px;
    vertical-align: -2px;
    background: var(--a2-accent-strong);
    animation: icCaret 0.8s steps(1) infinite;
  }

  .ic-composer.is-typing .ic-caret { display: inline-block; }

  @keyframes icCaret { 50% { opacity: 0; } }

  .ic-composer__send {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--a2-border-strong);
    color: var(--a2-text);
    font-size: 13px;
    font-weight: 700;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  .ic-composer.is-sent .ic-composer__send {
    background: var(--a2-accent);
    color: #04201d;
  }

  .ic-tabbar {
    margin-top: 8px;
    height: 46px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    text-align: center;
    font-family: var(--a2-font-sans);
    font-size: 9.5px;
    font-weight: 600;
    color: var(--a2-text-muted);
  }

  .ic-tabbar span.is-on { color: var(--a2-accent-strong); }

  .ic-tab-ico {
    display: block;
    width: 14px;
    height: 14px;
    margin: 0 auto 4px;
    border: 1.5px solid currentColor;
    border-radius: 3px;
  }

  .ic-tab-ico--assist { border-radius: 50%; }
  .ic-tab-ico--orders { height: 11px; width: 16px; }
  .ic-tab-ico--you { border-radius: 50%; width: 12px; height: 12px; }

  /* =======================================================================
     COMPOSED SCREENS (four structurally different surfaces)
     ======================================================================= */
  .ic-screen {
    display: none;
    height: 100%;
    flex-direction: column;
    gap: 10px;
  }

  .ic-screen.is-active {
    display: flex;
    animation: icFade 0.22s ease-out;
  }

  @keyframes icFade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ic-greet {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 2px 2px 0;
  }

  .ic-greet strong {
    font-size: 15.5px;
    font-weight: 640;
    letter-spacing: -0.02em;
    color: var(--a2-text);
  }

  .ic-greet span {
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-lbl {
    font-family: var(--a2-font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-accent-strong);
  }

  .ic-cta {
    appearance: none;
    margin-top: auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 16px;
    border: 1px solid var(--a2-cta-bg);
    border-radius: 3px;
    background: var(--a2-cta-bg);
    color: var(--a2-cta-fg);
    font-family: var(--a2-font-sans);
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .ic-cta:hover { background: var(--a2-cta-hover); }

  .ic-cta.is-done {
    justify-content: center;
    background: var(--a2-success);
    border-color: var(--a2-success);
    color: #ffffff;
  }

  /* 01 · recipe + grid + meter */
  .ic-recipe {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px 11px;
    border: 1px solid var(--a2-accent-border);
    background: var(--a2-accent-soft);
  }

  .ic-recipe strong {
    font-family: var(--a2-font-display);
    font-size: 17px;
    font-weight: 660;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--a2-text);
  }

  .ic-recipe__meta {
    font-size: 10.5px;
    color: var(--a2-text-secondary);
  }

  .ic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .ic-gtile {
    appearance: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 8px 8px 7px;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-surface);
    color: var(--a2-text);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .ic-gtile:hover { border-color: var(--a2-accent); }

  .ic-gtile b {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ic-gtile span {
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-gtile.is-off {
    opacity: 0.4;
    border-style: dashed;
  }

  .ic-gtile.is-off b { text-decoration: line-through; }

  .ic-gtile.is-pantry {
    border-style: dashed;
    background: transparent;
    color: var(--a2-text-muted);
    cursor: default;
  }

  .ic-gtile.is-pantry span { color: var(--a2-accent-strong); font-weight: 700; font-size: 8.5px; letter-spacing: 0.08em; }

  .ic-meter {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ic-meter__track {
    height: 6px;
    background: var(--a2-border);
  }

  .ic-meter__track i {
    display: block;
    height: 100%;
    background: var(--a2-accent);
    transition: width 0.25s ease;
  }

  .ic-meter__lbl {
    display: flex;
    justify-content: space-between;
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-meter__lbl span:first-child {
    font-weight: 700;
    color: var(--a2-text);
  }

  /* 02 · compare bars + deltas + toggle */
  .ic-bars2 {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 9px 12px 10px;
    border: 1px solid var(--a2-border);
    background: var(--a2-surface-subtle);
  }

  .ic-bars2 > div {
    display: grid;
    grid-template-columns: 52px 1fr 38px;
    align-items: center;
    gap: 8px;
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-bars2__track {
    height: 14px;
    background: var(--a2-border);
  }

  .ic-bars2__track i {
    display: block;
    height: 100%;
    background: var(--a2-text-muted);
  }

  .ic-bars2 .is-hi .ic-bars2__track i { background: var(--a2-accent); }
  .ic-bars2 .is-hi b, .ic-bars2 .is-hi span { color: var(--a2-text); }

  .ic-bars2 b {
    text-align: right;
    font-size: 11px;
    font-weight: 700;
  }

  .ic-deltas {
    display: flex;
    flex-direction: column;
  }

  .ic-deltas > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 6px 2px;
    border-top: 1px solid var(--a2-border);
  }

  .ic-deltas > div:last-child { border-bottom: 1px solid var(--a2-border); }

  .ic-deltas > div > span {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
  }

  .ic-deltas strong {
    font-size: 12px;
    font-weight: 600;
    color: var(--a2-text);
    white-space: nowrap;
  }

  .ic-deltas em {
    font-style: normal;
    font-size: 10.5px;
    color: var(--a2-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ic-deltas b {
    font-family: var(--a2-font-mono);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--a2-coral);
    white-space: nowrap;
  }

  .ic-toggle-row {
    appearance: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-surface);
    color: var(--a2-text);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ic-toggle-row strong {
    display: block;
    font-size: 12px;
    font-weight: 600;
  }

  .ic-toggle-row em {
    font-style: normal;
    font-size: 10.5px;
    color: var(--a2-accent-strong);
  }

  .ic-toggle-row i {
    position: relative;
    width: 32px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 9px;
    background: var(--a2-border-strong);
    transition: background-color 0.18s ease;
  }

  .ic-toggle-row i::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.18s ease;
  }

  .ic-toggle-row.is-on i { background: var(--a2-accent); }
  .ic-toggle-row.is-on i::after { transform: translateX(14px); }

  /* 03 · timeline + checklist */
  .ic-tl3 {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 6px 0 2px;
  }

  .ic-tl3::before {
    content: '';
    position: absolute;
    left: 16%;
    right: 16%;
    top: 11px;
    height: 1px;
    background: var(--a2-border-strong);
  }

  .ic-tl3 span {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    text-align: center;
  }

  .ic-tl3 i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--a2-border-strong);
    background: var(--a2-bg);
  }

  .ic-tl3 .is-done i { background: var(--a2-accent); border-color: var(--a2-accent); }
  .ic-tl3 .is-live i { border-color: var(--a2-accent-strong); box-shadow: 0 0 0 3px var(--a2-accent-soft); }

  .ic-tl3 b {
    font-family: var(--a2-font-mono);
    font-size: 9px;
    font-weight: 700;
    color: var(--a2-text);
  }

  .ic-tl3 em {
    font-style: normal;
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-checklist {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--a2-border);
  }

  .ic-ck {
    appearance: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 2px;
    border: none;
    border-bottom: 1px solid var(--a2-border);
    background: transparent;
    color: var(--a2-text);
    font-family: inherit;
    font-size: 12px;
    text-align: left;
    cursor: pointer;
  }

  .ic-ck i {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    border: 1.5px solid var(--a2-border-strong);
    border-radius: 3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ic-ck.is-done { color: var(--a2-text-muted); }
  .ic-ck.is-done span { text-decoration: line-through; }

  .ic-ck.is-done i {
    background: var(--a2-accent);
    border-color: var(--a2-accent);
  }

  .ic-ck.is-done i::after {
    content: '✓';
    font-size: 9px;
    font-weight: 700;
    color: #04201d;
  }

  .ic-ck b {
    margin-left: 6px;
    font-family: var(--a2-font-mono);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--a2-amber);
    border: 1px solid var(--a2-amber-border);
    padding: 1px 4px;
  }

  /* 04 · item + stepper + choices */
  .ic-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px 12px 11px;
    border: 1px solid var(--a2-accent-border);
    background: var(--a2-accent-soft);
  }

  .ic-item__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 13px;
    font-weight: 600;
    color: var(--a2-text);
  }

  .ic-item__row b {
    font-family: var(--a2-font-mono);
    font-size: 12px;
  }

  .ic-stepper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .ic-stepper > span {
    font-family: var(--a2-font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--a2-text-muted);
  }

  .ic-stepper > div {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ic-stepper button {
    appearance: none;
    width: 26px;
    height: 26px;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-bg);
    color: var(--a2-text);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
  }

  .ic-stepper strong {
    min-width: 18px;
    text-align: center;
    font-family: var(--a2-font-mono);
    font-size: 16px;
    font-weight: 700;
    color: var(--a2-text);
  }

  .ic-stepper em {
    font-style: normal;
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    color: var(--a2-text-muted);
  }

  .ic-choice2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .ic-choice {
    appearance: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 11px;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-surface);
    color: var(--a2-text);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .ic-choice span {
    font-family: var(--a2-font-mono);
