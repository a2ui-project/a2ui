const mermaidSpec = `
sequenceDiagram
  actor User as Mobile Chat User
  participant App as Mobile Renderer SDK (SwiftUI / Compose / Flutter)
  participant Agent as Agent + A2UI Agent SDK
  App->>Agent: Advertise a2uiRendererCapabilities (supportedCatalogIds) + chat prompt
  Agent-->>App: createSurface (surfaceId: "kyoto_trip", catalogId: ".../basic/catalog.json")
  Agent-->>App: Incremental updateComponents (root first) + updateDataModel (~5s stream)
  App-->>User: Progressively mounts interactive native UI cards inside chat
  User->>App: Adjusts cabin, guests slider, onsen, dinner (0ms local dataModel sync)
  User->>App: Taps Hold Itinerary
  App->>Agent: action (name: "confirm_trip", context from local dataModel)
  Agent-->>App: updateDataModel (path: "/trip/estUsd")
`;
---

<div
  class="hc-shell"
  id="hero-chat-visual"
  role="region"
  aria-label="How A2UI generates interactive mobile chat interfaces"
>
  <!-- Top 3-Step Summary Bar: Explains in a nutshell how UI gets generated -->
  <div class="hc-nutshell">
    <div class="hc-step">
      <span class="hc-step__num">1</span>
      <div class="hc-step__text">
        <strong>Shared component catalog</strong>
        <span>Your mobile app registers native views; the Agent SDK turns schemas into model instructions.</span>
      </div>
    </div>
    <span class="hc-step__arrow" aria-hidden="true">→</span>
    <div class="hc-step">
      <span class="hc-step__num">2</span>
      <div class="hc-step__text">
        <strong>Agent streams declarative UI</strong>
        <span>Triggered in chat, the agent emits layout and data updates incrementally, never executable code.</span>
      </div>
    </div>
    <span class="hc-step__arrow" aria-hidden="true">→</span>
    <div class="hc-step">
      <span class="hc-step__num">3</span>
      <div class="hc-step__text">
        <strong>Native widgets render in chat</strong>
        <span>The Renderer SDK mounts stateful host controls bound two-way to a local <code>dataModel</code>.</span>
      </div>
    </div>
  </div>

  <!-- Main Interactive Stage: Agent Stream + Local State -> Protocol Wire -> Mobile Device -->
  <div class="hc-stage">
    <!-- LEFT COLUMN: Agent Server Stream + Client Local Surface State -->
    <div class="hc-left-col">
      <div class="hc-agent">
        <div class="hc-agent__head">
          <div class="hc-agent__title-group">
            <span class="hc-live-dot" data-hc-el="agent-dot" aria-hidden="true"></span>
            <span class="hc-agent__badge">AGENT SERVER</span>
            <span class="hc-agent__title">LLM + A2UI Agent SDK</span>
          </div>

          <div class="hc-fmt-tabs" role="tablist" aria-label="Agent output format">
            <button
              type="button"
              role="tab"
              id="hc-fmt-tab-express"
              aria-selected="true"
              aria-controls="hc-code-express"
              tabindex="0"
              class="hc-fmt-tab is-active"
              data-hc-fmt="express"
            >
              Express (LLM)
            </button>
            <button
              type="button"
              role="tab"
              id="hc-fmt-tab-json"
              aria-selected="false"
              aria-controls="hc-code-json"
              tabindex="-1"
              class="hc-fmt-tab"
              data-hc-fmt="json"
            >
              v1.0 JSON
            </button>
          </div>
        </div>

        <!-- Catalog & Surface Context -->
        <div class="hc-context">
          <div class="hc-context__item">
            <span class="hc-context__k">Catalog</span>
            <div class="hc-catalog-chips">
              <code>Card</code>
              <code>Column</code>
              <code>Row</code>
              <code>Image</code>
              <code>Text</code>
              <code>Icon</code>
              <code>Tabs</code>
              <code>ChoicePicker</code>
              <code>Slider</code>
              <code>CheckBox</code>
              <code>Button</code>
            </div>
          </div>
          <div class="hc-context__item hc-context__item--surface">
            <span class="hc-context__k">Surface</span>
            <code class="hc-surface-id">kyoto_trip</code>
          </div>
        </div>

        <!-- Streaming Code Viewport (Fixed height to prevent page layout shift) -->
        <div class="hc-stream-viewport" data-hc-el="stream-viewport">
