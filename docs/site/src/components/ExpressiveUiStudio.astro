---

<div class="cap-grid" id="capability-gallery" role="region" aria-label="Core A2UI protocol capabilities">
  <!-- =====================================================================
       CAPABILITY 01: PROGRESSIVE STREAMING
       ===================================================================== -->
  <article class="cap-item">
    <span class="cap-cross" aria-hidden="true">+</span>

    <header class="cap-head">
      <span class="cap-kicker">01 // PROGRESSIVE STREAMING</span>
      <h3 class="cap-title">Stream UI as tokens arrive.</h3>
      <p class="cap-desc">
        Mount flat component lists incrementally — never wait for a finished response.
      </p>
    </header>

    <div class="cap-stage" id="cap-stream-stage" data-step="3">
      <div class="cap-stage__bar">
        <div class="cap-steps" role="tablist" aria-label="Streaming frame">
          <button type="button" class="cap-step" data-st-step="1">1 · Shell</button>
          <button type="button" class="cap-step" data-st-step="2">2 · Controls</button>
          <button type="button" class="cap-step is-active" data-st-step="3">3 · Bound</button>
        </div>
        <button type="button" class="cap-mini-btn" id="cap-stream-replay">Replay ↻</button>
      </div>

      <!-- Visual Progressive Blueprint -->
      <div class="st-blueprint" id="st-blueprint" data-frame="3" aria-label="Progressive UI frame preview">
        <div class="st-shell">
          <div class="st-shell__hdr">
            <span class="st-tag">createSurface</span>
            <span class="st-ms" id="st-ms-lbl">180ms · READY</span>
          </div>

          <div class="st-controls-row">
            <div class="st-slot">
              <span class="st-bar st-bar--w60"></span>
              <span class="st-val" id="st-val-a">94.2%</span>
            </div>
            <div class="st-slot">
              <span class="st-bar st-bar--w45"></span>
              <span class="st-val" id="st-val-b">ACTIVE</span>
            </div>
          </div>

          <div class="st-meter">
            <div class="st-meter__fill"></div>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- =====================================================================
       CAPABILITY 02: 0MS TWO-WAY DATA BINDING
       ===================================================================== -->
  <article class="cap-item">
    <span class="cap-cross" aria-hidden="true">+</span>

    <header class="cap-head">
      <span class="cap-kicker">02 // TWO-WAY DATA BINDING</span>
      <h3 class="cap-title">0ms local state sync.</h3>
      <p class="cap-desc">
        Inputs bind to JSON Pointer paths so state updates on-device without LLM roundtrips.
      </p>
    </header>

    <div class="cap-stage">
      <div class="cap-stage__bar">
        <span>RFC 6901 JSON POINTER</span>
        <span class="cap-accent-txt">0 NETWORK CALLS</span>
      </div>

      <div class="bd-diagram">
        <!-- Left: Bound Native UI Control -->
        <div class="bd-ui">
          <div class="bd-ui__lbl">
            <span>UI SLIDER</span>
            <strong id="bd-ui-num">72</strong>
          </div>
          <input type="range" id="bd-slider" class="cap-range" min="10" max="100" value="72" aria-label="Bound state value" />

          <button type="button" class="bd-toggle is-on" id="bd-lock-btn">
            <span>Gate Locked</span>
            <strong id="bd-lock-ui">true</strong>
          </button>
        </div>

        <!-- Center: Bidirectional Signal Arrow -->
        <div class="bd-bridge" aria-hidden="true">
          <span>0ms</span>
          <i></i>
        </div>

        <!-- Right: Live Reactive Data Model -->
        <pre class="bd-json" id="bd-json-box" aria-live="polite"><code>&#123;
  <span class="jk">"/limit"</span>: <span class="jv" id="bd-json-val">72</span>,
  <span class="jk">"/locked"</span>: <span class="jv" id="bd-json-lock">true</span>
&#125;</code></pre>
      </div>
    </div>
  </article>

  <!-- =====================================================================
       CAPABILITY 03: COMPACT FORMATS & @MACROS
       ===================================================================== -->
  <article class="cap-item">
    <span class="cap-cross" aria-hidden="true">+</span>

    <header class="cap-head">
      <span class="cap-kicker">03 // COMPACT INFERENCE</span>
      <h3 class="cap-title">77% smaller token payloads.</h3>
      <p class="cap-desc">
        Models emit terse A2UI Express or <code>@macros</code>; your server expands full trees.
      </p>
    </header>

    <div class="cap-stage">
      <div class="cap-stage__bar">
        <span>WIRE COMPRESSION</span>
        <div class="cap-steps" role="tablist" aria-label="Payload view">
          <button type="button" class="cap-step is-active" data-mc-view="macro">@macro</button>
          <button type="button" class="cap-step" data-mc-view="expanded">Expanded</button>
        </div>
      </div>

      <div class="mc-visual">
        <!-- Visual Token Bar Comparison -->
        <div class="mc-bars">
          <div class="mc-bar-row">
            <div class="mc-bar-lbl">
              <span>Raw Component Tree</span>
              <span>184 tok</span>
            </div>
            <div class="mc-track">
              <div class="mc-fill mc-fill--muted" style="width: 100%"></div>
            </div>
          </div>

          <div class="mc-bar-row">
            <div class="mc-bar-lbl">
              <strong>A2UI @macro</strong>
              <strong class="cap-accent-txt">42 tok (−77%)</strong>
            </div>
            <div class="mc-track">
              <div class="mc-fill mc-fill--accent" style="width: 23%"></div>
            </div>
          </div>
        </div>

        <pre class="mc-code" id="mc-code-box"><code>&#123; "@metricCard": &#123; "kpi": "/arr", "trend": "+34%" &#125; &#125;</code></pre>
      </div>
    </div>
  </article>

  <!-- =====================================================================
       CAPABILITY 04: IN-PLACE SURFACE MUTATION
       ===================================================================== -->
  <article class="cap-item">
    <span class="cap-cross" aria-hidden="true">+</span>

    <header class="cap-head">
      <span class="cap-kicker">04 // LIVE SURFACES</span>
      <h3 class="cap-title">Patch views in place across turns.</h3>
      <p class="cap-desc">
        Update mounted surfaces by ID — or embed <code>ui://</code> MCP canvases — with zero duplicates.
      </p>
    </header>

    <div class="cap-stage">
      <div class="cap-stage__bar">
        <span>surfaceId: "s_01"</span>
        <div class="cap-steps" role="tablist" aria-label="Conversation turn">
          <button type="button" class="cap-step" data-lv-turn="1">Turn 1</button>
          <button type="button" class="cap-step is-active" data-lv-turn="2">Turn 2</button>
          <button type="button" class="cap-step" data-lv-turn="3">Turn 3</button>
        </div>
      </div>

      <!-- Single Mounted Surface Mutating In Place -->
      <div class="lv-surface" id="lv-surface" data-turn="2">
        <div class="lv-surface__top">
          <div>
            <span class="lv-badge" id="lv-state-tag">PATCHED · REFINED</span>
            <strong class="lv-heading" id="lv-heading">2-Region Rollout Plan</strong>
          </div>
          <span class="lv-metric" id="lv-metric">65%</span>
        </div>

        <div class="lv-progress" aria-hidden="true">
          <div class="lv-progress__fill" id="lv-fill" style="width: 65%"></div>
        </div>

        <div class="lv-foot">
          <span>SAME MOUNTED NODE · 0 RE-PRINTS</span>
          <button type="button" class="cap-mini-btn" id="lv-next-btn">Next Turn →</button>
        </div>
      </div>
    </div>
  </article>
</div>

<script is:inline>
  (() => {
    const root = document.getElementById('capability-gallery');
    if (!root) return;

    /* --- 01: Progressive Streaming --- */
    const blueprint = document.getElementById('st-blueprint');
    const msLbl = document.getElementById('st-ms-lbl');
    const stSteps = root.querySelectorAll('[data-st-step]');
    const replayBtn = document.getElementById('cap-stream-replay');
    const frameMeta = {
      '1': '40ms · SHELL MOUNTED',
      '2': '110ms · CONTROLS STREAMED',
      '3': '180ms · READY',
    };
    let streamTimer = null;

    const setStreamFrame = (f) => {
      const key = String(f);
      if (blueprint) blueprint.setAttribute('data-frame', key);
      if (msLbl) msLbl.textContent = frameMeta[key] || frameMeta['3'];
      stSteps.forEach((b) => b.classList.toggle('is-active', b.getAttribute('data-st-step') === key));
    };

    stSteps.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (streamTimer) clearTimeout(streamTimer);
        setStreamFrame(btn.getAttribute('data-st-step') || '3');
      });
    });

    if (replayBtn) {
      replayBtn.addEventListener('click', () => {
        if (streamTimer) clearTimeout(streamTimer);
        setStreamFrame(1);
        streamTimer = setTimeout(() => {
          setStreamFrame(2);
          streamTimer = setTimeout(() => setStreamFrame(3), 460);
        }, 460);
      });
    }

    /* --- 02: 0ms Two-Way Data Binding --- */
    const bdSlider = document.getElementById('bd-slider');
    const bdUiNum = document.getElementById('bd-ui-num');
    const bdJsonVal = document.getElementById('bd-json-val');
    const bdLockBtn = document.getElementById('bd-lock-btn');
    const bdLockUi = document.getElementById('bd-lock-ui');
    const bdJsonLock = document.getElementById('bd-json-lock');
    const bdJsonBox = document.getElementById('bd-json-box');

    const pulseJson = () => {
      if (!bdJsonBox) return;
      bdJsonBox.classList.add('is-pulsing');
      setTimeout(() => bdJsonBox.classList.remove('is-pulsing'), 180);
    };

    if (bdSlider) {
      bdSlider.addEventListener('input', () => {
        if (bdUiNum) bdUiNum.textContent = bdSlider.value;
        if (bdJsonVal) bdJsonVal.textContent = bdSlider.value;
        pulseJson();
      });
    }

    if (bdLockBtn) {
      bdLockBtn.addEventListener('click', () => {
        const on = bdLockBtn.classList.toggle('is-on');
        const txt = on ? 'true' : 'false';
        if (bdLockUi) bdLockUi.textContent = txt;
        if (bdJsonLock) bdJsonLock.textContent = txt;
        pulseJson();
      });
    }

    /* --- 03: Compact Formats & @macros --- */
    const mcCodeBox = document.getElementById('mc-code-box');
    const mcBtns = root.querySelectorAll('[data-mc-view]');
    const mcSnippets = {
      macro: `{ "@metricCard": { "kpi": "/arr", "trend": "+34%" } }`,
      expanded: `[ { "id": "c1", "component": "Card", "children": ["h", "v", "b"] },
  { "id": "v", "component": "Metric", "value": { "path": "/arr" } },
  { "id": "b", "component": "DeltaTag", "text": "+34%" } ]`,
    };

    mcBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const k = btn.getAttribute('data-mc-view') || 'macro';
        mcBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        if (mcCodeBox) mcCodeBox.textContent = mcSnippets[k] || mcSnippets.macro;
      });
    });

    /* --- 04: Live In-Place Surface Mutation --- */
    const lvTurns = {
      1: { tag: 'CREATED · DRAFT', title: 'Single-Region Draft', pct: '30%' },
      2: { tag: 'PATCHED · REFINED', title: '2-Region Rollout Plan', pct: '65%' },
      3: { tag: 'PATCHED · COMMITTED', title: 'Global Cutover Active', pct: '100%' },
    };
    let curTurn = 2;
    const lvSurface = document.getElementById('lv-surface');
    const lvTag = document.getElementById('lv-state-tag');
    const lvHeading = document.getElementById('lv-heading');
    const lvMetric = document.getElementById('lv-metric');
    const lvFill = document.getElementById('lv-fill');
    const lvBtns = root.querySelectorAll('[data-lv-turn]');
    const lvNext = document.getElementById('lv-next-btn');

    const setLiveTurn = (n) => {
      curTurn = n;
      const d = lvTurns[n] || lvTurns[2];
      if (lvSurface) lvSurface.setAttribute('data-turn', String(n));
      if (lvTag) lvTag.textContent = d.tag;
      if (lvHeading) lvHeading.textContent = d.title;
      if (lvMetric) lvMetric.textContent = d.pct;
      if (lvFill) lvFill.style.width = d.pct;
      lvBtns.forEach((b) => b.classList.toggle('is-active', Number(b.getAttribute('data-lv-turn')) === n));
    };

    lvBtns.forEach((btn) => {
      btn.addEventListener('click', () => setLiveTurn(Number(btn.getAttribute('data-lv-turn') || 2)));
    });

    if (lvNext) {
      lvNext.addEventListener('click', () => {
        setLiveTurn(curTurn >= 3 ? 1 : curTurn + 1);
      });
    }
  })();
</script>

<style>
  /* =======================================================================
     SPACIOUS 2x2 ARCHITECTURAL CAPABILITY GRID
     ======================================================================= */
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 96px;
    row-gap: 116px;
    width: 100%;
  }

  @media (max-width: 920px) {
    .cap-grid {
      grid-template-columns: 1fr;
      row-gap: 80px;
    }
  }

  .cap-item {
    position: relative;
    padding-top: 34px;
    border-top: 1px solid var(--a2-border-strong);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .cap-cross {
    position: absolute;
    top: -7px;
    left: 0;
    font-family: var(--a2-font-mono);
    font-size: 13px;
    line-height: 1;
    color: var(--a2-text-muted);
    opacity: 0.55;
    pointer-events: none;
  }

  .cap-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cap-kicker {
    font-family: var(--a2-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--a2-accent);
  }

  .cap-title {
    margin: 0;
    font-family: var(--a2-font-display);
    font-size: 24px;
    font-weight: 630;
    line-height: 1.16;
    letter-spacing: -0.025em;
    color: var(--a2-text);
  }

  .cap-desc {
    margin: 2px 0 0;
    font-size: 14.5px;
    line-height: 1.58;
    color: var(--a2-text-secondary);
    max-width: 42ch;
  }

  .cap-desc code {
    font-family: var(--a2-font-mono);
    font-size: 12.5px;
    color: var(--a2-accent-strong);
  }

  /* =======================================================================
     SHARED VISUAL STAGE FRAME
     ======================================================================= */
  .cap-stage {
    flex: 1;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-surface);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .cap-stage__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--a2-border);
    background: var(--a2-surface-subtle);
    font-family: var(--a2-font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--a2-text-muted);
  }

  .cap-accent-txt {
    color: var(--a2-accent-strong);
  }

  .cap-steps {
    display: inline-flex;
    gap: 4px;
  }

  .cap-step {
    appearance: none;
    border: 1px solid transparent;
    background: transparent;
    padding: 3px 8px;
    font-family: var(--a2-font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--a2-text-muted);
    cursor: pointer;
  }

  .cap-step:hover {
    color: var(--a2-text);
  }

  .cap-step.is-active {
    border-color: var(--a2-accent);
    background: var(--a2-accent-soft);
    color: var(--a2-accent-strong);
  }

  .cap-mini-btn {
    appearance: none;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-bg);
    padding: 4px 10px;
    font-family: var(--a2-font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--a2-text);
    cursor: pointer;
    transition: border-color 0.14s ease;
  }

  .cap-mini-btn:hover {
    border-color: var(--a2-accent);
    color: var(--a2-accent-strong);
  }

  .cap-range {
    width: 100%;
    accent-color: var(--a2-accent);
    cursor: pointer;
  }

  /* =======================================================================
     01. PROGRESSIVE STREAMING BLUEPRINT
     ======================================================================= */
  .st-blueprint {
    padding: 18px;
  }

  .st-shell {
    border: 1px solid var(--a2-accent);
    background: var(--a2-bg);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-style 0.2s ease;
  }

  .st-blueprint[data-frame='1'] .st-shell {
    border-style: dashed;
  }

  .st-shell__hdr {
    display: flex;
    justify-content: space-between;
    font-family: var(--a2-font-mono);
    font-size: 10.5px;
  }

  .st-tag {
    color: var(--a2-accent-strong);
    font-weight: 600;
  }

  .st-ms {
    color: var(--a2-text-muted);
  }

  .st-controls-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    transition: opacity 0.22s ease;
  }

  .st-blueprint[data-frame='1'] .st-controls-row {
    opacity: 0.18;
  }

  .st-slot {
    border: 1px solid var(--a2-border);
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .st-bar {
    height: 6px;
    background: var(--a2-border-strong);
    display: block;
  }
  .st-bar--w60 { width: 48%; }
  .st-bar--w45 { width: 38%; }

  .st-val {
    font-family: var(--a2-font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--a2-text);
    transition: opacity 0.22s ease;
  }

  .st-blueprint[data-frame='1'] .st-val,
  .st-blueprint[data-frame='2'] .st-val {
    opacity: 0.15;
  }

  .st-meter {
    height: 4px;
    background: var(--a2-border);
  }

  .st-meter__fill {
    height: 100%;
    width: 100%;
    background: var(--a2-accent);
    transform-origin: left;
    transition: transform 0.28s ease;
  }

  .st-blueprint[data-frame='1'] .st-meter__fill { transform: scaleX(0.25); }
  .st-blueprint[data-frame='2'] .st-meter__fill { transform: scaleX(0.62); }
  .st-blueprint[data-frame='3'] .st-meter__fill { transform: scaleX(1); }

  /* =======================================================================
     02. 0MS DATA BINDING SPLIT DIAGRAM
     ======================================================================= */
  .bd-diagram {
    padding: 18px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 14px;
    align-items: center;
  }

  @media (max-width: 560px) {
    .bd-diagram { grid-template-columns: 1fr; }
  }

  .bd-ui {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bd-ui__lbl {
    display: flex;
    justify-content: space-between;
    font-family: var(--a2-font-mono);
    font-size: 10.5px;
    color: var(--a2-text-muted);
  }

  .bd-ui__lbl strong {
    font-size: 14px;
    color: var(--a2-text);
  }

  .bd-toggle {
    appearance: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    border: 1px solid var(--a2-border-strong);
    background: var(--a2-bg);
    color: var(--a2-text-secondary);
    font-family: var(--a2-font-sans);
    font-size: 12px;
    cursor: pointer;
  }

  .bd-toggle strong {
    font-family: var(--a2-font-mono);
    font-size: 11px;
    color: var(--a2-accent-strong);
  }

  .bd-toggle.is-on {
    border-color: var(--a2-accent);
  }

  .bd-bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: var(--a2-accent);
  }

  .bd-bridge i {
    display: block;
    width: 34px;
    height: 1.5px;
    background: var(--a2-accent);
  }

  .bd-json {
    margin: 0;
    padding: 14px;
    background: #0c0e14;
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-family: var(--a2-font-mono);
    font-size: 11.5px;
    line-height: 1.65;
    color: #cbd5e1;
    transition: border-color 0.15s ease;
  }

  .bd-json.is-pulsing {
    border-color: var(--a2-accent);
  }

  .bd-json .jk { color: #94a3b8; }
  .bd-json .jv { color: #2dd4bf; font-weight: 700; }

  /* =======================================================================
     03. COMPACT FORMATS & @MACROS
     ======================================================================= */
  .mc-visual {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mc-bars {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mc-bar-lbl {
    display: flex;
    justify-content: space-between;
    font-family: var(--a2-font-mono);
    font-size: 11px;
    color: var(--a2-text-secondary);
    margin-bottom: 5px;
  }

  .mc-track {
    height: 8px;
    background: var(--a2-surface-subtle);
    border: 1px solid var(--a2-border);
  }

  .mc-fill {
    height: 100%;
  }

  .mc-fill--muted {
    background: var(--a2-border-strong);
  }

  .mc-fill--accent {
    background: var(--a2-accent);
  }

  .mc-code {
    margin: 0;
    padding: 11px 14px;
    background: #0c0e14;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--a2-font-mono);
    font-size: 11px;
    line-height: 1.55;
    color: #e2e8f0;
    overflow-x: auto;
  }

  /* =======================================================================
     04. IN-PLACE LIVE SURFACE MUTATION
     ======================================================================= */
  .lv-surface {
    margin: 18px;
    padding: 16px;
    border: 1px solid var(--a2-accent);
    background: var(--a2-bg);
    display: flex;
    flex-direction: column;
    gap: 14px;
