---

<section class="a2-section gs-section" id="spectrum">
  <div class="gs-wrap">
    <!-- High-level editorial header -->
    <div class="gs-header">
      <h2 class="gs-h2">
        Three patterns. <span class="gs-accent">One generative UI spectrum.</span>
      </h2>
      <p class="gs-sub">
        Slide from fixed host templates to open-ended sandboxes to see how the same user request
        moves from agent to screen.
      </p>
    </div>

    <!-- Single unified interactive spectrum instrument -->
    <div
      class="gs-instrument"
      id="gs-instrument"
      data-active="a2ui"
      role="region"
      aria-label="Interactive generative UI spectrum explorer"
    >
      <!-- =================================================================
           TOP: CONTINUUM SCRUBBER RAIL + 3 SPECTRUM STATIONS
           ================================================================= -->
      <div class="gs-continuum">
        <div class="gs-poles" aria-hidden="true">
          <span class="gs-pole gs-pole--left">
            <i class="gs-pole__dot gs-pole__dot--cyan"></i>
            Strict host control
          </span>
          <span class="gs-pole gs-pole--center">Catalog-governed composition</span>
          <span class="gs-pole gs-pole--right">
            Open-ended UI freedom
            <i class="gs-pole__dot gs-pole__dot--amber"></i>
          </span>
        </div>

        <!-- Interactive continuum track (click or drag across the spectrum) -->
        <div class="gs-rail-wrap" id="gs-rail" aria-hidden="true">
          <div class="gs-rail">
            <div class="gs-rail__gradient"></div>
            <span class="gs-rail__tick" style="left: 16.6667%"></span>
            <span class="gs-rail__tick gs-rail__tick--mid" style="left: 50%"></span>
            <span class="gs-rail__tick" style="left: 83.3333%"></span>
            <div class="gs-rail__puck" id="gs-puck">
              <span class="gs-rail__puck-core"></span>
            </div>
          </div>
        </div>

        <!-- 3 stations along the spectrum -->
        <div class="gs-stops" role="tablist" aria-label="Generative UI patterns along the spectrum">
          <button
            type="button"
            class="gs-stop"
            role="tab"
            id="gs-tab-static"
            aria-selected="false"
            aria-controls="gs-stage-panel"
            tabindex="-1"
            data-stop="static"
          >
            <span class="gs-stop__top">
              <span class="gs-stop__idx">01 · STATIC</span>
              <span class="gs-stop__glyph" aria-hidden="true">
                <svg viewBox="0 0 20 14" width="20" height="14" fill="none">
                  <rect x="1" y="1" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.3" />
                  <rect x="4" y="4" width="12" height="6" rx="1" fill="currentColor" opacity="0.35" />
                </svg>
              </span>
            </span>
            <strong class="gs-stop__title">Pre-built widgets</strong>
            <span class="gs-stop__hint">Props into a fixed slot</span>
          </button>

          <button
            type="button"
            class="gs-stop is-active"
            role="tab"
            id="gs-tab-a2ui"
            aria-selected="true"
            aria-controls="gs-stage-panel"
            tabindex="0"
            data-stop="a2ui"
          >
            <span class="gs-stop__top">
              <span class="gs-stop__idx">02 · DECLARATIVE</span>
              <span class="gs-stop__pill">A2UI</span>
            </span>
            <strong class="gs-stop__title">Catalog composition</strong>
            <span class="gs-stop__hint">Novel layouts, native widgets</span>
          </button>

          <button
            type="button"
            class="gs-stop"
            role="tab"
            id="gs-tab-sandbox"
            aria-selected="false"
            aria-controls="gs-stage-panel"
            tabindex="-1"
            data-stop="sandbox"
          >
            <span class="gs-stop__top">
              <span class="gs-stop__idx">03 · OPEN-ENDED</span>
              <span class="gs-stop__glyph" aria-hidden="true">
                <svg viewBox="0 0 20 14" width="20" height="14" fill="none">
                  <rect
                    x="1"
                    y="1"
                    width="18"
                    height="12"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-dasharray="2.5 2"
                  />
                  <path
                    d="M7.2 4.8L4.8 7l2.4 2.2M12.8 4.8L15.2 7l-2.4 2.2"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </span>
            <strong class="gs-stop__title">Sandboxed code</strong>
            <span class="gs-stop__hint">HTML &amp; JS in an iframe</span>
          </button>
        </div>
      </div>

      <!-- =================================================================
           MAIN UNIFIED STAGE: LIVE VISUAL PIPELINE + SPECTRUM METERS
           ================================================================= -->
      <div class="gs-body" id="gs-stage-panel" role="tabpanel" aria-labelledby="gs-tab-a2ui">
        <!-- LEFT: VISUAL PIPELINE (Same intent -> Agent -> Boundary -> App Screen) -->
        <div class="gs-canvas">
          <div class="gs-intent-bar">
            <span class="gs-intent-bar__tag">SAME PROMPT</span>
            <span class="gs-intent-bar__text">
              "Flight delayed. Rebook me on the next nonstop with an aisle seat."
            </span>
          </div>

          <div class="gs-scenes">
            <!-- ===========================================================
                 SCENE 01 · STATIC WIDGETS
                 =========================================================== -->
            <div class="gs-scene" data-scene="static" aria-hidden="true">
              <div class="gs-pipeline">
                <!-- Col 1: Agent -->
                <div class="gs-node gs-node--agent">
                  <div class="gs-node__hdr">
                    <span class="gs-node__role">AGENT</span>
                    <span class="gs-node__kind">Tool call</span>
                  </div>
                  <div class="gs-code">
                    <div class="gs-code__ln"><span class="k">flight_card</span>(&#123;</div>
                    <div class="gs-code__ln">&nbsp;&nbsp;flight: <span class="s">"UA 418"</span>,</div>
                    <div class="gs-code__ln">&nbsp;&nbsp;dep: <span class="s">"6:45 PM"</span>,</div>
                    <div class="gs-code__ln">&nbsp;&nbsp;gate: <span class="s">"B12"</span></div>
                    <div class="gs-code__ln">&#125;)</div>
                  </div>
                  <span class="gs-node__foot">Sends flat arguments only</span>
                </div>

                <!-- Col 2: Boundary -->
                <div class="gs-bridge-col" aria-hidden="true">
                  <div class="gs-wire gs-wire--cyan">
                    <i class="gs-pkt"></i>
                  </div>
                  <div class="gs-gate-badge gs-gate-badge--cyan">
                    <strong>FIXED SLOT</strong>
                    <span>1 tool = 1 view</span>
                  </div>
                </div>

                <!-- Col 3: Host App Surface -->
                <div class="gs-app">
                  <div class="gs-app__chrome">
                    <span class="gs-app__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="gs-app__name">SkyLine App · Native</span>
                  </div>
                  <div class="gs-app__body">
                    <div class="gs-card-flight">
                      <div class="gs-card-flight__row">
                        <span class="gs-chip gs-chip--cyan">NONSTOP</span>
                        <span class="gs-card-flight__meta">Gate B12</span>
                      </div>
                      <strong class="gs-card-flight__route">UA 418 · SFO → JFK</strong>
                      <span class="gs-card-flight__sub">Departs 6:45 PM · On time</span>
                    </div>

                    <button type="button" class="gs-locked-slot" id="gs-static-locked">
                      <span class="gs-locked-slot__hdr">
                        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                          <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                        <span>Aisle seat picker unavailable</span>
                      </span>
                      <span class="gs-locked-slot__sub" id="gs-static-locked-msg">
                        Not in this template · needs an app update
                      </span>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- ===========================================================
                 SCENE 02 · DECLARATIVE CATALOG (A2UI)
                 =========================================================== -->
            <div class="gs-scene is-active" data-scene="a2ui" aria-hidden="false">
              <div class="gs-pipeline">
                <!-- Col 1: Agent -->
                <div class="gs-node gs-node--agent gs-node--a2ui">
                  <div class="gs-node__hdr">
                    <span class="gs-node__role gs-node__role--blue">
                      <i class="gs-live-dot" aria-hidden="true"></i>AGENT + SDK
                    </span>
                    <span class="gs-node__kind">JSONL stream</span>
                  </div>
                  <div class="gs-code">
                    <div class="gs-code__ln"><span class="k">Surface</span> <span class="s">"rebook"</span></div>
                    <div class="gs-code__ln">├─ <span class="k">FlightCard</span> <span class="s">"UA 418"</span></div>
                    <div class="gs-code__ln">├─ <span class="k">ChoiceChips</span> <span class="m">[/seat]</span></div>
                    <div class="gs-code__ln is-bound" id="gs-a2ui-binding">
                      │&nbsp;&nbsp;seat: <span class="s" id="gs-a2ui-seat-val">"14C"</span>
                    </div>
                    <div class="gs-code__ln">└─ <span class="k">Button</span> <span class="s">"Confirm"</span></div>
                  </div>
                  <span class="gs-node__foot">Composes tree + 2-way bindings</span>
                </div>

                <!-- Col 2: Catalog Boundary -->
                <div class="gs-bridge-col" aria-hidden="true">
                  <div class="gs-wire gs-wire--blue">
                    <i class="gs-pkt"></i>
                  </div>
                  <div class="gs-gate-badge gs-gate-badge--blue">
                    <strong>CATALOG GATE</strong>
                    <span>Allowlisted · No JS</span>
                  </div>
                </div>

                <!-- Col 3: Composed Native App Surface -->
                <div class="gs-app gs-app--a2ui">
                  <div class="gs-app__chrome">
                    <span class="gs-app__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="gs-app__name">SkyLine App · Native Catalog</span>
                  </div>
                  <div class="gs-app__body">
                    <div class="gs-card-flight gs-card-flight--a2ui">
                      <div class="gs-card-flight__row">
                        <span class="gs-chip gs-chip--blue">COMPOSED LIVE</span>
                        <span class="gs-card-flight__meta">6:45 PM</span>
                      </div>
                      <strong class="gs-card-flight__route">UA 418 · SFO → JFK</strong>
                    </div>

                    <div class="gs-seat-group" role="group" aria-label="Pick an aisle seat">
                      <button type="button" class="gs-seat is-on" data-seat="14C">
                        <strong>14C</strong>
                        <span>Main aisle</span>
                      </button>
                      <button type="button" class="gs-seat" data-seat="9F">
                        <strong>9F</strong>
                        <span>Exit aisle</span>
                      </button>
                    </div>

                    <button type="button" class="gs-confirm-btn" id="gs-a2ui-cta">
                      <span id="gs-a2ui-cta-lbl">Confirm seat 14C</span>
                      <span aria-hidden="true">→</span>
                    </button>

                    <div class="gs-platforms" aria-hidden="true">
                      <span>1 stream →</span>
                      <b>Web</b>
                      <b>Flutter</b>
                      <b>iOS</b>
                      <b>Android</b>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- ===========================================================
                 SCENE 03 · SANDBOXED CODE
                 =========================================================== -->
            <div class="gs-scene" data-scene="sandbox" aria-hidden="true">
              <div class="gs-pipeline">
                <!-- Col 1: Agent / Server -->
                <div class="gs-node gs-node--agent gs-node--amber">
                  <div class="gs-node__hdr">
                    <span class="gs-node__role gs-node__role--amber">AGENT / TOOL</span>
                    <span class="gs-node__kind">HTML bundle</span>
                  </div>
                  <div class="gs-code">
                    <div class="gs-code__ln"><span class="m">&lt;!doctype html&gt;</span></div>
                    <div class="gs-code__ln"><span class="a">&lt;style&gt;</span>.cabin&#123;…&#125;<span class="a">&lt;/style&gt;</span></div>
                    <div class="gs-code__ln"><span class="a">&lt;canvas</span> id=<span class="s">"deck"</span><span class="a">&gt;</span></div>
                    <div class="gs-code__ln"><span class="a">&lt;script</span> src=<span class="s">"map.js"</span><span class="a">&gt;</span></div>
                    <div class="gs-code__ln"><span class="m">// 48 KB mini-app</span></div>
                  </div>
                  <span class="gs-node__foot">Ships self-contained code</span>
                </div>

                <!-- Col 2: Sandbox Boundary -->
                <div class="gs-bridge-col" aria-hidden="true">
                  <div class="gs-wire gs-wire--amber">
                    <i class="gs-pkt"></i>
                  </div>
                  <div class="gs-gate-badge gs-gate-badge--amber">
                    <strong>IFRAME SANDBOX</strong>
                    <span>Isolated origin</span>
                  </div>
                </div>

                <!-- Col 3: Host App + Embedded Iframe -->
                <div class="gs-app">
                  <div class="gs-app__chrome">
                    <span class="gs-app__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="gs-app__name">SkyLine App · Host Shell</span>
                  </div>
                  <div class="gs-app__body">
                    <div class="gs-iframe-box">
                      <div class="gs-iframe-box__bar">
                        <span>&lt;iframe sandbox&gt;</span>
                        <span id="gs-sandbox-seat-readout">Deck 14C</span>
                      </div>
                      <svg class="gs-cabin-svg" viewBox="0 0 240 84" aria-label="Interactive custom aircraft cabin canvas">
                        <!-- Fuselage rails -->
                        <path
                          d="M8 14 Q120 4 232 14 M8 70 Q120 80 232 70"
                          fill="none"
                          stroke="currentColor"
                          stroke-opacity="0.24"
                          stroke-width="1.2"
                        />
                        <!-- Wing sweep hint -->
                        <path
                          d="M96 10 L118 2 L148 2 L134 10 M96 74 L118 82 L148 82 L134 74"
                          fill="currentColor"
                          fill-opacity="0.1"
                        />
                        <!-- Aisle center dashed guide -->
                        <line
                          x1="18"
                          y1="42"
                          x2="222"
                          y2="42"
                          stroke="currentColor"
                          stroke-opacity="0.2"
                          stroke-dasharray="3 3"
                        />
                        <!-- Seat grid rows -->
                        <g class="gs-cabin-seats">
                          <rect x="34" y="21" width="14" height="12" rx="2.5" opacity="0.28" />
                          <rect x="56" y="21" width="14" height="12" rx="2.5" opacity="0.28" />
                          <rect x="78" y="21" width="14" height="12" rx="2.5" opacity="0.28" />
                          <rect
                            class="gs-cabin-pick is-picked"
                            data-deck-seat="Deck 14C"
                            x="104"
                            y="20"
                            width="16"
                            height="14"
                            rx="3"
                          />
                          <rect
                            class="gs-cabin-pick"
                            data-deck-seat="Deck 15C"
                            x="128"
                            y="20"
                            width="16"
                            height="14"
                            rx="3"
                          />
                          <rect x="154" y="21" width="14" height="12" rx="2.5" opacity="0.28" />
                          <rect x="176" y="21" width="14" height="12" rx="2.5" opacity="0.28" />

                          <rect x="34" y="51" width="14" height="12" rx="2.5" opacity="0.28" />
                          <rect x="56" y="51" width="14" height="12" rx="2.5" opacity="0.28" />
                          <rect
                            class="gs-cabin-pick"
                            data-deck-seat="Deck 12D"
                            x="78"
                            y="50"
                            width="16"
                            height="14"
                            rx="3"
                          />
                          <rect x="104" y="51" width="14" height="12" rx="2.5" opacity="0.28" />
                          <rect x="128" y="51" width="14" height="12" rx="2.5" opacity="0.28" />
                          <rect
                            class="gs-cabin-pick"
                            data-deck-seat="Deck 16D"
                            x="154"
                            y="50"
                            width="16"
                            height="14"
                            rx="3"
                          />
                          <rect x="176" y="51" width="14" height="12" rx="2.5" opacity="0.28" />
                        </g>
                      </svg>
                      <div class="gs-iframe-box__foot">
                        Custom 2D/3D canvas · Separate CSS · Mobile WebView
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: LIVE VISUAL SPECTRUM PROFILE (Replaces static prose & bottom table) -->
        <aside class="gs-profile" aria-label="Pattern trade-off profile">
          <div class="gs-profile__summaries">
            <div class="gs-summary" data-summary="static">
              <span class="gs-summary__tag gs-summary__tag--cyan">01 · FIXED TEMPLATE</span>
              <p class="gs-summary__headline">
                Safe and native, but locked to the exact screens you hardcoded ahead of time.
              </p>
            </div>

            <div class="gs-summary is-active" data-summary="a2ui">
              <span class="gs-summary__tag gs-summary__tag--blue">02 · A2UI SWEET SPOT</span>
              <p class="gs-summary__headline">
                Agents compose tailored layouts at runtime using only native widgets from your catalog.
              </p>
            </div>

            <div class="gs-summary" data-summary="sandbox">
              <span class="gs-summary__tag gs-summary__tag--amber">03 · ISOLATED BUNDLE</span>
              <p class="gs-summary__headline">
                Unrestricted custom canvases inside an isolated frame with its own styling and bundle.
              </p>
            </div>
          </div>

          <!-- 5 animated visual signal bars -->
          <div class="gs-meters">
            <div class="gs-meter" data-meter="layout">
              <div class="gs-meter__row">
                <span class="gs-meter__lbl">Layout freedom</span>
                <span class="gs-meter__val" data-meter-val>Composed per intent</span>
              </div>
              <div class="gs-meter__track">
                <div class="gs-meter__fill" data-meter-fill style="width: 88%"></div>
              </div>
            </div>

            <div class="gs-meter" data-meter="brand">
              <div class="gs-meter__row">
                <span class="gs-meter__lbl">Host brand &amp; a11y</span>
                <span class="gs-meter__val" data-meter-val>100% native catalog</span>
              </div>
              <div class="gs-meter__track">
                <div class="gs-meter__fill" data-meter-fill style="width: 100%"></div>
              </div>
            </div>

            <div class="gs-meter" data-meter="security">
              <div class="gs-meter__row">
                <span class="gs-meter__lbl">Security boundary</span>
                <span class="gs-meter__val" data-meter-val>Data only · zero JS</span>
              </div>
              <div class="gs-meter__track">
                <div class="gs-meter__fill" data-meter-fill style="width: 96%"></div>
              </div>
            </div>

            <div class="gs-meter" data-meter="reach">
              <div class="gs-meter__row">
                <span class="gs-meter__lbl">Cross-platform native</span>
                <span class="gs-meter__val" data-meter-val>Web, mobile &amp; desktop</span>
              </div>
              <div class="gs-meter__track">
                <div class="gs-meter__fill" data-meter-fill style="width: 100%"></div>
              </div>
            </div>

            <div class="gs-meter" data-meter="speed">
              <div class="gs-meter__row">
                <span class="gs-meter__lbl">Streaming speed</span>
                <span class="gs-meter__val" data-meter-val>Progressive JSONL</span>
              </div>
              <div class="gs-meter__track">
                <div class="gs-meter__fill" data-meter-fill style="width: 96%"></div>
              </div>
            </div>
          </div>

          <!-- Best-fit workloads -->
          <div class="gs-fits">
            <span class="gs-fits__lbl">BEST FIT</span>
            <div class="gs-fits__stack">
              <div class="gs-fit-tags" data-fit="static">
                <span>Weather &amp; stock cards</span>
                <span>Single confirmations</span>
                <span>Status widgets</span>
              </div>
              <div class="gs-fit-tags is-active" data-fit="a2ui">
                <span>Multi-step workflows</span>
                <span>Adaptive forms</span>
                <span>Native mobile &amp; web</span>
              </div>
              <div class="gs-fit-tags" data-fit="sandbox">
                <span>Interactive maps</span>
                <span>2D/3D canvases</span>
                <span>Third-party mini-apps</span>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.getElementById('gs-instrument');
    if (!root) return;

    const stops = Array.from(root.querySelectorAll('[data-stop]'));
    const scenes = Array.from(root.querySelectorAll('[data-scene]'));
    const summaries = Array.from(root.querySelectorAll('[data-summary]'));
    const fits = Array.from(root.querySelectorAll('[data-fit]'));
    const panel = document.getElementById('gs-stage-panel');
    const rail = document.getElementById('gs-rail');
    const puck = document.getElementById('gs-puck');

    const ORDER = ['static', 'a2ui', 'sandbox'];
    const POS = { static: 16.6667, a2ui: 50, sandbox: 83.3333 };

    const PROFILES = {
      static: {
        layout: [20, 'Fixed per tool'],
        brand: [100, '100% host widgets'],
        security: [100, 'Typed props only'],
        reach: [38, 'Built per platform'],
        speed: [68, 'After tool resolves'],
      },
      a2ui: {
        layout: [88, 'Composed per intent'],
        brand: [100, '100% native catalog'],
        security: [96, 'Data only · zero JS'],
        reach: [100, 'Web, mobile & desktop'],
        speed: [96, 'Progressive JSONL'],
      },
      sandbox: {
        layout: [100, 'Any DOM or WebGL'],
        brand: [28, 'Re-styled per iframe'],
        security: [52, 'Sandboxed JS exec'],
        reach: [40, 'Web or WebView'],
        speed: [34, 'After bundle loads'],
      },
    };

    const setMode = (mode, focusTab = false) => {
      if (!PROFILES[mode]) return;
      root.setAttribute('data-active', mode);
      if (puck) {
        puck.style.left = `${POS[mode]}%`;
      }

      stops.forEach((btn) => {
        const active = btn.getAttribute('data-stop') === mode;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
        btn.setAttribute('tabindex', active ? '0' : '-1');
        if (active) {
          if (panel) panel.setAttribute('aria-labelledby', btn.id);
          if (focusTab) btn.focus();
        }
      });

      scenes.forEach((el) => {
        const active = el.getAttribute('data-scene') === mode;
        el.classList.toggle('is-active', active);
        el.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      summaries.forEach((el) => {
        el.classList.toggle('is-active', el.getAttribute('data-summary') === mode);
      });

      fits.forEach((el) => {
        el.classList.toggle('is-active', el.getAttribute('data-fit') === mode);
      });

      const data = PROFILES[mode];
      Object.keys(data).forEach((key) => {
        const row = root.querySelector(`[data-meter="${key}"]`);
        if (!row) return;
        const fill = row.querySelector('[data-meter-fill]');
        const val = row.querySelector('[data-meter-val]');
        if (fill) fill.style.width = `${data[key][0]}%`;
        if (val) val.textContent = data[key][1];
      });
    };

    stops.forEach((btn) => {
      btn.addEventListener('click', () => {
        setMode(btn.getAttribute('data-stop') || 'a2ui');
      });

      btn.addEventListener('keydown', (e) => {
        const idx = ORDER.indexOf(btn.getAttribute('data-stop') || 'a2ui');
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          setMode(ORDER[(idx + 1) % ORDER.length], true);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          setMode(ORDER[(idx - 1 + ORDER.length) % ORDER.length], true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          setMode(ORDER[0], true);
        } else if (e.key === 'End') {
          e.preventDefault();
          setMode(ORDER[ORDER.length - 1], true);
        }
      });
    });

    /* Pointer drag / click scrubbing along the continuum rail */
    if (rail && puck) {
      let dragging = false;

      const updateFromPointer = (clientX, snap) => {
        const rect = rail.getBoundingClientRect();
        if (!rect.width) return;
        const pct = Math.max(8, Math.min(92, ((clientX - rect.left) / rect.width) * 100));
        const mode = pct < 33.34 ? 'static' : pct > 66.66 ? 'sandbox' : 'a2ui';
        if (snap) {
          root.classList.remove('is-scrubbing');
          setMode(mode);
        } else {
          root.classList.add('is-scrubbing');
          setMode(mode);
          puck.style.left = `${pct}%`;
        }
      };

      rail.addEventListener('pointerdown', (e) => {
        dragging = true;
        rail.setPointerCapture(e.pointerId);
        updateFromPointer(e.clientX, false);
      });

      rail.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        updateFromPointer(e.clientX, false);
      });

      const endDrag = (e) => {
        if (!dragging) return;
        dragging = false;
        updateFromPointer(e.clientX, true);
      };

      rail.addEventListener('pointerup', endDrag);
      rail.addEventListener('pointercancel', () => {
        dragging = false;
        root.classList.remove('is-scrubbing');
        setMode(root.getAttribute('data-active') || 'a2ui');
      });
    }

    /* Scene 01 micro-interaction: clicking locked slot highlights template rigidity */
    const lockedBtn = document.getElementById('gs-static-locked');
    const lockedMsg = document.getElementById('gs-static-locked-msg');
    if (lockedBtn && lockedMsg) {
      lockedBtn.addEventListener('click', () => {
        lockedBtn.classList.remove('is-shake');
        void lockedBtn.offsetWidth;
        lockedBtn.classList.add('is-shake');
        lockedMsg.textContent = 'Blocked · ship new app code to add this control';
      });
    }

    /* Scene 02 micro-interaction: live 2-way seat binding + confirm CTA */
    const seatBtns = Array.from(root.querySelectorAll('[data-seat]'));
    const seatVal = document.getElementById('gs-a2ui-seat-val');
    const bindingLine = document.getElementById('gs-a2ui-binding');
    const a2uiCta = document.getElementById('gs-a2ui-cta');
    const a2uiCtaLbl = document.getElementById('gs-a2ui-cta-lbl');
    let currentSeat = '14C';

    seatBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentSeat = btn.getAttribute('data-seat') || '14C';
        seatBtns.forEach((b) => b.classList.toggle('is-on', b === btn));
        if (seatVal) seatVal.textContent = `"${currentSeat}"`;
        if (bindingLine) {
          bindingLine.classList.remove('is-flash');
          void bindingLine.offsetWidth;
          bindingLine.classList.add('is-flash');
        }
        if (a2uiCta && a2uiCtaLbl) {
          a2uiCta.classList.remove('is-done');
          a2uiCtaLbl.textContent = `Confirm seat ${currentSeat}`;
        }
      });
    });

    if (a2uiCta && a2uiCtaLbl) {
      a2uiCta.addEventListener('click', () => {
        const done = a2uiCta.classList.toggle('is-done');
        a2uiCtaLbl.textContent = done
          ? `✓ Rebooked · Seat ${currentSeat} saved`
          : `Confirm seat ${currentSeat}`;
      });
    }

    /* Scene 03 micro-interaction: custom SVG cabin canvas seat click */
    const cabinPicks = Array.from(root.querySelectorAll('.gs-cabin-pick'));
    const cabinReadout = document.getElementById('gs-sandbox-seat-readout');
    cabinPicks.forEach((rect) => {
      rect.addEventListener('click', () => {
        cabinPicks.forEach((r) => r.classList.toggle('is-picked', r === rect));
        if (cabinReadout) {
          cabinReadout.textContent = rect.getAttribute('data-deck-seat') || 'Deck 14C';
        }
      });
    });
  })();
</script>

