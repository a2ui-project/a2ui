const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="a2-section gs-section" id="spectrum">
  <div class="gs-wrap">
    <div class="gs-header">
      <h2 class="gs-h2">
        Generative UI spectrum <span class="gs-accent">with A2UI</span>
      </h2>
      <p class="gs-sub">
        The same request can come back as a pre-built widget, a composed screen, or generated code.
        Move the slider to see each one and how A2UI handles it.
      </p>
    </div>

    <div
      class="gs-flow"
      id="gs-instrument"
      data-active="a2ui"
      role="region"
      aria-label="Interactive generative UI spectrum"
    >
      <!-- =================================================================
           SHARED USER PROMPT (Constant input above the spectrum)
           ================================================================= -->
      <div class="gs-prompt-stage">
        <div class="gs-prompt-card">
          <span class="gs-prompt-card__avatar" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
              <path
                d="M2.5 3.5A1.5 1.5 0 0 1 4 2h8a1.5 1.5 0 0 1 1.5 1.5v6A1.5 1.5 0 0 1 12 11H6.2L3.3 13.4a.5.5 0 0 1-.8-.4V3.5Z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <p class="gs-prompt-card__quote">
            “Flight delayed — rebook me on the next nonstop with an aisle seat.”
          </p>
        </div>

        <div class="gs-prompt-stem" aria-hidden="true">
          <span class="gs-prompt-stem__line gs-prompt-stem__line--arrow"></span>
        </div>
      </div>

      <!-- =================================================================
           UNIFIED SPECTRUM SLIDER + OUTCOME STAGE
           ================================================================= -->
      <div class="gs-card">
        <!-- Spectrum Slider Header (Zero eyebrows) -->
        <div class="gs-slider-band">
          <div class="gs-stops" role="tablist" aria-label="Generative UI spectrum">
            <button
              type="button"
              class="gs-stop"
              role="tab"
              id="gs-tab-static"
              aria-selected="false"
              aria-controls="gs-stage-panel"
              tabindex="-1"
              data-stop="static"
            >
              <span class="gs-stop__title">Controlled</span>
              <span class="gs-stop__sub">Pre-built widgets</span>
            </button>

            <button
              type="button"
              class="gs-stop is-active"
              role="tab"
              id="gs-tab-a2ui"
              aria-selected="true"
              aria-controls="gs-stage-panel"
              tabindex="0"
              data-stop="a2ui"
            >
              <span class="gs-stop__title">Composition</span>
              <span class="gs-stop__sub">Native component catalog</span>
            </button>

            <button
              type="button"
              class="gs-stop"
              role="tab"
              id="gs-tab-sandbox"
              aria-selected="false"
              aria-controls="gs-stage-panel"
              tabindex="-1"
              data-stop="sandbox"
            >
              <span class="gs-stop__title">Code generation</span>
              <span class="gs-stop__sub">Generated HTML &amp; JS</span>
            </button>
          </div>

          <!-- Draggable / clickable continuum rail -->
          <div class="gs-rail-wrap" id="gs-rail" aria-hidden="true">
            <div class="gs-rail">
              <div class="gs-rail__gradient"></div>
              <span class="gs-rail__tick" style="left: 16.6667%"></span>
              <span class="gs-rail__tick gs-rail__tick--mid" style="left: 50%"></span>
              <span class="gs-rail__tick" style="left: 83.3333%"></span>
              <div class="gs-rail__puck" id="gs-puck">
                <span class="gs-rail__puck-core"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Outcome Stage: Visual Screen Outcome (Left) + 3 Consolidated Points (Right) -->
        <div class="gs-body" id="gs-stage-panel" role="tabpanel" aria-labelledby="gs-tab-a2ui">
          <!-- LEFT: VISUAL OUTCOME FOR THE SHARED PROMPT -->
          <div class="gs-canvas">
            <div class="gs-scenes">
              <!-- =========================================================
                   OUTCOME 1 · STRICT CONTROL
                   ========================================================= -->
              <div class="gs-scene" data-scene="static" aria-hidden="true">
                <div class="gs-wire-pill gs-wire-pill--cyan">
                  <span class="gs-wire-pill__verb">Agent calls</span>
                  <code>flight_card(&#123; flight: "UA 418", gate: "B12" &#125;)</code>
                </div>

                <div class="gs-wire-drop gs-wire-drop--cyan" aria-hidden="true"></div>

                <div class="gs-app">
                  <div class="gs-app__chrome">
                    <span class="gs-app__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="gs-app__name">Host App · Hardcoded Template</span>
                  </div>
                  <div class="gs-app__body">
                    <div class="gs-flight">
                      <div class="gs-flight__top">
                        <span class="gs-badge gs-badge--cyan">NONSTOP</span>
                        <span class="gs-flight__meta">Departs 6:45 PM · Gate B12</span>
                      </div>
                      <strong class="gs-flight__route">UA 418 · SFO → JFK</strong>
                    </div>

                    <button type="button" class="gs-missing" id="gs-static-locked">
                      <span class="gs-missing__hdr">
                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                          <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                        <span>Aisle seat picker unavailable</span>
                      </span>
                      <span class="gs-missing__sub" id="gs-static-locked-msg">
                        This template only renders flight details — seat selection wasn't hardcoded.
                      </span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- =========================================================
                   OUTCOME 2 · FLEXIBLE COMPOSITION (A2UI)
                   ========================================================= -->
              <div class="gs-scene is-active" data-scene="a2ui" aria-hidden="false">
                <div class="gs-wire-pill gs-wire-pill--blue">
                  <span class="gs-wire-pill__verb">Agent composes</span>
                  <code>FlightCard + ChoiceChips + Button</code>
                </div>

                <div class="gs-wire-drop gs-wire-drop--blue" aria-hidden="true"></div>

                <div class="gs-app gs-app--a2ui">
                  <div class="gs-app__chrome">
                    <span class="gs-app__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="gs-app__name">Host App · Native Catalog</span>
                  </div>
                  <div class="gs-app__body">
                    <div class="gs-flight gs-flight--a2ui">
                      <div class="gs-flight__top">
                        <span class="gs-badge gs-badge--blue">NONSTOP</span>
                        <span class="gs-flight__meta">Departs 6:45 PM · Gate B12</span>
                      </div>
                      <strong class="gs-flight__route">UA 418 · SFO → JFK</strong>
                    </div>

                    <div class="gs-seats" role="group" aria-label="Choose an aisle seat">
                      <button type="button" class="gs-seat is-on" data-seat="14C">
                        <strong>14C</strong>
                        <span>Main aisle</span>
                      </button>
                      <button type="button" class="gs-seat" data-seat="9F">
                        <strong>9F</strong>
                        <span>Exit aisle</span>
                      </button>
                    </div>

                    <button type="button" class="gs-cta" id="gs-a2ui-cta">
                      <span id="gs-a2ui-cta-lbl">Confirm rebooking · Seat 14C</span>
                      <span aria-hidden="true">→</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- =========================================================
                   OUTCOME 3 · RENDER ANYTHING
                   ========================================================= -->
              <div class="gs-scene" data-scene="sandbox" aria-hidden="true">
                <div class="gs-wire-pill gs-wire-pill--amber">
                  <span class="gs-wire-pill__verb">Agent writes</span>
                  <code>&lt;iframe sandbox&gt; HTML, CSS &amp; JS bundle</code>
                </div>

                <div class="gs-wire-drop gs-wire-drop--amber" aria-hidden="true"></div>

                <div class="gs-app">
                  <div class="gs-app__chrome">
                    <span class="gs-app__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="gs-app__name">Host App · Embedded Sandbox</span>
                  </div>
                  <div class="gs-app__body">
                    <div class="gs-sandbox-frame">
                      <div class="gs-sandbox-frame__bar">
                        <span>&lt;iframe sandbox&gt; · Custom cabin map</span>
                        <span id="gs-sandbox-seat-readout">Seat 14C</span>
                      </div>
                      <svg
                        class="gs-cabin-svg"
                        viewBox="0 0 260 92"
                        aria-label="Interactive custom aircraft cabin map"
                      >
                        <path
                          d="M10 15 Q130 5 250 15 M10 77 Q130 87 250 77"
                          fill="none"
                          stroke="currentColor"
                          stroke-opacity="0.24"
                          stroke-width="1.3"
                        />
                        <path
                          d="M104 11 L128 2 L160 2 L144 11 M104 81 L128 90 L160 90 L144 81"
                          fill="currentColor"
                          fill-opacity="0.1"
                        />
                        <line
                          x1="20"
                          y1="46"
                          x2="240"
                          y2="46"
                          stroke="currentColor"
                          stroke-opacity="0.2"
                          stroke-dasharray="3 3"
                        />
                        <g class="gs-cabin-seats">
                          <rect x="36" y="22" width="15" height="13" rx="2.5" opacity="0.25" />
                          <rect x="60" y="22" width="15" height="13" rx="2.5" opacity="0.25" />
                          <rect x="84" y="22" width="15" height="13" rx="2.5" opacity="0.25" />
                          <rect
                            class="gs-cabin-pick is-picked"
                            data-deck-seat="Seat 14C"
                            x="112"
                            y="21"
                            width="17"
                            height="15"
                            rx="3"
                          />
                          <rect
                            class="gs-cabin-pick"
                            data-deck-seat="Seat 15C"
                            x="138"
                            y="21"
                            width="17"
                            height="15"
                            rx="3"
                          />
                          <rect x="166" y="22" width="15" height="13" rx="2.5" opacity="0.25" />
                          <rect x="190" y="22" width="15" height="13" rx="2.5" opacity="0.25" />

                          <rect x="36" y="57" width="15" height="13" rx="2.5" opacity="0.25" />
                          <rect x="60" y="57" width="15" height="13" rx="2.5" opacity="0.25" />
                          <rect
                            class="gs-cabin-pick"
                            data-deck-seat="Seat 12D"
                            x="84"
                            y="56"
                            width="17"
                            height="15"
                            rx="3"
                          />
                          <rect x="112" y="57" width="15" height="13" rx="2.5" opacity="0.25" />
                          <rect x="138" y="57" width="15" height="13" rx="2.5" opacity="0.25" />
                          <rect
                            class="gs-cabin-pick"
                            data-deck-seat="Seat 16D"
                            x="166"
                            y="56"
                            width="17"
                            height="15"
                            rx="3"
                          />
                          <rect x="190" y="57" width="15" height="13" rx="2.5" opacity="0.25" />
                        </g>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT: CONSOLIDATED HIGH-LEVEL SUMMARY (1 headline + 3 crisp points, zero eyebrows) -->
          <div class="gs-details">
            <!-- Slide 1: Controlled -->
            <div class="gs-detail" data-detail="static" aria-hidden="true">
              <h3 class="gs-detail__title">The model picks a pre-built widget and fills in its data.</h3>
              <ul class="gs-points">
                <li class="gs-point">
                  <span class="gs-point__icon gs-point__icon--pos" aria-hidden="true">+</span>
                  <div>
                    <strong>100% host-controlled</strong>
                    <span>Inherits your app's exact styling, components, and security model.</span>
                  </div>
                </li>
                <li class="gs-point">
                  <span class="gs-point__icon gs-point__icon--lim" aria-hidden="true">–</span>
                  <div>
                    <strong>Locked to pre-built views</strong>
                    <span>Agents can fill data slots, but cannot combine widgets for new requests.</span>
                  </div>
                </li>
                <li class="gs-point">
                  <span class="gs-point__icon gs-point__icon--lim" aria-hidden="true">–</span>
                  <div>
                    <strong>New flows require app releases</strong>
                    <span>Anything you didn't anticipate upfront falls back to plain chat text.</span>
                  </div>
                </li>
              </ul>
              <p class="gs-with">
                <strong>With A2UI:</strong> You register each pre-built widget as a catalog component or a server-side macro. The model picks one, and the A2UI renderer on the client draws it.
              </p>
              <p class="gs-with__links">
                <a href={`${base}/guides/macros/`}>Macros →</a>
              </p>
            </div>

            <!-- Slide 2: Composition -->
            <div class="gs-detail is-active" data-detail="a2ui" aria-hidden="false">
              <h3 class="gs-detail__title">Tailored layouts assembled from your native catalog.</h3>
              <ul class="gs-points">
                <li class="gs-point">
                  <span class="gs-point__icon gs-point__icon--blue" aria-hidden="true">+</span>
                  <div>
                    <strong>Adapts to every prompt</strong>
                    <span>Agents compose multi-step flows on the fly from widgets you approve.</span>
                  </div>
                </li>
                <li class="gs-point">
                  <span class="gs-point__icon gs-point__icon--blue" aria-hidden="true">+</span>
                  <div>
                    <strong>Native &amp; safe by default</strong>
                    <span>Streams declarative JSON data with two-way bindings — never executable code.</span>
                  </div>
                </li>
                <li class="gs-point">
                  <span class="gs-point__icon gs-point__icon--blue" aria-hidden="true">+</span>
                  <div>
                    <strong>One stream, every screen</strong>
                    <span>Renders natively across React, Lit, Angular, Flutter, SwiftUI, and Compose.</span>
                  </div>
                </li>
              </ul>
              <p class="gs-with">
                <strong>With A2UI:</strong> The model builds the screen from components in your catalog, and the renderer draws it with your own components as it streams in. In hosts that support MCP Apps, the same A2UI surface can run inside an MCP App.
              </p>
              <p class="gs-with__links">
                <a href={`${base}/concepts/overview/`}>How A2UI works →</a>
                <a href={`${base}/guides/a2ui-in-mcp-apps/`}>A2UI in MCP Apps →</a>
              </p>
            </div>

            <!-- Slide 3: Code generation -->
            <div class="gs-detail" data-detail="sandbox" aria-hidden="true">
              <h3 class="gs-detail__title">The model writes HTML and JS that runs in a sandbox.</h3>
              <ul class="gs-points">
                <li class="gs-point">
                  <span class="gs-point__icon gs-point__icon--amber" aria-hidden="true">+</span>
                  <div>
                    <strong>Unrestricted custom visuals</strong>
                    <span>Built for bespoke 2D/3D canvases, interactive maps, and full mini-apps.</span>
                  </div>
                </li>
                <li class="gs-point">
                  <span class="gs-point__icon gs-point__icon--lim" aria-hidden="true">–</span>
                  <div>
                    <strong>Isolated from your design system</strong>
                    <span>Runs inside an iframe boundary with separate styling, state, and a11y.</span>
                  </div>
                </li>
                <li class="gs-point">
                  <span class="gs-point__icon gs-point__icon--lim" aria-hidden="true">–</span>
                  <div>
                    <strong>Tied to web &amp; WebViews</strong>
                    <span>Ships heavier HTML/JS payloads rather than native mobile or desktop widgets.</span>
                  </div>
                </li>
              </ul>
              <p class="gs-with">
                <strong>With A2UI:</strong> Generated HTML and JS can run as an MCP App inside an A2UI surface, next to your native components.
              </p>
              <p class="gs-with__links">
                <a href={`${base}/guides/mcp-apps-in-a2ui/`}>MCP Apps in A2UI →</a>
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.getElementById('gs-instrument');
    if (!root) return;

    const stops = Array.from(root.querySelectorAll('[data-stop]'));
    const scenes = Array.from(root.querySelectorAll('[data-scene]'));
    const details = Array.from(root.querySelectorAll('[data-detail]'));
    const panel = document.getElementById('gs-stage-panel');
    const rail = document.getElementById('gs-rail');
    const puck = document.getElementById('gs-puck');

    const ORDER = ['static', 'a2ui', 'sandbox'];
    const POS = { static: 16.6667, a2ui: 50, sandbox: 83.3333 };

    const setMode = (mode, focusTab = false) => {
      if (!POS[mode]) return;
      root.setAttribute('data-active', mode);
      if (puck) {
        puck.style.left = `${POS[mode]}%`;
      }

      stops.forEach((btn) => {
        const active = btn.getAttribute('data-stop') === mode;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
        btn.setAttribute('tabindex', active ? '0' : '-1');
        if (active) {
          if (panel) panel.setAttribute('aria-labelledby', btn.id);
          if (focusTab) btn.focus();
        }
      });

      scenes.forEach((el) => {
        const active = el.getAttribute('data-scene') === mode;
        el.classList.toggle('is-active', active);
        el.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      details.forEach((el) => {
        const active = el.getAttribute('data-detail') === mode;
        el.classList.toggle('is-active', active);
        el.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
    };

    stops.forEach((btn) => {
      btn.addEventListener('click', () => {
        setMode(btn.getAttribute('data-stop') || 'a2ui');
      });

      btn.addEventListener('keydown', (e) => {
        const idx = ORDER.indexOf(btn.getAttribute('data-stop') || 'a2ui');
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          setMode(ORDER[(idx + 1) % ORDER.length], true);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          setMode(ORDER[(idx - 1 + ORDER.length) % ORDER.length], true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          setMode(ORDER[0], true);
        } else if (e.key === 'End') {
          e.preventDefault();
          setMode(ORDER[ORDER.length - 1], true);
        }
      });
    });

    /* Pointer drag / click scrubbing along the continuum rail */
    if (rail && puck) {
      let dragging = false;

      const updateFromPointer = (clientX, snap) => {
        const rect = rail.getBoundingClientRect();
        if (!rect.width) return;
        const pct = Math.max(8, Math.min(92, ((clientX - rect.left) / rect.width) * 100));
        const mode = pct < 33.34 ? 'static' : pct > 66.66 ? 'sandbox' : 'a2ui';
        if (snap) {
          root.classList.remove('is-scrubbing');
          setMode(mode);
        } else {
          root.classList.add('is-scrubbing');
          setMode(mode);
          puck.style.left = `${pct}%`;
        }
      };

      rail.addEventListener('pointerdown', (e) => {
        dragging = true;
        if (e.isTrusted) {
          rail.setPointerCapture(e.pointerId);
        }
        updateFromPointer(e.clientX, false);
      });

      rail.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        updateFromPointer(e.clientX, false);
      });

      const endDrag = (e) => {
        if (!dragging) return;
        dragging = false;
        updateFromPointer(e.clientX, true);
      };

      rail.addEventListener('pointerup', endDrag);
      rail.addEventListener('pointercancel', () => {
        dragging = false;
        root.classList.remove('is-scrubbing');
        setMode(root.getAttribute('data-active') || 'a2ui');
      });
    }

    /* Slide 1 micro-interaction */
    const lockedBtn = document.getElementById('gs-static-locked');
    const lockedMsg = document.getElementById('gs-static-locked-msg');
    if (lockedBtn && lockedMsg) {
      lockedBtn.addEventListener('click', () => {
        lockedBtn.classList.remove('is-shake');
        void lockedBtn.offsetWidth;
        lockedBtn.classList.add('is-shake');
        lockedMsg.textContent = 'Blocked — shipping a seat picker requires updating host app code.';
      });
    }

    /* Slide 2 micro-interaction */
    const seatBtns = Array.from(root.querySelectorAll('[data-seat]'));
    const a2uiCta = document.getElementById('gs-a2ui-cta');
    const a2uiCtaLbl = document.getElementById('gs-a2ui-cta-lbl');
    let currentSeat = '14C';

    seatBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentSeat = btn.getAttribute('data-seat') || '14C';
        seatBtns.forEach((b) => b.classList.toggle('is-on', b === btn));
        if (a2uiCta && a2uiCtaLbl) {
          a2uiCta.classList.remove('is-done');
          a2uiCtaLbl.textContent = `Confirm rebooking · Seat ${currentSeat}`;
        }
      });
    });

    if (a2uiCta && a2uiCtaLbl) {
      a2uiCta.addEventListener('click', () => {
        const done = a2uiCta.classList.toggle('is-done');
        a2uiCtaLbl.textContent = done
          ? `✓ Rebooked on UA 418 · Seat ${currentSeat}`
          : `Confirm rebooking · Seat ${currentSeat}`;
      });
    }

    /* Slide 3 micro-interaction */
    const cabinPicks = Array.from(root.querySelectorAll('.gs-cabin-pick'));
    const cabinReadout = document.getElementById('gs-sandbox-seat-readout');
    cabinPicks.forEach((rect) => {
      rect.addEventListener('click', () => {
        cabinPicks.forEach((r) => r.classList.toggle('is-picked', r === rect));
        if (cabinReadout) {
          cabinReadout.textContent = rect.getAttribute('data-deck-seat') || 'Seat 14C';
        }
      });
    });
  })();
</script>

<style>
  .gs-section {
    position: relative;
    padding: 112px 0 124px;
    background: var(--a2-bg);
    border-top: 1px solid var(--a2-border-strong);
    scroll-margin-top: 72px;
  }

  @media (max-width: 720px) {
    .gs-section {
      padding: 80px 0 88px;
    }
  }

  .gs-wrap {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 36px;
  }

  @media (max-width: 640px) {
    .gs-wrap {
      padding: 0 20px;
    }
  }

  /* Clean stacked section header (flush optical left alignment, zero eyebrow) */
  .gs-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 40px;
  }

  .gs-h2 {
    margin: 0;
    font-family: var(--a2-font-display);
    font-size: clamp(2rem, 3.5vw, 2.9rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: var(--a2-tracking-h2);
    color: var(--a2-text);
  }

  .gs-accent {
    color: var(--a2-heading-accent);
  }

  .gs-sub {
    margin: 0;
    padding-left: clamp(7px, 0.75vw, 11px);
    max-width: 58ch;
    font-size: 16px;
    line-height: 1.55;
