import '@pagefind/default-ui/css/ui.css';
import project from 'virtual:starlight/project-context';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;
const isOverview = pathname === `${base}/` || pathname === `${base}` || pathname === '/';
const isBuildWith =
  pathname === `${base}/build-with-a2ui` || pathname.startsWith(`${base}/build-with-a2ui/`);
const isGetHelp =
  pathname === `${base}/get-help` || pathname.startsWith(`${base}/get-help/`);
const isDocs = !isOverview && !isBuildWith && !isGetHelp;

const dataAttributes: Record<string, string> = {};
if (project.trailingSlash === 'never') dataAttributes['data-strip-trailing-slash'] = '';
---

