<script is:inline>
  (() => {
    const platformKey = document.querySelector('[data-platform-key]');
    if (platformKey && !/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
      platformKey.textContent = 'Ctrl+';
    }

    const btn = document.getElementById('a2-sl-theme-toggle');
    if (!btn) return;
    const syncLabel = () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const label = current === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
      btn.setAttribute('title', label);
      btn.setAttribute('aria-label', label);
    };
    syncLabel();
    new MutationObserver(syncLabel).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('starlight-theme', next);
        localStorage.setItem('a2ui-theme', next);
      } catch (e) {}
      if (
        typeof StarlightThemeProvider !== 'undefined' &&
        typeof StarlightThemeProvider.updatePickers === 'function'
      ) {
        StarlightThemeProvider.updatePickers(next);
      }
      window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: next } }));
    });
  })();
</script>

<script>
  import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';

  class A2SiteSearch extends HTMLElement {
    private cleanup: (() => void) | null = null;
    private pagefindPromise: Promise<void> | null = null;

    connectedCallback() {
      const openBtn = this.querySelector<HTMLButtonElement>('button[data-open-modal]');
      const closeBtn = this.querySelector<HTMLButtonElement>('button[data-close-modal]');
      const dialog = this.querySelector<HTMLDialogElement>('dialog');
      const dialogFrame = this.querySelector<HTMLElement>('.a2-sl-dialog-frame');
      const searchContainer = this.querySelector<HTMLElement>('#starlight__search');
      if (!openBtn || !closeBtn || !dialog || !dialogFrame || !searchContainer) return;

      const shouldStrip = this.dataset.stripTrailingSlash !== undefined;
      const stripTrailingSlash = (path: string) => path.replace(/(.)\/(#.*)?$/, '$1$2');
      const formatURL = shouldStrip ? stripTrailingSlash : (path: string) => path;

      const ensurePagefind = () => {
        if (this.pagefindPromise) return this.pagefindPromise;
        this.pagefindPromise = (async () => {
          try {
            // @ts-expect-error — Missing types for @pagefind/default-ui package.
            const { PagefindUI } = await import('@pagefind/default-ui');
            new PagefindUI({
              ...pagefindUserConfig,
              element: '#starlight__search',
              baseUrl: import.meta.env.BASE_URL,
              bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
              showImages: false,
              translations: { placeholder: 'Search docs' },
              showSubResults: true,
              processResult: (result: { url: string; sub_results?: Array<{ url: string }> }) => {
                result.url = formatURL(result.url);
                if (result.sub_results) {
                  result.sub_results = result.sub_results.map((sub_result) => {
                    sub_result.url = formatURL(sub_result.url);
                    return sub_result;
                  });
                }
              },
            });
          } catch (err) {
            console.error('Failed to initialize Pagefind UI:', err);
          }
        })();
        return this.pagefindPromise;
      };

      const onClick = (event: MouseEvent) => {
        const isLink = event.target instanceof Element && Boolean(event.target.closest('a[href]'));
        if (
          isLink ||
          (document.body.contains(event.target as Node) && !dialogFrame.contains(event.target as Node))
        ) {
          closeModal();
        }
      };

      const focusSearchInput = () => {
        const input = searchContainer.querySelector<HTMLInputElement>('input');
        if (input) {
          input.focus();
          return true;
        }
        return false;
      };

      const openModal = (event?: Event) => {
        if (!dialog.open) {
          dialog.showModal();
          document.body.toggleAttribute('data-search-modal-open', true);
          window.addEventListener('click', onClick);
        }
        event?.stopPropagation();
        if (!focusSearchInput()) {
          ensurePagefind().then(() => {
            if (dialog.open) {
              requestAnimationFrame(() => focusSearchInput());
            }
          });
        }
      };

      const closeModal = () => {
        if (dialog.open) dialog.close();
      };

      const onDialogClose = () => {
        document.body.toggleAttribute('data-search-modal-open', false);
        window.removeEventListener('click', onClick);
      };

      const onKeyDown = (e: KeyboardEvent) => {
        if ((e.metaKey === true || e.ctrlKey === true) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          dialog.open ? closeModal() : openModal();
        }
      };

      openBtn.addEventListener('click', openModal);
      closeBtn.addEventListener('click', closeModal);
      dialog.addEventListener('close', onDialogClose);
      window.addEventListener('keydown', onKeyDown);

      const onIdle = window.requestIdleCallback || ((cb: () => void) => window.setTimeout(cb, 1));
      let idleId: number | null = null;
      const triggerIdle = () => {
        idleId = onIdle(() => ensurePagefind());
      };

      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', triggerIdle);
      } else {
        triggerIdle();
      }

      this.cleanup = () => {
        openBtn.removeEventListener('click', openModal);
        closeBtn.removeEventListener('click', closeModal);
        dialog.removeEventListener('close', onDialogClose);
        window.removeEventListener('keydown', onKeyDown);
        window.removeEventListener('click', onClick);
        window.removeEventListener('DOMContentLoaded', triggerIdle);
        if (idleId !== null && window.cancelIdleCallback) {
          window.cancelIdleCallback(idleId);
        } else if (idleId !== null) {
          window.clearTimeout(idleId);
        }
      };
    }

    disconnectedCallback() {
      if (this.cleanup) {
        this.cleanup();
        this.cleanup = null;
      }
    }
  }

  if (!customElements.get('a2-site-search')) {
    customElements.define('a2-site-search', A2SiteSearch);
  }
</script>

<script>
  let renderGeneration = 0;

  const renderMermaid = async () => {
    const generation = ++renderGeneration;
    for (const pre of document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]')) {
      const lines = pre.querySelectorAll('.ec-line');
      const code = (
        lines.length
          ? Array.from(lines, l => l.textContent ?? '').join('\n')
          : (pre.querySelector('code')?.textContent || pre.textContent || '')
      ).trim();
      const div = document.createElement('div');
      div.className = 'mermaid-rendered not-content';
      div.dataset.mermaidSource = code;
      const ec = pre.closest('.expressive-code');
      if (ec) {
        for (const el of ec.querySelectorAll('link, script')) {
          document.head.appendChild(el);
        }
        ec.replaceWith(div);
      } else {
        pre.replaceWith(div);
      }
    }

    const blocks = document.querySelectorAll<HTMLElement>(
      '.mermaid-rendered[data-mermaid-source]',
    );
    if (!blocks.length) return;

    const {default: mermaid} = await import('mermaid');
    await document.fonts?.ready;
    if (generation !== renderGeneration) return;

    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: isDark ? 'dark' : 'default',
      fontFamily: 'inherit',
    });

    for (let i = 0; i < blocks.length; i++) {
      if (generation !== renderGeneration) return;
      const div = blocks[i];
      const code = div.dataset.mermaidSource;
      if (!code) continue;
      try {
        const id = `mermaid-svg-${generation}-${i}-${Date.now().toString(36)}`;
        const {svg} = await mermaid.render(id, code);
        if (generation === renderGeneration) {
          div.innerHTML = svg;
        }
      } catch (err) {
        if (!div.innerHTML) {
          const pre = document.createElement('pre');
          pre.textContent = code;
          div.replaceChildren(pre);
        }
        console.error('Mermaid render error:', err);
      }
    }
  };

  let lastTheme = document.documentElement.getAttribute('data-theme');
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      lastTheme = document.documentElement.getAttribute('data-theme');
      void renderMermaid();
    });
  } else {
    void renderMermaid();
  }
  new MutationObserver(() => {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    if (currentTheme !== lastTheme) {
      lastTheme = currentTheme;
      void renderMermaid();
    }
  }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>

<style>
  .a2-sl-header {
    --a2-hdr-text: var(--a2-text, #ffffff);
    --a2-hdr-text-secondary: var(--a2-text-secondary, #9aa0a6);
    --a2-hdr-text-muted: var(--a2-text-muted, #80868b);
    --a2-hdr-surface: var(--a2-surface, #1e1f20);
    --a2-hdr-hover-bg: var(--a2-surface-raised, #282a2c);
    --a2-hdr-border: var(--a2-border, #2a2b2d);
    --a2-hdr-border-strong: var(--a2-border-strong, #303134);
    --a2-hdr-accent: var(--a2-accent, #8ab4f8);
    --a2-hdr-accent-text: var(--a2-accent-strong, #aecbfa);
    --a2-hdr-accent-soft: var(--a2-accent-soft, rgba(138, 180, 248, 0.12));

    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    width: 100%;
    gap: 16px;
  }

  :global(:root[data-theme='light']) .a2-sl-header {
    --a2-hdr-text: #1f1f1f;
    --a2-hdr-text-secondary: #5f6368;
    --a2-hdr-text-muted: #80868b;
    --a2-hdr-surface: #ffffff;
    --a2-hdr-hover-bg: #f1f3f4;
    --a2-hdr-border: #e8eaed;
    --a2-hdr-border-strong: #bdc1c6;
    --a2-hdr-accent: #0b57d0;
    --a2-hdr-accent-text: #0842a0;
    --a2-hdr-accent-soft: rgba(11, 87, 208, 0.09);
  }

  .a2-sl-header__left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .a2-sl-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    font-family: var(--a2-font-display, 'Manrope', sans-serif);
    font-weight: 600;
    font-size: 16.5px;
    line-height: 1;
    letter-spacing: -0.028em;
    color: var(--a2-hdr-text);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .a2-sl-brand__ver {
    font-family: var(--a2-font-mono, monospace);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 2px 5px;
    border-radius: 2px;
    background: var(--a2-hdr-surface);
    border: 1px solid var(--a2-hdr-border);
    color: var(--a2-hdr-text-muted);
  }

  .a2-sl-brand:hover {
    color: var(--a2-hdr-text);
  }

  .a2-sl-logo {
    flex-shrink: 0;
    display: block;
  }

  .a2-sl-header__slash {
    color: var(--a2-hdr-border-strong);
    font-size: 18px;
    font-weight: 300;
    line-height: 1;
    margin: 0 4px;
    user-select: none;
  }

  .a2-sl-header__tabs {
    display: flex;
    align-items: center;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .a2-sl-header__tabs::-webkit-scrollbar {
    display: none;
  }

  .a2-sl-tab {
    font-size: 13.5px;
    font-weight: 500;
    line-height: 20px;
    color: var(--a2-hdr-text-secondary);
    text-decoration: none;
    padding: 5px 11px;
    border-radius: 7px;
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .a2-sl-tab:hover {
    color: var(--a2-hdr-text);
    background: var(--a2-hdr-hover-bg);
  }

  .a2-sl-tab.is-active {
    color: var(--a2-hdr-text);
    background: var(--a2-hdr-hover-bg);
    font-weight: 500;
  }

  @media (max-width: 1020px) {
    .a2-sl-brand__ver {
      display: none;
    }
  }

  .a2-sl-header__right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  a2-site-search {
    display: contents;
  }

  .a2-sl-search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 36px;
    padding: 0 10px 0 12px;
    border-radius: 8px;
    background: var(--a2-hdr-surface);
    border: 1px solid var(--a2-hdr-border-strong);
    color: var(--a2-hdr-text-muted);
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
