import RendererLogo from './RendererLogo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="dsm-root" id="dsm-showcase">
  <div class="dsm-open-split" id="dsm-stage" data-skin="cupertino">
    <!-- Left Column: Vertical Architectural Design System Index (Zero Pills, Zero Outer Card) -->
    <div class="dsm-rail">
      <div class="dsm-index" role="tablist" aria-label="Select host design system">
        <button type="button" role="tab" aria-selected="true" class="dsm-row is-active" data-dsm-skin="cupertino">
          <span class="dsm-row__num">01</span>
          <span class="dsm-row__main">
            <strong>Cupertino Native</strong>
            <span>iOS · SwiftUI renderer</span>
          </span>
          <span class="dsm-row__mark"><RendererLogo name="swiftui" size={18} /></span>
        </button>

        <button type="button" role="tab" aria-selected="false" class="dsm-row" data-dsm-skin="material">
          <span class="dsm-row__num">02</span>
          <span class="dsm-row__main">
            <strong>Material You Tonal</strong>
            <span>Android · Jetpack Compose renderer</span>
          </span>
          <span class="dsm-row__mark"><RendererLogo name="compose" size={18} /></span>
        </button>

        <button type="button" role="tab" aria-selected="false" class="dsm-row" data-dsm-skin="editorial">
          <span class="dsm-row__num">03</span>
          <span class="dsm-row__main">
            <strong>Editorial Luxury</strong>
            <span>Custom brand · Flutter renderer</span>
          </span>
          <span class="dsm-row__mark"><RendererLogo name="flutter" size={18} /></span>
        </button>

        <button type="button" role="tab" aria-selected="false" class="dsm-row" data-dsm-skin="saas">
          <span class="dsm-row__num">04</span>
          <span class="dsm-row__main">
            <strong>Monospace Workspace</strong>
            <span>Web · React, Lit or Angular renderer</span>
          </span>
          <span class="dsm-row__mark"><RendererLogo name="react" size={18} /><RendererLogo name="lit" size={16} /><RendererLogo name="angular" size={18} /></span>
        </button>
      </div>

      <p class="dsm-note" id="dsm-skin-desc">
        The agent emits zero CSS, fonts, or pixel coordinates. Your iOS host maps <code>OrderCard</code> and <code>ChoicePicker</code> directly to native SwiftUI controls.
      </p>

      <dl class="dsm-specs">
        <div>
          <dt>HOST TYPEFACE</dt>
          <dd id="dsm-tok-font">SF Pro Display</dd>
        </div>
        <div>
          <dt>CORNER PROFILE</dt>
          <dd id="dsm-tok-radius">28px Continuous</dd>
        </div>
        <div>
          <dt>LLM STYLING</dt>
          <dd class="dsm-zero">0 bytes</dd>
        </div>
      </dl>
    </div>

    <!-- Right Column: Crop-Marked Open Drafting Plinth -->
    <div class="dsm-plinth">
      <span class="dsm-crop dsm-crop--tl" aria-hidden="true"></span>
      <span class="dsm-crop dsm-crop--tr" aria-hidden="true"></span>
      <span class="dsm-crop dsm-crop--bl" aria-hidden="true"></span>
      <span class="dsm-crop dsm-crop--br" aria-hidden="true"></span>

      <div class="dsm-card">
        <div class="dsm-card__top">
          <div>
            <span class="dsm-card__kicker">REPEAT DISPATCH · ROASTERY</span>
            <h4 class="dsm-card__title">gesha single origin</h4>
          </div>
          <div class="dsm-card__price" id="dsm-total-badge">$48</div>
        </div>

        <p class="dsm-card__sub">Washed · Bergamot, jasmine &amp; white peach · Roasted 18h ago</p>

        <div class="dsm-section">
          <span class="dsm-section__lbl">Grind Preparation</span>
          <div class="dsm-seg" role="radiogroup" aria-label="Grind preparation">
            <button type="button" class="dsm-seg__btn is-active" data-dsm-grind="Whole Bean">Whole Bean</button>
            <button type="button" class="dsm-seg__btn" data-dsm-grind="Espresso">Espresso</button>
            <button type="button" class="dsm-seg__btn" data-dsm-grind="Pour Over">Pour Over</button>
          </div>
        </div>

        <div class="dsm-row-split">
          <div class="dsm-section">
            <span class="dsm-section__lbl">Quantity (250g)</span>
            <div class="dsm-stepper">
              <button type="button" class="dsm-step-btn" id="dsm-qty-dec" aria-label="Fewer bags">−</button>
              <span class="dsm-step-val" id="dsm-qty-val">2 bags</span>
              <button type="button" class="dsm-step-btn" id="dsm-qty-inc" aria-label="More bags">+</button>
            </div>
          </div>

          <div class="dsm-section">
            <span class="dsm-section__lbl">Courier Window</span>
            <div class="dsm-chips">
              <button type="button" class="dsm-chip is-active" data-dsm-slot="Within 45m">45 min</button>
              <button type="button" class="dsm-chip" data-dsm-slot="Tomorrow 8 AM">08:00</button>
            </div>
          </div>
        </div>

        <button type="button" class="dsm-cta" id="dsm-order-btn">
          Dispatch 2 Bags (Whole Bean) · $48
        </button>
      </div>
    </div>
  </div>

  <!-- Official renderer grid: one mark per target, plus the community ecosystem -->
  <div class="dsm-renderers">
    <div class="dsm-renderers__head">
      <span class="dsm-renderers__lbl">OFFICIAL RENDERERS · ONE PROTOCOL</span>
      <a href={`${base}/concepts/renderer-sdks/`} class="dsm-renderers__link">RENDERER SDKS →</a>
    </div>

    <ul class="dsm-rgrid" aria-label="Official A2UI renderers">
      <li><a href={`${base}/concepts/renderer-sdks/`}><RendererLogo name="react" size={26} /><strong>React</strong><code>@a2ui/react</code></a></li>
      <li><a href={`${base}/concepts/renderer-sdks/`}><RendererLogo name="lit" size={24} /><strong>Lit</strong><code>@a2ui/lit</code></a></li>
      <li><a href={`${base}/concepts/renderer-sdks/`}><RendererLogo name="angular" size={26} /><strong>Angular</strong><code>@a2ui/angular</code></a></li>
      <li><a href={`${base}/concepts/renderer-sdks/`}><RendererLogo name="flutter" size={26} /><strong>Flutter</strong><code>a2ui_flutter</code></a></li>
      <li><a href={`${base}/concepts/renderer-sdks/`}><RendererLogo name="swiftui" size={26} /><strong>SwiftUI</strong><code>A2UISwiftUI</code></a></li>
      <li><a href={`${base}/concepts/renderer-sdks/`}><RendererLogo name="compose" size={26} /><strong>Jetpack Compose</strong><code>Kotlin · Android</code></a></li>
    </ul>

    <div class="dsm-community">
      <span class="dsm-renderers__lbl">FROM THE COMMUNITY</span>
      <div class="dsm-community__list">
        <span><RendererLogo name="vue" size={14} /> Vue</span>
        <span><RendererLogo name="svelte" size={14} /> Svelte</span>
        <span>React Native</span>
        <span>Compose Multiplatform</span>
        <span>Lynx</span>
        <span>Ink (terminal)</span>
        <a href={`${base}/ecosystem/renderers/`}>All ecosystem renderers →</a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.getElementById('dsm-showcase');
    const stage = document.getElementById('dsm-stage');
    if (!root || !stage) return;

    const skinMeta = {
      cupertino: {
        desc: 'The agent emits zero CSS, fonts, or pixel coordinates. Your iOS host maps OrderCard and ChoicePicker directly to native SwiftUI controls.',
        font: 'SF Pro Display',
        radius: '28px Continuous',
      },
      material: {
        desc: 'On Android, the exact same semantic stream adopts dynamic tonal surfaces, stadium geometry, and Jetpack Compose state.',
        font: 'Google Sans / Roboto',
        radius: '24px + Stadium',
      },
      editorial: {
        desc: 'Luxury and editorial apps keep 100% of their visual soul — optical serif display type, warm paper stock, and hard architectural shadows.',
        font: 'Newsreader Serif',
        radius: '0px Architectural',
      },
      saas: {
        desc: 'In dense web workspaces, components snap into dark-slate tokens, tabular monospace typography, and crisp hairline borders.',
        font: 'JetBrains Mono',
        radius: '6px Precision',
      },
    };

    const descEl = document.getElementById('dsm-skin-desc');
    const tokFont = document.getElementById('dsm-tok-font');
    const tokRadius = document.getElementById('dsm-tok-radius');

    root.querySelectorAll('[data-dsm-skin]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const skin = btn.getAttribute('data-dsm-skin') || 'cupertino';
        stage.setAttribute('data-skin', skin);
        root.querySelectorAll('[data-dsm-skin]').forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', String(active));
        });
        const meta = skinMeta[skin];
        if (meta) {
          if (descEl) descEl.textContent = meta.desc;
          if (tokFont) tokFont.textContent = meta.font;
          if (tokRadius) tokRadius.textContent = meta.radius;
        }
      });
    });

    let qty = 2;
    let grind = 'Whole Bean';
    let slot = 'Within 45m';
    const qtyVal = document.getElementById('dsm-qty-val');
    const totalBadge = document.getElementById('dsm-total-badge');
    const orderBtn = document.getElementById('dsm-order-btn');

    const syncOrder = () => {
      const total = qty * 24;
      if (qtyVal) qtyVal.textContent = `${qty} bag${qty > 1 ? 's' : ''}`;
      if (totalBadge) totalBadge.textContent = `$${total}`;
      if (orderBtn && !orderBtn.classList.contains('is-dispatched')) {
        orderBtn.textContent = `Dispatch ${qty} Bag${qty > 1 ? 's' : ''} (${grind}) · $${total}`;
      }
    };

    const decBtn = document.getElementById('dsm-qty-dec');
    const incBtn = document.getElementById('dsm-qty-inc');
    if (decBtn) {
      decBtn.addEventListener('click', () => {
        qty = Math.max(1, qty - 1);
        if (orderBtn) orderBtn.classList.remove('is-dispatched');
        syncOrder();
      });
    }
    if (incBtn) {
      incBtn.addEventListener('click', () => {
        qty = Math.min(6, qty + 1);
        if (orderBtn) orderBtn.classList.remove('is-dispatched');
        syncOrder();
      });
    }

    root.querySelectorAll('[data-dsm-grind]').forEach((btn) => {
      btn.addEventListener('click', () => {
        grind = btn.getAttribute('data-dsm-grind') || 'Whole Bean';
        root.querySelectorAll('[data-dsm-grind]').forEach((b) => b.classList.toggle('is-active', b === btn));
        if (orderBtn) orderBtn.classList.remove('is-dispatched');
        syncOrder();
      });
    });

    root.querySelectorAll('[data-dsm-slot]').forEach((btn) => {
      btn.addEventListener('click', () => {
        slot = btn.getAttribute('data-dsm-slot') || 'Within 45m';
        root.querySelectorAll('[data-dsm-slot]').forEach((b) => b.classList.toggle('is-active', b === btn));
        if (orderBtn) orderBtn.classList.remove('is-dispatched');
        syncOrder();
      });
    });

    if (orderBtn) {
      orderBtn.addEventListener('click', () => {
        const dispatched = orderBtn.classList.toggle('is-dispatched');
        const total = qty * 24;
        orderBtn.textContent = dispatched
          ? `✓ Courier Assigned (${slot}) · $${total}`
          : `Dispatch ${qty} Bag${qty > 1 ? 's' : ''} (${grind}) · $${total}`;
      });
    }
  })();
</script>

<style>
  .dsm-root {
    display: flex;
    flex-direction: column;
    gap: 72px;
    width: 100%;
  }

  .dsm-open-split {
    display: grid;
    grid-template-columns: minmax(290px, 0.82fr) minmax(320px, 1.28fr);
    gap: 84px;
    align-items: center;
  }

  @media (max-width: 920px) {
    .dsm-open-split {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  /* --- Left Vertical Architectural Selector --- */
  .dsm-rail {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .dsm-index {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--a2-border-strong);
  }

  .dsm-row {
    appearance: none;
    position: relative;
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 20px 16px;
    border: none;
    border-bottom: 1px solid var(--a2-border);
    background: transparent;
    color: var(--a2-text-muted);
    font-family: var(--a2-font-sans);
    text-align: left;
    cursor: pointer;
    transition: color 0.16s ease, background-color 0.16s ease;
  }

  .dsm-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--a2-accent);
    transform: scaleY(0);
    transition: transform 0.2s ease;
  }

  .dsm-row:hover {
    color: var(--a2-text);
    background: var(--a2-surface-subtle);
  }

  .dsm-row.is-active {
    color: var(--a2-text);
    background: var(--a2-surface-subtle);
  }

  .dsm-row.is-active::before {
    transform: scaleY(1);
  }

  .dsm-row__num {
    font-family: var(--a2-font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--a2-accent);
  }

  .dsm-row__main {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .dsm-row__main strong {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .dsm-row__main span {
    font-family: var(--a2-font-mono);
    font-size: 11px;
    color: var(--a2-text-muted);
  }

  .dsm-row__mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--a2-text-muted);
    opacity: 0.55;
    transition: opacity 0.16s ease;
  }

  .dsm-row:hover .dsm-row__mark,
  .dsm-row.is-active .dsm-row__mark {
    opacity: 1;
  }

  .dsm-row.is-active .dsm-row__mark :global(.rmark) {
    color: var(--brand);
  }

  .dsm-note {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--a2-text-secondary);
  }

  .dsm-note code {
    font-family: var(--a2-font-mono);
    font-size: 12.5px;
    color: var(--a2-text);
  }

  .dsm-specs {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--a2-border);
  }

  .dsm-specs dt {
    font-family: var(--a2-font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    color: var(--a2-text-muted);
    margin-bottom: 4px;
  }

  .dsm-specs dd {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--a2-text);
  }

  .dsm-zero {
    font-family: var(--a2-font-mono);
    color: var(--a2-accent-strong) !important;
  }

  /* --- Right Crop-Marked Open Plinth --- */
  .dsm-plinth {
    position: relative;
    padding: 64px 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: radial-gradient(var(--a2-dot-grid) 1.25px, transparent 1.25px);
    background-size: 18px 18px;
    border: 1px dashed var(--a2-border-strong);
    transition: background-color 0.35s ease;
  }

  @media (max-width: 560px) {
    .dsm-plinth {
      padding: 24px 16px;
    }
  }

  .dsm-crop {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--a2-text);
    border-style: solid;
    pointer-events: none;
  }
  .dsm-crop--tl { top: -1px; left: -1px; border-width: 2px 0 0 2px; }
  .dsm-crop--tr { top: -1px; right: -1px; border-width: 2px 2px 0 0; }
  .dsm-crop--bl { bottom: -1px; left: -1px; border-width: 0 0 2px 2px; }
  .dsm-crop--br { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }

  /* 4 Distinct Design System Skins */
  .dsm-open-split[data-skin='cupertino'] .dsm-plinth {
    --mc-bg: #ffffff;
    --mc-border: rgba(15, 23, 42, 0.08);
    --mc-shadow: 0 28px 60px -14px rgba(0, 60, 140, 0.22), 0 2px 8px rgba(0, 0, 0, 0.06);
    --mc-radius: 28px;
    --mc-ctrl-radius: 11px;
    --mc-btn-radius: 15px;
    --mc-font-title: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
    --mc-title-transform: capitalize;
    --mc-title-style: normal;
    --mc-ink: #111827;
    --mc-sub: #6b7280;
    --mc-well: #f1f4f9;
    --mc-active-bg: #ffffff;
    --mc-active-fg: #111827;
    --mc-active-shadow: 0 2px 6px rgba(0, 0, 0, 0.09);
    --mc-cta-bg: #007aff;
    --mc-cta-fg: #ffffff;
    --mc-badge-bg: rgba(0, 122, 255, 0.1);
    --mc-badge-fg: #007aff;
  }

  .dsm-open-split[data-skin='material'] .dsm-plinth {
    --mc-bg: #f3f9ef;
    --mc-border: #bfd8ba;
    --mc-shadow: 0 22px 48px -14px rgba(20, 50, 20, 0.25);
    --mc-radius: 26px;
    --mc-ctrl-radius: 999px;
    --mc-btn-radius: 999px;
    --mc-font-title: 'Inter', system-ui, sans-serif;
    --mc-title-transform: capitalize;
    --mc-title-style: normal;
    --mc-ink: #152514;
    --mc-sub: #475b46;
    --mc-well: #e1eee0;
    --mc-active-bg: #bce0b5;
    --mc-active-fg: #0e220d;
    --mc-active-shadow: none;
    --mc-cta-bg: #2c612a;
    --mc-cta-fg: #ffffff;
    --mc-badge-bg: #d3ead0;
    --mc-badge-fg: #1c4c1b;
  }

  .dsm-open-split[data-skin='editorial'] .dsm-plinth {
    --mc-bg: #faf5eb;
    --mc-border: #1e1814;
    --mc-shadow: 8px 8px 0px #1e1814;
    --mc-radius: 0px;
    --mc-ctrl-radius: 0px;
    --mc-btn-radius: 0px;
    --mc-font-title: var(--a2-font-serif);
    --mc-title-transform: capitalize;
    --mc-title-style: italic;
    --mc-ink: #1e1814;
    --mc-sub: #695c4f;
    --mc-well: #efe7d8;
    --mc-active-bg: #1e1814;
    --mc-active-fg: #faf5eb;
    --mc-active-shadow: none;
    --mc-cta-bg: #b84326;
    --mc-cta-fg: #fffaf5;
    --mc-badge-bg: #efe0d9;
    --mc-badge-fg: #993218;
  }

  .dsm-open-split[data-skin='saas'] .dsm-plinth {
    --mc-bg: #0f131b;
    --mc-border: rgba(45, 212, 191, 0.35);
    --mc-shadow: 0 28px 60px -14px rgba(0, 0, 0, 0.65);
    --mc-radius: 6px;
    --mc-ctrl-radius: 4px;
    --mc-btn-radius: 4px;
    --mc-font-title: var(--a2-font-mono);
    --mc-title-transform: uppercase;
    --mc-title-style: normal;
    --mc-ink: #f8fafc;
    --mc-sub: #94a3b8;
    --mc-well: #080b10;
    --mc-active-bg: rgba(20, 184, 166, 0.2);
    --mc-active-fg: #2dd4bf;
    --mc-active-shadow: inset 0 0 0 1px rgba(45, 212, 191, 0.45);
    --mc-cta-bg: #14b8a6;
    --mc-cta-fg: #041311;
    --mc-badge-bg: rgba(20, 184, 166, 0.16);
    --mc-badge-fg: #2dd4bf;
  }

  .dsm-card {
    width: 100%;
    max-width: 440px;
    background: var(--mc-bg);
    border: 1px solid var(--mc-border);
    border-radius: var(--mc-radius);
    box-shadow: var(--mc-shadow);
    padding: 24px;
    color: var(--mc-ink);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition:
      background 0.3s ease,
      border-radius 0.32s cubic-bezier(0.2, 0.9, 0.3, 1),
      box-shadow 0.3s ease,
      border-color 0.3s ease,
      color 0.25s ease;
  }

  .dsm-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .dsm-card__kicker {
    display: block;
    font-family: var(--a2-font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.09em;
    color: var(--mc-sub);
    margin-bottom: 4px;
  }

  .dsm-card__title {
    margin: 0;
    font-family: var(--mc-font-title);
    font-style: var(--mc-title-style);
    text-transform: var(--mc-title-transform);
    font-size: 24px;
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--mc-ink);
  }

  .dsm-open-split[data-skin='saas'] .dsm-card__title {
    font-size: 16.5px;
    letter-spacing: 0.03em;
  }

  .dsm-card__price {
    padding: 5px 11px;
    border-radius: var(--mc-ctrl-radius);
    background: var(--mc-badge-bg);
    color: var(--mc-badge-fg);
    font-family: var(--a2-font-mono);
    font-size: 14px;
    font-weight: 700;
  }

  .dsm-card__sub {
    margin: -6px 0 0;
    font-size: 13px;
    color: var(--mc-sub);
  }

  .dsm-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dsm-section__lbl {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--mc-sub);
  }

  .dsm-seg {
