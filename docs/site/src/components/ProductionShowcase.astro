---

<section class="a2-section a2-section--alt ps-section" id="customers">
  <div class="ps-wrap">
    <!-- Minimal editorial header -->
    <div class="ps-head">
      <h2 class="ps-h2">
        Shipping across <span class="ps-accent">Google and the industry.</span>
      </h2>
    </div>

    <!-- Architectural 5-cell brand logo & name showcase -->
    <ul class="ps-brands" aria-label="Teams and products shipping with A2UI">
      <!-- 1. Alation -->
      <li class="ps-brand">
        <a
          href="https://www.alation.com"
          target="_blank"
          rel="noopener noreferrer"
          class="ps-brand__inner"
          aria-label="Alation — Intelligence Operating System"
        >
          <div class="ps-brand__lockup">
            <svg
              class="ps-wordmark-svg"
              viewBox="0 0 101 23"
              height="20"
              aria-hidden="true"
            >
              <path
                fill="currentColor"
