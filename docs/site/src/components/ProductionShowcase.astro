import TeamLogo from './TeamLogo.astro';

const stories = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/built-with-a2ui/`;
---

<section class="a2-section a2-section--alt ps-section" id="customers">
  <div class="ps-wrap">
    <div class="ps-head">
      <h2 class="ps-h2">
        Shipping across <span class="ps-accent">Google and the industry.</span>
      </h2>
    </div>

    <ul class="ps-brands" aria-label="Teams and products shipping with A2UI">
      <!-- 1. Alation -->
      <li class="ps-brand">
        <a
          href={`${stories}#alation`}
          class="ps-brand__inner"
          aria-label="Alation, Alation AIOS: read the story"
        >
          <div class="ps-brand__lockup">
            <TeamLogo team="alation" idPrefix="ps-alation" />
          </div>
          <span class="ps-brand__product">Alation AIOS</span>
        </a>
      </li>

      <!-- 2. ByteDance -->
      <li class="ps-brand">
        <a
          href={`${stories}#bytedance`}
          class="ps-brand__inner"
          aria-label="ByteDance, Lynx: read the story"
        >
          <div class="ps-brand__lockup">
            <TeamLogo team="bytedance" idPrefix="ps-bytedance" />
          </div>
          <span class="ps-brand__product">Lynx</span>
        </a>
      </li>

      <!-- 3. Atlassian -->
      <li class="ps-brand">
        <a
          href={`${stories}#atlassian`}
          class="ps-brand__inner"
          aria-label="Atlassian, Jira: read the story"
        >
          <div class="ps-brand__lockup">
            <TeamLogo team="atlassian" idPrefix="ps-atlassian" />
          </div>
          <span class="ps-brand__product">Jira</span>
        </a>
      </li>

      <!-- 4. Google Cloud -->
      <li class="ps-brand">
        <a
          href={`${stories}#gemini-notebook`}
          class="ps-brand__inner"
          aria-label="Gemini, Gemini Notebook: read the story"
        >
          <div class="ps-brand__lockup">
            <TeamLogo team="gemini" idPrefix="ps-gemini" />
          </div>
          <span class="ps-brand__product">Gemini Notebook</span>
        </a>
      </li>
      <li class="ps-brand">
        <a
          href={`${stories}#gemini-enterprise`}
          class="ps-brand__inner"
          aria-label="Google Cloud, Gemini Enterprise: read the story"
        >
          <div class="ps-brand__lockup">
            <TeamLogo team="google-cloud" idPrefix="ps-google-cloud" />
          </div>
          <span class="ps-brand__product">Gemini Enterprise</span>
        </a>
      </li>
    </ul>

    <!-- Partner quotes (only where approved quotes exist) -->
    <div class="ps-quotes">
      <blockquote class="ps-quote">
        <p>
          The Alation Intelligence Operating System (AIOS) brings artifacts with data, charts, and
          insights directly to where teams work with transparency about where each figure comes
          from. A2UI provides the interactive UI scaffolding that makes these artifacts feel like
          high-touch, tailored applications, whether they are used in Alation or in the AI
          Assistants our customers already use.
        </p>
        <footer>
          <strong>GT Volpe</strong>
          <span>Vice President of Product Management, Alation</span>
        </footer>
      </blockquote>

      <blockquote class="ps-quote">
        <p>
          A2UI is headed in the right direction: it separates how a model produces an interface
          from how an app renders it. Swappable inference formats and macros keep generation
          efficient, and even LLMs can be swapped for a System 1 model. In our playground, a
          decision model like Jev picks components and values instead of writing text, and then the
          SDK builds the A2UI screens that Lynx renders natively.
        </p>
        <footer>
          <strong>Shouqun Liu</strong>
          <span>Engineering Lead for Lynx at ByteDance</span>
        </footer>
      </blockquote>
    </div>
  </div>
</section>

<style>
  .ps-section {
    position: relative;
    padding: 96px 0 104px;
    background: var(--a2-bg-alt);
    border-top: 1px solid var(--a2-border-strong);
    scroll-margin-top: 72px;
  }

  @media (max-width: 720px) {
    .ps-section {
      padding: 72px 0 80px;
    }
  }

  .ps-wrap {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 36px;
  }

  @media (max-width: 640px) {
    .ps-wrap {
      padding: 0 20px;
    }
  }

  .ps-head {
    margin-bottom: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
  }

  .ps-h2 {
    margin: 0;
    font-family: var(--a2-font-display);
    font-size: clamp(1.85rem, 3vw, 2.45rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: var(--a2-tracking-h2);
    color: var(--a2-text);
  }

  .ps-accent {
    color: var(--a2-heading-accent);
  }

  /* Architectural 5-cell brand grid */
  .ps-brands {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--a2-border-strong);
    border-radius: 6px;
    background: var(--a2-bg);
    overflow: hidden;
  }

  .ps-brand + .ps-brand {
    border-left: 1px solid var(--a2-border);
  }

  @media (max-width: 1040px) {
    .ps-brands {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .ps-brand:nth-child(-n + 3) {
      grid-column: span 2;
    }

    .ps-brand:nth-child(n + 4) {
      grid-column: span 3;
      border-top: 1px solid var(--a2-border);
    }

    .ps-brand:nth-child(4) {
      border-left: none;
    }
  }

  @media (max-width: 600px) {
    .ps-brands {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ps-brand {
      grid-column: span 1 !important;
      border-left: none !important;
      border-top: none !important;
    }

    .ps-brand:nth-child(even) {
      border-left: 1px solid var(--a2-border) !important;
    }

    .ps-brand:nth-child(n + 3) {
      border-top: 1px solid var(--a2-border) !important;
    }

    .ps-brand:last-child {
      grid-column: 1 / -1 !important;
    }
  }

  .ps-brand__inner {
    height: 100%;
    min-height: 98px;
    padding: 26px 16px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    color: var(--a2-text);
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  a.ps-brand__inner:hover {
    background: var(--a2-surface-raised);
  }

  .ps-brand__lockup {
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--a2-text);
  }

  .ps-brand__lockup :global(.team-logo) {
    gap: 10px;
  }

  .ps-brand__product {
    font-family: var(--a2-font-mono);
    font-size: 11.5px;
    line-height: 1.3;
    color: var(--a2-text-muted);
    transition: color 0.16s ease;
  }

  a.ps-brand__inner:hover .ps-brand__product,
  a.ps-brand__inner:focus-visible .ps-brand__product {
    color: var(--a2-accent);
  }

  .ps-brand__lockup :global(.team-logo__name) {
    font-family: var(--a2-font-display);
    font-size: 19.5px;
    font-weight: 680;
    letter-spacing: -0.025em;
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .ps-brand__inner {
      min-height: 86px;
      padding: 20px 10px;
    }

    .ps-brand__lockup :global(.team-logo) {
      gap: 8px;
    }

    .ps-brand__lockup :global(.team-logo__wordmark) {
      height: 22px;
    }

    .ps-brand__lockup :global(.team-logo__name) {
      font-size: 17px;
    }
  }

  .ps-quotes {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 64px;
    align-items: start;
  }

  .ps-quote {
    position: relative;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    height: 100%;
  }

  .ps-quote + .ps-quote::before {
    content: '';
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: -32px;
    width: 1px;
    background: var(--a2-border);
  }

  @media (max-width: 820px) {
    .ps-quotes {
      grid-template-columns: 1fr;
      row-gap: 28px;
      margin-top: 32px;
    }

    .ps-quote + .ps-quote {
      padding-top: 28px;
      border-top: 1px solid var(--a2-border);
    }

    .ps-quote + .ps-quote::before {
      display: none;
    }
  }

  .ps-quote p {
    margin: 0;
    font-family: var(--a2-font-display);
    font-size: clamp(1.05rem, 1.45vw, 1.25rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: -0.012em;
    color: var(--a2-text);
  }

  .ps-quote p::before {
    content: '\201C';
    display: block;
    height: 0.62em;
    margin-bottom: 10px;
    font-size: 3.4rem;
    font-weight: 700;
    line-height: 1;
    color: var(--a2-heading-accent);
  }

  .ps-quote footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 10px;
    font-size: 14px;
  }

  .ps-quote strong {
    font-weight: 650;
    color: var(--a2-text);
  }

  .ps-quote span {
    font-family: var(--a2-font-mono);
    font-size: 12px;
    color: var(--a2-text-muted);
  }
</style>
