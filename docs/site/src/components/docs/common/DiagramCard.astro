interface Props {
  title: string;
  mermaid: string; // The canonical structural specification
}

const { title, mermaid } = Astro.props;
---

<div class="diagram-card border rounded-xl overflow-hidden my-6 not-content">
  <!-- Human View: Rich Tailwind / Visual Card Layout -->
  <div class="human-view p-6 bg-card text-card-foreground">
    <h4 class="text-lg font-semibold mb-4">{title}</h4>
    <slot /> <!-- Render rich UI cards or interactive canvas -->
  </div>

  <!-- Agent & Accessibility View: Machine-readable spec hidden from human UI -->
  <script type="text/vnd.mermaid" data-agent-diagram="spec" style="display: none;">
    {mermaid.trim()}
  </script>
</div>
