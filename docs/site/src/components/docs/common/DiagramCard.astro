interface Props {
  title: string;
  mermaid: string; // The canonical structural specification
}

const { title, mermaid } = Astro.props;
---

<div class="diagram-card border rounded-xl overflow-hidden my-6 not-content">
  <!-- Human View: Rich Tailwind / Visual Card Layout -->
  <div class="human-view p-6 bg-card text-card-foreground">
    <h4 class="text-lg font-semibold mb-4">{title}</h4>
    <slot /> <!-- Render rich UI cards or interactive canvas -->
  </div>

  <!-- Agent & Accessibility View: Semantic Details Accordion with Raw Mermaid -->
  <details class="agent-view border-t bg-muted/40 px-4 py-2 text-xs">
    <summary class="cursor-pointer text-muted-foreground hover:text-foreground font-mono">
      View Diagram Source (Mermaid & Machine-Readable Spec)
    </summary>
    <div
      class="mt-2 font-mono whitespace-pre text-xs text-foreground bg-background p-3 rounded border overflow-x-auto"
      data-agent-content="diagram-spec"
    >
      {mermaid.trim()}
    </div>
  </details>
</div>
