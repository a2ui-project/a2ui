interface SchemaItem {
  version: string;
  label: string;
  href: string;
  title?: string;
}

interface Props {
  items: SchemaItem[];
}

const {items} = Astro.props;
const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

function resolveHref(href: string): string {
  if (!href.startsWith('/') || !baseUrl) {
    return href;
  }
  return `${baseUrl}${href}`;
}
---

<div class="schema-chips not-content" role="list" aria-label="JSON Schema definitions">
  {
    items.map(item => {
      const [filePart, defPart] = item.label.split('#');
      return (
        <a
          role="listitem"
          class:list={[
            'schema-chip',
            item.version.startsWith('v1') ? 'schema-chip--v1' : 'schema-chip--v09',
          ]}
          href={resolveHref(item.href)}
          title={item.title ?? `${item.label} (${item.version})`}
        >
          <span class="schema-chip__ver">{item.version}</span>
          <span class="schema-chip__label">
            <span>{filePart}</span>
            {defPart && <span class="schema-chip__def">#{defPart}</span>}
          </span>
          <span class="schema-chip__arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      );
    })
  }
</div>

<style>
  .schema-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0 1rem;
    max-width: 100%;
  }

  .schema-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    max-width: 100%;
    padding: 0.2rem 0.55rem 0.2rem 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    line-height: 1.3;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .schema-chip:hover,
  .schema-chip:focus-visible {
    border-color: var(--sl-color-accent);
    background: rgba(20, 184, 166, 0.1);
  }

  .schema-chip__ver {
    flex-shrink: 0;
    display: inline-block;
    padding: 0.1rem 0.42rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    background: rgba(148, 163, 184, 0.16);
    color: var(--sl-color-gray-2);
  }

  .schema-chip--v1 .schema-chip__ver {
    background: rgba(20, 184, 166, 0.18);
    color: var(--sl-color-text-accent);
  }

  :global(:root[data-theme='light']) .schema-chip--v1 .schema-chip__ver {
    background: #ccfbf1;
    color: #0f766e;
  }

  :global(:root[data-theme='light']) .schema-chip__ver {
    background: #e2e8f0;
    color: #334155;
  }

  .schema-chip__label {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    font-weight: 500;
    min-width: 0;
  }

  .schema-chip__def {
    opacity: 0.78;
  }

  .schema-chip__arrow {
    flex-shrink: 0;
    font-size: 0.72rem;
    opacity: 0.65;
  }

  .schema-chip:hover .schema-chip__arrow {
    opacity: 1;
    color: var(--sl-color-text-accent);
  }
</style>
