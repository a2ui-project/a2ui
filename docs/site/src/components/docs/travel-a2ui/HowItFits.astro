    border-radius: 10px;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-3);
  }
  :root[data-theme='light'] .fit__agent {
    background: #fff;
    border-color: rgba(147, 51, 234, 0.4);
    color: #475569;
  }
  .fit__agent-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
  }
  .fit__agent-head strong {
    color: #c084fc;
  }
  :root[data-theme='light'] .fit__agent-head strong {
    color: #7e22ce;
  }
  .fit__pill {
    padding: 0.1rem 0.45rem;
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 4px;
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
  }
  :root[data-theme='light'] .fit__pill {
    border-color: #d8b4fe;
    background: #f3e8ff;
    color: #7e22ce;
  }
  .fit__wire {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    padding: 0.25rem 0.5rem;
    border-left: 1px dashed var(--sl-color-gray-4);
    border-right: 1px dashed var(--sl-color-gray-4);
