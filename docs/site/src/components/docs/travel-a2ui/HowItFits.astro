    gap: 0.75rem;
    margin: 1.5rem 0;
    font-size: var(--sl-text-sm);
  }
  .fit p,
  .fit pre {
    margin: 0;
  }
  .fit code {
    font-size: 0.72rem;
  }
  .fit__side {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    background: var(--sl-color-bg-sidebar);
  }
  :root[data-theme='light'] .fit__side {
    background: #f8fafc;
    border-color: #e2e8f0;
  }
  .fit__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }
  .fit__badge {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .fit__badge--server {
    border: 1px solid rgba(168, 85, 247, 0.35);
    background: rgba(168, 85, 247, 0.14);
    color: #c084fc;
  }
  .fit__badge--client {
    border: 1px solid rgba(59, 130, 246, 0.35);
    background: rgba(59, 130, 246, 0.14);
    color: #60a5fa;
  }
  :root[data-theme='light'] .fit__badge--server {
