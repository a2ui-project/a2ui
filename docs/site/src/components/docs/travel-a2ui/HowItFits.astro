// How A2UI fits into Travel A2UI: an SDK for the builder's agent, a renderer
// for the builder's app. The same picture as the Concepts overview's pipeline
// (purple for the builder's agent code, blue for the builder's app, a dashed
// teal line around the A2UI SDKs), drawn with this sample's real pieces and
// paths. Plain HTML, so it reflows on a phone instead of shrinking.
import {Image} from 'astro:assets';
import flutterShot from '../../../assets/quickstart/travel-a2ui/flutter.png';

// Real messages from this sample (`renderers/flutter/test/fixtures/flights.json`), trimmed.
const components = `{"id": "fares__flightoption_1",
 "component": "FlightOption",
 "airline": {"@path": "airline"},
 "price": {"@path": "price"}, …}`;
const data = `{"path": "/flights",
 "value": [{"airline": "TAP Air Portugal",
            "price": "€292", …}]}`;
---

<figure class="fit not-content" aria-labelledby="fit-caption">
  <section class="fit__side fit__side--server" aria-label="Server: your agent">
    <div class="fit__head">
      <span class="fit__badge fit__badge--server">SERVER · YOUR AGENT</span>
      <code>apps/server/</code>
    </div>

    <div class="fit__two">
      <div class="fit__card">
        <span class="fit__tag">YOUR CATALOG</span>
        <strong>Components and functions</strong>
        <p>
          What the client can draw and compute: <code>FlightOption</code>, <code>DateRangePicker</code>,
          <code>calcNights</code>…
        </p>
        <code class="fit__path">catalogs/a2ui-travel/catalog.json</code>
      </div>
      <div class="fit__card">
        <span class="fit__tag">YOUR TOOLS</span>
        <strong>Domain lookups</strong>
        <p>Flights, fares, hotels and places. Fixture data in this sample.</p>
        <code class="fit__path">data/tools.json</code>
      </div>
    </div>

    <div class="fit__sdk">
      <div class="fit__sdk-head">
        <span class="fit__sdk-label">A2UI AGENT SDK</span>
        <span class="fit__sdk-langs">a2ui-agent-sdk · Python</span>
      </div>
      <div class="fit__two">
        <div class="fit__card">
          <strong>Skill generator</strong>
          <p>Turns the catalog into skills that teach the model to write A2UI.</p>
          <code class="fit__path">skills/express-modular/</code>
        </div>
        <div class="fit__card">
          <strong>Compiler</strong>
          <p>Reads what the model writes as it streams, checks it against the catalog, and emits A2UI JSON.</p>
        </div>
      </div>
    </div>

    <div class="fit__two fit__flow" aria-hidden="true">
      <span>↓ A2UI skills</span>
      <span>↑ A2UI Express, as the model writes it</span>
    </div>

    <div class="fit__agent">
      <div class="fit__agent-head">
        <strong>Your agent</strong>
        <code class="fit__pill">brain/</code>
      </div>
      <p>
        Calls Gemini with the skills and your tools, keeps the conversation and the trip, and hands the
        model's UI to the compiler.
      </p>
    </div>
  </section>

  <div class="fit__wire">
    <span class="fit__wire-label">A2UI PROTOCOL · JSON over SSE</span>
    <div class="fit__two">
      <pre class="fit__code"><span class="fit__code-tag">updateComponents</span>{components}</pre>
      <pre class="fit__code"><span class="fit__code-tag">updateDataModel · data, sent separately</span>{data}</pre>
    </div>
    <div class="fit__chips" aria-hidden="true">
      <span>↓ to the client</span>
      <span class="fit__chip-up">↑ action: select_flight</span>
    </div>
  </div>

  <section class="fit__side fit__side--client" aria-label="Client: your app">
    <div class="fit__head">
      <span class="fit__badge fit__badge--client">CLIENT · YOUR APP</span>
      <code>apps/web/ · apps/flutter/</code>
    </div>
    <div class="fit__client">
      <div class="fit__phone">
        <div class="fit__screen">
          <Image
            src={flutterShot}
            width={360}
            alt="The Flutter client: flight options drawn as an A2UI surface inside the app"
          />
          <span class="fit__surface" aria-hidden="true"><span>A2UI surface</span></span>
        </div>
        <span>What the user sees: an A2UI surface inside your app</span>
      </div>
      <div class="fit__stack">
        <div class="fit__card fit__card--app">
          <span class="fit__tag">YOUR APP</span>
          <strong>Everything around the surfaces</strong>
          <p>The header, the chat, the key form: the same on every turn.</p>
        </div>
        <div class="fit__card fit__card--app">
          <span class="fit__tag">YOUR COMPONENT IMPLEMENTATIONS</span>
          <strong>The catalog, as native widgets</strong>
          <p>React views and Flutter widgets for <code>FlightOption</code>, <code>HotelCard</code>…</p>
          <code class="fit__path">renderers/react/ · renderers/flutter/</code>
        </div>
        <div class="fit__sdk">
          <div class="fit__sdk-head">
            <span class="fit__sdk-label">A2UI RENDERER</span>
            <span class="fit__sdk-langs">@a2ui/react · a2ui_flutter</span>
          </div>
          <p class="fit__sdk-text">
            Its MessageProcessor applies the messages and binds the data; the renderer draws each
            surface with your widgets and sends a tap back as an action.
          </p>
        </div>
      </div>
    </div>
  </section>

  <figcaption id="fit-caption">
    Purple is your agent's code, blue is your app, and the dashed teal lines are the A2UI SDKs: an
    SDK for your agent, a renderer for your app.
  </figcaption>
</figure>

<style>
