    padding: 0.15rem 0.55rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 6px;
    background: var(--sl-color-bg);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    color: #60a5fa;
  }
  .fit__chips .fit__chip-up {
    color: #2dd4bf;
  }
  :root[data-theme='light'] .fit__chips span {
    color: #1d4ed8;
  }
  :root[data-theme='light'] .fit__chips .fit__chip-up {
    color: #0f766e;
  }
  .fit__client {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    align-items: start;
  }
  @container (min-width: 520px) {
    .fit__client {
      grid-template-columns: minmax(9rem, 13rem) 1fr;
    }
  }
  .fit__phone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    color: var(--sl-color-gray-3);
    text-align: center;
  }
  .fit__screen {
    position: relative;
    width: 100%;
    max-width: 13rem;
    overflow: hidden;
    border: 6px solid #1f1f1f;
    border-radius: 1.4rem;
  }
  :root:not([data-theme='light']) .fit__screen {
    border-color: #5f6368;
  }
  .fit__screen img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The flight card's place in the screenshot (measured from flutter.png):
     the surface, not the app around it. */
  .fit__surface {
    position: absolute;
    top: 17.4%;
    bottom: 8.4%;
    left: 2.2%;
    right: 2.2%;
    border: 2px dashed #14b8a6;
    border-radius: 0.5rem;
  }
  .fit__surface span {
    position: absolute;
    top: -0.75rem;
