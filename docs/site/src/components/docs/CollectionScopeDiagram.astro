---

<div
  class="cs-root not-content"
  data-diagram
  data-diagram-title="collection-scope"
>
  <div class="cs-header">
    <div class="cs-header__left">
      <span class="cs-badge">DYNAMIC LIST TEMPLATES</span>
      <span class="cs-title">
        Repeating a Template with <code>ChildList</code> &amp; Local Paths
      </span>
    </div>
    <code class="cs-expr"
      >children: &#123; "path": "/guests", "componentId": "guestRow"
      &#125;</code
    >
  </div>

  <div class="cs-grid">
    <!-- Left: Data Model Array & Template Blueprint -->
    <div class="cs-left-col">
      <div class="cs-card">
        <div class="cs-card__head">
          <span>1. Data Model List</span>
          <code>path: "/guests"</code>
        </div>
        <div class="cs-code">
          <div>[</div>
          <div class="cs-indent">
            &#123; <span class="cs-k">"name"</span>:
            <span class="cs-s">"Alex Rivera"</span> &#125;,
          </div>
          <div class="cs-indent">
            &#123; <span class="cs-k">"name"</span>:
            <span class="cs-s">"Sam Taylor"</span> &#125;
          </div>
          <div>]</div>
        </div>
      </div>

      <div class="cs-card">
        <div class="cs-card__head">
          <span>2. Template Component</span>
          <code>id: "guestRow"</code>
        </div>
        <div class="cs-code">
          <div>&#123;</div>
          <div class="cs-indent">
            <span class="cs-k">"id"</span>:
            <span class="cs-s">"guestRow"</span>,
          </div>
          <div class="cs-indent">
            <span class="cs-k">"component"</span>:
            <span class="cs-s">"Text"</span>,
          </div>
          <div class="cs-indent">
            <span class="cs-k">"text"</span>: &#123;
            <span class="cs-p">"@path"</span>: <span class="cs-s">"name"</span>
            &#125;
          </div>
          <div>&#125;</div>
        </div>
        <div class="cs-legend">
          <span>
            <strong class="cs-p">Local path:</strong>
            <code>"name"</code> (no leading <code>/</code>) resolves relative to each
            array item.
          </span>
        </div>
      </div>
    </div>

    <!-- Right: Rendered UI inside a Window Outline -->
    <div class="cs-ui-col">
      <div class="cs-ui-caption">Rendered List UI</div>
      <div class="cs-window-frame">
        <div class="cs-window-chrome">
          <div class="cs-window-dots" aria-hidden="true">
            <span class="cs-wdot cs-wdot--red"></span>
            <span class="cs-wdot cs-wdot--yellow"></span>
            <span class="cs-wdot cs-wdot--green"></span>
          </div>
          <span class="cs-window-title">Column#root</span>
        </div>

        <div class="cs-window-screen">
          <div class="cs-ui-section-label">Guests (2)</div>

          <div class="cs-ui-row">
            <div class="cs-ui-row__left">
              <span class="cs-ui-avatar">AR</span>
              <span class="cs-ui-name">Alex Rivera</span>
            </div>
            <code class="cs-ui-scope-tag">/guests/0/name</code>
          </div>

          <div class="cs-ui-row">
            <div class="cs-ui-row__left">
              <span class="cs-ui-avatar">ST</span>
              <span class="cs-ui-name">Sam Taylor</span>
            </div>
            <code class="cs-ui-scope-tag">/guests/1/name</code>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Agent & Accessibility View: Machine-readable spec hidden from human UI -->
  <script type="text/vnd.mermaid" data-agent-diagram="spec" style="display: none;">
    flowchart LR
      subgraph DataModel["Data Model (/guests)"]
        g0["/guests/0: { name: 'Alex Rivera' }"]
        g1["/guests/1: { name: 'Sam Taylor' }"]
      end
      subgraph Template["Template Component (Text#guestRow)"]
        tpl["text: { '@path': 'name' }"]
      end
      subgraph Rendered["Rendered List UI (Column#root)"]
        r0["Row 0: 'Alex Rivera' (/guests/0/name)"]
        r1["Row 1: 'Sam Taylor' (/guests/1/name)"]
      end
      g0 --> tpl --> r0
      g1 --> tpl --> r1
  </script>
</div>

<style>
  .cs-root {
    margin: 1.5rem 0 2rem;
    font-family: var(--sl-font);
    color: var(--ink, #111827);
    border-radius: 12px;
    background: var(--surface, #ffffff);
    border: 1px solid var(--border, #e5e7eb);
    box-shadow: var(--shadow-card, 0 1px 2px rgba(0, 0, 0, 0.03));
    overflow: hidden;
  }

  .cs-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 1.15rem;
    background: var(--surface-sunken, #f8f9fa);
    border-bottom: 1px solid var(--border, #e5e7eb);
  }

  .cs-header__left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .cs-badge {
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: var(--blue-50, #eaf2fb);
    color: var(--blue-700, #24599a);
    border: 1px solid var(--blue-200, #c3d8ee);
  }

  .cs-title {
    font-weight: 700;
    font-size: 0.85rem;
  }

  .cs-title code {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    color: var(--blue-700, #24599a);
  }

  .cs-expr {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    padding: 0.18rem 0.5rem;
    border-radius: 5px;
    background: var(--surface, #ffffff);
    border: 1px solid var(--border, #e5e7eb);
    color: var(--code, #1e293b);
  }

  .cs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 1.1rem;
    padding: 1.05rem 1.15rem;
    align-items: center;
  }

  .cs-left-col {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
  }

  .cs-card {
    padding: 0.75rem 0.85rem;
    border-radius: 8px;
    background: var(--surface-sunken, #f8f9fa);
    border: 1px solid var(--border, #e5e7eb);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .cs-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-weight: 700;
    font-size: 0.78rem;
  }

  .cs-card__head code {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    color: var(--blue-700, #24599a);
  }

  .cs-code {
    font-family: var(--sl-font-mono);
    font-size: 0.69rem;
    line-height: 1.5;
    padding: 0.5rem 0.65rem;
    border-radius: 6px;
    background: var(--surface, #ffffff);
    border: 1px solid var(--border, #e5e7eb);
  }

  .cs-indent {
    padding-left: 0.9rem;
  }

  .cs-k {
    color: var(--ink, #111827);
  }

  .cs-p {
    color: var(--blue-700, #24599a);
    font-weight: 600;
  }

  .cs-s {
    color: var(--success, #047857);
  }

  .cs-legend {
    font-size: 0.68rem;
    color: var(--text-muted, #4b5563);
  }

  .cs-legend code {
    font-family: var(--sl-font-mono);
    font-size: 0.65rem;
  }

  /* Right Column: Window Outline */
  .cs-ui-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }

  .cs-ui-caption {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-eyebrow, #5f6672);
  }

  .cs-window-frame {
    width: 100%;
    max-width: 340px;
    border-radius: 16px;
    padding: 0.4rem;
    background: var(--surface-page, #f3f4f6);
    border: 1px solid var(--border, #e5e7eb);
    box-shadow: var(--shadow-card, 0 1px 2px rgba(0, 0, 0, 0.03));
    display: flex;
    flex-direction: column;
  }

  .cs-window-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.3rem 0.6rem 0.42rem;
  }

  .cs-window-dots {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .cs-wdot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border-strong, #9ca3af);
  }

  .cs-window-title {
    font-family: var(--sl-font-mono);
    font-size: 0.64rem;
    color: var(--text-subtle, #6b7280);
  }

  .cs-window-screen {
    background: #ffffff;
    color: #111827;
    border-radius: 11px;
    padding: 0.8rem;
    border: 1px solid #e5e7eb;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cs-ui-section-label {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
  }

  .cs-ui-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    flex-wrap: wrap;
    padding: 0.48rem 0.6rem;
    border-radius: 8px;
    background: #f8f9fa;
    border: 1px solid #e5e7eb;
  }

  .cs-ui-row__left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .cs-ui-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    background: #eaf2fb;
    color: #24599a;
    font-size: 0.62rem;
    font-weight: 800;
  }

  .cs-ui-name {
    font-size: 0.78rem;
    font-weight: 700;
    color: #111827;
  }

  .cs-ui-scope-tag {
    font-family: var(--sl-font-mono);
    font-size: 0.6rem;
    padding: 0.1rem 0.38rem;
    border-radius: 4px;
    background: #eaf2fb;
    color: #24599a;
    border: 1px solid #c3d8ee;
  }

  @media (max-width: 900px) {
    .cs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
