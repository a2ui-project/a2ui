---

<div class="ca-root not-content">
  <!-- Handshake: the renderer advertises catalogs, the agent picks one. -->
  <div class="ca-handshake">
    <div class="ca-endpoint ca-endpoint--agent">
      <div class="ca-endpoint__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2a4 4 0 0 1 4 4v2a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4Z" />
          <path d="M16 14H8a4 4 0 0 0-4 4v2h16v-2a4 4 0 0 0-4-4Z" />
        </svg>
      </div>
      <div class="ca-endpoint__body">
        <span class="ca-endpoint__label">Agent</span>
        <span class="ca-endpoint__sub">Prompts the LLM with the catalog</span>
      </div>
    </div>

    <div class="ca-handshake__bridge">
      <div class="ca-wire">
        <span class="ca-arrow" aria-hidden="true">&larr;</span>
        <code>supportedCatalogIds</code>
      </div>
      <div class="ca-wire">
        <code>createSurface.<wbr />catalogId</code>
        <span class="ca-arrow" aria-hidden="true">&rarr;</span>
      </div>
    </div>

    <div class="ca-endpoint ca-endpoint--renderer">
      <div class="ca-endpoint__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="3" width="20" height="14" rx="2" />
          <path d="M8 21h8" />
          <path d="M12 17v4" />
        </svg>
      </div>
      <div class="ca-endpoint__body">
        <span class="ca-endpoint__label">Renderer</span>
        <span class="ca-endpoint__sub">Implements the catalog natively</span>
      </div>
    </div>
  </div>

  <!-- The catalog document shared by both sides. -->
  <div class="ca-catalog">
    <div class="ca-catalog__header">
      <span class="ca-badge">Catalog</span>
      <code class="ca-catalog__uri">https://example.com/<wbr />catalogs/<wbr />travel/<wbr />v1/<wbr />catalog.json</code>
    </div>

    <div class="ca-grid">
      <!-- Components -->
      <div class="ca-panel">
        <div class="ca-panel__head">
          <span class="ca-panel__title">Components</span>
          <code class="ca-key">"components"</code>
        </div>

        <div class="ca-card ca-card--featured">
          <code class="ca-card__name">FlightStatusCard</code>
          <p class="ca-card__desc">Shows a flight's number, fare, and action buttons.</p>
          <ul class="ca-props">
            <li class="ca-prop">
              <code class="ca-prop__name">flightNumber</code>
              <span class="ca-type">DynamicString</span>
              <span class="ca-req">required</span>
            </li>
            <li class="ca-prop">
              <code class="ca-prop__name">fareAmount</code>
              <span class="ca-type">DynamicNumber</span>
            </li>
            <li class="ca-prop">
              <code class="ca-prop__name">actions</code>
              <span class="ca-type">ChildList</span>
            </li>
          </ul>
          <span class="ca-rule">
            allowedParents: <code>["Column", "List"]</code>
          </span>
        </div>

        <div class="ca-others">
          <span class="ca-others__label">Also in this catalog</span>
          <div class="ca-chips">
            <code class="ca-chip">Column</code>
            <code class="ca-chip">Text</code>
            <code class="ca-chip">Button</code>
            <code class="ca-chip">TextField</code>
          </div>
        </div>
      </div>

      <!-- Functions -->
      <div class="ca-panel">
        <div class="ca-panel__head">
          <span class="ca-panel__title">Functions</span>
          <code class="ca-key">"functions"</code>
        </div>

        <div class="ca-card">
          <code class="ca-card__name">formatCurrency</code>
          <p class="ca-card__desc">Formats a number as a currency string inside a property binding.</p>
          <div class="ca-tags">
            <span class="ca-type">returns string</span>
            <span class="ca-caller ca-caller--teal">rendererOnly</span>
          </div>
        </div>

        <div class="ca-card">
          <code class="ca-card__name">holdSeat</code>
          <p class="ca-card__desc">
            Runs on the renderer when the agent sends <code>callRendererFunction</code>.
          </p>
          <div class="ca-tags">
            <span class="ca-type">returns boolean</span>
            <span class="ca-caller ca-caller--blue">agentOnly</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Instructions -->
    <div class="ca-instructions">
      <div class="ca-panel__head">
        <span class="ca-panel__title">Instructions</span>
        <code class="ca-key">"instructions"</code>
      </div>
      <p class="ca-instructions__sub">Markdown guidance that the agent SDK adds to the LLM system prompt.</p>
      <code class="ca-instructions__quote">"Place FlightStatusCard inside a Column. Format fares with formatCurrency."</code>
    </div>
  </div>
</div>

<style>
  .ca-root {
    container-type: inline-size;
    margin: 1.75rem 0 2.25rem;
    font-family: var(--sl-font);
    color: #e2e8f0;
  }

  :root[data-theme='light'] .ca-root {
    color: #0f172a;
  }

  .ca-root code {
    font-family: var(--sl-font-mono);
  }

  /* Handshake */
  .ca-handshake {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .ca-endpoint {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.7rem 0.85rem;
    border-radius: 10px;
    background: #0f172a;
    border: 1px solid #1e293b;
  }

  :root[data-theme='light'] .ca-endpoint {
    background: #ffffff;
    border-color: #cbd5e1;
  }

  .ca-endpoint__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
  }

  .ca-endpoint__icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .ca-endpoint--agent .ca-endpoint__icon {
    background: rgba(20, 184, 166, 0.14);
    color: #2dd4bf;
  }

  :root[data-theme='light'] .ca-endpoint--agent .ca-endpoint__icon {
    background: #ccfbf1;
    color: #0f766e;
  }

  .ca-endpoint--renderer .ca-endpoint__icon {
    background: rgba(56, 189, 248, 0.14);
    color: #38bdf8;
  }

  :root[data-theme='light'] .ca-endpoint--renderer .ca-endpoint__icon {
    background: #e0f2fe;
    color: #0369a1;
  }

  .ca-endpoint__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .ca-endpoint__label {
    font-weight: 700;
    font-size: 0.88rem;
  }

  .ca-endpoint__sub {
    font-size: 0.74rem;
    line-height: 1.3;
    color: #94a3b8;
  }

  :root[data-theme='light'] .ca-endpoint__sub {
    color: #475569;
  }

  .ca-handshake__bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .ca-wire {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    max-width: 100%;
  }

  .ca-wire code {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid #334155;
    color: #cbd5e1;
  }

  :root[data-theme='light'] .ca-wire code {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #1e293b;
  }

  .ca-arrow {
    font-weight: 700;
    color: #2dd4bf;
  }

  :root[data-theme='light'] .ca-arrow {
    color: #0d9488;
  }

  /* Catalog card */
  .ca-catalog {
    border-radius: 14px;
    background: #0b1120;
    border: 1px solid #1e293b;
    overflow: hidden;
  }

  :root[data-theme='light'] .ca-catalog {
    background: #ffffff;
    border-color: #cbd5e1;
  }

  .ca-catalog__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    background: rgba(15, 23, 42, 0.75);
    border-bottom: 1px solid #1e293b;
  }

  :root[data-theme='light'] .ca-catalog__header {
    background: #f8fafc;
    border-bottom-color: #e2e8f0;
  }

  .ca-badge {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 5px;
    background: rgba(20, 184, 166, 0.16);
    color: #2dd4bf;
    border: 1px solid rgba(20, 184, 166, 0.35);
  }

  :root[data-theme='light'] .ca-badge {
    background: #ccfbf1;
    color: #0f766e;
    border-color: #5eead4;
  }

  .ca-catalog__uri {
    min-width: 0;
    font-size: 0.78rem;
    font-weight: 600;
    overflow-wrap: anywhere;
    color: #f8fafc;
  }

  :root[data-theme='light'] .ca-catalog__uri {
    color: #0f172a;
  }

  .ca-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.9rem;
    padding: 1rem;
  }

  .ca-panel {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
    padding: 0.85rem;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid #1e293b;
  }

  :root[data-theme='light'] .ca-panel {
    background: #f8fafc;
    border-color: #e2e8f0;
  }

  .ca-panel__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .ca-panel__title {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .ca-key {
    font-size: 0.72rem;
    padding: 0.08rem 0.38rem;
    border-radius: 4px;
    background: rgba(20, 184, 166, 0.1);
    color: #2dd4bf;
  }

  :root[data-theme='light'] .ca-key {
    background: #ccfbf1;
    color: #0f766e;
  }

  /* Component and function cards */
  .ca-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    min-width: 0;
    padding: 0.7rem 0.75rem;
    border-radius: 8px;
    background: rgba(2, 6, 23, 0.45);
    border: 1px solid #1e293b;
  }

  :root[data-theme='light'] .ca-card {
    background: #ffffff;
    border-color: #cbd5e1;
  }

  .ca-card--featured {
    border-color: rgba(20, 184, 166, 0.4);
  }

  :root[data-theme='light'] .ca-card--featured {
    border-color: #5eead4;
  }

  .ca-card__name {
    font-size: 0.84rem;
    font-weight: 700;
    color: #f8fafc;
  }

  :root[data-theme='light'] .ca-card__name {
    color: #0f172a;
  }

  .ca-card__desc {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.4;
    color: #94a3b8;
  }

  .ca-card__desc code {
    font-size: 0.7rem;
    overflow-wrap: anywhere;
    color: #cbd5e1;
  }

  :root[data-theme='light'] .ca-card__desc {
    color: #475569;
  }

  :root[data-theme='light'] .ca-card__desc code {
    color: #0f172a;
  }

  .ca-props {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-self: stretch;
    margin: 0;
    padding: 0.5rem 0.6rem;
    list-style: none;
    border-radius: 6px;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid #1e293b;
  }

  :root[data-theme='light'] .ca-props {
    background: #f8fafc;
    border-color: #e2e8f0;
  }

  .ca-prop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.45rem;
    margin: 0;
    font-size: 0.74rem;
  }

  .ca-prop__name {
    font-weight: 600;
    color: #e2e8f0;
  }

  :root[data-theme='light'] .ca-prop__name {
    color: #0f172a;
  }

  .ca-type {
    font-family: var(--sl-font-mono);
    font-size: 0.67rem;
    padding: 0.06rem 0.35rem;
    border-radius: 4px;
    background: rgba(56, 189, 248, 0.1);
    color: #38bdf8;
  }

  :root[data-theme='light'] .ca-type {
    background: #e0f2fe;
    color: #0369a1;
  }

  .ca-req {
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    color: #fb7185;
  }

  :root[data-theme='light'] .ca-req {
    color: #be123c;
  }

  .ca-rule {
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid #334155;
    color: #94a3b8;
  }

  .ca-rule code {
    color: #2dd4bf;
  }

  :root[data-theme='light'] .ca-rule {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #475569;
  }

  :root[data-theme='light'] .ca-rule code {
    color: #0f766e;
  }

  .ca-others {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ca-others__label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #94a3b8;
  }

  :root[data-theme='light'] .ca-others__label {
    color: #64748b;
  }

  .ca-chips,
  .ca-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ca-chip {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 5px;
    background: rgba(2, 6, 23, 0.4);
    border: 1px solid #1e293b;
    color: #e2e8f0;
  }

  :root[data-theme='light'] .ca-chip {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #0f172a;
  }

  .ca-caller {
    font-family: var(--sl-font-mono);
    font-size: 0.67rem;
    padding: 0.06rem 0.4rem;
    border-radius: 4px;
  }

  .ca-caller--teal {
    background: rgba(20, 184, 166, 0.1);
    color: #5eead4;
    border: 1px solid rgba(20, 184, 166, 0.25);
  }

  :root[data-theme='light'] .ca-caller--teal {
    background: #f0fdfa;
    color: #0f766e;
    border-color: #99f6e4;
  }

  .ca-caller--blue {
    background: rgba(56, 189, 248, 0.1);
    color: #7dd3fc;
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  :root[data-theme='light'] .ca-caller--blue {
    background: #f0f9ff;
    color: #0369a1;
    border-color: #bae6fd;
  }

  /* Instructions */
  .ca-instructions {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.85rem 1rem 1rem;
    background: rgba(15, 23, 42, 0.8);
    border-top: 1px solid #1e293b;
  }

  :root[data-theme='light'] .ca-instructions {
    background: #f8fafc;
    border-top-color: #e2e8f0;
  }

  .ca-instructions__sub {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.4;
    color: #94a3b8;
  }

  :root[data-theme='light'] .ca-instructions__sub {
    color: #475569;
  }

  .ca-instructions__quote {
    display: block;
    padding: 0.45rem 0.65rem;
    font-size: 0.71rem;
    line-height: 1.45;
    border-radius: 6px;
    background: rgba(2, 6, 23, 0.6);
    border: 1px solid #1e293b;
    color: #5eead4;
  }

  :root[data-theme='light'] .ca-instructions__quote {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #0f766e;
  }

  /* Give the components panel more room when both panels sit side by side. */
  @container (min-width: 36rem) {
    .ca-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  /* Stack the handshake when the diagram is narrow. */
  @container (max-width: 34rem) {
    .ca-handshake {
      grid-template-columns: minmax(0, 1fr);
    }

    .ca-handshake__bridge {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.35rem 0.85rem;
    }

    /* The agent sits above the renderer, so the arrows point up and down. */
    .ca-arrow {
      display: inline-block;
      width: 1em;
      height: 1em;
      line-height: 1em;
      text-align: center;
      transform: rotate(90deg);
    }
  }
</style>
