<svg
  class={`rmark ${className}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role="img"
  aria-label={mark.title}
  style={`--brand: ${mark.color}`}
>
  <path fill="currentColor" d={mark.d}></path>
</svg>

<style>
  .rmark {
    display: inline-block;
    flex-shrink: 0;
    color: currentColor;
    transition: color 0.18s ease;
  }
</style>
