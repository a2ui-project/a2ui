import {
  DEFAULT_OG_IMAGE_PATH,
  DEFAULT_SITE_ORIGIN,
  GOOGLE_FONTS_URL,
  SITE_NAME,
} from '../lib/seo.mjs';
import {normalizeBasePrefix} from '../lib/spec-schemas.mjs';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogType?: 'website' | 'article';
  ogImagePath?: string;
  preloadImageHref?: string;
  includeWebSiteJsonLd?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogType = 'website',
  ogImagePath = DEFAULT_OG_IMAGE_PATH,
  preloadImageHref,
  includeWebSiteJsonLd = false,
} = Astro.props;

const base = normalizeBasePrefix(import.meta.env.BASE_URL);
const isSubpathBuild = Boolean(base);
const siteUrl = Astro.site ?? new URL(DEFAULT_SITE_ORIGIN);
const canonicalHref = !isSubpathBuild ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const ogImageHref = new URL(`${base}${ogImagePath}`, siteUrl).href;
const websiteJsonLd =
  includeWebSiteJsonLd && !isSubpathBuild
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_NAME,
        alternateName: 'Agent to User Interface',
        url: new URL('/', siteUrl).href,
        description,
      })
    : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{
  isSubpathBuild ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <>
      <link rel="canonical" href={canonicalHref} />
      <link rel="sitemap" href="/sitemap-index.xml" />
      <meta property="og:url" content={canonicalHref} />
    </>
  )
}
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:image" content={ogImageHref} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageHref} />
<link rel="icon" type="image/svg+xml" href={`${base}/assets/favicon.svg`} />
<link
  rel="alternate"
  type="text/markdown"
  href={`${base}/llms.txt`}
  title="A2UI documentation index for LLMs"
/>
{
  preloadImageHref && (
    <link rel="preload" as="image" href={preloadImageHref} fetchpriority="high" />
  )
}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href={GOOGLE_FONTS_URL} />
<link rel="stylesheet" href={GOOGLE_FONTS_URL} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={GOOGLE_FONTS_URL} /></noscript>
{websiteJsonLd && <script type="application/ld+json" set:html={websiteJsonLd} />}
<script is:inline>
  (() => {
    try {
      const saved = localStorage.getItem('starlight-theme') || localStorage.getItem('a2ui-theme');
      document.documentElement.setAttribute(
        'data-theme',
        saved === 'dark' || saved === 'light' ? saved : 'light',
      );
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  })();
</script>
<slot />
