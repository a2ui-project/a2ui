            "catalogId": "https://a2ui.org/specification/v1_0/catalogs/mcp/catalog.json",
            "title": "3D Holographic Geometry Studio",
            "htmlContent": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\" />\n<style>\n\n* { box-sizing: border-box; }\nbody {\n  margin: 0;\n  font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  background: #0f172a;\n  color: #e2e8f0;\n  height: 100vh;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 8px 12px;\n  background: #1e293b;\n  border-bottom: 1px solid #334155;\n  flex-shrink: 0;\n  flex-wrap: wrap;\n}\n.topbar-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.app-badge {\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  padding: 2px 7px;\n  border-radius: 999px;\n  background: rgba(56, 189, 248, 0.16);\n  color: #38bdf8;\n  border: 1px solid rgba(56, 189, 248, 0.3);\n}\n.app-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: #f8fafc;\n}\n.topbar-right {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n.dims-pill {\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: 11px;\n  padding: 2px 8px;\n  border-radius: 6px;\n  background: #0f172a;\n  color: #94a3b8;\n  border: 1px solid #334155;\n}\n.btn {\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 500;\n  padding: 4px 9px;\n  border-radius: 6px;\n  border: 1px solid #475569;\n  background: #1e293b;\n  color: #e2e8f0;\n  cursor: pointer;\n  transition: all 120ms ease;\n}\n.btn:hover { background: #334155; color: #fff; }\n.btn.active, .btn.primary {\n  background: #2563eb;\n  border-color: #3b82f6;\n  color: #fff;\n}\n.btn.primary:hover { background: #1d4ed8; }\n\n.viewport-wrap {\n  position: relative;\n  flex: 1;\n  min-height: 0;\n  background: radial-gradient(ellipse at 50% 35%, #172554 0%, #090d16 75%);\n  overflow: hidden;\n  cursor: grab;\n}\n.viewport-wrap:active { cursor: grabbing; }\ncanvas { width: 100%; height: 100%; display: block; }\n.overlay-stats {\n  position: absolute;\n  left: 12px;\n  bottom: 12px;\n  display: flex;\n  gap: 8px;\n  pointer-events: none;\n}\n.stat-chip {\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: 11px;\n  padding: 4px 8px;\n  border-radius: 6px;\n  background: rgba(15, 23, 42, 0.78);\n  border: 1px solid rgba(56, 189, 248, 0.3);\n  color: #e0f2fe;\n}\n</style>\n</head>\n<body>\n  <div class=\"topbar\">\n    <div class=\"topbar-left\">\n      <span class=\"app-badge\">MCP App</span>\n      <span class=\"app-title\">3D Holographic Geometry Studio</span>\n      <button class=\"btn active\" data-geom=\"torusKnot\">Torus Knot</button>\n      <button class=\"btn\" data-geom=\"crystal\">Geodesic Crystal</button>\n      <button class=\"btn\" data-geom=\"wave\">Cyber Wave</button>\n    </div>\n    <div class=\"topbar-right\">\n      <button class=\"btn active\" id=\"spin-btn\">Auto-Orbit</button>\n      <button class=\"btn\" id=\"wire-btn\">Shaded + Neon</button>\n      <button class=\"btn primary\" id=\"snap-btn\">Capture Pose</button>\n      <span class=\"dims-pill\" id=\"dims-badge\">auto</span>\n    </div>\n  </div>\n  <div class=\"viewport-wrap\" id=\"wrap\">\n    <canvas id=\"gl-canvas\"></canvas>\n    <div class=\"overlay-stats\">\n      <span class=\"stat-chip\" id=\"mesh-stat\">Faces: 512</span>\n      <span class=\"stat-chip\">Drag to Orbit 360° • Wheel to Zoom</span>\n    </div>\n  </div>\n<script>\n\nlet nextId = 1;\nconst pending = new Map();\nlet hostDims = { width: 0, height: 0 };\nlet bridgeReady = false;\nlet lastTelemetrySync = 0;\nconst toolInputListeners = [];\nconst toolResultListeners = [];\nconst dataUpdateListeners = [];\nconst hostContextListeners = [];\n\nfunction post(message) {\n  window.parent.postMessage(message, '*');\n}\n\nfunction sendRequest(method, params) {\n  const id = nextId++;\n  post({ jsonrpc: '2.0', id, method, params });\n  return new Promise((resolve, reject) => pending.set(id, { resolve, reject }));\n}\n\nfunction sendNotification(method, params = {}) {\n  post({ jsonrpc: '2.0', method, params });\n}\n\nfunction reportSize(height, width) {\n  const params = {};\n  if (typeof height === 'number') params.height = Math.round(height);\n  if (typeof width === 'number') params.width = Math.round(width);\n  sendNotification('ui/notifications/size-changed', params);\n}\n\nfunction updateDimsBadge(dims) {\n  if (!dims) return;\n  if (typeof dims.width === 'number') hostDims.width = Math.round(dims.width);\n  if (typeof dims.height === 'number') hostDims.height = Math.round(dims.height);\n  const el = document.getElementById('dims-badge');\n  if (el && hostDims.width && hostDims.height) {\n    el.textContent = hostDims.width + ' × ' + hostDims.height + ' px';\n  }\n}\n\nwindow.addEventListener('message', (event) => {\n  const msg = event.data;\n  if (!msg || msg.jsonrpc !== '2.0') return;\n  if (msg.method === 'ping' && msg.id !== undefined) {\n    post({ jsonrpc: '2.0', id: msg.id, result: {} });\n    return;\n  }\n  if (msg.id !== undefined && (msg.result !== undefined || msg.error !== undefined)) {\n    const waiter = pending.get(msg.id);\n    if (waiter) {\n      pending.delete(msg.id);\n      if (msg.error) waiter.reject(msg.error);\n      else waiter.resolve(msg.result);\n    }\n    return;\n  }\n  if (msg.method === 'ui/notifications/tool-input') {\n    const args = (msg.params && msg.params.arguments) || {};\n    toolInputListeners.forEach((fn) => fn(args));\n  } else if (msg.method === 'ui/notifications/tool-result') {\n    const res = msg.params || {};\n    toolResultListeners.forEach((fn) => fn(res));\n  } else if (msg.method === 'ui/notifications/data-model-update') {\n    dataUpdateListeners.forEach((fn) => fn(msg.params || {}));\n  } else if (msg.method === 'ui/notifications/host-context-changed') {\n    const ctx = msg.params || {};\n    if (ctx.containerDimensions) updateDimsBadge(ctx.containerDimensions);\n    hostContextListeners.forEach((fn) => fn(ctx));\n  }\n});\n\nasync function bootMcpApp(appName, initialHeight) {\n  const initResult = await sendRequest('ui/initialize', {\n    appInfo: { name: appName, version: '1.0.0' },\n    appCapabilities: { availableDisplayModes: ['inline', 'fullscreen'] },\n    protocolVersion: '2026-01-26',\n  });\n  if (initResult && initResult.hostContext && initResult.hostContext.containerDimensions) {\n    updateDimsBadge(initResult.hostContext.containerDimensions);\n  }\n  sendNotification('ui/notifications/initialized', {});\n  bridgeReady = true;\n  if (initialHeight) {\n    reportSize(initialHeight);\n  }\n}\n\n\nconst canvas = document.getElementById('gl-canvas');\nconst ctx = canvas.getContext('2d');\nlet geomType = 'torusKnot';\nlet autoSpin = true;\nlet wireMode = false;\nlet rotX = 0.42;\nlet rotY = 0.65;\nlet cameraDist = 4.4;\nlet mesh = { verts: [], faces: [] };\n\nfunction wrapAngle(rad) {\n  const twoPi = Math.PI * 2;\n  return ((((rad + Math.PI) % twoPi) + twoPi) % twoPi) - Math.PI;\n}\n\nfunction formatTelemetry() {\n  return `${geomType} (yaw=${rotY.toFixed(2)}, pitch=${rotX.toFixed(2)}, zoom=${cameraDist.toFixed(1)})`;\n}\n\nfunction syncTelemetry(force = false) {\n  if (!bridgeReady) return;\n  const now = performance.now();\n  if (!force && now - lastTelemetrySync < 80) return;\n  lastTelemetrySync = now;\n  sendNotification('ui/notifications/data-model-change', {\n    key: 'scene3d',\n    subpath: '/telemetry',\n    value: formatTelemetry(),\n  });\n}\n\nfunction buildTorusKnot() {\n  const verts = [], faces = [];\n  const tubular = 64, radial = 12, p = 2, q = 3;\n  for (let i = 0; i <= tubular; i++) {\n    const u = (i / tubular) * Math.PI * 2 * p;\n    const cu = Math.cos(u), su = Math.sin(u);\n    const quOverP = (q / p) * u;\n    const cs = Math.cos(quOverP), ss = Math.sin(quOverP);\n    const r = 1.05 * (2 + cs) * 0.42;\n    const cx = r * cu, cy = r * su, cz = 1.05 * ss * 0.42;\n    const du = 0.01;\n    const u2 = u + du;\n    const r2 = 1.05 * (2 + Math.cos((q / p) * u2)) * 0.42;\n    const tx = r2 * Math.cos(u2) - cx, ty = r2 * Math.sin(u2) - cy, tz = 1.05 * Math.sin((q / p) * u2) * 0.42 - cz;\n    const tLen = Math.hypot(tx, ty, tz) || 1;\n    const T = [tx / tLen, ty / tLen, tz / tLen];\n    const B = [T[1], -T[0], 0];\n    const bLen = Math.hypot(B[0], B[1], B[2]) || 1;\n    B[0] /= bLen; B[1] /= bLen;\n    const N = [\n      T[1]*B[2] - T[2]*B[1],\n      T[2]*B[0] - T[0]*B[2],\n      T[0]*B[1] - T[1]*B[0]\n    ];\n    const tubeR = 0.28;\n    for (let j = 0; j <= radial; j++) {\n      const v = (j / radial) * Math.PI * 2;\n      const cv = Math.cos(v), sv = Math.sin(v);\n      verts.push([\n        cx + tubeR * (cv * N[0] + sv * B[0]),\n        cy + tubeR * (cv * N[1] + sv * B[1]),\n        cz + tubeR * (cv * N[2] + sv * B[2]),\n      ]);\n    }\n  }\n  for (let i = 0; i < tubular; i++) {\n    for (let j = 0; j < radial; j++) {\n      const a = i * (radial + 1) + j;\n      const b = (i + 1) * (radial + 1) + j;\n      faces.push([a, b, b + 1, a + 1]);\n    }\n  }\n  return { verts, faces };\n}\n\nfunction buildCrystal() {\n  const verts = [], faces = [];\n  const lat = 14, lon = 22, R = 1.38;\n  for (let i = 0; i <= lat; i++) {\n    const theta = (i / lat) * Math.PI;\n    const st = Math.sin(theta), ct = Math.cos(theta);\n    for (let j = 0; j <= lon; j++) {\n      const phi = (j / lon) * Math.PI * 2;\n      const pulse = 1 + 0.12 * Math.sin(3 * theta) * Math.cos(4 * phi);\n      verts.push([R * pulse * st * Math.cos(phi), R * pulse * ct, R * pulse * st * Math.sin(phi)]);\n    }\n  }\n  for (let i = 0; i < lat; i++) {\n    for (let j = 0; j < lon; j++) {\n      const a = i * (lon + 1) + j;\n      const b = (i + 1) * (lon + 1) + j;\n      faces.push([a, b, b + 1, a + 1]);\n    }\n  }\n  return { verts, faces };\n}\n\nfunction buildWave(timeSec = 0) {\n  const verts = [], faces = [];\n  const N = 18, span = 1.65;\n  for (let i = 0; i <= N; i++) {\n    for (let j = 0; j <= N; j++) {\n      const x = ((i / N) - 0.5) * 2 * span;\n      const z = ((j / N) - 0.5) * 2 * span;\n      const d = Math.hypot(x, z);\n      const y = 0.38 * Math.sin(d * 3.4 - timeSec * 2.2) * Math.cos(x * 1.5);\n      verts.push([x, y, z]);\n    }\n  }\n  for (let i = 0; i < N; i++) {\n    for (let j = 0; j < N; j++) {\n      const a = i * (N + 1) + j;\n      const b = (i + 1) * (N + 1) + j;\n      faces.push([a, b, b + 1, a + 1]);\n    }\n  }\n  return { verts, faces };\n}\n\nfunction rebuildMesh(t = 0) {\n  if (geomType === 'crystal') mesh = buildCrystal();\n  else if (geomType === 'wave') mesh = buildWave(t);\n  else mesh = buildTorusKnot();\n  document.getElementById('mesh-stat').textContent = `${geomType} • ${mesh.faces.length} quads`;\n}\n\nfunction resizeCanvas() {\n  const rect = document.getElementById('wrap').getBoundingClientRect();\n  const dpr = Math.min(window.devicePixelRatio || 1, 2);\n  canvas.width = Math.max(1, Math.floor(rect.width * dpr));\n  canvas.height = Math.max(1, Math.floor(rect.height * dpr));\n}\nnew ResizeObserver(resizeCanvas).observe(document.getElementById('wrap'));\n\nfunction project([x, y, z], w, h, cx, sx, cy, sy) {\n  const x1 = x * cy + z * sy;\n  const z1 = -x * sy + z * cy;\n  const y2 = y * cx - z1 * sx;\n  const z2 = y * sx + z1 * cx;\n  const depth = cameraDist - z2;\n  const fov = Math.min(w, h) * 0.92;\n  const scale = fov / Math.max(depth, 0.4);\n  return [w * 0.5 + x1 * scale, h * 0.5 - y2 * scale, z2, x1, y2];\n}\n\nfunction renderFrame(ts) {\n  const t = ts * 0.001;\n  if (autoSpin) {\n    rotY = wrapAngle(rotY + 0.011);\n    syncTelemetry(false);\n  }\n  if (geomType === 'wave') mesh = buildWave(t);\n\n  const w = canvas.width, h = canvas.height;\n  ctx.clearRect(0, 0, w, h);\n\n  const cx = Math.cos(rotX), sx = Math.sin(rotX);\n  const cy = Math.cos(rotY), sy = Math.sin(rotY);\n  const projected = mesh.verts.map(v => project(v, w, h, cx, sx, cy, sy));\n\n  const sortedFaces = mesh.faces.map((f, idx) => {\n    const p0 = projected[f[0]], p1 = projected[f[1]], p2 = projected[f[2]], p3 = projected[f[3]];\n    const avgZ = (p0[2] + p1[2] + p2[2] + p3[2]) * 0.25;\n    // Normal in view space\n    const ux = p1[3] - p0[3], uy = p1[4] - p0[4], uz = p1[2] - p0[2];\n    const vx = p2[3] - p0[3], vy = p2[4] - p0[4], vz = p2[2] - p0[2];\n    const nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx;\n    const nLen = Math.hypot(nx, ny, nz) || 1;\n    const light = Math.max(0.15, (nx * 0.4 + ny * 0.6 + nz * 0.7) / nLen);\n    return { f, avgZ, light, idx };\n  }).sort((a, b) => a.avgZ - b.avgZ);\n\n  ctx.lineWidth = Math.max(1, w / 650);\n  for (const item of sortedFaces) {\n    const [a, b, c, d] = item.f;\n    const p0 = projected[a], p1 = projected[b], p2 = projected[c], p3 = projected[d];\n    ctx.beginPath();\n    ctx.moveTo(p0[0], p0[1]);\n    ctx.lineTo(p1[0], p1[1]);\n    ctx.lineTo(p2[0], p2[1]);\n    ctx.lineTo(p3[0], p3[1]);\n    ctx.closePath();\n\n    const hue = (195 + (item.idx % 48) * 1.4) % 360;\n    const lum = Math.round(16 + item.light * 44);\n    if (!wireMode) {\n      ctx.fillStyle = `hsla(${hue}, 85%, ${lum}%, 0.88)`;\n      ctx.fill();\n    }\n    ctx.strokeStyle = wireMode\n      ? `hsla(${hue}, 95%, 65%, 0.75)`\n      : `hsla(${hue}, 90%, ${Math.min(82, lum + 22)}%, 0.42)`;\n    ctx.stroke();\n  }\n  requestAnimationFrame(renderFrame);\n}\n\nlet dragging = false, lx = 0, ly = 0;\nconst wrap = document.getElementById('wrap');\nwrap.addEventListener('pointerdown', (e) => {\n  dragging = true; autoSpin = false;\n  document.getElementById('spin-btn').classList.remove('active');\n  lx = e.clientX; ly = e.clientY;\n});\nwindow.addEventListener('pointermove', (e) => {\n  if (!dragging) return;\n  rotY = wrapAngle(rotY + (e.clientX - lx) * 0.01);\n  rotX = Math.max(-1.4, Math.min(1.4, rotX + (e.clientY - ly) * 0.01));\n  lx = e.clientX; ly = e.clientY;\n  syncTelemetry(false);\n});\nwindow.addEventListener('pointerup', () => {\n  if (!dragging) return;\n  dragging = false;\n  syncTelemetry(true);\n});\nwrap.addEventListener('wheel', (e) => {\n  e.preventDefault();\n  cameraDist = Math.max(2.6, Math.min(7.5, cameraDist + e.deltaY * 0.003));\n  syncTelemetry(false);\n}, { passive: false });\n\ndocument.querySelectorAll('[data-geom]').forEach(btn => {\n  btn.addEventListener('click', () => {\n    document.querySelectorAll('[data-geom]').forEach(b => b.classList.remove('active'));\n    btn.classList.add('active');\n    geomType = btn.getAttribute('data-geom');\n    rebuildMesh();\n    sendNotification('ui/notifications/data-model-change', {\n      key: 'scene3d',\n      subpath: '/geometry',\n      value: geomType,\n    });\n    syncTelemetry(true);\n  });\n});\n\ndocument.getElementById('spin-btn').addEventListener('click', (e) => {\n  autoSpin = !autoSpin;\n  e.currentTarget.classList.toggle('active', autoSpin);\n  syncTelemetry(true);\n});\ndocument.getElementById('wire-btn').addEventListener('click', (e) => {\n  wireMode = !wireMode;\n  e.currentTarget.textContent = wireMode ? 'Wireframe Only' : 'Shaded + Neon';\n});\ndocument.getElementById('snap-btn').addEventListener('click', () => {\n  syncTelemetry(true);\n  sendRequest('tools/call', {\n    name: 'capture_3d_snapshot',\n    arguments: {\n      geometry: geomType,\n      yaw: Number(rotY.toFixed(2)),\n      pitch: Number(rotX.toFixed(2)),\n      zoom: Number(cameraDist.toFixed(1)),\n    },\n  });\n});\n\nfunction applySceneState(s) {\n  if (!s || typeof s !== 'object') return;\n  if (typeof s.geometry === 'string' && ['torusKnot', 'crystal', 'wave'].includes(s.geometry)) {\n    geomType = s.geometry;\n    document.querySelectorAll('[data-geom]').forEach(b => {\n      b.classList.toggle('active', b.getAttribute('data-geom') === geomType);\n    });\n    rebuildMesh();\n    syncTelemetry(true);\n  }\n}\n\ntoolInputListeners.push((args) => applySceneState(args.scene3d || args));\ndataUpdateListeners.push((params) => {\n  if (params.key === 'scene3d') {\n    if (!params.subpath) applySceneState(params.value);\n    else if (params.subpath === '/geometry') applySceneState({ geometry: params.value });\n  }\n});\n\nresizeCanvas();\nrebuildMesh();\nrequestAnimationFrame(renderFrame);\nbootMcpApp('3D Holographic Geometry Studio', 360);\n</script>\n</body>\n</html>",
            "allowedTools": ["capture_3d_snapshot"],
            "data": {
              "paths": {
                "scene3d": "/scene3d"
              }
            }
          },
          {
            "id": "scene3d_telemetry_text",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "Captured 3D camera telemetry: ${/scene3d/telemetry}"
              }
            }
          }
