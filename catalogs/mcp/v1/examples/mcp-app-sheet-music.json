{
  "name": "MCP App sheet music",
  "description": "Interactive ABC sheet music engraver and Web Audio polyphonic synthesizer MCP App. Showcases bidirectional A2UI data.paths synchronization (ui/notifications/data-model-update and data-model-change) between a sibling TextField and sandboxed SVG/Web Audio rendering, MCP ui/update-model-context (syncing the auditioned note context to /music/modelContext), and score transposition via tools/call (transpose_score).",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "gallery-mcp-app-sheet-music",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "v1.0",
      "updateDataModel": {
        "surfaceId": "gallery-mcp-app-sheet-music",
        "value": {
          "music": {
            "abc": "E E F G | G F E D | C C D E | E D D2",
            "nowPlaying": "Click any note head or ▶ Play Synth"
          }
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "gallery-mcp-app-sheet-music",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["music_heading", "music_abc_input", "music_app", "music_status_text"],
            "align": "stretch"
          },
          {
            "id": "music_heading",
            "component": "Text",
            "text": "### ABC Sheet Music Engraver & Synth Player (`ext-apps/sheet-music-server` — `ontoolinput` + Web Audio)"
          },
          {
            "id": "music_abc_input",
            "component": "TextField",
            "label": "ABC Notation Score (edit notes C D E F G A B c d e)",
            "value": {
              "@path": "/music/abc"
            }
          },
          {
            "id": "music_app",
            "component": "McpApp",
            "catalogId": "https://a2ui.org/specification/v1_0/catalogs/mcp/catalog.json",
            "title": "ABC Sheet Music Engraver",
            "htmlContent": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\" />\n<style>\n\n* { box-sizing: border-box; }\nbody {\n  margin: 0;\n  font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  background: #0f172a;\n  color: #e2e8f0;\n  height: 100vh;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 8px 12px;\n  background: #1e293b;\n  border-bottom: 1px solid #334155;\n  flex-shrink: 0;\n  flex-wrap: wrap;\n}\n.topbar-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.app-badge {\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  padding: 2px 7px;\n  border-radius: 999px;\n  background: rgba(56, 189, 248, 0.16);\n  color: #38bdf8;\n  border: 1px solid rgba(56, 189, 248, 0.3);\n}\n.app-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: #f8fafc;\n}\n.topbar-right {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n.dims-pill {\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: 11px;\n  padding: 2px 8px;\n  border-radius: 6px;\n  background: #0f172a;\n  color: #94a3b8;\n  border: 1px solid #334155;\n}\n.btn {\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 500;\n  padding: 4px 9px;\n  border-radius: 6px;\n  border: 1px solid #475569;\n  background: #1e293b;\n  color: #e2e8f0;\n  cursor: pointer;\n  transition: all 120ms ease;\n}\n.btn:hover { background: #334155; color: #fff; }\n.btn.active, .btn.primary {\n  background: #2563eb;\n  border-color: #3b82f6;\n  color: #fff;\n}\n.btn.primary:hover { background: #1d4ed8; }\n\n.music-body {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 12px;\n  flex: 1;\n  min-height: 0;\n}\n.staff-card {\n  background: #f8fafc;\n  color: #0f172a;\n  border-radius: 10px;\n  padding: 10px 14px;\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  min-height: 140px;\n  box-shadow: inset 0 2px 6px rgba(15, 23, 42, 0.08);\n}\n.staff-header {\n  display: flex;\n  justify-content: space-between;\n  font-size: 12px;\n  font-weight: 700;\n  color: #334155;\n  margin-bottom: 4px;\n}\nsvg#staff-svg { width: 100%; height: 120px; display: block; }\n.note-group { cursor: pointer; transition: transform 120ms; }\n.note-head { fill: #0f172a; transition: fill 120ms; }\n.note-group.playing .note-head { fill: #d97706; r: 7.5; }\n.note-group:hover .note-head { fill: #2563eb; }\n.controls-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  font-size: 12px;\n  color: #94a3b8;\n}\n</style>\n</head>\n<body>\n  <div class=\"topbar\">\n    <div class=\"topbar-left\">\n      <span class=\"app-badge\">MCP App</span>\n      <span class=\"app-title\">ABC Sheet Music Engraver & Synth</span>\n      <button class=\"btn\" data-tune=\"ode\">Ode to Joy</button>\n      <button class=\"btn\" data-tune=\"arp\">Cyberpunk Arp</button>\n      <button class=\"btn\" data-tune=\"scale\">C Major Scale</button>\n    </div>\n    <div class=\"topbar-right\">\n      <button class=\"btn primary\" id=\"play-btn\">▶ Play Synth</button>\n      <button class=\"btn\" id=\"transpose-btn\">Transpose +2</button>\n      <span class=\"dims-pill\" id=\"dims-badge\">auto</span>\n    </div>\n  </div>\n  <div class=\"music-body\">\n    <div class=\"staff-card\">\n      <div class=\"staff-header\">\n        <span id=\"score-title\">Ode to Joy (Beethoven) — 4/4 Standard Staff</span>\n        <span id=\"active-note-label\">Click any note head to audition</span>\n      </div>\n      <svg id=\"staff-svg\" viewBox=\"0 0 640 120\"></svg>\n    </div>\n    <div class=\"controls-bar\">\n      <span id=\"abc-preview\">ABC: E E F G | G F E D | C C D E | E D D2</span>\n      <span>Web Audio Polyphonic Oscillator • 128 BPM</span>\n    </div>\n  </div>\n<script>\n\nlet nextId = 1;\nconst pending = new Map();\nlet hostDims = { width: 0, height: 0 };\nconst toolInputListeners = [];\nconst toolResultListeners = [];\nconst dataUpdateListeners = [];\nconst hostContextListeners = [];\n\nfunction post(message) {\n  window.parent.postMessage(message, '*');\n}\n\nfunction sendRequest(method, params) {\n  const id = nextId++;\n  post({ jsonrpc: '2.0', id, method, params });\n  return new Promise((resolve, reject) => pending.set(id, { resolve, reject }));\n}\n\nfunction sendNotification(method, params = {}) {\n  post({ jsonrpc: '2.0', method, params });\n}\n\nfunction reportSize(height, width) {\n  const params = {};\n  if (typeof height === 'number') params.height = Math.round(height);\n  if (typeof width === 'number') params.width = Math.round(width);\n  sendNotification('ui/notifications/size-changed', params);\n}\n\nfunction updateDimsBadge(dims) {\n  if (!dims) return;\n  if (typeof dims.width === 'number') hostDims.width = Math.round(dims.width);\n  if (typeof dims.height === 'number') hostDims.height = Math.round(dims.height);\n  const el = document.getElementById('dims-badge');\n  if (el && hostDims.width && hostDims.height) {\n    el.textContent = hostDims.width + ' × ' + hostDims.height + ' px';\n  }\n}\n\nwindow.addEventListener('message', (event) => {\n  const msg = event.data;\n  if (!msg || msg.jsonrpc !== '2.0') return;\n  if (msg.method === 'ping' && msg.id !== undefined) {\n    post({ jsonrpc: '2.0', id: msg.id, result: {} });\n    return;\n  }\n  if (msg.id !== undefined && (msg.result !== undefined || msg.error !== undefined)) {\n    const waiter = pending.get(msg.id);\n    if (waiter) {\n      pending.delete(msg.id);\n      if (msg.error) waiter.reject(msg.error);\n      else waiter.resolve(msg.result);\n    }\n    return;\n  }\n  if (msg.method === 'ui/notifications/tool-input') {\n    const args = (msg.params && msg.params.arguments) || {};\n    toolInputListeners.forEach((fn) => fn(args));\n  } else if (msg.method === 'ui/notifications/tool-result') {\n    const res = msg.params || {};\n    toolResultListeners.forEach((fn) => fn(res));\n  } else if (msg.method === 'ui/notifications/data-model-update') {\n    dataUpdateListeners.forEach((fn) => fn(msg.params || {}));\n  } else if (msg.method === 'ui/notifications/host-context-changed') {\n    const ctx = msg.params || {};\n    if (ctx.containerDimensions) updateDimsBadge(ctx.containerDimensions);\n    hostContextListeners.forEach((fn) => fn(ctx));\n  }\n});\n\nasync function bootMcpApp(appName, initialHeight) {\n  const initResult = await sendRequest('ui/initialize', {\n    appInfo: { name: appName, version: '1.0.0' },\n    appCapabilities: { availableDisplayModes: ['inline', 'fullscreen'] },\n    protocolVersion: '2026-01-26',\n  });\n  if (initResult && initResult.hostContext && initResult.hostContext.containerDimensions) {\n    updateDimsBadge(initResult.hostContext.containerDimensions);\n  }\n  sendNotification('ui/notifications/initialized', {});\n  if (initialHeight) {\n    reportSize(initialHeight);\n  }\n}\n\n\nconst TUNES = {\n  ode: { title: 'Ode to Joy (Beethoven)', abc: 'E E F G | G F E D | C C D E | E D D2' },\n  arp: { title: 'Cyberpunk Dorian Motif', abc: 'D F A c | B A G F | E G B d | c B A2' },\n  scale: { title: 'Ascending Concert Scale', abc: 'C D E F | G A B c | d c B A | G F E C' },\n};\n\nconst PITCH_MAP = {\n  'C': { step: 0, freq: 261.63 },\n  'D': { step: 1, freq: 293.66 },\n  'E': { step: 2, freq: 329.63 },\n  'F': { step: 3, freq: 349.23 },\n  'G': { step: 4, freq: 392.00 },\n  'A': { step: 5, freq: 440.00 },\n  'B': { step: 6, freq: 493.88 },\n  'c': { step: 7, freq: 523.25 },\n  'd': { step: 8, freq: 587.33 },\n  'e': { step: 9, freq: 659.25 },\n};\nconst STEP_ORDER = ['C', 'D', 'E', 'F', 'G', 'A', 'B', 'c', 'd', 'e'];\n\nlet abcString = TUNES.ode.abc;\nlet tuneTitle = TUNES.ode.title;\nlet activeIdx = -1;\nlet audioCtx = null;\nlet playTimer = null;\n\nfunction parseAbc(abc) {\n  const tokens = String(abc || '').trim().split(/\\s+/);\n  const items = [];\n  for (const tok of tokens) {\n    if (tok === '|') {\n      items.push({ type: 'bar' });\n      continue;\n    }\n    const m = tok.match(/^([A-Ga-g])(2)?$/);\n    if (m && PITCH_MAP[m[1]]) {\n      items.push({\n        type: 'note',\n        pitch: m[1],\n        duration: m[2] ? 2 : 1,\n        ...PITCH_MAP[m[1]],\n      });\n    }\n  }\n  return items;\n}\n\nfunction renderStaff() {\n  document.getElementById('score-title').textContent = tuneTitle;\n  document.getElementById('abc-preview').textContent = 'ABC: ' + abcString;\n  const svg = document.getElementById('staff-svg');\n  svg.textContent = '';\n  const ns = 'http://www.w3.org/2000/svg';\n\n  // 5 staff lines: E4 (step 2) is bottom line y=84, each diatonic step is 5px\n  for (let i = 0; i < 5; i++) {\n    const y = 44 + i * 10;\n    const line = document.createElementNS(ns, 'line');\n    line.setAttribute('x1', '16');\n    line.setAttribute('x2', '624');\n    line.setAttribute('y1', String(y));\n    line.setAttribute('y2', String(y));\n    line.setAttribute('stroke', '#94a3b8');\n    line.setAttribute('stroke-width', '1.2');\n    svg.appendChild(line);\n  }\n\n  // Treble clef symbol\n  const clef = document.createElementNS(ns, 'text');\n  clef.setAttribute('x', '22');\n  clef.setAttribute('y', '78');\n  clef.setAttribute('font-size', '44');\n  clef.setAttribute('fill', '#0f172a');\n  clef.textContent = '𝄞';\n  svg.appendChild(clef);\n\n  const items = parseAbc(abcString);\n  const spacing = Math.min(34, 540 / Math.max(items.length, 1));\n  let noteIndex = 0;\n\n  items.forEach((item, idx) => {\n    const x = 68 + idx * spacing;\n    if (item.type === 'bar') {\n      const bar = document.createElementNS(ns, 'line');\n      bar.setAttribute('x1', String(x));\n      bar.setAttribute('x2', String(x));\n      bar.setAttribute('y1', '44');\n      bar.setAttribute('y2', '84');\n      bar.setAttribute('stroke', '#475569');\n      bar.setAttribute('stroke-width', '1.5');\n      svg.appendChild(bar);\n      return;\n    }\n    const currentNoteIdx = noteIndex++;\n    // step 2 (E4) -> y=84; each step up is -5px\n    const y = 84 - (item.step - 2) * 5;\n    const g = document.createElementNS(ns, 'g');\n    g.setAttribute('class', currentNoteIdx === activeIdx ? 'note-group playing' : 'note-group');\n\n    // Ledger line for Middle C (step 0 -> y=94)\n    if (item.step === 0) {\n      const ledger = document.createElementNS(ns, 'line');\n      ledger.setAttribute('x1', String(x - 10));\n      ledger.setAttribute('x2', String(x + 10));\n      ledger.setAttribute('y1', '94');\n      ledger.setAttribute('y2', '94');\n      ledger.setAttribute('stroke', '#334155');\n      ledger.setAttribute('stroke-width', '1.4');\n      g.appendChild(ledger);\n    }\n\n    const head = document.createElementNS(ns, 'ellipse');\n    head.setAttribute('cx', String(x));\n    head.setAttribute('cy', String(y));\n    head.setAttribute('rx', '6.2');\n    head.setAttribute('ry', '4.6');\n    head.setAttribute('transform', `rotate(-18 ${x} ${y})`);\n    head.setAttribute('class', 'note-head');\n    if (item.duration === 2) {\n      head.setAttribute('fill', '#f8fafc');\n      head.setAttribute('stroke', '#0f172a');\n      head.setAttribute('stroke-width', '2');\n    }\n\n    const stem = document.createElementNS(ns, 'line');\n    const stemUp = item.step < 6;\n    stem.setAttribute('x1', String(stemUp ? x + 5.5 : x - 5.5));\n    stem.setAttribute('x2', String(stemUp ? x + 5.5 : x - 5.5));\n    stem.setAttribute('y1', String(y));\n    stem.setAttribute('y2', String(stemUp ? y - 28 : y + 28));\n    stem.setAttribute('stroke', '#0f172a');\n    stem.setAttribute('stroke-width', '1.6');\n\n    const lbl = document.createElementNS(ns, 'text');\n    lbl.setAttribute('x', String(x));\n    lbl.setAttribute('y', '112');\n    lbl.setAttribute('font-size', '10');\n    lbl.setAttribute('text-anchor', 'middle');\n    lbl.setAttribute('fill', '#64748b');\n    lbl.textContent = item.pitch;\n\n    g.append(head, stem, lbl);\n    g.addEventListener('click', () => {\n      activeIdx = currentNoteIdx;\n      playTone(item.freq, 0.25);\n      announceNote(item.pitch, item.freq);\n      renderStaff();\n    });\n    svg.appendChild(g);\n  });\n}\n\nfunction playTone(freq, durSec) {\n  const Ctx = window.AudioContext || window.webkitAudioContext;\n  if (!Ctx) return;\n  if (!audioCtx) audioCtx = new Ctx();\n  if (audioCtx.state === 'suspended') audioCtx.resume();\n  const osc = audioCtx.createOscillator();\n  const gain = audioCtx.createGain();\n  osc.type = 'triangle';\n  osc.frequency.setValueAtTime(freq, audioCtx.currentTime);\n  gain.gain.setValueAtTime(0.18, audioCtx.currentTime);\n  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + durSec);\n  osc.connect(gain);\n  gain.connect(audioCtx.destination);\n  osc.start();\n  osc.stop(audioCtx.currentTime + durSec);\n}\n\nfunction announceNote(pitch, freq) {\n  const status = `Playing ${pitch} (${freq.toFixed(1)} Hz) — ${tuneTitle}`;\n  document.getElementById('active-note-label').textContent = status;\n  sendNotification('ui/notifications/data-model-change', {\n    key: 'music',\n    subpath: '/nowPlaying',\n    value: status,\n  });\n  sendRequest('ui/update-model-context', {\n    structuredContent: { activePitch: pitch, frequencyHz: Number(freq.toFixed(1)), tune: tuneTitle },\n  }).catch(() => {});\n}\n\ndocument.getElementById('play-btn').addEventListener('click', () => {\n  if (playTimer) {\n    clearInterval(playTimer);\n    playTimer = null;\n    document.getElementById('play-btn').textContent = '▶ Play Synth';\n    return;\n  }\n  const notes = parseAbc(abcString).filter(x => x.type === 'note');\n  if (notes.length === 0) return;\n  let idx = 0;\n  document.getElementById('play-btn').textContent = '⏹ Stop';\n  const step = () => {\n    if (idx >= notes.length) {\n      clearInterval(playTimer);\n      playTimer = null;\n      activeIdx = -1;\n      document.getElementById('play-btn').textContent = '▶ Play Synth';\n      renderStaff();\n      return;\n    }\n    activeIdx = idx;\n    const n = notes[idx++];\n    playTone(n.freq, 0.26 * n.duration);\n    announceNote(n.pitch, n.freq);\n    renderStaff();\n  };\n  step();\n  playTimer = setInterval(step, 280);\n});\n\ndocument.getElementById('transpose-btn').addEventListener('click', () => {\n  abcString = abcString.replace(/[A-Ga-g]/g, (ch) => {\n    const idx = STEP_ORDER.indexOf(ch);\n    return idx >= 0 ? STEP_ORDER[(idx + 1) % STEP_ORDER.length] : ch;\n  });\n  renderStaff();\n  sendNotification('ui/notifications/data-model-change', {\n    key: 'music',\n    subpath: '/abc',\n    value: abcString,\n  });\n  sendRequest('tools/call', {\n    name: 'transpose_score',\n    arguments: { abc: abcString },\n  });\n});\n\ndocument.querySelectorAll('[data-tune]').forEach(btn => {\n  btn.addEventListener('click', () => {\n    const preset = TUNES[btn.getAttribute('data-tune')];\n    if (!preset) return;\n    abcString = preset.abc;\n    tuneTitle = preset.title;\n    renderStaff();\n    sendNotification('ui/notifications/data-model-change', {\n      key: 'music',\n      subpath: '/abc',\n      value: abcString,\n    });\n  });\n});\n\nfunction applyMusicData(val) {\n  if (!val || typeof val !== 'object') return;\n  if (typeof val.abc === 'string' && val.abc !== abcString) {\n    abcString = val.abc;\n    renderStaff();\n    sendRequest('ui/update-model-context', {\n      structuredContent: { abc: abcString, tune: tuneTitle },\n    }).catch(() => {});\n  }\n}\n\ntoolInputListeners.push((args) => applyMusicData(args.music || args));\ndataUpdateListeners.push((params) => {\n  if (params.key === 'music') {\n    if (!params.subpath) applyMusicData(params.value);\n    else if (params.subpath === '/abc') applyMusicData({ abc: params.value });\n  }\n});\n\nrenderStaff();\nbootMcpApp('ABC Sheet Music Engraver', 250);\n</script>\n</body>\n</html>",
            "allowedTools": ["transpose_score"],
            "data": {
              "paths": {
                "music": "/music",
                "modelContext": "/music/modelContext"
              }
            }
          },
          {
            "id": "music_status_text",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "Synthesizer status: ${/music/nowPlaying}"
              }
            }
          }
        ]
      }
    }
  ]
}
