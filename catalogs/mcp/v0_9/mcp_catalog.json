{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/specification/v0_9/catalogs/mcp/mcp_catalog.json",
  "title": "A2UI MCP Catalog",
  "description": "A2UI Catalog for interacting with Model Context Protocol (MCP) servers, and for reshaping what a tool returns into data model updates.",
  "catalogId": "https://a2ui.org/specification/v0_9/catalogs/mcp/mcp_catalog.json",
  "components": {},
  "functions": {
    "callMcpTool": {
      "type": "object",
      "description": "Executes a tool on a connected Model Context Protocol (MCP) server and returns the result. To turn that result into data model updates, nest this call inside `jmespath` and `updateDataModel`.",
      "properties": {
        "call": {
          "const": "callMcpTool"
        },
        "args": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "The name of the MCP tool to execute."
            },
            "arguments": {
              "type": "object",
              "description": "The arguments to pass to the MCP tool.",
              "additionalProperties": {
                "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue"
              }
            }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "any"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "jmespath": {
      "type": "object",
      "description": "Evaluates a JMESPath expression against a document.",
      "properties": {
        "call": {
          "const": "jmespath"
        },
        "args": {
          "type": "object",
          "properties": {
            "expression": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "A JMESPath expression, as specified at jmespath.org, evaluated against `data`."
            },
            "data": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue",
              "description": "The document the expression reads."
            }
          },
          "required": ["expression", "data"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "any"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "split": {
      "type": "object",
      "description": "Splits a string, or each element of an array, on a separator.",
      "properties": {
        "call": {
          "const": "split"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue",
              "description": "The string to split. An array is split element by element, giving an array of arrays."
            },
            "separator": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "The separator to split on. An empty separator splits into characters."
            }
          },
          "required": ["value", "separator"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "any"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "regexCapture": {
      "type": "object",
      "description": "Returns the capture groups of the first RE2 match.",
      "properties": {
        "call": {
          "const": "regexCapture"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue",
              "description": "The string to match. An array is matched element by element, giving an array of results."
            },
            "pattern": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "An RE2 pattern. The result is the capture groups of the first match, or null when the pattern does not match. A group that did not participate reads as an empty string."
            }
          },
          "required": ["value", "pattern"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "any"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "regexReplace": {
      "type": "object",
      "description": "Replaces every RE2 match with literal text.",
      "properties": {
        "call": {
          "const": "regexReplace"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue",
              "description": "The string to rewrite. An array is rewritten element by element."
            },
            "pattern": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "An RE2 pattern. Every match is replaced."
            },
            "replacement": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Literal replacement text. A group reference such as $1 is not expanded."
            }
          },
          "required": ["value", "pattern", "replacement"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "any"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "updateDataModel": {
      "type": "object",
      "description": "Writes an object of data model paths into the calling surface.",
      "properties": {
        "call": {
          "const": "updateDataModel"
        },
        "args": {
          "type": "object",
          "properties": {
            "updates": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue",
              "description": "An object whose keys are data model paths and whose values are what to write there, for example {\"/entries\": [...], \"/title\": \"Home\"}. A key starting with \"/\" is absolute; a relative key resolves against the data context the call was made from, which is the row scope when the call came from a template list."
            }
          },
          "required": ["updates"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "any"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "anyComponent": {
      "type": "object"
    },
    "anyFunction": {
      "oneOf": [
        {
          "$ref": "#/functions/callMcpTool"
        },
        {
          "$ref": "#/functions/jmespath"
        },
        {
          "$ref": "#/functions/split"
        },
        {
          "$ref": "#/functions/regexCapture"
        },
        {
          "$ref": "#/functions/regexReplace"
        },
        {
          "$ref": "#/functions/updateDataModel"
        }
      ]
    }
  }
}
