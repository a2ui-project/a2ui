{
  "name": "URL order tracker",
  "description": "A WebAppFrameUrl order tracker that covers every interaction of the component: it loads an external app by URL, takes its theme and locale from static config, reads the orders from bound data, writes a status summary back through mutableData for a sibling basic component, reports selected and delivered orders as actions and sizes its frame to its content.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "gallery-iframe-order-tracker",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "v1.0",
      "updateDataModel": {
        "surfaceId": "gallery-iframe-order-tracker",
        "value": {
          "orders": [
            {
              "id": "A-1001",
              "status": "shipped"
            },
            {
              "id": "A-1002",
              "status": "processing"
            },
            {
              "id": "A-1003",
              "status": "shipped"
            }
          ],
          "summary": ""
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "gallery-iframe-order-tracker",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["title", "order_tracker", "summary_view"],
            "align": "stretch"
          },
          {
            "id": "title",
            "component": "Text",
            "text": "## Order tracker"
          },
          {
            "id": "order_tracker",
            "component": "WebAppFrameUrl",
            "catalogId": "https://a2ui.org/specification/v1_0/catalogs/iframe/catalog.json",
            "url": "https://example.com/a2ui-apps/order-tracker/",
            "height": 240,
            "config": {
              "theme": "light",
              "locale": "en-US"
            },
            "data": {
              "paths": {
                "orders": "/orders",
                "summary": "/summary"
              }
            },
            "mutableData": {
              "summary": {
                "type": "string"
              }
            },
            "allowedEvents": {
              "order_selected": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "string"
                  }
                },
                "required": ["orderId"],
                "additionalProperties": false
              },
              "order_delivered": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "string"
                  }
                },
                "required": ["orderId"],
                "additionalProperties": false
              }
            }
          },
          {
            "id": "summary_view",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "Status: ${/summary}"
              }
            },
            "variant": "caption"
          }
        ]
      }
    }
  ]
}
