{
  "name": "Contact Card",
  "description": "Example of contact card",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "gallery-contact-card",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "gallery-contact-card",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": {
              "@child": "main_column"
            }
          },
          {
            "id": "main_column",
            "component": "Column",
            "children": {
              "@child": ["avatar_image", "name", "title", "divider", "contact_info", "actions"]
            },
            "align": "center"
          },
          {
            "id": "avatar_image",
            "component": "Image",
            "url": {
              "@path": "/avatar"
            },
            "fit": "cover",
            "variant": "avatar"
          },
          {
            "id": "name",
            "component": "Text",
            "text": {
              "@path": "/name"
            }
          },
          {
            "id": "title",
            "component": "Text",
            "text": {
              "@path": "/title"
            },
            "variant": "body"
          },
          {
            "id": "divider",
            "component": "Divider"
          },
          {
            "id": "contact_info",
            "component": "Column",
            "children": {
              "@child": ["phone_row", "email_row", "location_row"]
            }
          },
          {
            "id": "phone_row",
            "component": "Row",
            "children": {
              "@child": ["phone_icon", "phone_text"]
            },
            "align": "center"
          },
          {
            "id": "phone_icon",
            "component": "Icon",
            "name": "phone"
          },
          {
            "id": "phone_text",
            "component": "Text",
            "text": {
              "@path": "/phone"
            },
            "variant": "body"
          },
          {
            "id": "email_row",
            "component": "Row",
            "children": {
              "@child": ["email_icon", "email_text"]
            },
            "align": "center"
          },
          {
            "id": "email_icon",
            "component": "Icon",
            "name": "mail"
          },
          {
            "id": "email_text",
            "component": "Text",
            "text": {
              "@path": "/email"
            },
            "variant": "body"
          },
          {
            "id": "location_row",
            "component": "Row",
            "children": {
              "@child": ["location_icon", "location_text"]
            },
            "align": "center"
          },
          {
            "id": "location_icon",
            "component": "Icon",
            "name": "locationOn"
          },
          {
            "id": "location_text",
            "component": "Text",
            "text": {
              "@path": "/location"
            },
            "variant": "body"
          },
          {
            "id": "actions",
            "component": "Row",
            "children": {
              "@child": ["call_btn", "message_btn"]
            }
          },
          {
            "id": "call_btn_text",
            "component": "Text",
            "text": "Call"
          },
          {
            "id": "call_btn",
            "component": "Button",
            "child": {
              "@child": "call_btn_text"
            },
            "action": {
              "@action": {
                "name": "call",
                "context": {}
              }
            }
          },
          {
            "id": "message_btn_text",
            "component": "Text",
            "text": "Message"
          },
          {
            "id": "message_btn",
            "component": "Button",
            "child": {
              "@child": "message_btn_text"
            },
            "action": {
              "@action": {
                "name": "message",
                "context": {}
              }
            }
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "gallery-contact-card",
        "value": {
          "avatar": "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop",
          "name": "David Park",
          "title": "Engineering Manager",
          "phone": "+1 (555) 234-5678",
          "email": "david.park@company.com",
          "location": "San Francisco, CA"
        }
      }
    }
  ]
}
