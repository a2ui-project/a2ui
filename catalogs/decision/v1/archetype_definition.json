{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/specification/v1_0/decision/archetype_definition.json",
  "title": "A2UI decision layout archetype grammar",
  "description": "Catalog-agnostic grammar of layout archetypes, blocks, questions, slots, and rules consumed by the decision inference format. Experimental and non-normative: the Python agent SDK (a2ui.inference_formats.decision) is the reference implementation, and this schema may change between grammar versions.",
  "type": "object",
  "required": ["grammarVersion", "thresholds", "job", "archetypes", "blocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "grammarVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Compatibility version of the grammar. A catalog pattern file declares the grammar version it targets, and the SDK rejects a mismatch."
    },
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "job": {"$ref": "#/$defs/job"},
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/archetype"}
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/block"}
    },
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    },
    "lint": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "A probability or score threshold in the closed interval [0, 1]."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "A lowercase snake_case identifier for an archetype, family, block, or pattern."
    },
    "blockMark": {
      "type": "string",
      "pattern": "^[a-z_]+[!?]?$",
      "description": "A block id with an optional mark: `!` required, `?` optional, bare expected."
    },
    "stringList": {
      "type": "array",
      "description": "A list of strings.",
      "items": {"type": "string"}
    },
    "stringMap": {
      "type": "object",
      "description": "A map of string keys to string values.",
      "additionalProperties": {"type": "string"}
    },
    "range": {
      "type": "array",
      "description": "An inclusive [min, max] pair; null leaves that end open.",
      "prefixItems": [{"type": ["integer", "null"]}, {"type": ["integer", "null"]}],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "thresholds": {
      "type": "object",
      "description": "Probability thresholds governing family, archetype, block, instance, template, and action-gate selection.",
      "required": [
        "family",
        "archetype",
        "expected",
        "optional",
        "instance",
        "template",
        "templateMutable",
        "actionGateFloor",
        "actionGateCap",
        "noFit"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "$ref": "#/$defs/unitInterval",
          "description": "Minimum probability for a job family option to be selected."
        },
        "archetype": {
          "$ref": "#/$defs/unitInterval",
          "description": "Minimum probability for an archetype within the chosen family to be selected."
        },
        "expected": {
          "$ref": "#/$defs/unitInterval",
          "description": "Minimum gate probability for an unmarked (expected) block to be included."
        },
        "optional": {
          "$ref": "#/$defs/unitInterval",
          "description": "Minimum gate probability for a `?`-marked (optional) block to be included."
        },
        "instance": {
          "$ref": "#/$defs/unitInterval",
          "description": "Minimum probability for a per-element instance question answer."
        },
        "template": {
          "$ref": "#/$defs/unitInterval",
          "description": "Minimum probability for the template question to render a registered template."
        },
        "templateMutable": {
          "$ref": "#/$defs/unitInterval",
          "description": "Template threshold when the payload or the template is editable."
        },
        "actionGateFloor": {
          "$ref": "#/$defs/unitInterval",
          "description": "Minimum archetype confidence required to enable interactive actions when stakes are 0."
        },
        "actionGateCap": {
          "$ref": "#/$defs/unitInterval",
          "description": "Minimum archetype confidence required to enable interactive actions when stakes reach the maximum level."
        },
        "noFit": {
          "$ref": "#/$defs/unitInterval",
          "description": "Minimum probability of the job.family option `none` at which the planner gives up on archetypes and returns a no_fit outcome, so the caller falls back to free-form synthesis."
        }
      }
    },
    "job": {
      "type": "object",
      "description": "Top-level surface questions that classify the user's job family, stakes, and urgency.",
      "required": ["family", "stakes", "urgency"],
      "additionalProperties": false,
      "properties": {
        "family": {
          "$ref": "#/$defs/choiceQuestion",
          "description": "Which kind of job the surface serves. Every option except `none` names the family of one or more archetypes. The option `none` has no archetypes: it lets the model say that no layout fits, and wins once its probability reaches thresholds.noFit."
        },
        "stakes": {
          "$ref": "#/$defs/scoreQuestion",
          "description": "Score question measuring the cost or irreversibility of an error on this surface."
        },
        "urgency": {
          "$ref": "#/$defs/scoreQuestion",
          "description": "Score question measuring how quickly the person must act on the surface."
        }
      }
    },
    "shapeFilter": {
      "type": "object",
      "description": "Deterministic payload pre-filter evaluated before a question enters the batch.",
      "additionalProperties": false,
      "properties": {
        "pointers": {"$ref": "#/$defs/stringList"},
        "arrayLength": {"$ref": "#/$defs/range"},
        "elementTypes": {"$ref": "#/$defs/stringList"},
        "elementKeys": {"$ref": "#/$defs/stringList"},
        "mutable": {"type": "boolean"},
        "proseLength": {
          "type": "array",
          "items": {"enum": ["line", "blurb", "summary", "article"]}
        },
        "count": {"$ref": "#/$defs/range"},
        "actions_allowed": {"type": "boolean"}
      }
    },
    "archetype": {
      "type": "object",
      "description": "An ordered layout composition of blocks belonging to one job family.",
      "required": ["id", "family", "criteria", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "family": {"$ref": "#/$defs/identifier"},
        "criteria": {"type": "string", "minLength": 1},
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/blockMark"}
        },
        "shape": {"$ref": "#/$defs/shapeFilter"},
        "atLeast": {"type": "integer", "minimum": 1},
        "frame": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        }
      }
    },
    "appliesWhen": {
      "type": "object",
      "description": "Slot name to semantic type(s) or the word `bound`; the question is asked only when it holds.",
      "additionalProperties": {
        "oneOf": [{"type": "string"}, {"$ref": "#/$defs/stringList"}]
      }
    },
    "derivedWhen": {
      "type": "object",
      "description": "Deterministic answers keyed by hint source; the question is skipped when one matches.",
      "additionalProperties": {"type": "object"}
    },
    "requires": {
      "type": "object",
      "description": "Option id to the slots, knob options, pattern variants, or capability flags it needs.",
      "additionalProperties": {"$ref": "#/$defs/stringList"}
    },
    "questionBase": {
      "type": "object",
      "description": "Common fields shared by choice, boolean, and score questions.",
      "required": ["kind", "question"],
      "properties": {
        "kind": {"enum": ["choice", "boolean", "score"]},
        "question": {"type": "string", "minLength": 1},
        "appliesWhen": {"$ref": "#/$defs/appliesWhen"},
        "derivedWhen": {"$ref": "#/$defs/derivedWhen"},
        "note": {"type": "string"}
      }
    },
    "choiceQuestion": {
      "allOf": [{"$ref": "#/$defs/questionBase"}],
      "type": "object",
      "description": "A multiple-choice question whose options come from a static map or a bound slot.",
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "choice"},
        "question": true,
        "appliesWhen": true,
        "derivedWhen": true,
        "note": true,
        "options": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        },
        "optionsFrom": {"type": "string", "minLength": 1},
        "requires": {"$ref": "#/$defs/requires"},
        "allowNone": {"type": "boolean"}
      },
      "oneOf": [{"required": ["options"]}, {"required": ["optionsFrom"]}]
    },
    "booleanQuestion": {
      "allOf": [{"$ref": "#/$defs/questionBase"}],
      "type": "object",
      "description": "A yes/no gate or anatomy question with explicit criteria for both outcomes.",
      "required": ["yes", "no"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "boolean"},
        "question": true,
        "appliesWhen": true,
        "derivedWhen": true,
        "note": true,
        "yes": {"type": "string", "minLength": 1},
        "no": {"type": "string", "minLength": 1}
      }
    },
    "scoreQuestion": {
      "allOf": [{"$ref": "#/$defs/questionBase"}],
      "type": "object",
      "description": "An ordinal scale question evaluated as the expected level index across ordered criteria.",
      "required": ["levels"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "score"},
        "question": true,
        "appliesWhen": true,
        "derivedWhen": true,
        "note": true,
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "perPointer": {"type": "boolean"},
        "select": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 1},
            "aboveLevel": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "question": {
      "description": "Any decision question (choice, boolean, or score).",
      "oneOf": [
        {"$ref": "#/$defs/choiceQuestion"},
        {"$ref": "#/$defs/booleanQuestion"},
        {"$ref": "#/$defs/scoreQuestion"}
      ]
    },
    "slot": {
      "type": "object",
      "description": "A data slot on a block or repeated element that binds to payload pointers matching semantic types.",
      "required": ["from"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "required": {"type": "boolean"},
        "repeat": {"type": "boolean"},
        "max": {"type": "integer", "minimum": 1},
        "prefer": {"$ref": "#/$defs/stringList"},
        "avoidKeys": {"$ref": "#/$defs/stringList"},
        "sibling": {"$ref": "#/$defs/stringList"},
        "orderBy": {"type": "string", "minLength": 1},
        "mutable": {"type": "boolean"},
        "elementTypes": {"$ref": "#/$defs/stringList"},
        "default": true,
        "note": {"type": "string"},
        "fields": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/slot"}
        }
      }
    },
    "measure": {
      "type": "object",
      "description": "A deterministic bucketed measure computed from payload metadata rather than asked of the model.",
      "required": ["derivedFrom", "levels"],
      "additionalProperties": false,
      "properties": {
        "derivedFrom": {"type": "string", "minLength": 1},
        "levels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/range"}
        },
        "note": {"type": "string"}
      }
    },
    "block": {
      "type": "object",
      "description": "A reusable content block with its primary abstract pattern, gate, questions, slots, and fallback chain.",
      "required": ["id", "pattern", "fallback"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "pattern": {"$ref": "#/$defs/identifier"},
        "shape": {"$ref": "#/$defs/shapeFilter"},
        "gate": {"$ref": "#/$defs/booleanQuestion"},
        "salience": {"$ref": "#/$defs/scoreQuestion"},
        "anatomy": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/question"}
        },
        "instance": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/question"}
        },
        "measures": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/measure"}
        },
        "slots": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/slot"}
        },
        "fallback": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z_-]+(:[a-z_]+)?$"}
        }
      }
    },
    "rule": {
      "type": "object",
      "description": "A named normative planning rule enforced by the layout planner and pattern expander.",
      "required": ["id", "rule"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "rule": {"type": "string", "minLength": 1}
      }
    }
  }
}
